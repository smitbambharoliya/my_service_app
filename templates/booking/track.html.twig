{% extends 'base.html.twig' %}

{% block stylesheets %}
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css">
{% endblock %}

{% block title %}Telemetry — {{ booking.service.title }}{% endblock %}

{% block body %}
<div class="animate-fade-in" style="padding-top: 100px;">
    {# ── 1. TELEMETRY HEADER & TIMELINE ── #}
    <section class="py-5" style="background: linear-gradient(to bottom, var(--bg-deep), transparent);">
        <div class="container">
            <div class="d-flex justify-content-between align-items-center mb-5">
                <div>
                    <span class="text-teal text-xxs fw-800 letter-spacing-3 mb-2 d-block">REAL-TIME TELEMETRY</span>
                    <h1 class="luxury-serif text-pure mb-0">Expedition Alpha-{{ booking.id }}</h1>
                </div>
                <div class="text-end">
                    <div class="badge-status status-active px-4">Live Satellite Link</div>
                    <div class="text-xxs text-dim mt-2 fw-800">REFRESHING EVERY 5.0s</div>
                </div>
            </div>

            {# Booking Timeline Component #}
            <div class="booking-timeline mb-5">
                <div class="timeline-track">
                    <div class="timeline-progress" style="width: {{ booking.status|lower == 'pending' ? '12.5%' : (booking.status|lower == 'on-the-way' ? '62.5%' : (booking.status|lower == 'completed' ? '100%' : '37.5%')) }};"></div>
                </div>
                <div class="timeline-steps">
                    <div class="step {{ booking.status|lower in ['pending', 'accepted', 'on-the-way', 'completed'] ? 'active' : '' }}">
                        <div class="step-node"></div>
                        <div class="step-label">PROPOSAL</div>
                    </div>
                    <div class="step {{ booking.status|lower in ['accepted', 'on-the-way', 'completed'] ? 'active' : '' }}">
                        <div class="step-node"></div>
                        <div class="step-label">CONFIRMED</div>
                    </div>
                    <div class="step {{ booking.status|lower in ['on-the-way', 'completed'] ? 'active' : '' }}">
                        <div class="step-node"></div>
                        <div class="step-label">DISPATCHED</div>
                    </div>
                    <div class="step {{ booking.status|lower == 'completed' ? 'active' : '' }}">
                        <div class="step-node"></div>
                        <div class="step-label">COMPLETED</div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    {# ── 2. MAP & HUD INTERFACE ── #}
    <section class="container mb-5">
        <div class="row g-5">
            {# Map Sidebar (HUD) #}
            <div class="col-xl-4">
                <div class="glass-card mb-4 p-4 border-teal-glow">
                    <div class="d-flex align-items-center gap-4 mb-5">
                        <div class="user-orb" style="width: 50px; height: 50px; font-size: 1.2rem;">
                            {{ booking.service.provider.fullName|slice(0,1)|upper }}
                        </div>
                        <div>
                            <div class="text-pure fw-bold h5 mb-0">{{ booking.service.provider.fullName }}</div>
                            <div class="text-xxs text-teal fw-800">{{ booking.service.provider.tier|upper }} PROFESSIONAL</div>
                        </div>
                    </div>

                    <div class="hud-stats d-grid gap-4">
                        <div class="hud-stat">
                            <i class="fas fa-location-dot text-teal"></i>
                            <div>
                                <div class="label">CURRENT SECTOR</div>
                                <div class="value">Bhatar, Sector 7-X</div>
                            </div>
                        </div>
                        <div class="hud-stat">
                            <i class="fas fa-clock text-teal"></i>
                            <div>
                                <div class="label">EST. ARRIVAL</div>
                                <div class="value">14.2 Minutes</div>
                            </div>
                        </div>
                        <div class="hud-stat">
                            <i class="fas fa-bolt text-teal"></i>
                            <div>
                                <div class="label">PROTOCOL STATUS</div>
                                <div class="value text-pure">{{ booking.status|upper }}</div>
                            </div>
                        </div>
                    </div>

                    <div class="mt-5 pt-5 border-top border-glass">
                        <div class="d-grid gap-3">
                            <a href="tel:{{ booking.service.provider.mobile }}" class="btn-luxury py-3 w-100"><i class="fas fa-phone-alt me-2"></i> ESTABLISH VOICE LINK</a>
                            <a href="{{ path('app_customer_dashboard') }}" class="btn-outline-luxury py-3 w-100">RETURN TO MANIFEST</a>
                        </div>
                    </div>
                </div>

                <div class="glass-card p-4" style="background: rgba(16, 185, 129, 0.03);">
                    <p class="text-xxs text-dim mb-0 italic">Secure end-to-end encryption active. Telemetry data is restricted to authorized session tokens.</p>
                </div>
            </div>

            {# Main Telemetry Feed (Map) #}
            <div class="col-xl-8">
                <div class="glass-card p-0 overflow-hidden" style="height: 650px; border-radius: 32px;">
                    <div id="tracking-map" style="height: 100%; width: 100%; z-index: 1;"></div>
                </div>
            </div>
        </div>
    </section>
</div>

<style>
    /* HUD Stats */
    .hud-stat { display: flex; align-items: flex-start; gap: 20px; }
    .hud-stat i { font-size: 1.1rem; margin-top: 4px; }
    .hud-stat .label { font-size: 0.6rem; font-weight: 800; color: var(--text-dim); text-transform: uppercase; letter-spacing: 0.15em; }
    .hud-stat .value { font-size: 0.95rem; font-weight: 700; color: var(--text-silver); }

    /* Booking Timeline (Horizontal Progress) */
    .booking-timeline { margin: 20px 0 30px; }
    .timeline-track-h {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }
    .timeline-track-h::before {
        content: '';
        position: absolute;
        top: 50%; left: 0; right: 0;
        height: 2px;
        background: var(--glass-border);
        transform: translateY(-50%);
        z-index: 0;
    }
    .timeline-steps { display: flex; justify-content: space-between; position: relative; z-index: 1; width: 100%; }
    .step { display: flex; flex-direction: column; align-items: center; flex: 1; }
    .step-node {
        width: 30px; height: 30px; border-radius: 50%;
        border: 2px solid var(--glass-border);
        background: var(--bg-deep);
        display: flex; align-items: center; justify-content: center;
        font-size: 0.7rem; color: var(--text-dim);
        margin-bottom: 8px; transition: all 0.4s;
        position: relative; z-index: 2;
    }
    .step.active .step-node {
        border-color: var(--accent-teal);
        background: rgba(16,185,129,0.15);
        color: var(--accent-teal);
        box-shadow: 0 0 15px var(--accent-teal-glow);
    }
    .step-label { font-size: 0.58rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.1em; color: var(--text-dim); text-align: center; }
    .step.active .step-label { color: var(--accent-teal); }

    /* Map Pulsing Animation */
    @keyframes map-pulse {
        0%   { transform: scale(1); box-shadow: 0 0 10px var(--accent-teal-glow); }
        50%  { transform: scale(1.4); box-shadow: 0 0 30px var(--accent-teal-glow); }
        100% { transform: scale(1); box-shadow: 0 0 10px var(--accent-teal-glow); }
    }
    .custom-teal-pulse {
        background: var(--accent-teal);
        width: 14px; height: 14px;
        border-radius: 50%;
        border: 3px solid #FFF;
        animation: map-pulse 2s infinite ease-in-out;
    }
    .leaflet-container { background: var(--bg-deep); }
</style>

<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script>
    document.addEventListener('DOMContentLoaded', () => {
        const centerLat = {{ booking.latitude|default('21.1702') }};
        const centerLng = {{ booking.longitude|default('72.8311') }};
        const destLat = centerLat + 0.015;
        const destLng = centerLng + 0.012;

        const map = L.map('tracking-map', { zoomControl: false, attributionControl: false }).setView([centerLat, centerLng], 14);
        L.tileLayer('https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png', { maxZoom: 19 }).addTo(map);

        const tealIcon = L.divIcon({
            className: 'custom-div-icon',
            html: '<div class="custom-teal-pulse"></div>',
            iconSize: [14, 14], iconAnchor: [7, 7]
        });

        const destIcon = L.divIcon({
            className: 'dest-icon',
            html: '<div class="p-2 bg-deep border-teal rounded-circle" style="box-shadow: 0 0 20px var(--accent-teal-glow);"><i class="fas fa-home text-teal" style="font-size: 16px;"></i></div>',
            iconSize: [32, 32], iconAnchor: [16, 16]
        });

        L.marker([destLat, destLng], { icon: destIcon }).addTo(map).bindPopup("PRIMARY ESTATE NODE", { closeButton: false }).openPopup();
        const providerMarker = L.marker([centerLat, centerLng], { icon: tealIcon }).addTo(map);

        // Track Polyline
        L.polyline([[centerLat, centerLng], [destLat, destLng]], {
            color: 'var(--accent-teal)', weight: 2, opacity: 0.2, dashArray: '8, 8'
        }).addTo(map);

        // Smooth Simulation
        let progress = 0;
        const animateNode = () => {
            if (progress <= 1) {
                const lat = centerLat + (destLat - centerLat) * progress;
                const lng = centerLng + (destLng - centerLng) * progress;
                providerMarker.setLatLng([lat, lng]);
                progress += 0.005;
                setTimeout(animateNode, 200);
            }
        };
        {% if booking.status|lower == 'on-the-way' %}
            animateNode();
        {% endif %}
    });
</script>
{% endblock %}

