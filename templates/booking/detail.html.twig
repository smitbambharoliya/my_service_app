{% extends 'base.html.twig' %}

{% block title %}Protocol #{{ booking.id|slice(0,8) }} — {{ booking.service.title }}{% endblock %}

{% block stylesheets %}
<style>
    /* ── SPATIAL HERO ── */
    .booking-detail-hero {
        background: radial-gradient(circle at top left, rgba(0, 255, 213, 0.05), transparent 40%);
        border-bottom: 1px solid rgba(255, 255, 255, 0.05);
        padding: 80px 0 50px;
    }

    /* ── HOLOGRAPHIC TIMELINE ── */
    .status-timeline {
        display: flex;
        justify-content: space-between;
        position: relative;
        margin: 50px 0;
    }
    .status-timeline::before {
        content: '';
        position: absolute;
        top: 20px;
        left: 5%;
        right: 5%;
        height: 2px;
        background: rgba(255, 255, 255, 0.05);
        z-index: 0;
    }
    .status-step {
        position: relative;
        z-index: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        width: 25%;
    }
    .step-node {
        width: 42px; height: 42px;
        border-radius: 12px;
        background: var(--bg-obsidian);
        border: 2px solid rgba(255, 255, 255, 0.1);
        display: flex; align-items: center; justify-content: center;
        transition: all 0.5s var(--ease-spatial);
        color: var(--text-dim);
    }
    .status-step.done .step-node {
        border-color: var(--accent-teal);
        color: var(--accent-teal);
        box-shadow: 0 0 20px rgba(0, 255, 213, 0.2);
        background: rgba(0, 255, 213, 0.05);
    }
    .status-step.current .step-node {
        border-color: var(--accent-gold);
        color: var(--accent-gold);
        background: rgba(245, 158, 11, 0.1);
        animation: node-pulse 2s infinite;
    }
    @keyframes node-pulse {
        0% { box-shadow: 0 0 0 0 rgba(245, 158, 11, 0.4); }
        70% { box-shadow: 0 0 0 15px rgba(245, 158, 11, 0); }
        100% { box-shadow: 0 0 0 0 rgba(245, 158, 11, 0); }
    }
    .step-label {
        font-size: 0.6rem;
        font-weight: 800;
        letter-spacing: 2px;
        margin-top: 15px;
        color: var(--text-dim);
    }
    .status-step.current .step-label { color: #fff; text-shadow: 0 0 10px rgba(255,255,255,0.3); }

    /* ── CUSTOMER COMPONENTS ── */
    .capital-reserve {
        background: linear-gradient(145deg, rgba(212, 175, 55, 0.08), transparent);
        border: 1px solid rgba(212, 175, 55, 0.2);
    }
    .luxury-input {
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(255, 255, 255, 0.1);
        color: #fff;
        border-radius: 12px;
        padding: 15px;
        width: 100%;
        transition: 0.3s;
    }
    .luxury-input:focus { outline: none; border-color: var(--accent-teal); background: rgba(0, 255, 213, 0.02); }
</style>
{% endblock %}

{% block body %}
<div class="reveal-3d">
    {# ── HERO HEADER ── #}
    <section class="booking-detail-hero">
        <div class="container">
            <nav class="mb-4">
                <div class="d-flex align-items-center gap-2 text-xxs fw-800 letter-spacing-1 opacity-50">
                    <a href="{{ path('app_customer_dashboard') }}" class="text-white text-decoration-none">MANIFEST</a>
                    <i class="fas fa-chevron-right" style="font-size: 8px;"></i>
                    <span class="text-teal">PROTOCOL #{{ booking.id|slice(0,8)|upper }}</span>
                </div>
            </nav>

            <div class="row align-items-end g-4">
                <div class="col-lg-8">
                    <span class="badge-status status-pending mb-3" style="letter-spacing: 2px;">EXPEDITION ACTIVE</span>
                    <h1 class="luxury-serif text-white mb-2" style="font-size: 3.5rem;">{{ booking.service.title }}</h1>
                    <div class="d-flex align-items-center gap-4">
                        <div class="d-flex align-items-center gap-2">
                            <i class="fas fa-fingerprint text-teal"></i>
                            <span class="text-xxs fw-800 text-dim">TYPE: {{ booking.bookingType|upper }}</span>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <i class="far fa-clock text-dim"></i>
                            <span class="text-xxs fw-800 text-dim">{{ booking.bookingDate|date('d . m . Y') }} @ {{ booking.bookingDate|date('H:i') }}</span>
                        </div>
                    </div>
                </div>
                <div class="col-lg-4 text-lg-end">
                    <div class="glass-card d-inline-block px-4 py-3 border-0 bg-surface">
                        <div class="text-xxs text-dim fw-800 mb-1">TRACKING SIGNATURE</div>
                        <div class="text-teal font-monospace fw-800">{{ booking.trackingId|default('SIG-PENDING') }}</div>
                    </div>
                </div>
            </div>

            {# ── SPATIAL TIMELINE ── #}
            <div class="status-timeline">
                {% set statuses = ['pending', 'confirmed', 'on-the-way', 'completed'] %}
                {% set normalizedStatus = booking.status|lower %}
                {% set currentIndex = normalizedStatus == 'completed' ? 3 : (normalizedStatus == 'on-the-way' ? 2 : (normalizedStatus in ['confirmed', 'accepted'] ? 1 : 0)) %}
                
                {% for s in statuses %}
                    <div class="status-step {{ loop.index0 < currentIndex ? 'done' : (loop.index0 == currentIndex ? 'current' : '') }}">
                        <div class="step-node">
                            <i class="fas {{ loop.index0 < currentIndex ? 'fa-check' : (loop.index0 == currentIndex ? 'fa-atom' : 'fa-circle') }}"></i>
                        </div>
                        <div class="step-label">{{ s|replace({'-': ' '})|upper }}</div>
                    </div>
                {% endfor %}
            </div>
        </div>
    </section>

    {# ── CONTENT GRID ── #}
    <div class="container py-5">
        <div class="row g-5">
            {# LEFT: Operational Intel #}
            <div class="col-lg-8">
                <div class="glass-card p-5 mb-4 border-glow-hover">
                    <div class="d-flex align-items-center gap-3 mb-4">
                        <div class="p-3 rounded-4 bg-surface border-glass text-teal"><i class="fas fa-microchip fs-4"></i></div>
                        <h3 class="luxury-serif text-white m-0">Mission Parameters</h3>
                    </div>
                    <p class="text-dim mb-5" style="line-height: 2; font-size: 1.1rem;">{{ booking.service.description }}</p>
                    
                    {% if booking.notes %}
                        <div class="p-4 rounded-4 bg-surface border-glass">
                            <div class="text-xxs text-teal fw-800 letter-spacing-2 mb-3">CLIENT INSTRUCTIONS</div>
                            <p class="text-white mb-0 italic" style="opacity: 0.8;">"{{ booking.notes }}"</p>
                        </div>
                    {% endif %}
                </div>

                {# ── ESTIMATION MODULE ── #}
                {% if booking.bookingType == 'visit' %}
                    <div class="glass-card p-5 mb-4 border-purple-soft" style="background: rgba(157, 124, 255, 0.02);">
                        <h4 class="luxury-serif text-white mb-4"><i class="fas fa-calculator text-purple me-3"></i>Estimation Protocol</h4>
                        {% if booking.estimatedCost %}
                            <div class="d-flex justify-content-between align-items-center p-4 rounded-4 bg-surface mb-4">
                                <div>
                                    <div class="text-xxs text-dim fw-800 mb-1">PROPOSED CAPITAL</div>
                                    <div class="h2 text-white fw-900 mb-0">₹{{ booking.estimatedCost|number_format(2) }}</div>
                                </div>
                                <span class="badge-status {{ booking.estimationStatus == 'accepted' ? 'status-active' : 'status-pending' }}">
                                    {{ (booking.estimationStatus ?? 'AWAITING RESPONSE')|upper }}
                                </span>
                            </div>
                            {% if booking.estimationStatus == 'pending' and booking.customer == app.user %}
                                <div class="d-flex gap-3">
                                    <form action="{{ path('app_booking_estimate_response', {id: booking.id}) }}" method="POST" class="flex-fill">
                                        <input type="hidden" name="_token" value="{{ csrf_token('booking_estimate_response_' ~ booking.id) }}">
                                        <input type="hidden" name="response" value="accepted">
                                        <button type="submit" class="btn-luxury w-100 py-3">AUTHORIZE SETTLEMENT</button>
                                    </form>
                                    <form action="{{ path('app_booking_estimate_response', {id: booking.id}) }}" method="POST" class="flex-fill">
                                        <input type="hidden" name="_token" value="{{ csrf_token('booking_estimate_response_' ~ booking.id) }}">
                                        <input type="hidden" name="response" value="rejected">
                                        <button type="submit" class="btn-outline-luxury w-100 py-3 text-red">ABORT</button>
                                    </form>
                                </div>
                            {% endif %}
                        {% else %}
                            <div class="text-center py-5 opacity-40">
                                <i class="fas fa-satellite-dish fs-1 text-dim mb-3"></i>
                                <p class="text-dim fw-800 letter-spacing-1">AWAITING ARTISAN TELEMETRY...</p>
                            </div>
                        {% endif %}
                    </div>
                {% endif %}

                {# ── REVIEW MODULE ── #}
                {% if booking.status|lower == 'completed' %}
                    <div class="glass-card p-5 border-teal-soft">
                        <h4 class="luxury-serif text-white mb-4"><i class="fas fa-star text-gold me-3"></i>Fidelity Feedback</h4>
                        {% if not booking.review %}
                            <form action="{{ path('app_customer_add_review', {id: booking.id}) }}" method="POST">
                                <input type="hidden" name="_token" value="{{ csrf_token('review' ~ booking.id) }}">
                                <div class="mb-4">
                                    <label class="text-xxs text-dim fw-800 mb-3 d-block">RATING</label>
                                    <div class="d-flex gap-3">
                                        {% for i in 1..5 %}
                                            <input type="radio" name="rating" value="{{ i }}" id="star{{ i }}" class="d-none star-radio" required>
                                            <label for="star{{ i }}" class="step-node cursor-pointer star-label" style="width: 50px; height: 50px;" data-value="{{ i }}">
                                                <i class="fas fa-star"></i>
                                            </label>
                                        {% endfor %}
                                    </div>
                                </div>
                                <div class="mb-4">
                                    <label class="text-xxs text-dim fw-800 mb-3 d-block">DETAILED LOG</label>
                                    <textarea name="comment" class="luxury-input" rows="4" placeholder="Share mission outcome..."></textarea>
                                </div>
                                <button type="submit" class="btn-luxury w-100 py-3">SUBMIT TO ARCHIVE</button>
                            </form>
                        {% else %}
                            <div class="p-4 rounded-4 bg-surface border-glass">
                                <div class="text-gold mb-3 fs-5">
                                    {% for i in 1..5 %}<i class="f{{ i <= booking.review.rating ? 'as' : 'ar' }} fa-star"></i>{% endfor %}
                                </div>
                                <p class="text-white italic mb-3">"{{ booking.review.comment }}"</p>
                                <div class="text-xxs text-dim fw-800">ARCHIVED ON: {{ booking.review.createdAt|date('d F Y') }}</div>
                            </div>
                        {% endif %}
                    </div>
                {% endif %}
            </div>

            {# RIGHT: Command Sidebar #}
            <div class="col-lg-4">
                <div class="sticky-top" style="top: 120px;">
                    {# Financial Module #}
                    <div class="glass-card p-4 mb-4 capital-reserve">
                        <div class="text-xxs text-dim fw-800 mb-3">CAPITAL RESERVE</div>
                        <div class="luxury-serif text-gold h1 fw-900 mb-1">
                            ₹{{ (booking.estimatedCost ?? booking.service.price)|number_format(2) }}
                        </div>
                        <div class="text-xxs text-dim letter-spacing-1">{{ booking.estimatedCost ? 'SETTLED ESTIMATE' : 'INITIAL SERVICE VALUE' }}</div>
                    </div>

                    {# Artisan Module #}
                    <div class="glass-card p-4 mb-4">
                        <div class="text-xxs text-dim fw-800 mb-4">ARTISAN LEAD</div>
                        <div class="d-flex align-items-center gap-3 mb-4">
                            <div class="user-orb" style="width: 45px; height: 45px; font-size: 1rem;">{{ booking.service.provider.fullName|slice(0,1)|upper }}</div>
                            <div>
                                <div class="text-white fw-bold">{{ booking.service.provider.fullName }}</div>
                                <div class="text-xxs text-teal fw-900 letter-spacing-1">{{ booking.service.provider.tier|upper }} RANK</div>
                            </div>
                        </div>
                        <div class="d-grid gap-2">
                            <a href="tel:{{ booking.service.provider.mobile }}" class="btn-outline-luxury py-2 text-center small fw-800"><i class="fas fa-phone me-2"></i>AUDIO LINK</a>
                            {% set target = booking.customer == app.user ? booking.service.provider : booking.customer %}
                            <a href="{{ path('app_message_chat', {id: target.id}) }}" class="btn-luxury py-2 text-center small fw-800"><i class="fas fa-comment-dots me-2"></i>SECURE CHAT</a>
                        </div>
                    </div>

                    {# System Controls #}
                    <div class="d-grid gap-2">
                        {% if booking.status|lower == 'pending' and booking.customer == app.user %}
                            <form action="{{ path('app_booking_cancel', {id: booking.id}) }}" method="POST" onsubmit="return confirm('Terminate this protocol?');">
                                <input type="hidden" name="_token" value="{{ csrf_token('booking_cancel_' ~ booking.id) }}">
                                <button type="submit" class="btn-outline-luxury w-100 py-3 text-red border-red">
                                    TERMINATE BOOKING
                                </button>
                            </form>
                        {% endif %}
                        <a href="{{ path('app_customer_dashboard') }}" class="btn-outline-luxury w-100 py-3 text-center text-white opacity-50 hover-100">
                            RETURN TO MANIFEST
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    // Star Rating Interaction
    document.querySelectorAll('.star-label').forEach(label => {
        label.addEventListener('click', function() {
            const val = parseInt(this.dataset.value);
            document.querySelectorAll('.star-label').forEach((l, i) => {
                if (i < val) {
                    l.style.borderColor = 'var(--accent-gold)';
                    l.style.color = 'var(--accent-gold)';
                } else {
                    l.style.borderColor = 'rgba(255,255,255,0.1)';
                    l.style.color = 'var(--text-dim)';
                }
            });
        });
    });
</script>
{% endblock %}