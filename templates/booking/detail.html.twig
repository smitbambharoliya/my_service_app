{% extends 'base.html.twig' %}

{% block title %}Booking #{{ booking.id }} — {{ booking.service.title }}{% endblock %}

{% block stylesheets %}
<style>
    .booking-detail-hero {
        background: linear-gradient(135deg, rgba(16,185,129,0.05), transparent);
        border-bottom: 1px solid var(--glass-border);
        padding: 60px 0 40px;
    }
    .status-timeline {
        display: flex;
        align-items: center;
        gap: 0;
        margin: 30px 0;
    }
    .status-step {
        display: flex;
        flex-direction: column;
        align-items: center;
        flex: 1;
        position: relative;
    }
    .status-step::after {
        content: '';
        position: absolute;
        top: 16px;
        left: 50%;
        width: 100%;
        height: 2px;
        background: var(--glass-border);
        z-index: 0;
    }
    .status-step:last-child::after { display: none; }
    .status-step.done::after { background: var(--accent-teal); }
    .step-circle {
        width: 32px; height: 32px;
        border-radius: 50%;
        border: 2px solid var(--glass-border);
        background: var(--bg-deep);
        display: flex; align-items: center; justify-content: center;
        font-size: 0.7rem;
        z-index: 1;
        transition: all 0.3s;
    }
    .status-step.done .step-circle {
        border-color: var(--accent-teal);
        background: rgba(16,185,129,0.15);
        color: var(--accent-teal);
    }
    .status-step.current .step-circle {
        border-color: var(--accent-gold);
        background: rgba(245,158,11,0.15);
        color: var(--accent-gold);
        animation: pulse-gold 2s infinite;
    }
    .step-label {
        font-size: 0.6rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        color: var(--text-dim);
        margin-top: 8px;
        text-align: center;
    }
    .status-step.done .step-label,
    .status-step.current .step-label { color: var(--text-silver); }
</style>
{% endblock %}

{% block body %}
<div class="animate-fade-in">
    {# ── HERO HEADER ── #}
    <section class="booking-detail-hero">
        <div class="container">
            <nav class="mb-4">
                <ol class="breadcrumb text-xxs fw-800 text-uppercase" style="--bs-breadcrumb-divider: '·';">
                    <li class="breadcrumb-item"><a href="{{ path('app_home') }}" class="text-dim text-decoration-none">Home</a></li>
                    <li class="breadcrumb-item"><a href="{{ path('app_customer_dashboard') }}" class="text-dim text-decoration-none">Dashboard</a></li>
                    <li class="breadcrumb-item active text-teal">Booking #{{ booking.id }}</li>
                </ol>
            </nav>

            <div class="row align-items-center g-4">
                <div class="col-lg-8">
                    <div class="text-xxs text-dim fw-800 letter-spacing-2 mb-2">EXPEDITION PROTOCOL</div>
                    <h1 class="luxury-serif text-pure mb-3" style="font-size: 2.5rem;">{{ booking.service.title }}</h1>
                    <div class="d-flex align-items-center gap-3 flex-wrap">
                        {% if booking.status|lower == 'completed' %}
                            <span class="badge-status status-active"><i class="fas fa-check-circle me-1"></i> COMPLETED</span>
                        {% elseif booking.status|lower == 'on-the-way' %}
                            <span class="badge-status status-active" style="background: rgba(245,158,11,0.1); color: var(--accent-gold); border-color: rgba(245,158,11,0.2);"><i class="fas fa-location-arrow me-1"></i> ON THE WAY</span>
                        {% elseif booking.status|lower == 'cancelled' %}
                            <span class="badge-status status-alert"><i class="fas fa-times-circle me-1"></i> CANCELLED</span>
                        {% elseif booking.status|lower == 'pending' %}
                            <span class="badge-status status-pending"><i class="fas fa-clock me-1"></i> PENDING</span>
                        {% else %}
                            <span class="badge-status status-active">{{ booking.status|upper }}</span>
                        {% endif %}
                        <span class="text-xxs text-dim fw-800">{{ booking.bookingType|upper }} PROTOCOL</span>
                        <span class="text-xxs text-dim fw-800">{{ booking.bookingDate|date('d F Y, H:i') }}</span>
                    </div>
                </div>
                <div class="col-lg-4 text-lg-end">
                    <div class="text-dim text-xxs mb-1">TRACKING ID</div>
                    <div class="text-teal fw-800" style="font-size: 0.9rem; letter-spacing: 0.15em;">{{ booking.trackingId|default('N/A') }}</div>
                </div>
            </div>

            {# Status Timeline #}
            <div class="status-timeline mt-5">
                {% set statuses = ['pending', 'confirmed', 'on-the-way', 'completed'] %}
                {% set currentIndex = statuses|keys|filter(k => statuses[k] == booking.status|lower)|first ?? 0 %}
                {% for s in statuses %}
                    {% set idx = loop.index0 %}
                    <div class="status-step {{ idx < currentIndex ? 'done' : (idx == currentIndex ? 'current' : '') }}">
                        <div class="step-circle">
                            {% if idx < currentIndex %}<i class="fas fa-check"></i>
                            {% elseif idx == currentIndex %}<i class="fas fa-circle-dot"></i>
                            {% else %}<i class="far fa-circle"></i>{% endif %}
                        </div>
                        <div class="step-label">{{ s|replace({'-': ' '})|upper }}</div>
                    </div>
                {% endfor %}
            </div>
        </div>
    </section>

    {# ── DETAIL BODY ── #}
    <section class="container py-5">
        <div class="row g-5">
            {# LEFT: Main Details #}
            <div class="col-lg-8">

                {# Service Card #}
                <div class="glass-card mb-4">
                    <div class="d-flex align-items-center gap-4 mb-4">
                        <div class="p-3 rounded-4" style="background: rgba(16,185,129,0.1); border: 1px solid rgba(16,185,129,0.2);">
                            <i class="fas fa-microchip text-teal fs-4"></i>
                        </div>
                        <div>
                            <h3 class="luxury-serif mb-1">{{ booking.service.title }}</h3>
                            <div class="text-xxs text-dim fw-800">{{ booking.service.category.name|upper }}</div>
                        </div>
                    </div>
                    <p class="text-silver mb-4" style="line-height: 1.8;">{{ booking.service.description }}</p>
                    {% if booking.notes %}
                        <div class="p-3 rounded-4" style="background: rgba(255,255,255,0.02); border: 1px solid var(--glass-border);">
                            <div class="text-xxs text-dim fw-800 mb-2">CUSTOMER NOTES</div>
                            <p class="text-silver mb-0 text-sm">{{ booking.notes }}</p>
                        </div>
                    {% endif %}
                </div>

                {# Estimation Section (for visit bookings) #}
                {% if booking.bookingType == 'visit' %}
                    <div class="glass-card mb-4" style="background: rgba(245,158,11,0.03); border-color: rgba(245,158,11,0.2);">
                        <h4 class="luxury-serif mb-4"><i class="fas fa-calculator text-gold me-2"></i>Estimation Protocol</h4>
                        {% if booking.estimatedCost %}
                            <div class="d-flex justify-content-between align-items-center mb-4">
                                <div>
                                    <div class="text-xxs text-dim fw-800 mb-1">PROVIDER ESTIMATE</div>
                                    <div class="h3 text-gold fw-800 mb-0">₹{{ booking.estimatedCost|number_format(2) }}</div>
                                </div>
                                <div class="badge-status {{ booking.estimationStatus == 'accepted' ? 'status-active' : (booking.estimationStatus == 'rejected' ? 'status-alert' : 'status-pending') }}">
                                    {{ (booking.estimationStatus ?? 'pending')|upper }}
                                </div>
                            </div>
                            {% if booking.estimationStatus == 'pending' and booking.customer == app.user %}
                                <div class="d-flex gap-3">
                                    <form action="{{ path('app_booking_estimate_response', {id: booking.id}) }}" method="POST" class="flex-fill">
                                        <input type="hidden" name="_token" value="{{ csrf_token('booking_estimate_response_' ~ booking.id) }}">
                                        <input type="hidden" name="response" value="accepted">
                                        <button type="submit" class="btn-luxury w-100 py-3"><i class="fas fa-check me-2"></i>ACCEPT ESTIMATE</button>
                                    </form>
                                    <form action="{{ path('app_booking_estimate_response', {id: booking.id}) }}" method="POST" class="flex-fill">
                                        <input type="hidden" name="_token" value="{{ csrf_token('booking_estimate_response_' ~ booking.id) }}">
                                        <input type="hidden" name="response" value="rejected">
                                        <button type="submit" class="btn-outline-luxury w-100 py-3 text-red" style="border-color: var(--accent-red);"><i class="fas fa-times me-2"></i>DECLINE</button>
                                    </form>
                                </div>
                            {% endif %}
                        {% else %}
                            <div class="text-center py-4 opacity-50">
                                <i class="fas fa-hourglass-half fs-2 text-gold mb-3 d-block"></i>
                                <p class="text-dim text-sm">Awaiting provider estimate submission.</p>
                            </div>
                        {% endif %}
                    </div>
                {% endif %}

                {# Review Section #}
                {% if booking.status|lower == 'completed' %}
                    {% if not booking.review %}
                        <div class="glass-card mb-4" style="background: rgba(16,185,129,0.03); border: 1px dashed rgba(16,185,129,0.3);">
                            <h4 class="luxury-serif mb-4"><i class="fas fa-star text-gold me-2"></i>Submit Review</h4>
                            <form action="{{ path('app_customer_add_review', {id: booking.id}) }}" method="POST">
                                <input type="hidden" name="_token" value="{{ csrf_token('review' ~ booking.id) }}">
                                <div class="mb-4">
                                    <div class="text-xxs text-dim fw-800 mb-3">RATING</div>
                                    <div class="d-flex gap-2 mb-3">
                                        {% for i in 1..5 %}
                                            <input type="radio" name="rating" value="{{ i }}" id="star{{ i }}" class="d-none star-radio" required>
                                            <label for="star{{ i }}" class="fa-solid fa-star text-dim fs-5 cursor-pointer star-label" data-value="{{ i }}"></label>
                                        {% endfor %}
                                    </div>
                                </div>
                                <div class="mb-4">
                                    <div class="text-xxs text-dim fw-800 mb-3">COMMENTS</div>
                                    <textarea name="comment" class="luxury-input" rows="3" placeholder="Share your experience..."></textarea>
                                </div>
                                <button type="submit" class="btn-luxury w-100 py-3">SUBMIT REVIEW</button>
                            </form>
                        </div>
                    {% else %}
                        <div class="glass-card mb-4">
                            <h4 class="luxury-serif mb-4"><i class="fas fa-star text-gold me-2"></i>Your Review</h4>
                            <div class="text-gold mb-3">
                                {% for i in 1..5 %}<i class="f{{ i <= booking.review.rating ? 'as' : 'ar' }} fa-star"></i>{% endfor %}
                            </div>
                            <p class="text-silver italic">"{{ booking.review.comment }}"</p>
                            <div class="text-xxs text-dim fw-800">{{ booking.review.createdAt|date('d F Y') }}</div>
                        </div>
                    {% endif %}
                {% endif %}

                {# Tracking link if on-the-way #}
                {% if booking.status|lower == 'on-the-way' %}
                    <div class="glass-card mb-4" style="background: rgba(16,185,129,0.05); border-color: rgba(16,185,129,0.3);">
                        <div class="d-flex align-items-center justify-content-between">
                            <div>
                                <h4 class="luxury-serif mb-1"><i class="fas fa-location-arrow text-teal me-2"></i>Provider En Route</h4>
                                <p class="text-dim text-sm mb-0">Track your provider's live location on the map.</p>
                            </div>
                            <a href="{{ path('app_booking_track', {id: booking.id}) }}" class="btn-luxury px-4 py-2">TRACK NOW</a>
                        </div>
                    </div>
                {% endif %}
            </div>

            {# RIGHT: Sidebar #}
            <div class="col-lg-4">
                <div class="sticky-top" style="top: 120px;">

                    {# Cost Card #}
                    <div class="glass-card mb-4" style="background: rgba(212,175,55,0.03); border-color: rgba(212,175,55,0.2);">
                        <div class="text-xxs text-dim fw-800 mb-3">CAPITAL RESERVED</div>
                        <div class="luxury-serif text-gold mb-1" style="font-size: 2.5rem;">
                            ₹{{ (booking.estimatedCost ?? booking.service.price)|number_format(2) }}
                        </div>
                        {% if booking.estimatedCost %}
                            <div class="text-xxs text-dim">PROVIDER ESTIMATE</div>
                        {% else %}
                            <div class="text-xxs text-dim">BASE SERVICE PRICE</div>
                        {% endif %}
                    </div>

                    {# Provider Card #}
                    <div class="glass-card mb-4">
                        <div class="text-xxs text-dim fw-800 mb-4">ARTISAN LEAD</div>
                        <div class="d-flex align-items-center gap-3 mb-4">
                            <div class="user-orb">{{ booking.service.provider.fullName|slice(0,1)|upper }}</div>
                            <div>
                                <div class="text-pure fw-bold">{{ booking.service.provider.fullName }}</div>
                                <div class="text-xxs text-teal fw-800">{{ booking.service.provider.tier|upper }}</div>
                            </div>
                        </div>
                        {% if booking.service.provider.mobile %}
                            <a href="tel:{{ booking.service.provider.mobile }}" class="btn-outline-luxury w-100 py-2 text-center" style="font-size: 0.7rem;">
                                <i class="fas fa-phone me-2"></i>CONTACT ARTISAN
                            </a>
                        {% endif %}
                    </div>

                    {# Actions #}
                    {% if booking.status|lower == 'pending' and booking.customer == app.user %}
                        <form action="{{ path('app_booking_cancel', {id: booking.id}) }}" method="POST" onsubmit="return confirm('Cancel this booking?');">
                            <input type="hidden" name="_token" value="{{ csrf_token('booking_cancel_' ~ booking.id) }}">
                            <button type="submit" class="btn-outline-luxury w-100 py-3 text-red" style="border-color: var(--accent-red); color: var(--accent-red);">
                                <i class="fas fa-times-circle me-2"></i>CANCEL BOOKING
                            </button>
                        </form>
                    {% endif %}

                    <div class="mt-3">
                        <a href="{{ path('app_customer_dashboard') }}" class="btn-outline-luxury w-100 py-3 text-center" style="font-size: 0.72rem;">
                            <i class="fas fa-arrow-left me-2"></i>BACK TO MANIFEST
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>

<style>
    .star-label { cursor: pointer; transition: color 0.2s; }
    .star-label:hover, .star-label.active { color: var(--accent-gold) !important; }
    .cursor-pointer { cursor: pointer; }
</style>
<script>
document.querySelectorAll('.star-label').forEach(label => {
    label.addEventListener('click', function() {
        const val = parseInt(this.dataset.value);
        document.querySelectorAll('.star-label').forEach((l, i) => {
            l.classList.toggle('text-gold', i < val);
            l.classList.toggle('text-dim', i >= val);
        });
    });
});
</script>
{% endblock %}
