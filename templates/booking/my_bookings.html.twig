{% extends 'base.html.twig' %}

{% block title %}My Bookings — ServiceHub Heritage{% endblock %}

{% block body %}
<div class="animate-fade-in" style="padding-top: 40px; padding-bottom: 80px;">
    <div class="container">

        {# ── PAGE HEADER ── #}
        <div class="d-flex justify-content-between align-items-end mb-5">
            <div>
                <div class="text-xxs text-teal fw-800 letter-spacing-3 mb-2">PROTOCOL ARCHIVE</div>
                <h1 class="luxury-serif text-pure mb-0" style="font-size: 2.8rem;">Session Logs</h1>
            </div>
            <a href="{{ path('app_service_list') }}" class="btn-luxury py-2 px-4" style="font-size: 0.75rem;">
                <i class="fas fa-plus me-2"></i>NEW BOOKING
            </a>
        </div>

        {# ── STATUS FILTER TABS ── #}
        <div class="d-flex gap-2 mb-5 flex-wrap">
            {% set statuses = ['All', 'pending', 'confirmed', 'on-the-way', 'completed', 'cancelled'] %}
            {% set activeFilter = app.request.query.get('status', 'All') %}
            {% for s in statuses %}
                <a href="{{ path('app_booking_my_bookings', s != 'All' ? {'status': s} : {}) }}"
                   class="badge-status {{ s == activeFilter ? 'status-active' : '' }}"
                   style="{{ s != activeFilter ? 'opacity:0.5;' : '' }} text-decoration: none; cursor: pointer;">
                    {{ s|replace({'-': ' '})|upper }}
                </a>
            {% endfor %}
        </div>

        {# ── BOOKING CARDS ── #}
        {% set filtered = bookings %}
        {% if activeFilter != 'All' %}
            {% set filtered = bookings|filter(b => b.status|lower == activeFilter|lower) %}
        {% endif %}

        {% if filtered|length == 0 %}
            <div class="glass-card py-5 text-center">
                <div class="empty-state">
                    <i class="fa-solid fa-calendar-xmark text-dim mb-3" style="font-size: 3rem;"></i>
                    <h4 class="text-pure">No Active Bookings</h4>
                    <p class="text-dim">You have not scheduled any service interventions yet.</p>
                    <a href="{{ path('app_home') }}" class="btn-luxury mt-3">BROWSE SERVICES</a>
                </div>
            </div>
        {% else %}
            <div class="row g-4">
                {% for booking in filtered %}
                    <div class="col-xl-6">
                        <div class="glass-card p-0 border-0 overflow-hidden h-100">
                            {# Card Header #}
                            <div class="p-4 d-flex justify-content-between align-items-start">
                                <div class="d-flex gap-4">
                                    <div class="p-3 rounded-4" style="background: rgba(255,255,255,0.03); border: 1px solid var(--glass-border); flex-shrink: 0;">
                                        <i class="fas fa-microchip text-teal fs-5"></i>
                                    </div>
                                    <div>
                                        <h4 class="mb-1 fw-bold text-pure">{{ booking.service.title }}</h4>
                                        <div class="d-flex gap-2 flex-wrap">
                                            <span class="text-xxs text-dim fw-800 border border-secondary px-2 py-1 rounded-pill">{{ booking.service.category.name|upper }}</span>
                                            <span class="text-xxs text-dim fw-800 border border-secondary px-2 py-1 rounded-pill">{{ booking.bookingType|upper }}</span>
                                        </div>
                                    </div>
                                </div>
                                <div class="text-end flex-shrink-0">
                                    {% if booking.status|lower == 'completed' %}
                                        <span class="badge-status status-active">COMPLETED</span>
                                    {% elseif booking.status|lower == 'on-the-way' %}
                                        <span class="badge-status status-active" style="background:rgba(245,158,11,.1);color:var(--accent-gold);border-color:rgba(245,158,11,.2);">ON TRANSIT</span>
                                    {% elseif booking.status|lower == 'cancelled' %}
                                        <span class="badge-status status-alert">CANCELLED</span>
                                    {% elseif booking.status|lower == 'pending' %}
                                        <span class="badge-status status-pending">PENDING</span>
                                    {% else %}
                                        <span class="badge-status status-active">{{ booking.status|upper }}</span>
                                    {% endif %}
                                    <div class="text-xxs text-dim mt-2">{{ booking.bookingDate|date('d M Y') }}</div>
                                </div>
                            </div>

                            {# Provider Info #}
                            <div class="px-4 py-3" style="background: rgba(255,255,255,0.02); border-top: 1px solid var(--glass-border);">
                                <div class="d-flex align-items-center justify-content-between">
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="user-orb" style="width:28px; height:28px; font-size:0.6rem;">
                                            {{ booking.service.provider.fullName|slice(0,1)|upper }}
                                        </div>
                                        <div class="text-xxs">
                                            <span class="text-dim">ARTISAN:</span>
                                            <span class="text-pure fw-bold">{{ booking.service.provider.fullName }}</span>
                                        </div>
                                    </div>
                                    {% if booking.status|lower == 'on-the-way' %}
                                        <a href="{{ path('app_booking_track', {id: booking.id}) }}" class="text-teal text-xxs fw-800 text-decoration-none">
                                            <i class="fas fa-location-arrow me-1"></i>TRACK
                                        </a>
                                    {% endif %}
                                </div>
                            </div>

                            {# Footer Actions #}
                            <div class="p-4" style="border-top: 1px solid var(--glass-border);">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <div class="text-xxs text-dim fw-800">AMOUNT</div>
                                        <div class="h5 text-pure fw-800 mb-0">
                                            ₹{{ (booking.estimatedCost ?? booking.service.price)|number_format }}
                                        </div>
                                    </div>
                                    <div class="d-flex gap-2">
                                        <a href="{{ path('app_booking_detail', {id: booking.id}) }}" class="btn-outline-luxury py-2 px-3" style="font-size: 0.65rem;">VIEW DETAIL</a>
                                        {% if booking.status|lower == 'pending' %}
                                            <form action="{{ path('app_booking_cancel', {id: booking.id}) }}" method="POST" onsubmit="return confirm('Cancel this booking?');">
                                                <input type="hidden" name="_token" value="{{ csrf_token('booking_cancel_' ~ booking.id) }}">
                                                <button class="bg-transparent border-0 text-red text-xxs fw-800 px-2">CANCEL</button>
                                            </form>
                                        {% endif %}
                                    </div>
                                </div>

                                {# Inline Review (Completed, no review yet) #}
                                {% if booking.status|lower == 'completed' and not booking.review %}
                                    <div class="mt-4 p-3 rounded-4" style="background: rgba(16,185,129,0.03); border: 1px dashed rgba(16,185,129,0.2);">
                                        <div class="text-xxs text-teal fw-800 mb-3">APPRECIATION PROTOCOL</div>
                                        <form action="{{ path('app_customer_add_review', {id: booking.id}) }}" method="POST">
                                            <input type="hidden" name="_token" value="{{ csrf_token('review' ~ booking.id) }}">
                                            <div class="d-flex align-items-center gap-3 mb-3">
                                                <div class="d-flex gap-1">
                                                    {% for i in 1..5 %}
                                                        <input type="radio" name="rating" value="{{ i }}" id="star-{{ booking.id }}-{{ i }}" class="d-none" required>
                                                        <label for="star-{{ booking.id }}-{{ i }}" class="fa-solid fa-star text-dim cursor-pointer" data-value="{{ i }}"></label>
                                                    {% endfor %}
                                                </div>
                                            </div>
                                            <div class="d-flex gap-2">
                                                <input type="text" name="comment" class="luxury-input py-2 text-xs" placeholder="Comments..." style="flex:1;">
                                                <button type="submit" class="btn-luxury py-2 px-3" style="font-size:0.6rem;">SUBMIT</button>
                                            </div>
                                        </form>
                                    </div>
                                {% elseif booking.review %}
                                    <div class="mt-3 p-3 rounded-3" style="background: rgba(255,255,255,0.02);">
                                        <div class="text-gold mb-1" style="font-size:0.7rem;">
                                            {% for i in 1..booking.review.rating %}<i class="fas fa-star"></i>{% endfor %}
                                        </div>
                                        <p class="text-xxs text-silver italic mb-0">"{{ booking.review.comment }}"</p>
                                    </div>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% endif %}
    </div>
</div>

<style>
    .cursor-pointer { cursor: pointer; }
    .star-label:hover, .fa-star:hover { color: var(--accent-gold) !important; }
</style>
<script>
document.querySelectorAll('label[data-value]').forEach(label => {
    label.addEventListener('click', function() {
        const val = parseInt(this.dataset.value);
        const form = this.closest('form');
        form.querySelectorAll('label[data-value]').forEach((l, i) => {
            l.classList.toggle('text-gold', i < val);
            l.classList.toggle('text-dim', i >= val);
        });
    });
});
</script>
{% endblock %}
