{% extends 'base.html.twig' %}

{% block title %}Expedition Manifest — ServiceHub{% endblock %}

{% block body %}
<div class="reveal-3d" style="padding-top: 50px; padding-bottom: 100px;">
    <div class="container">

        {# ── SPATIAL HEADER ── #}
        <div class="d-flex justify-content-between align-items-end mb-5">
            <div>
                <div class="text-xxs text-teal fw-800 letter-spacing-3 mb-2">OPERATIONAL LOGS</div>
                <h1 class="luxury-serif text-white mb-0" style="font-size: 3.2rem;">My Manifest</h1>
            </div>
            <a href="{{ path('app_service_list') }}" class="btn-luxury py-3 px-5">
                <i class="fas fa-plus me-2"></i> NEW EXPEDITION
            </a>
        </div>

        {# ── BENTO STATUS FILTERS ── #}
        <div class="d-flex gap-2 mb-5 flex-wrap">
            {% set statuses = ['All', 'pending', 'confirmed', 'on-the-way', 'completed', 'cancelled'] %}
            {% set activeFilter = app.request.query.get('status', 'All') %}
            {% for s in statuses %}
                <a href="{{ path('app_booking_my_bookings', s != 'All' ? {'status': s} : {}) }}"
                   class="badge-status-pill {{ s == activeFilter ? 'pill-active' : '' }}">
                    <span class="status-dot-sm"></span>
                    {{ s|replace({'-': ' '})|upper }}
                </a>
            {% endfor %}
        </div>

        {# ── LOGIC: FILTERING ── #}
        {% set filtered = bookings %}
        {% if activeFilter != 'All' %}
            {% set filtered = bookings|filter(b => b.status|lower == activeFilter|lower) %}
        {% endif %}

        {% if filtered|length == 0 %}
            <div class="glass-card py-5 text-center border-dashed">
                <i class="fa-solid fa-satellite-dish text-dim mb-4" style="font-size: 3.5rem; opacity: 0.3;"></i>
                <h4 class="luxury-serif text-white">No Transmissions Detected</h4>
                <p class="text-dim">Your manifest is empty for this status parameter.</p>
                <a href="{{ path('app_service_list') }}" class="text-teal fw-800 text-xxs letter-spacing-2 text-decoration-none">INITIALIZE SEARCH <i class="fas fa-arrow-right ms-2"></i></a>
            </div>
        {% else %}
            <div class="row g-4">
                {% for booking in filtered %}
                    <div class="col-xl-6">
                        <div class="glass-card p-0 border-0 overflow-hidden h-100 border-glow-hover d-flex flex-column">
                            {# Node Header #}
                            <div class="p-4 d-flex justify-content-between align-items-start">
                                <div class="d-flex gap-4">
                                    <div class="p-3 rounded-4 bg-surface-dark border-glass">
                                        <i class="fas fa-atom text-teal fs-4"></i>
                                    </div>
                                    <div>
                                        <h4 class="mb-1 fw-900 text-white h5">{{ booking.service.title }}</h4>
                                        <div class="d-flex gap-2">
                                            <span class="badge-tag">{{ booking.service.category.name|upper }}</span>
                                            <span class="badge-tag">{{ booking.bookingType|upper }}</span>
                                        </div>
                                    </div>
                                </div>
                                <div class="text-end">
                                    {% if booking.status|lower == 'completed' %}
                                        <span class="badge-status status-active">SETTLED</span>
                                    {% elseif booking.status|lower == 'on-the-way' %}
                                        <span class="badge-status status-active" style="background:rgba(245,158,11,.1);color:var(--accent-gold);border-color:rgba(245,158,11,.2);">EN ROUTE</span>
                                    {% elseif booking.status|lower == 'cancelled' %}
                                        <span class="badge-status status-alert">VOID</span>
                                    {% else %}
                                        <span class="badge-status status-pending">{{ booking.status|upper }}</span>
                                    {% endif %}
                                    <div class="text-xxs text-dim mt-2 font-monospace">{{ booking.bookingDate|date('d . m . Y') }}</div>
                                </div>
                            </div>

                            {# Telemetry Info (Provider) #}
                            <div class="px-4 py-3 bg-surface-dark border-top border-white border-opacity-5">
                                <div class="d-flex align-items-center justify-content-between">
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="user-orb" style="width:30px; height:30px; font-size:0.7rem;">
                                            {{ booking.service.provider.fullName|slice(0,1)|upper }}
                                        </div>
                                        <div class="text-xxs fw-800 letter-spacing-1">
                                            <span class="text-dim">ARTISAN:</span>
                                            <span class="text-white">{{ booking.service.provider.fullName|upper }}</span>
                                        </div>
                                    </div>
                                    {% if booking.status|lower == 'on-the-way' %}
                                        <a href="{{ path('app_booking_track', {id: booking.id}) }}" class="track-pulse-link">
                                            <i class="fas fa-location-crosshairs me-1"></i> LIVE TRACKING
                                        </a>
                                    {% endif %}
                                </div>
                            </div>

                            {# Footer Actions & Capital #}
                            <div class="p-4 mt-auto border-top border-white border-opacity-5">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <div class="text-xxs text-dim fw-800">CAPITAL</div>
                                        <div class="h4 text-white fw-900 mb-0">₹{{ (booking.estimatedCost ?? booking.service.price)|number_format }}</div>
                                    </div>
                                    <div class="d-flex gap-2">
                                        <a href="{{ path('app_booking_detail', {id: booking.id}) }}" class="btn-outline-luxury py-2 px-4" style="font-size: 0.65rem;">MANIFEST DETAIL</a>
                                        {% if booking.status|lower == 'pending' %}
                                            <form action="{{ path('app_booking_cancel', {id: booking.id}) }}" method="POST" class="m-0" onsubmit="return confirm('Abort this mission?');">
                                                <input type="hidden" name="_token" value="{{ csrf_token('review' ~ booking.id) }}">
                                                <button class="btn-void-action">TERMINATE</button>
                                            </form>
                                        {% endif %}
                                    </div>
                                </div>

                                {# Inline Feedback Core #}
                                {% if booking.status|lower == 'completed' and not booking.review %}
                                    <div class="mt-4 p-4 rounded-4 border-glass" style="background: rgba(0, 255, 213, 0.02);">
                                        <div class="text-xxs text-teal fw-900 letter-spacing-2 mb-3">FIDELITY FEEDBACK</div>
                                        <form action="{{ path('app_customer_add_review', {id: booking.id}) }}" method="POST">
                                            <input type="hidden" name="_token" value="{{ csrf_token('review' ~ booking.id) }}">
                                            <div class="d-flex align-items-center gap-4 mb-3">
                                                <div class="d-flex gap-2">
                                                    {% for i in 1..5 %}
                                                        <input type="radio" name="rating" value="{{ i }}" id="star-{{ booking.id }}-{{ i }}" class="d-none star-radio" required>
                                                        <label for="star-{{ booking.id }}-{{ i }}" class="fas fa-star text-dim cursor-pointer star-node" data-value="{{ i }}"></label>
                                                    {% endfor %}
                                                </div>
                                            </div>
                                            <div class="d-flex gap-2">
                                                <input type="text" name="comment" class="cyber-input py-2 text-xs" placeholder="Operational comments..." style="flex:1;">
                                                <button type="submit" class="btn-luxury py-2 px-4" style="font-size:0.6rem;">SYNC</button>
                                            </div>
                                        </form>
                                    </div>
                                {% elseif booking.review %}
                                    <div class="mt-4 p-3 rounded-4 bg-surface-dark border-glass">
                                        <div class="text-gold mb-1" style="font-size:0.7rem;">
                                            {% for i in 1..booking.review.rating %}<i class="fas fa-star"></i>{% endfor %}
                                        </div>
                                        <p class="text-xxs text-dim italic mb-0">"{{ booking.review.comment }}"</p>
                                    </div>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% endif %}
    </div>
</div>

<style>
    /* ── SPATIAL COMPONENTS ── */
    .badge-status-pill {
        display: flex; align-items: center; gap: 8px;
        padding: 8px 20px; border-radius: 99px;
        background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.08);
        color: #94a3b8; font-size: 0.65rem; font-weight: 800;
        text-decoration: none; transition: all 0.4s var(--ease-spatial);
    }
    .badge-status-pill:hover, .pill-active {
        background: rgba(0, 255, 213, 0.08); border-color: rgba(0, 255, 213, 0.3); color: #fff;
    }
    .status-dot-sm { width: 6px; height: 6px; border-radius: 50%; background: #475569; }
    .pill-active .status-dot-sm { background: var(--accent-teal); box-shadow: 0 0 8px var(--accent-teal); }

    .badge-tag { font-size: 0.55rem; font-weight: 900; padding: 2px 8px; border-radius: 4px; background: rgba(255,255,255,0.05); color: #64748b; border: 1px solid rgba(255,255,255,0.05); }

    .bg-surface-dark { background: rgba(0,0,0,0.15); }
    .border-glass { border: 1px solid rgba(255, 255, 255, 0.08); }
    .border-glow-hover:hover { border-color: rgba(0, 255, 213, 0.3) !important; transform: translateY(-5px); box-shadow: 0 20px 40px rgba(0,0,0,0.3); }

    .btn-void-action { background: transparent; border: none; color: #ff5d73; font-size: 0.6rem; font-weight: 900; letter-spacing: 1px; padding: 0 10px; transition: 0.3s; }
    .btn-void-action:hover { opacity: 0.6; }

    .track-pulse-link { color: var(--accent-teal); font-size: 0.6rem; font-weight: 900; text-decoration: none; display: flex; align-items: center; gap: 5px; animation: text-glow 2s infinite; }
    @keyframes text-glow { 0%, 100% { opacity: 1; } 50% { opacity: 0.5; } }

    .cyber-input { background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.1); color: #fff; border-radius: 8px; padding: 10px; outline: none; transition: 0.3s; }
    .cyber-input:focus { border-color: var(--accent-teal); }

    .star-node { transition: all 0.3s; }
    .star-node:hover { transform: scale(1.2); color: var(--accent-gold) !important; }
</style>

<script>
document.querySelectorAll('.star-node').forEach(node => {
    node.addEventListener('click', function() {
        const val = parseInt(this.dataset.value);
        const parent = this.closest('.d-flex');
        parent.querySelectorAll('.star-node').forEach((star, i) => {
            if (i < val) {
                star.classList.replace('text-dim', 'text-gold');
                star.style.textShadow = '0 0 10px rgba(212, 175, 55, 0.4)';
            } else {
                star.classList.replace('text-gold', 'text-dim');
                star.style.textShadow = 'none';
            }
        });
    });
});
</script>
{% endblock %}