{% extends 'base.html.twig' %}

{% block title %}Initialize Protocol — {{ service.title }}{% endblock %}

{% block body %}
<div class="container py-5 reveal-3d">
    <div class="row justify-content-center">
        <div class="col-lg-8 col-xl-7">
            <div class="glass-card p-0 overflow-hidden border-glow-hover">
                {# ── MODULE HEADER ── #}
                <div class="p-4 border-bottom border-white border-opacity-10" style="background: linear-gradient(135deg, rgba(0, 255, 213, 0.1), rgba(157, 124, 255, 0.1));">
                    <h2 class="luxury-serif text-white mb-1"><i class="fas fa-calendar-plus me-3 text-teal"></i>Initialize Booking</h2>
                    <p class="text-xxs text-dim fw-800 letter-spacing-2 mb-0">MISSION PARAMETER CONFIGURATION</p>
                </div>

                <div class="p-4 p-md-5">
                    {# ── SERVICE BRIEFING UNIT ── #}
                    <div class="p-4 rounded-4 mb-5 bg-surface border-glass">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <span class="badge-status py-0 px-2 mb-2" style="font-size: 0.6rem; background: rgba(0,255,213,0.1); color: var(--accent-cyan);">
                                    {{ service.category.name|upper }}
                                </span>
                                <h4 class="text-white fw-900 mb-1">{{ service.title }}</h4>
                                {% if service.isPremium %}
                                    <div class="text-gold text-xxs fw-800"><i class="fas fa-crown me-1"></i>PREMIUM FIDELITY</div>
                                {% endif %}
                            </div>
                            <div class="text-end">
                                <div class="text-teal h3 fw-900 mb-0">₹{{ service.price|number_format }}</div>
                                <div class="text-xxs text-dim fw-800">BASE CAPITAL</div>
                            </div>
                        </div>
                    </div>

                    {{ form_start(form, {'attr': {'novalidate': 'novalidate', 'class': 'spatial-form'}}) }}

                        {# ── MODE SELECTION NODES ── #}
                        <div class="mb-5">
                            <label class="text-xxs text-dim fw-800 letter-spacing-1 d-block mb-3">SELECT OPERATIONAL MODE</label>
                            <div class="row g-3">
                                <div class="col-6">
                                    <label class="mode-node-wrapper w-100" for="{{ form.bookingType.children['0'].vars.id }}">
                                        <div class="mode-node p-4 text-center">
                                            <i class="fas fa-bolt-lightning fs-3 mb-3 text-cyan"></i>
                                            <div class="fw-bold text-white small">ONLINE</div>
                                            <div class="text-xxs text-dim mt-1">Remote Uplink</div>
                                        </div>
                                    </label>
                                </div>
                                <div class="col-6">
                                    <label class="mode-node-wrapper w-100" for="{{ form.bookingType.children['1'].vars.id }}">
                                        <div class="mode-node p-4 text-center">
                                            <i class="fas fa-house-signal fs-3 mb-3 text-purple"></i>
                                            <div class="fw-bold text-white small">VISIT</div>
                                            <div class="text-xxs text-dim mt-1">Physical Deployment</div>
                                        </div>
                                    </label>
                                </div>
                            </div>

                            {# Logic info banner #}
                            <div id="visit-info-box" class="mt-3 p-3 rounded-3 border-glass bg-surface reveal-3d" style="display:none;">
                                <div class="d-flex gap-3 align-items-center">
                                    <i class="fas fa-circle-info text-purple"></i>
                                    <span class="text-xxs text-dim fw-600">The Artisan will transmit a calculated estimate after the initial site survey.</span>
                                </div>
                            </div>

                            <div class="d-none">{{ form_widget(form.bookingType) }}</div>
                        </div>

                        {# ── TEMPORAL COORDINATES ── #}
                        <div class="mb-4">
                            <label class="text-xxs text-dim fw-800 letter-spacing-1 d-block mb-2">TEMPORAL COORDINATES (DATE & TIME)</label>
                            {{ form_widget(form.bookingDate, {'attr': {'class': 'cyber-input'}}) }}
                            <div class="text-danger text-xxs mt-1">{{ form_errors(form.bookingDate) }}</div>
                        </div>

                        {# ── MISSION NOTES ── #}
                        <div class="mb-5">
                            <label class="text-xxs text-dim fw-800 letter-spacing-1 d-block mb-2">ADDITIONAL MISSION DATA</label>
                            {{ form_widget(form.notes, {'attr': {'class': 'cyber-input', 'rows': '4', 'placeholder': 'Input address or specific requirements...'}}) }}
                        </div>

                        {# ── SUBMIT ACTIONS ── #}
                        <div class="d-grid gap-3">
                            <button type="submit" class="btn-luxury py-3 fs-6">
                                <i class="fas fa-shield-check me-2"></i>CONFIRM PROTOCOL
                            </button>
                            <a href="{{ path('app_service_show', {id: service.id}) }}" class="btn-outline-luxury py-2 text-xxs text-center letter-spacing-1">
                                <i class="fas fa-arrow-left me-2"></i>ABORT INITIALIZATION
                            </a>
                        </div>

                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    /* ── SPATIAL FORM UI ── */
    .bg-surface { background: rgba(255, 255, 255, 0.02); }
    .border-glass { border: 1px solid rgba(255, 255, 255, 0.08); }

    .cyber-input {
        background: rgba(255, 255, 255, 0.04) !important;
        border: 1px solid rgba(255, 255, 255, 0.1) !important;
        color: #fff !important;
        border-radius: 12px !important;
        padding: 12px 16px !important;
        width: 100%;
        transition: all 0.3s var(--ease-spatial);
    }
    .cyber-input:focus {
        border-color: var(--accent-teal) !important;
        background: rgba(0, 255, 213, 0.03) !important;
        box-shadow: 0 0 20px rgba(0, 255, 213, 0.1) !important;
        outline: none;
    }

    /* ── MODE NODES ── */
    .mode-node-wrapper { cursor: pointer; }
    .mode-node {
        background: rgba(255, 255, 255, 0.02);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 16px;
        transition: all 0.4s var(--ease-spatial);
    }
    .mode-node:hover {
        background: rgba(255, 255, 255, 0.05);
        border-color: rgba(255, 255, 255, 0.2);
        transform: translateY(-3px);
    }

    /* Active States */
    input[value="online"]:checked ~ .row .mode-node-wrapper[for*="bookingType_0"] .mode-node {
        border-color: var(--accent-cyan);
        background: rgba(0, 255, 213, 0.08);
        box-shadow: 0 0 30px rgba(0, 255, 213, 0.15);
    }
    input[value="visit"]:checked ~ .row .mode-node-wrapper[for*="bookingType_1"] .mode-node {
        border-color: var(--accent-purple);
        background: rgba(157, 124, 255, 0.08);
        box-shadow: 0 0 30px rgba(157, 124, 255, 0.15);
    }

    .text-cyan { color: var(--accent-cyan) !important; }
    .text-purple { color: var(--accent-purple) !important; }
</style>

<script>
document.addEventListener('DOMContentLoaded', function () {
    const radios = document.querySelectorAll('input[name$="[bookingType]"]');
    const visitInfo = document.getElementById('visit-info-box');

    function toggleBanner() {
        const selected = document.querySelector('input[name$="[bookingType]"]:checked').value;
        visitInfo.style.display = (selected === 'visit') ? 'block' : 'none';
    }

    radios.forEach(radio => radio.addEventListener('change', toggleBanner));
    
    // Initial Check
    toggleBanner();
});
</script>
{% endblock %}