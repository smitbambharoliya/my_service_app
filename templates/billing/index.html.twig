{% extends 'dashboard_base.html.twig' %}
{% import 'partials/_components.html.twig' as ui %}

{% block page_title %}Operational Billing & Protocols{% endblock %}

{% block body %}
<div class="row g-4 mb-5 fade-up">
    <div class="col-md-4">
        {{ ui.glass_card({
            title: 'Current Matrix Status',
            body: '<div class="h2 fw-900 text-white mb-0">AURORA ELITE</div><div class="text-xxs text-cyan fw-bold mt-1">SECURE ACCESS GRANTED</div>'
        }) }}
    </div>
    <div class="col-md-4">
        {{ ui.glass_card({
            title: 'Total Protocols',
            body: '<div class="h2 fw-900 text-white mb-0">' ~ billings|length ~ '</div><div class="text-xxs text-muted fw-bold mt-1">ALL SESSIONS RECORDED</div>'
        }) }}
    </div>
    <div class="col-md-4">
        {{ ui.glass_card({
            title: 'Settled Capital',
            body: '<div class="h2 fw-900 text-violet mb-0">₹' ~ (billings|reduce((carry, b) => b.paymentStatus == 'paid' or b.paymentStatus == 'success' ? carry + b.amount : carry, 0))|number_format(0) ~ '</div><div class="text-xxs text-muted fw-bold mt-1">VERIFIED VIA STRIPE</div>'
        }) }}
    </div>
</div>

<div class="glass-card border-subtle overflow-hidden fade-up" style="transition-delay: 100ms;">
    <div class="p-4 border-bottom border-subtle d-flex justify-content-between align-items-center bg-surface-2">
        <h5 class="text-xs text-muted fw-900 mb-0">TRANSACTION LEDGER</h5>
        <div class="badge-pill badge-confirmed px-3 py-1">ENCRYPTED</div>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="bg-surface-3">
                <tr class="border-0">
                    <th class="ps-4 py-3 text-xxs text-muted fw-900">REFERENCE ID</th>
                    <th class="py-3 text-xxs text-muted fw-900">DEPLOYMENT DATE</th>
                    <th class="py-3 text-xxs text-muted fw-900">PROTOCOL DETAILS</th>
                    <th class="py-3 text-xxs text-muted fw-900">CAPITAL</th>
                    <th class="py-3 text-xxs text-muted fw-900">VERIFICATION</th>
                    <th class="pe-4 py-3 text-end text-xxs text-muted fw-900">ACTIONS</th>
                </tr>
            </thead>
            <tbody class="border-0">
                {% for bill in billings %}
                    <tr class="border-subtle">
                        <td class="ps-4">
                            <span class="text-xs fw-bold text-cyan">#{{ bill.transactionId }}</span>
                        </td>
                        <td>
                            <span class="text-xs text-muted fw-bold">{{ bill.createdAt|date('d M, Y') }}</span>
                        </td>
                        <td>
                            <div class="text-xs text-white fw-bold mb-1">{{ bill.serviceName|default('Service Protocol') }}</div>
                            <div class="d-flex align-items-center gap-2">
                                <span class="badge-pill bg-dark-2 text-muted px-2 py-0 fw-900" style="font-size: 0.6rem;">{{ bill.category|upper }}</span>
                                {% if bill.items %}
                                    <span class="text-xxs text-violet fw-bold"><i class="fas fa-layer-group"></i> {{ bill.items|length }} ELEMENTS</span>
                                {% endif %}
                            </div>
                        </td>
                        <td>
                            <span class="text-xs fw-900 text-white">₹{{ bill.amount|number_format(2) }}</span>
                        </td>
                        <td>
                            {% if bill.paymentStatus == 'paid' or bill.paymentStatus == 'success' %}
                                <div class="badge-pill badge-confirmed px-2 py-1"><i class="fas fa-check-circle me-1"></i> SETTLED</div>
                            {% elseif bill.paymentStatus == 'unpaid' %}
                                <div class="badge-pill badge-pending px-2 py-1"><i class="fas fa-clock me-1"></i> PENDING</div>
                            {% elseif bill.paymentStatus == 'estimate' %}
                                <div class="badge-pill bg-amber text-dark px-2 py-1 fw-bold" style="font-size: 0.65rem;"><i class="fas fa-file-invoice me-1"></i> ESTIMATE</div>
                            {% else %}
                                <div class="badge-pill bg-dark-3 text-muted px-2 py-1 fw-bold" style="font-size: 0.65rem;">{{ bill.paymentStatus|upper }}</div>
                            {% endif %}
                        </td>
                        <td class="pe-4 text-end">
                            <div class="btn-group gap-2">
                                {% if bill.paymentStatus == 'unpaid' %}
                                    <a href="{{ path('app_billing_checkout', {id: bill.id}) }}" class="btn-violet px-3 py-1 text-xxs fw-900">
                                        SETTLE NOW
                                    </a>
                                {% endif %}
                                
                                {% if bill.paymentStatus == 'paid' or bill.paymentStatus == 'success' %}
                                    <a href="{{ path('app_billing_download', {id: bill.id}) }}" class="btn-ghost border-subtle px-3 py-1 text-xxs fw-900">
                                        <i class="fas fa-download me-1"></i> DOCUMENT
                                    </a>
                                {% endif %}

                                {% if bill.paymentStatus == 'estimate' %}
                                    <a href="{{ path('app_customer_dashboard') }}" class="btn-ghost border-subtle px-3 py-1 text-xxs fw-900">
                                        VIEW TERMS
                                    </a>
                                {% endif %}
                            </div>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="6" class="text-center py-5">
                            <div class="text-muted opacity-50">
                                <i class="fas fa-receipt fa-3x mb-3 text-violet"></i>
                                <p class="text-xs fw-bold">NO PROTOCOL LOGS DETECTED</p>
                            </div>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}

{% block stylesheets %}
<style>
    .table > :not(caption) > * > * { 
        background-color: transparent !important; 
        border-bottom-color: var(--border-subtle) !important;
        padding-top: 1.25rem;
        padding-bottom: 1.25rem;
    }
    .table tbody tr:hover { background-color: rgba(255, 255, 255, 0.02) !important; }
    .bg-amber { background-color: #F59E0B; }
</style>
{% endblock %}