{% extends 'base.html.twig' %}

{% block title %}Exchequer Ledger — ServiceHub{% endblock %}

{% block body %}
<div class="container py-5 reveal-3d">
    {# ── SPATIAL HEADER ── #}
    <div class="row mb-5 align-items-end">
        <div class="col-md-7">
            <span class="text-xxs fw-800 letter-spacing-3 text-teal d-block mb-2">FINANCIAL TELEMETRY</span>
            <h1 class="luxury-serif text-pure mb-0" style="font-size: 3rem;">Exchequer Ledger</h1>
            <p class="text-dim mt-2 mb-0">Audit your capital deployment and subscription fidelity.</p>
        </div>
        <div class="col-md-5 text-md-end mt-4 mt-md-0">
            <div class="glass-card d-inline-flex align-items-center gap-3 px-4 py-2 border-0">
                <div class="pulse-indicator {{ app.user.isVerified ? 'bg-teal' : 'bg-dim' }}"></div>
                <div class="text-start">
                    <div class="text-xxs text-dim fw-800">IDENTITY STATUS</div>
                    <div class="text-pure small fw-bold">{{ app.user.isVerified ? 'VERIFIED NODE' : 'STANDARD ACCESS' }}</div>
                </div>
            </div>
        </div>
    </div>

    {# ── BENTO METRICS ── #}
    <div class="row g-4 mb-5">
        <div class="col-md-6">
            <div class="glass-card p-4 h-100 d-flex align-items-center justify-content-between border-teal-soft">
                <div>
                    <div class="text-xxs text-dim fw-800 letter-spacing-1 mb-2">TOTAL CAPITAL DEPLOYED</div>
                    <div class="h1 fw-900 text-pure mb-0">₹{{ total_spent|default('0.00') }}</div>
                </div>
                <div class="p-4 rounded-circle bg-surface border-glass">
                    <i class="fas fa-vault text-teal fs-3"></i>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="glass-card p-4 h-100 d-flex align-items-center justify-content-between border-purple-soft">
                <div>
                    <div class="text-xxs text-dim fw-800 letter-spacing-1 mb-2">ACTIVE FIDELITY PLAN</div>
                    <div class="h1 fw-900 text-purple mb-0">Premium</div>
                </div>
                <div class="p-4 rounded-circle bg-surface border-glass">
                    <i class="fas fa-crown text-purple fs-3"></i>
                </div>
            </div>
        </div>
    </div>

    {# ── TRANSACTION NODE LIST ── #}
    <div class="glass-card p-0 overflow-hidden">
        <div class="p-4 border-bottom border-white border-opacity-5 d-flex justify-content-between align-items-center">
            <h5 class="luxury-serif text-white m-0">Recent Artifact Settlements</h5>
            <span class="text-xxs text-dim fw-800">{{ billings|length }} RECORDS SYNCED</span>
        </div>
        
        <div class="table-responsive">
            <table class="table mb-0 align-middle" style="--bs-table-bg: transparent; --bs-table-color: #f7fbff;">
                <thead>
                    <tr class="text-xxs text-dim fw-800 letter-spacing-1 border-0">
                        <th class="ps-4 py-4">TRANSACTION ID</th>
                        <th class="py-4">ARTIFACT DETAILS</th>
                        <th class="py-4">CAPITAL</th>
                        <th class="py-4">STATUS</th>
                        <th class="pe-4 py-4 text-end">ARCHIVE</th>
                    </tr>
                </thead>
                <tbody>
                    {% for bill in billings %}
                    <tr class="border-top border-white border-opacity-5 hover-bright">
                        <td class="ps-4">
                            <code class="text-teal small">#{{ bill.transactionId }}</code>
                            <div class="text-xxs text-dim mt-1">{{ bill.createdAt|date('M d, Y') }}</div>
                        </td>
                        <td>
                            <div class="fw-bold text-white small">{{ bill.serviceName|default('Service Protocol') }}</div>
                            <div class="text-xxs text-dim mt-1">
                                <span class="badge-status py-0 px-2" style="font-size: 0.6rem; background: rgba(255,255,255,0.05);">{{ bill.category|default('General')|upper }}</span>
                            </div>
                        </td>
                        <td>
                            <span class="fw-900 text-white">₹{{ bill.amount }}</span>
                        </td>
                        <td>
                            {% if bill.paymentStatus == 'success' %}
                                <span class="badge-status status-active">SETTLED</span>
                            {% else %}
                                <span class="badge-status status-alert">FAILED</span>
                            {% endif %}
                        </td>
                        <td class="text-end pe-4">
                            <button class="btn-action-spatial text-teal" title="Download PDF">
                                <i class="fas fa-file-pdf"></i>
                            </button>
                        </td>
                    </tr>
                    {% else %}
                    <tr>
                        <td colspan="5" class="text-center py-5">
                            <i class="fas fa-receipt text-dim fs-1 mb-3 opacity-20"></i>
                            <p class="text-dim small mb-0">No transaction telemetry found.</p>
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>

<style>
    :root {
        --text-pure: #ffffff;
        --text-dim: #94a3b8;
        --accent-teal: #00ffd5;
        --accent-purple: #9d7cff;
        --glass-border: rgba(255, 255, 255, 0.12);
        --bg-surface: rgba(255, 255, 255, 0.03);
    }

    .border-teal-soft { border-color: rgba(0, 255, 213, 0.2) !important; }
    .border-purple-soft { border-color: rgba(157, 124, 255, 0.2) !important; }
    .bg-surface { background: var(--bg-surface); }
    .border-glass { border: 1px solid var(--glass-border); }

    .hover-bright:hover {
        background: rgba(255, 255, 255, 0.02) !important;
    }

    .pulse-indicator {
        width: 8px; height: 8px;
        border-radius: 50%;
        position: relative;
    }
    .bg-teal { background: var(--accent-teal); box-shadow: 0 0 10px var(--accent-teal); }
    .bg-teal::after {
        content: ''; position: absolute; inset: -4px; border-radius: 50%;
        border: 1px solid var(--accent-teal); animation: pulse-ring 2s infinite;
    }
    
    @keyframes pulse-ring {
        0% { transform: scale(1); opacity: 1; }
        100% { transform: scale(2.5); opacity: 0; }
    }

    .btn-action-spatial {
        width: 38px; height: 38px;
        border-radius: 10px;
        display: inline-flex; align-items: center; justify-content: center;
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid var(--glass-border);
        transition: all 0.3s cubic-bezier(0.23, 1, 0.32, 1);
        cursor: pointer;
        color: inherit;
    }
    .btn-action-spatial:hover {
        background: rgba(255, 255, 255, 0.1);
        transform: scale(1.1);
        border-color: var(--accent-teal);
    }

    .badge-status {
        font-family: 'Plus Jakarta Sans', sans-serif;
        font-weight: 800;
        letter-spacing: 1px;
        padding: 4px 12px;
        border-radius: 8px;
        font-size: 0.65rem;
        border: 1px solid transparent;
    }
    .status-active { background: rgba(0, 255, 213, 0.1); color: var(--accent-teal); border-color: rgba(0, 255, 213, 0.2); }
    .status-alert { background: rgba(255, 93, 115, 0.1); color: #ff5d73; border-color: rgba(255, 93, 115, 0.2); }
</style>
{% endblock %}