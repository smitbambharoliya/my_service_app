<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;700&family=Playfair+Display:wght@700&display=swap');
        
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            color: #07080F;
            margin: 0;
            padding: 40px;
            background: #FFF;
        }

        .header {
            border-bottom: 2px solid #D4AF37;
            padding-bottom: 20px;
            margin-bottom: 40px;
            overflow: hidden;
        }

        .logo {
            font-family: 'Playfair Display', serif;
            font-size: 24px;
            font-weight: 700;
            float: left;
        }

        .logo span { color: #D4AF37; }

        .invoice-details {
            float: right;
            text-align: right;
            font-size: 12px;
            color: #64748B;
        }

        .section-title {
            font-family: 'Playfair Display', serif;
            font-size: 18px;
            margin-bottom: 20px;
            color: #07080F;
        }

        .bill-to {
            margin-bottom: 40px;
        }

        .bill-to-label {
            font-size: 10px;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: #94A3B8;
            margin-bottom: 5px;
        }

        .bill-to-name {
            font-size: 16px;
            font-weight: 700;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 40px;
        }

        th {
            text-align: left;
            font-size: 10px;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: #94A3B8;
            padding: 15px 0;
            border-bottom: 1px solid #E2E8F0;
        }

        td {
            padding: 20px 0;
            border-bottom: 1px solid #F1F5F9;
            font-size: 14px;
        }

        .total-row td {
            border-bottom: none;
            padding-top: 40px;
        }

        .total-label {
            font-size: 12px;
            font-weight: 700;
            text-align: right;
            padding-right: 20px;
        }

        .total-amount {
            font-family: 'Playfair Display', serif;
            font-size: 24px;
            font-weight: 700;
            color: #D4AF37;
        }

        .footer {
            margin-top: 100px;
            font-size: 10px;
            color: #94A3B8;
            text-align: center;
            border-top: 1px solid #F1F5F9;
            padding-top: 20px;
        }

        .badge {
            display: inline-block;
            padding: 4px 10px;
            border-radius: 20px;
            font-size: 10px;
            font-weight: 700;
            text-transform: uppercase;
        }
        .badge-paid { background: #DCFCE7; color: #166534; }
    </style>
</head>
<body>
    <div class="header">
        <div class="logo">Service<span>Hub</span></div>
        <div class="invoice-details">
            <div>INVOICE PROTOCOL #{{ billing.transactionId }}</div>
            <div>DATED: {{ billing.createdAt|date('d F Y') }}</div>
        </div>
    </div>

    <div class="bill-to">
        <div class="bill-to-label">ESTATE OF</div>
        <div class="bill-to-name">{{ billing.user.fullName }}</div>
        <div style="font-size: 12px; color: #64748B;">{{ billing.user.email }}</div>
    </div>

    <h2 class="section-title">Protocol Details</h2>
    <table>
        <thead>
            <tr>
                <th>Service Description</th>
                <th style="text-align: right;">Amount</th>
            </tr>
        </thead>
        <tbody>
            {% if billing.items %}
                {% for item in billing.items %}
                    <tr>
                        <td>{{ item.name }}</td>
                        <td style="text-align: right;">₹{{ item.amount|number_format }}</td>
                    </tr>
                {% endfor %}
            {% else %}
                <tr>
                    <td>{{ billing.serviceName }} - {{ billing.category }}</td>
                    <td style="text-align: right;">₹{{ billing.amount|number_format }}</td>
                </tr>
            {% endif %}
            <tr class="total-row">
                <td class="total-label">SETTLEMENT TOTAL</td>
                <td class="total-amount" style="text-align: right;">₹{{ billing.amount|number_format }}</td>
            </tr>
        </tbody>
    </table>

    <div style="margin-top: 20px;">
        <span class="badge badge-paid">Settled via {{ billing.paymentStatus|upper }} Protocol</span>
    </div>

    <div class="footer">
        <p>This is a digitally verified luxury heritage invoice from ServiceHub Concierge.</p>
        <p>&copy; {{ "now"|date("Y") }} ServiceHub Obsidian X. All Rights Reserved.</p>
    </div>
</body>
</html>
