{#
 # Aurora Glassy Spatial Components 2026
 # High-fidelity macros for the ServiceHub Obsidian X ecosystem.
 #}

{# ── 1. ACTION NODES (Buttons) ── #}
{% macro button(text, href = '#', variant = 'primary', icon = '', size = 'md', type = 'link', extra_class = '') %}
    {% set size_map = { 'sm': 'py-2 px-4 text-xxs', 'md': 'py-3 px-6 text-xs', 'lg': 'py-4 px-8 text-sm' } %}
    
    {# Mapping variants to spatial CSS classes #}
    {% set variant_map = {
        'primary': 'btn-luxury',
        'secondary': 'btn-spatial-glass',
        'success': 'btn-luxury',
        'danger': 'btn-spatial-void',
        'warning': 'btn-spatial-gold',
        'outline': 'btn-outline-luxury'
    } %}

    {% set common_class = 'd-inline-flex align-items-center justify-content-center fw-900 letter-spacing-2 text-uppercase ' ~ variant_map[variant] ~ ' ' ~ size_map[size] ~ ' ' ~ extra_class %}

    {% if type == 'link' %}
        <a href="{{ href }}" class="{{ common_class }}" style="text-decoration: none;">
            {% if icon %}<i class="fas fa-{{ icon }} me-2"></i>{% endif %}
            <span>{{ text }}</span>
        </a>
    {% else %}
        <button type="{{ type }}" class="{{ common_class }}">
            {% if icon %}<i class="fas fa-{{ icon }} me-2"></i>{% endif %}
            <span>{{ text }}</span>
        </button>
    {% endif %}
{% endmacro %}

{# ── 2. SPATIAL ARTIFACTS (Cards) ── #}
{% macro card(title = '', content = '', footer = '', icon = '', glow = false) %}
<div class="glass-card {{ glow ? 'border-' ~ glow ~ '-glow' : '' }} reveal-3d overflow-hidden h-100">
    {% if title or icon %}
        <div class="p-4 pb-0 d-flex justify-content-between align-items-start">
            <div>
                {% if title %}
                    <h3 class="luxury-serif text-white h5 mb-1">{{ title }}</h3>
                {% endif %}
                <div class="header-decoration-line"></div>
            </div>
            {% if icon %}
                <div class="p-2 rounded-3 bg-surface border-glass text-teal shadow-sm">
                    <i class="fas fa-{{ icon }}"></i>
                </div>
            {% endif %}
        </div>
    {% endif %}
    
    <div class="p-4 {{ title or icon ? 'pt-3' : '' }}">
        {{ content|raw }}
    </div>

    {% if footer %}
        <div class="p-3 bg-surface-dark border-top border-white border-opacity-5">
            {{ footer|raw }}
        </div>
    {% endif %}
</div>
{% endmacro %}

{# ── 3. TELEMETRY NODES (Stat Cards) ── #}
{% macro stat_card(value, label, icon = '', glow = 'teal', trend = '', trend_up = true) %}
<div class="glass-card p-4 border-glow-hover h-100 d-flex flex-column justify-content-between border-{{ glow }}-soft">
    <div class="d-flex justify-content-between align-items-start mb-3">
        <div class="text-xxs text-dim fw-900 letter-spacing-2 text-uppercase">{{ label }}</div>
        {% if icon %}
            <i class="fas fa-{{ icon }} text-{{ glow }} opacity-40"></i>
        {% endif %}
    </div>
    <div>
        <div class="h2 fw-900 text-white mb-1 font-monospace">{{ value }}</div>
        {% if trend %}
            <div class="text-xxs {{ trend_up ? 'text-teal' : 'text-red' }} fw-900 font-monospace">
                <i class="fas fa-caret-{{ trend_up ? 'up' : 'down' }} me-1"></i>{{ trend }}
            </div>
        {% endif %}
    </div>
</div>
{% endmacro %}

{# ── 4. SYSTEM BADGES ── #}
{% macro badge(text, type = 'active', icon = '') %}
<span class="badge-status status-{{ type }} px-3 py-1 reveal-3d">
    {% if icon %}<i class="fas fa-{{ icon }} me-1"></i>{% endif %}
    <span class="font-monospace fw-900" style="font-size: 0.55rem;">{{ text|upper }}</span>
</span>
{% endmacro %}

{# ── 5. TERMINAL INPUTS ── #}
{% macro input(name, label = '', value = '', type = 'text', placeholder = '', required = false, icon = '') %}
<div class="mb-4">
    {% if label %}
        <label class="text-xxs text-dim fw-900 letter-spacing-1 d-block mb-2" for="{{ name }}">
            {{ label|upper }} {% if required %}<span class="text-teal">*</span>{% endif %}
        </label>
    {% endif %}
    <div class="position-relative">
        <input type="{{ type }}"
               name="{{ name }}"
               id="{{ name }}"
               value="{{ value }}"
               placeholder="{{ placeholder }}"
               {% if required %}required{% endif %}
               class="cyber-input {{ icon ? 'ps-5' : '' }}">
        {% if icon %}
            <i class="fas fa-{{ icon }} position-absolute top-50 start-0 translate-middle-y ms-3 text-dim opacity-30"></i>
        {% endif %}
    </div>
</div>
{% endmacro %}

{# ── 6. FIDELITY AVATAR ── #}
{% macro avatar(user, size = 'md', status = 'online') %}
{% set sizes = {'sm': 36, 'md': 48, 'lg': 64, 'xl': 110} %}
<div class="user-orb reveal-3d" 
     style="width: {{ sizes[size] }}px; height: {{ sizes[size] }}px; font-size: {{ sizes[size] // 2.5 }}px; border-color: var(--accent-teal);">
    {{ user.fullName|slice(0,1)|upper }}
    {% if status == 'online' %}
        <div class="status-dot-pulse" style="position: absolute; bottom: 5%; right: 5%;"></div>
    {% endif %}
</div>
{% endmacro %}

{# ── 7. TELEMETRY DROPOUT (Empty State) ── #}
{% macro empty_state(icon, title, message, action_text = '', action_href = '') %}
<div class="glass-card border-dashed py-5 px-4 text-center reveal-3d" style="background: rgba(255,255,255,0.01);">
    <div class="mb-4 opacity-30">
        <i class="fas fa-{{ icon }} animate-flicker" style="font-size: 3.5rem; color: var(--accent-teal);"></i>
    </div>
    <h3 class="luxury-serif text-white mb-2 h4">{{ title|upper }}</h3>
    <p class="text-dim mx-auto mb-4" style="max-width: 400px; font-size: 0.9rem;">{{ message }}</p>
    {% if action_text and action_href %}
        {{ _self.button(action_text, action_href, 'primary', 'plus', 'sm') }}
    {% endif %}
</div>
{% endmacro %}

{# ── 8. SYSTEM MESH BACKGROUND ── #}
{% macro mesh_background() %}
<div class="hero-bloom-glow"></div>
<div class="cyber-grid" style="opacity: 0.3;"></div>
{% endmacro %}