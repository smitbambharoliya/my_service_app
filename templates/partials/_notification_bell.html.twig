<style>
    /* ── NOTIFICATION SPATIAL WIDGET ── */
    .notification-shell .notification-button {
        width: 44px;
        height: 44px;
        border-radius: 12px;
        border: 1px solid rgba(255, 255, 255, 0.08);
        background: rgba(255, 255, 255, 0.03);
        backdrop-filter: blur(10px);
        color: var(--text-dim);
        position: relative;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        transition: all 0.4s var(--ease-spatial);
    }

    .notification-shell .notification-button:hover {
        color: #fff;
        border-color: var(--accent-teal);
        background: rgba(0, 255, 213, 0.05);
        box-shadow: 0 0 20px rgba(0, 255, 213, 0.15);
    }

    .notification-shell .notification-badge {
        position: absolute;
        top: -5px;
        right: -5px;
        min-width: 18px;
        height: 18px;
        padding: 0 5px;
        border-radius: 6px;
        background: var(--accent-teal);
        color: #05070a;
        font-size: 0.6rem;
        font-weight: 900;
        display: none;
        align-items: center;
        justify-content: center;
        box-shadow: 0 0 12px rgba(0, 255, 213, 0.4);
        z-index: 2;
    }

    .notification-shell .notification-menu {
        width: 380px;
        background: rgba(10, 15, 25, 0.95);
        backdrop-filter: blur(30px);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 24px;
        overflow: hidden;
        margin-top: 12px !important;
        box-shadow: 0 40px 100px rgba(0, 0, 0, 0.6);
    }

    .notification-shell .notification-header {
        padding: 20px 24px;
        background: rgba(255, 255, 255, 0.02);
        border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    }

    .notification-shell .notification-item {
        display: block;
        padding: 20px 24px;
        text-decoration: none;
        color: inherit;
        border-bottom: 1px solid rgba(255, 255, 255, 0.03);
        transition: all 0.3s var(--ease-spatial);
        position: relative;
    }

    .notification-shell .notification-item:hover {
        background: rgba(255, 255, 255, 0.03);
        transform: translateX(5px);
    }

    .notification-shell .notification-item.unread {
        background: linear-gradient(90deg, rgba(0, 255, 213, 0.03) 0%, transparent 100%);
    }

    /* Fidelity Unread Accent */
    .notification-shell .notification-item.unread::before {
        content: '';
        position: absolute;
        left: 0; top: 20%; bottom: 20%;
        width: 3px;
        background: var(--accent-teal);
        box-shadow: 0 0 10px var(--accent-teal);
        border-radius: 0 4px 4px 0;
    }

    .notification-shell .item-title {
        font-weight: 800;
        color: #fff;
        font-size: 0.85rem;
        letter-spacing: 0.5px;
    }

    .notification-shell .item-time {
        font-family: monospace;
        font-size: 0.65rem;
        color: var(--text-dim);
        opacity: 0.6;
    }

    .notification-shell .item-msg {
        font-size: 0.8rem;
        color: var(--text-dim);
        line-height: 1.5;
        margin-top: 4px;
    }

    .notification-shell .view-all-link {
        color: var(--accent-teal);
        font-size: 0.65rem;
        font-weight: 900;
        letter-spacing: 1px;
        text-transform: uppercase;
    }
</style>

<div class="dropdown notification-shell" data-notification-widget>
    <button class="notification-button btn btn-link text-decoration-none p-0" type="button" data-bs-toggle="dropdown" aria-expanded="false">
        <i class="fa-regular fa-bell"></i>
        <span class="notification-badge" data-notification-count>0</span>
    </button>

    <div class="dropdown-menu dropdown-menu-end notification-menu p-0 reveal-3d">
        <div class="notification-header d-flex align-items-center justify-content-between">
            <div>
                <div class="fw-900 text-white text-xxs letter-spacing-2">SIGNAL FEED</div>
                <div class="text-dim" style="font-size: 0.7rem;">Real-time system telemetry</div>
            </div>
            <a href="{{ path('app_notification_index') }}" class="view-all-link text-decoration-none">View Archive</a>
        </div>
        
        <div data-notification-list class="custom-scrollbar" style="max-height: 400px; overflow-y: auto;">
            <div class="px-4 py-5 text-center opacity-50">
                <i class="fas fa-circle-notch fa-spin text-teal mb-3"></i>
                <div class="text-xxs fw-800">SYNCING ARCHIVES...</div>
            </div>
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', () => {
    const widget = document.querySelector('[data-notification-widget]');
    if (!widget) return;

    const countBadge = widget.querySelector('[data-notification-count]');
    const list = widget.querySelector('[data-notification-list]');
    const summaryUrl = '{{ path('app_notification_summary') }}';

    function escapeHtml(v) {
        return String(v).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    }

    function renderNotifications(data) {
        const count = Number(data.count || 0);
        countBadge.textContent = count > 99 ? '!' : String(count);
        countBadge.style.display = count > 0 ? 'flex' : 'none';

        if (!data.notifications || data.notifications.length === 0) {
            list.innerHTML = `
                <div class="px-4 py-5 text-center">
                    <i class="fas fa-satellite-dish text-dim opacity-20 mb-3" style="font-size: 2rem;"></i>
                    <div class="text-xxs text-dim fw-800 letter-spacing-1">NO INCOMING SIGNALS</div>
                </div>`;
            return;
        }

        list.innerHTML = data.notifications.map((n) => `
            <a href="${n.visitUrl}" class="notification-item ${n.isRead ? '' : 'unread'}">
                <div class="d-flex justify-content-between align-items-start gap-3">
                    <div class="item-title">${escapeHtml(n.title).toUpperCase()}</div>
                    <div class="item-time">${escapeHtml(n.createdAt || 'NOW')}</div>
                </div>
                <div class="item-msg">${escapeHtml(n.message)}</div>
            </a>
        `).join('');
    }

    async function loadNotifications() {
        try {
            const response = await fetch(summaryUrl, { headers: {'X-Requested-With': 'XMLHttpRequest'} });
            if (!response.ok) throw new Error();
            renderNotifications(await response.json());
        } catch (error) {
            list.innerHTML = '<div class="px-4 py-4 text-red text-xxs fw-800">UPLINK ERROR</div>';
        }
    }

    widget.querySelector('[data-bs-toggle="dropdown"]').addEventListener('click', loadNotifications);
    loadNotifications();
    setInterval(loadNotifications, 30000);
});
</script>