{# 1. Append the new Message Node to the telemetry feed #}
<turbo-stream action="append" target="chat-messages">
    <template>
        <div class="msg-spatial-wrapper animate-spatial-entry">
            <div class="msg-bubble msg-rcvd reveal-3d">
                <div class="msg-content">
                    {{ message.content|escape }}
                </div>
                <div class="msg-metadata">
                    <span class="msg-time font-monospace">{{ message.createdAt|date('H:i') }}</span>
                    <i class="fas fa-check-double msg-status-icon"></i>
                </div>
            </div>
        </div>
    </template>
</turbo-stream>

{# 2. Reset the Command Terminal (Input Field) #}
<turbo-stream action="replace" target="message-terminal-container">
    <template>
        <div id="message-terminal-container" class="position-relative">
            <input type="text" 
                   name="message" 
                   id="messageInput" 
                   class="cyber-input pe-5" 
                   placeholder="Transmit message..." 
                   autocomplete="off" 
                   data-msg-target="input" />
            <div class="input-glow-bar"></div>
        </div>
    </template>
</turbo-stream>

<style>
    /* ── SPATIAL MESSAGE UI ── */
    .msg-spatial-wrapper {
        display: flex;
        justify-content: flex-start;
        margin-bottom: 15px;
        perspective: 1000px;
    }

    .msg-bubble {
        background: rgba(255, 255, 255, 0.03);
        backdrop-filter: blur(15px);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 18px 18px 18px 4px;
        padding: 12px 16px;
        max-width: 80%;
        color: #fff;
        box-shadow: 0 10px 30px rgba(0,0,0,0.2);
        transition: all 0.3s var(--ease-spatial);
    }

    .msg-metadata {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 6px;
        margin-top: 6px;
        opacity: 0.4;
    }

    .msg-time { font-size: 0.6rem; font-weight: 800; letter-spacing: 1px; }
    .msg-status-icon { font-size: 0.55rem; color: var(--accent-teal); }

    /* Entry Animation */
    .animate-spatial-entry {
        animation: msgSlideIn 0.5s var(--ease-spatial) forwards;
    }

    @keyframes msgSlideIn {
        from { opacity: 0; transform: translateY(20px) rotateX(-20deg); filter: blur(5px); }
        to { opacity: 1; transform: translateY(0) rotateX(0); filter: blur(0); }
    }

    /* Terminal Reset Glow */
    .input-glow-bar {
        position: absolute;
        bottom: 0; left: 10%; right: 10%;
        height: 1px;
        background: var(--accent-teal);
        box-shadow: 0 0 15px var(--accent-teal);
        opacity: 0;
        animation: terminalPulse 1s ease-out;
    }

    @keyframes terminalPulse {
        0% { opacity: 1; width: 0%; left: 50%; }
        100% { opacity: 0; width: 80%; left: 10%; }
    }
</style>