{% extends 'dashboard_base.html.twig' %}

{% block page_title %}Identity Inbox{% endblock %}

{% block stylesheets %}
<style>
/* ── SPATIAL INBOX ARCHITECTURE ── */
.inbox-wrapper { max-width: 1000px; margin: 0 auto; padding: 40px 0; }

.contact-list {
    background: rgba(255, 255, 255, 0.02);
    backdrop-filter: blur(25px);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 32px;
    overflow: hidden;
    box-shadow: 0 40px 100px rgba(0,0,0,0.4);
}

.contact-item {
    padding: 28px 32px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    display: flex;
    align-items: center;
    gap: 24px;
    transition: all 0.4s var(--ease-spatial);
    text-decoration: none;
    position: relative;
    overflow: hidden;
}

.contact-item:last-child { border: none; }

.contact-item:hover {
    background: rgba(255, 255, 255, 0.04);
    transform: scale(1.01);
    z-index: 2;
}

/* Unread State Glow */
.contact-item.has-unread {
    background: linear-gradient(90deg, rgba(0, 255, 213, 0.03) 0%, transparent 100%);
}
.contact-item.has-unread::before {
    content: '';
    position: absolute;
    left: 0; top: 15%; bottom: 15%;
    width: 3px;
    background: var(--accent-teal);
    box-shadow: 0 0 15px var(--accent-teal);
    border-radius: 0 4px 4px 0;
}

.c-avatar-spatial {
    width: 64px; height: 64px;
    border-radius: 20px;
    background: var(--bg-obsidian);
    border: 1px solid rgba(255, 255, 255, 0.1);
    display: flex; align-items: center; justify-content: center;
    color: var(--accent-teal);
    font-size: 1.4rem;
    font-weight: 900;
    transition: 0.3s;
    box-shadow: 0 10px 20px rgba(0,0,0,0.2);
}

.contact-item:hover .c-avatar-spatial {
    border-color: var(--accent-teal);
    box-shadow: 0 0 20px rgba(0, 255, 213, 0.2);
}

.c-info { flex: 1; min-width: 0; }
.c-name { 
    color: #fff; 
    font-size: 1.1rem; 
    font-weight: 800; 
    letter-spacing: 0.5px;
    margin-bottom: 6px; 
}

.c-msg { 
    color: var(--text-dim); 
    font-size: 0.85rem; 
    white-space: nowrap; 
    overflow: hidden; 
    text-overflow: ellipsis; 
    max-width: 85%;
    transition: 0.3s;
}

.unread-text { color: #fff; font-weight: 600; }

.c-meta { text-align: right; }
.c-time { 
    color: var(--text-dim); 
    font-size: 0.65rem; 
    font-weight: 800;
    font-family: monospace;
    text-transform: uppercase;
    margin-bottom: 10px; 
}

.spatial-badge-unread {
    background: var(--accent-teal);
    color: #05070a;
    border-radius: 8px;
    padding: 4px 10px;
    font-size: 0.65rem;
    font-weight: 900;
    letter-spacing: 1px;
    box-shadow: 0 0 15px rgba(0, 255, 213, 0.4);
}
</style>
{% endblock %}

{% block body %}
<div class="inbox-wrapper reveal-3d">
    <div class="d-flex justify-content-between align-items-end mb-5">
        <div>
            <span class="text-xxs text-teal fw-900 letter-spacing-3 mb-2 d-block">COMMUNICATION UPLINK</span>
            <h2 class="luxury-serif text-white m-0" style="font-size: 2.8rem;">Inbox<span class="text-teal">.</span></h2>
        </div>
        <div class="text-xxs text-dim fw-800 letter-spacing-1">
            SYNCED: {{ "now"|date('H:i:s T') }}
        </div>
    </div>

    <div class="contact-list border-glow-hover">
        {% for contact in contacts %}
            <a href="{{ path('app_message_chat', {'id': contact.contact_id}) }}" 
               class="contact-item {{ contact.unread_count > 0 ? 'has-unread' : '' }}">
                
                <div class="c-avatar-spatial">
                    {{ contact.contact_email|slice(0,1)|upper }}
                </div>
                
                <div class="c-info">
                    <div class="c-name">{{ contact.contact_email|split('@')[0]|upper }}</div>
                    <div class="c-msg {{ contact.unread_count > 0 ? 'unread-text' : '' }}">
                        {% if contact.unread_count > 0 %}
                            <i class="fas fa-bolt-lightning text-teal me-1"></i>
                        {% endif %}
                        {{ contact.last_message }}
                    </div>
                </div>
                
                <div class="c-meta">
                    <div class="c-time">{{ contact.last_message_date|date('M d . H:i') }}</div>
                    {% if contact.unread_count > 0 %}
                        <div class="spatial-badge-unread">NEW: {{ contact.unread_count }}</div>
                    {% endif %}
                </div>
            </a>
        {% else %}
            <div class="p-5 text-center">
                <div class="opacity-20 mb-4">
                    <i class="fas fa-satellite-dish" style="font-size: 4rem;"></i>
                </div>
                <h5 class="luxury-serif text-white">No active transmissions</h5>
                <p class="text-dim text-xs letter-spacing-1">Initialize a connection with a service provider to begin.</p>
                <a href="{{ path('app_service_list') }}" class="btn-luxury mt-4 py-2 px-4" style="font-size: 0.6rem;">BROWSE ARCHIVE</a>
            </div>
        {% endfor %}
    </div>
</div>
{% endblock %}