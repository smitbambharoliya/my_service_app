{% extends 'base.html.twig' %}

{% block title %}Sign In — ServiceHub Luxury Portal{% endblock %}

{% block stylesheets %}
<style>
    html { scroll-behavior: smooth; }
    body {
        background: #6c86c8ff;
        overflow-x: hidden;
        overflow-y: auto;
        min-height: 100vh;
    }

    /* Dark Theme Typography Overrides */
    :root {
        --text-pure: #ffffff;
        --text-silver: #94a3b8;
        --text-dim: #64748b;
    }
    h1, h2, h3, h4, h5, h6, .luxury-serif, .text-pure { color: #0c0707ff !important; }
    .text-silver { color: var(--text-silver) !important; }
    .text-dim { color: var(--text-dim) !important; }
    .text-gold { color: #38bdf8 !important; }

    .portal-wrapper {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        position: relative;
        padding: clamp(1.5rem, 4vw, 2.5rem) clamp(1rem, 3vw, 2.5rem) clamp(2.5rem, 6vh, 4rem);
        box-sizing: border-box;
    }

    .portal-bg-accent {
        position: absolute;
        width: 1200px; height: 1200px;
        background: radial-gradient(circle, rgba(59, 130, 246, 0.04) 0%, transparent 70%);
        top: -400px; right: -400px;
        z-index: 1;
        pointer-events: none;
    }

    .portal-card {
        width: 100%;
        max-width: 1100px;
        display: grid;
        grid-template-columns: 1.2fr 1fr;
        background: #0f172a;
        border: 1px solid rgba(255,255,255,0.05);
        border-radius: var(--r-xl);
        overflow: hidden;
        position: relative;
        z-index: 10;
        box-shadow: 0 20px 50px rgba(0,0,0,0.5), 0 0 40px rgba(59, 130, 246, 0.15);
    }

    .portal-visual {
        background-size: cover;
        background-position: center;
        position: relative;
        padding: 60px;
        display: flex;
        flex-direction: column;
        justify-content: flex-end;
    }
    .portal-visual::after {
        content: ''; position: absolute; inset: 0;
        background: linear-gradient(to top, rgba(15, 23, 42, 1) 0%, rgba(15, 23, 42, 0.4) 50%, rgba(15, 23, 42, 0) 100%);
    }
    .visual-content { position: relative; z-index: 10; }

    /* Right: The Secure Terminal */
    .portal-form-side {
        padding: 60px;
        background: #0f172a;
    }

    .input-label {
        font-size: 0.65rem;
        font-weight: 800;
        color: var(--text-dim);
        text-transform: uppercase;
        letter-spacing: 0.2em;
        margin-bottom: 12px;
        display: block;
    }

    .auth-input {
        width: 100%;
        background: rgba(0, 0, 0, 0.2);
        border: 1px solid rgba(255,255,255,0.1);
        border-radius: var(--r-md);
        padding: 16px 20px;
        color: #ffffff;
        font-size: 0.9rem;
        transition: all 0.4s var(--ease-luxury);
        margin-bottom: 24px;
        font-family: 'Plus Jakarta Sans', sans-serif;
    }
    .auth-input:focus {
        background: rgba(0, 0, 0, 0.4);
        border-color: #38bdf8;
        outline: none;
        box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1);
    }

    @media (max-width: 992px) {
        .portal-card { grid-template-columns: 1fr; max-width: 500px; }
        .portal-visual { display: none; }
        .portal-form-side { padding: 40px; }
    }
</style>
{% endblock %}

{% block body %}
<div class="portal-wrapper">
    <div class="portal-bg-accent"></div>
    
    <div class="portal-card animate-fade-in">
        {# ── LEFT: VISUAL ── #}
        <div class="portal-visual" style="background-image: url('https://images.unsplash.com/photo-1600607687920-4e2a09cf159d?q=80&w=1200&auto=format&fit=crop');">
            <div class="visual-content">
                <span class="text-gold text-xs fw-800 letter-spacing-2 mb-3 d-block" style="text-shadow: 0 0 10px rgba(56, 189, 248, 0.5);">WELCOME BACK</span>
                <h2 class="luxury-serif text-pure mb-4" style="font-size: 2.3rem; text-shadow: 0 4px 15px rgba(255, 255, 255, 0.3);">Sign in to<br>continue with ServiceHub.</h2>
                <p class="text-silver mb-0" style="max-width: 350px;">Access your bookings, services and history in one place.</p>
            </div>
        </div>

        {# ── RIGHT: THE SECURE TERMINAL ── #}
        <div class="portal-form-side">
            <div class="text-center mb-5">
                <a href="{{ path('app_home') }}" class="luxury-serif text-pure text-decoration-none h3 mb-1 d-block">ServiceHub<span class="text-gold">.</span></a>
                <p class="text-xs text-dim fw-bold letter-spacing-1 mb-1">Sign in to your account</p>
                <p class="text-xxs text-muted mb-0">Use your email and password to continue.</p>
            </div>

            {% if error %}
                <div class="glass-card mb-4 p-3 d-flex align-items-center gap-3" style="border-left: 2px solid #ef4444 !important; background: rgba(239, 68, 68, 0.05); box-shadow: none;">
                    <i class="fas fa-shield-halved text-red fs-5"></i>
                    <div class="text-xs text-pure fw-bold">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
                </div>
            {% endif %}

            <form method="post">
                <div class="mb-4">
                    <label class="input-label">Identity (Email)</label>
                    <input type="email" name="email" value="{{ last_username }}" class="auth-input" placeholder="representative@domain.com" required autofocus>
                </div>

                <div class="mb-4">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <label class="input-label mb-0">Security Key</label>
                        <a href="#" class="text-xxs text-gold text-decoration-none fw-bold">RECOVER KEY</a>
                    </div>
                    <input type="password" name="password" class="auth-input" placeholder="••••••••" required>
                </div>

                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                <div class="mb-5 d-flex align-items-center gap-3">
                    <input type="checkbox" name="_remember_me" id="rememberMe" class="form-check-input bg-transparent" style="border-color: #cbd5e1;">
                    <label class="text-xs text-dim fw-bold cursor-pointer" for="rememberMe">TRUST THIS DEVICE</label>
                </div>

                <button class="btn-aurora-gradient w-100 py-3 mb-4 justify-content-center" style="font-size: 0.8rem; border-radius: 50px;" type="submit">
                    INITIALIZE SESSION <i class="fas fa-arrow-right ms-2"></i>
                </button>

                <div class="text-center">
                    <p class="text-xs text-dim mb-0">
                        New to the Heritage? <a href="{{ path('app_register') }}" class="text-gold fw-bold text-decoration-none">SIGN UP NOW</a>
                    </p>
                </div>
            </form>
        </div>
    </div>
</div>
{% endblock %}