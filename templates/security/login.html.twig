{% extends 'base.html.twig' %}

{% block title %}Sign In — ServiceHub Luxury Portal{% endblock %}

{% block stylesheets %}
<style>
    html { scroll-behavior: smooth; }

    .portal-wrapper {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        position: relative;
        padding: clamp(1.5rem, 4vw, 2.5rem);
        box-sizing: border-box;
    }

    .portal-card {
        width: 100%;
        max-width: 1050px;
        display: grid;
        grid-template-columns: 1.2fr 1fr;
        background: var(--glass-bg);
        backdrop-filter: blur(var(--glass-blur));
        -webkit-backdrop-filter: blur(var(--glass-blur));
        border: 1px solid var(--glass-border);
        border-radius: 28px;
        overflow: hidden;
        position: relative;
        z-index: 10;
        box-shadow: var(--shadow-elevated);
    }

    .portal-visual {
        background-size: cover;
        background-position: center;
        position: relative;
        padding: 60px;
        display: flex;
        flex-direction: column;
        justify-content: flex-end;
        border-radius: 28px 0 0 28px;
        overflow: hidden;
    }
    .portal-visual::after {
        content: ''; position: absolute; inset: 0;
        background: linear-gradient(to top, rgba(15, 23, 42, 0.9) 0%, rgba(15, 23, 42, 0.3) 60%, transparent 100%);
    }
    .visual-content { position: relative; z-index: 10; }
    .visual-content h2, .visual-content p { color: #ffffff !important; }
    .visual-content .text-gold { color: #bae6fd !important; }

    .portal-form-side {
        padding: 56px 52px;
        background: rgba(255, 255, 255, 0.7);
        backdrop-filter: blur(10px);
    }

    .input-label {
        font-size: 0.65rem;
        font-weight: 800;
        color: var(--color-on-surface-variant);
        text-transform: uppercase;
        letter-spacing: 0.15em;
        margin-bottom: 8px;
        display: block;
    }

    .auth-input {
        width: 100%;
        background: rgba(255, 255, 255, 0.6);
        border: 1px solid var(--glass-border);
        border-radius: 12px;
        padding: 14px 18px;
        color: var(--color-on-surface);
        font-size: 0.9rem;
        transition: all 0.3s var(--ease-luxury);
        margin-bottom: 20px;
        font-family: 'Outfit', sans-serif;
    }
    .auth-input:focus {
        background: rgba(255, 255, 255, 0.9);
        border-color: var(--color-primary);
        outline: none;
        box-shadow: 0 0 0 4px rgba(14, 165, 233, 0.12);
    }
    .auth-input::placeholder { color: #94a3b8; }

    .portal-form-side h3, .portal-form-side p, .portal-form-side label {
        color: var(--color-on-surface) !important;
    }
    .link-accent { color: var(--color-primary); font-weight: 700; text-decoration: none; }
    .link-accent:hover { color: var(--color-secondary); }

    .submit-btn {
        width: 100%;
        background: linear-gradient(135deg, var(--color-primary), var(--color-secondary));
        color: #ffffff;
        border: none;
        border-radius: 50px;
        padding: 14px;
        font-size: 0.85rem;
        font-weight: 700;
        letter-spacing: 0.05em;
        cursor: pointer;
        transition: all 0.3s var(--ease-luxury);
        box-shadow: 0 8px 25px rgba(14,165,233,0.25);
    }
    .submit-btn:hover { transform: translateY(-2px); box-shadow: 0 12px 30px rgba(14,165,233,0.35); }

    @media (max-width: 992px) {
        .portal-card { grid-template-columns: 1fr; max-width: 480px; }
        .portal-visual { display: none; }
        .portal-form-side { padding: 40px 36px; border-radius: 28px; }
    }
</style>
{% endblock %}

{% block body %}
<div class="portal-wrapper">
    
    <div class="portal-card animate-fade-in">
        {# ── LEFT: VISUAL ── #}
        <div class="portal-visual" style="background-image: url('https://images.unsplash.com/photo-1600607687920-4e2a09cf159d?q=80&w=1200&auto=format&fit=crop');">
            <div class="visual-content">
                <span class="text-gold text-xs fw-800 letter-spacing-2 mb-3 d-block" style="text-shadow: 0 0 10px rgba(56, 189, 248, 0.5);">WELCOME BACK</span>
                <h2 class="luxury-serif text-pure mb-4" style="font-size: 2.3rem; text-shadow: 0 4px 15px rgba(255, 255, 255, 0.3);">Sign in to<br>continue with ServiceHub.</h2>
                <p class="text-silver mb-0" style="max-width: 350px;">Access your bookings, services and history in one place.</p>
            </div>
        </div>

        {# ── RIGHT: THE SECURE TERMINAL ── #}
        <div class="portal-form-side">
            <div class="text-center mb-5">
                <a href="{{ path('app_home') }}" class="text-decoration-none h3 mb-1 d-block fw-800" style="color: var(--color-on-surface); font-family: Outfit, sans-serif;">Service<span style="color: var(--color-primary); font-style: italic;">Hub</span></a>
                <p class="text-xs fw-bold letter-spacing-1 mb-1" style="color: var(--color-on-surface-variant);">Sign in to your account</p>
                <p class="text-xxs mb-0" style="color: #94a3b8;">Use your email and password to continue.</p>
            </div>

            {% if error %}
                <div class="glass-card mb-4 p-3 d-flex align-items-center gap-3" style="border-left: 2px solid #ef4444 !important; background: rgba(239, 68, 68, 0.05); box-shadow: none;">
                    <i class="fas fa-shield-halved text-red fs-5"></i>
                    <div class="text-xs text-pure fw-bold">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
                </div>
            {% endif %}

            <form method="post">
                <div class="mb-4">
                    <label class="input-label">Identity (Email)</label>
                    <input type="email" name="email" value="{{ last_username }}" class="auth-input" placeholder="representative@domain.com" required autofocus>
                </div>

                <div class="mb-4">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <label class="input-label mb-0">Password</label>
                        <a href="#" class="text-xxs link-accent">Forgot password?</a>
                    </div>
                    <input type="password" name="password" class="auth-input" placeholder="••••••••" required>
                </div>

                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                <div class="mb-4 d-flex align-items-center gap-3">
                    <input type="checkbox" name="_remember_me" id="rememberMe" class="form-check-input" style="border-color: #cbd5e1; width:18px; height:18px;">
                    <label class="text-xs fw-600 cursor-pointer" for="rememberMe" style="color: var(--color-on-surface-variant);">Remember me on this device</label>
                </div>

                <button class="submit-btn mb-4" type="submit">
                    Sign In <i class="fas fa-arrow-right ms-2"></i>
                </button>

                <div class="text-center">
                    <p class="text-xs mb-0" style="color: var(--color-on-surface-variant);">
                        New here? <a href="{{ path('app_register') }}" class="link-accent">Create an account</a>
                    </p>
                </div>
            </form>
        </div>
    </div>
</div>
{% endblock %}