{% extends 'base.html.twig' %}

{% block title %}Authenticate Node - ServiceHub{% endblock %}

{% block stylesheets %}
<style>
    /* ── SPATIAL AUTHENTICATION TERMINAL ── */
    html { scroll-behavior: smooth; background-color: #05070a; }

    .portal-wrapper {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        position: relative;
        padding: 2rem 1rem;
        box-sizing: border-box;
    }

    .cyber-grid-bg {
        position: absolute; inset: 0;
        background: radial-gradient(circle at bottom left, rgba(157, 124, 255, 0.05) 0%, #05070a 100%);
        z-index: 0;
    }

    .portal-card {
        width: 100%;
        max-width: 1100px;
        display: grid;
        grid-template-columns: 1.2fr 1fr;
        background: rgba(10, 15, 25, 0.6);
        backdrop-filter: blur(30px);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 32px;
        overflow: hidden;
        position: relative;
        z-index: 10;
        box-shadow: 0 40px 100px rgba(0,0,0,0.6);
    }

    /* ── LEFT: HOLOGRAPHIC VISUAL ── */
    .portal-visual {
        background: linear-gradient(135deg, rgba(0, 0, 0, 0.8), rgba(10, 15, 25, 0.9)), 
                    url('https://images.unsplash.com/photo-1550751827-4bd374c3f58b?q=80&w=1200&auto=format&fit=crop');
        background-size: cover;
        background-position: center;
        background-blend-mode: overlay;
        position: relative;
        padding: 60px;
        display: flex;
        flex-direction: column;
        justify-content: center;
        border-right: 1px solid rgba(255, 255, 255, 0.05);
    }
    
    .portal-visual::before {
        content: ''; position: absolute; inset: 0;
        background: radial-gradient(circle at 30% 50%, rgba(0, 255, 213, 0.15) 0%, transparent 60%);
        pointer-events: none;
    }

    /* ── RIGHT: SECURE TERMINAL ── */
    .portal-form-side {
        padding: 60px 50px;
        display: flex;
        flex-direction: column;
        justify-content: center;
    }

    .input-label-spatial {
        font-size: 0.65rem;
        font-weight: 900;
        color: var(--text-dim);
        text-transform: uppercase;
        letter-spacing: 2px;
        margin-bottom: 10px;
        display: block;
    }

    .cyber-input {
        width: 100%;
        background: rgba(255, 255, 255, 0.03) !important;
        border: 1px solid rgba(255, 255, 255, 0.1) !important;
        border-radius: 12px !important;
        padding: 16px 20px !important;
        color: #fff !important;
        transition: all 0.3s var(--ease-spatial);
        margin-bottom: 24px;
    }
    
    .cyber-input:focus {
        border-color: var(--accent-teal) !important;
        background: rgba(0, 255, 213, 0.02) !important;
        box-shadow: 0 0 20px rgba(0, 255, 213, 0.1) !important;
        outline: none;
    }
    .cyber-input::placeholder { color: rgba(255,255,255,0.2) !important; }

    /* Custom Checkbox */
    .form-check-input {
        background-color: rgba(255,255,255,0.1);
        border-color: rgba(255,255,255,0.2);
        width: 1.2rem; height: 1.2rem;
        cursor: pointer;
    }
    .form-check-input:checked {
        background-color: var(--accent-teal);
        border-color: var(--accent-teal);
        box-shadow: 0 0 10px var(--accent-teal);
    }

    /* Telemetry Error */
    .alert-spatial-error {
        display: flex; align-items: flex-start; gap: 12px;
        padding: 16px; border-radius: 12px;
        font-size: 0.8rem; font-weight: 600;
        margin-bottom: 24px;
        background: rgba(255, 93, 115, 0.05);
        border: 1px solid rgba(255, 93, 115, 0.2);
        color: #ff5d73;
        position: relative;
        overflow: hidden;
    }
    .alert-spatial-error::before {
        content: ''; position: absolute; left: 0; top: 0; bottom: 0; width: 3px;
        background: #ff5d73; box-shadow: 0 0 15px #ff5d73;
    }

    @media (max-width: 992px) {
        .portal-card { grid-template-columns: 1fr; max-width: 500px; }
        .portal-visual { display: none; }
        .portal-form-side { padding: 40px 30px; }
    }
</style>
{% endblock %}

{% block body %}
<div class="portal-wrapper reveal-3d">
    <div class="cyber-grid-bg"></div>
    
    <div class="portal-card border-glow-hover text-start">
        
        {# ── LEFT: HOLOGRAPHIC VISUAL ── #}
        <div class="portal-visual">
            <div class="position-relative z-index-10">
                <span class="text-xxs text-teal fw-900 letter-spacing-4 mb-3 d-block">SECURE CONNECTION</span>
                <h2 class="luxury-serif text-white mb-4" style="font-size: 2.8rem; line-height: 1.1;">Re-establish<br>network uplink.</h2>
                <p class="text-dim mb-0" style="max-width: 350px; font-size: 0.95rem; line-height: 1.6;">
                    Access your active missions, secure comms, and telemetry data from your central hub.
                </p>
            </div>
        </div>

        {# ── RIGHT: THE SECURE TERMINAL ── #}
        <div class="portal-form-side">
            <div class="mb-5">
                <h3 class="luxury-serif text-white h3 mb-1">Authenticate</h3>
                <p class="text-xxs text-dim fw-900 letter-spacing-2 mb-0">IDENTITY VERIFICATION REQUIRED</p>
            </div>

            {% if error %}
                <div class="alert-spatial-error">
                    <i class="fas fa-shield-halved mt-1"></i>
                    <span>{{ error.messageKey|trans(error.messageData, 'security') }}</span>
                </div>
            {% endif %}

            <form method="post" class="spatial-form">
                <div class="mb-4">
                    <label class="input-label-spatial">Establishment ID (Email)</label>
                    <input type="email" name="email" value="{{ last_username }}" class="cyber-input" placeholder="node@server.com" required autofocus>
                </div>

                <div class="mb-4">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <label class="input-label-spatial mb-0">Security Cipher (Password)</label>
                        <a href="#" class="text-xxs text-teal fw-900 text-decoration-none letter-spacing-1" style="transition: 0.3s;">RECOVER CIPHER</a>
                    </div>
                    <input type="password" name="password" class="cyber-input" placeholder="••••••••" required>
                </div>

                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                <div class="mb-5 d-flex align-items-center gap-3 bg-surface p-3 rounded-3 border-glass">
                    <input type="checkbox" name="_remember_me" id="rememberMe" class="form-check-input m-0">
                    <label class="text-xxs text-dim fw-900 letter-spacing-1 cursor-pointer m-0" for="rememberMe">
                        MAINTAIN PERSISTENT UPLINK
                    </label>
                </div>

                <button class="btn-luxury w-100 py-4 mb-4" type="submit" style="font-size: 0.85rem;">
                    INITIALIZE SESSION <i class="fas fa-arrow-right ms-2"></i>
                </button>

                <div class="text-center pt-4 border-top border-white border-opacity-5">
                    <p class="text-xs text-dim fw-800 mb-0">
                        UNREGISTERED NODE? 
                        <a href="{{ path('app_register') }}" class="text-teal text-decoration-none ms-2 letter-spacing-1">INITIALIZE NEW ACCOUNT</a>
                    </p>
                </div>
            </form>
        </div>
    </div>
</div>
{% endblock %}
