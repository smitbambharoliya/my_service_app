{% extends 'base.html.twig' %}

{% block title %}Collection — ServiceHub Digital Heritage{% endblock %}

{% block stylesheets %}
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"/>
<style>
    body { background: var(--bg-deep); }

    .collection-header {
        padding: 140px 0 80px;
        background: radial-gradient(circle at top right, rgba(212, 175, 55, 0.05), transparent 60%),
                    radial-gradient(circle at bottom left, rgba(16, 185, 129, 0.03), transparent 60%);
        border-bottom: 1px solid var(--glass-border);
    }

    .explorer-layout {
        display: grid;
        grid-template-columns: 320px 1fr;
        gap: 60px;
        padding: 80px 0;
    }

    /* Sidebar */
    .sidebar-atelier { position: sticky; top: 120px; height: fit-content; }
    .filter-group { margin-bottom: 45px; }
    .filter-label { font-size: 0.6rem; font-weight: 800; color: var(--text-dim); text-transform: uppercase; letter-spacing: 0.25em; margin-bottom: 25px; display: block; }

    /* Cards & Breeze Preview */
    .exhibit-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(360px, 1fr)); gap: 40px; }
    
    .exhibit-card {
        background: rgba(255,255,255,0.02);
        border: 1px solid var(--glass-border);
        border-radius: 24px;
        overflow: hidden;
        transition: all 0.6s var(--ease-luxury);
        position: relative;
    }

    .exhibit-image-box {
        height: 240px;
        position: relative;
        overflow: hidden;
    }
    .exhibit-image {
        width: 100%; height: 100%;
        object-fit: cover;
        transition: transform 1.2s var(--ease-luxury);
    }
    .exhibit-card:hover .exhibit-image { transform: scale(1.1); }

    /* Breeze Preview Overlay */
    .breeze-preview {
        position: absolute;
        inset: 0;
        background: rgba(10, 14, 22, 0.85);
        backdrop-filter: blur(10px);
        opacity: 0;
        visibility: hidden;
        transition: all 0.4s var(--ease-luxury);
        display: flex;
        flex-direction: column;
        justify-content: center;
        padding: 40px;
        z-index: 20;
    }
    .exhibit-card:hover .breeze-preview { opacity: 1; visibility: visible; }

    .breeze-stat { border-left: 2px solid var(--accent-gold); padding-left: 15px; margin-bottom: 20px; }
    .breeze-stat .label { font-size: 0.6rem; font-weight: 800; color: var(--text-dim); text-transform: uppercase; }
    .breeze-stat .value { font-family: 'Playfair Display', serif; color: var(--text-pure); font-size: 1.1rem; }

    /* Map View */
    #mapContainer { width: 100%; height: 750px; border-radius: 30px; border: 1px solid var(--glass-border); overflow: hidden; display: none; }

    @media (max-width: 1100px) {
        .explorer-layout { grid-template-columns: 1fr; }
        .sidebar-atelier { position: static; margin-bottom: 60px; }
    }
</style>
{% endblock %}

{% block body %}
<section class="collection-header">
    <div class="container fade-up">
        <div class="d-flex justify-content-between align-items-end flex-wrap gap-5">
            <div class="max-w-600">
                <span class="text-gold text-xxs fw-800 letter-spacing-3 mb-3 d-block">PROCURREMENT PORTFOLIO</span>
                <h1 class="luxury-serif text-pure mb-4" style="font-size: clamp(2.5rem, 5vw, 4rem);">The Archive</h1>
                <p class="text-silver text-lg opacity-70">{{ services|length }} bespoke technical protocols currently available for reservation.</p>
            </div>
            
            <div class="luxury-toggle">
                <div class="toggle-node active" id="btn-grid" onclick="toggleView('grid')">GALLERY</div>
                <div class="toggle-node" id="btn-map" onclick="toggleView('map')">CARTOGRAPHY</div>
            </div>
        </div>
    </div>
</section>

<div class="container explorer-layout fade-up">
    {# ── SIDEBAR ── #}
    <aside class="sidebar-atelier">
        <div class="glass-card p-5" style="border-radius: 30px;">
            <form action="{{ path('app_service_list') }}" method="GET" id="filterForm">
                <div class="filter-group">
                    <label class="filter-label">Sector Category</label>
                    {% set cats = ['All Services', 'Structural', 'Electrical', 'Sanitization', 'Climate', 'Carpentry', 'Aesthetics'] %}
                    <div class="d-grid gap-3">
                        {% for cat in cats %}
                            <label class="d-flex align-items-center gap-3 cursor-pointer group">
                                <input type="radio" name="category" value="{{ cat }}" onchange="this.form.submit()" 
                                    class="d-none" {{ (active_category == cat) or (active_category is empty and cat == 'All Services') ? 'checked' : '' }}>
                                <div class="p-1 rounded-circle border transition-all {{ (active_category == cat) or (active_category is empty and cat == 'All Services') ? 'border-gold' : 'border-glass' }}" style="width:18px; height:18px; display:flex; align-items:center; justify-content:center;">
                                    <div class="rounded-circle {{ (active_category == cat) or (active_category is empty and cat == 'All Services') ? 'bg-gold' : '' }}" style="width:8px; height:8px;"></div>
                                </div>
                                <span class="text-xs transition-all {{ (active_category == cat) or (active_category is empty and cat == 'All Services') ? 'text-pure fw-bold' : 'text-dim group-hover:text-silver' }}">{{ cat|upper }}</span>
                            </label>
                        {% endfor %}
                    </div>
                </div>

                <div class="filter-group">
                    <label class="filter-label">Capital Threshold</label>
                    <select name="price" class="luxury-input py-3" onchange="this.form.submit()" style="font-size: 0.75rem;">
                        <option value="">Full Range</option>
                        <option value="Under ₹1,000" {{ active_price == 'Under ₹1,000' ? 'selected' : '' }}>Entry (< ₹1k)</option>
                        <option value="₹1,000 - ₹5,000" {{ active_price == '₹1,000 - ₹5,000' ? 'selected' : '' }}>Executive (₹1k - 5k)</option>
                        <option value="₹5,000+" {{ active_price == '₹5,000+' ? 'selected' : '' }}>Imperial (₹5k+)</option>
                    </select>
                </div>

                <a href="{{ path('app_service_list') }}" class="btn-outline-luxury w-100 text-center py-3" style="font-size:0.65rem;">PURGE FILTERS</a>
            </form>
        </div>
    </aside>

    {# ── MAIN COLLECTION ── #}
    <main>
        <div id="gridContainer" class="exhibit-grid">
            {% for svc in services %}
                <div class="exhibit-card" style="animation-delay: {{ loop.index0 * 0.1 }}s;">
                    <div class="exhibit-image-box">
                        <img src="https://images.unsplash.com/photo-1581578731548-c64695cc6952?q=80&w=600&auto=format&fit=crop" class="exhibit-image" alt="Exhibit">
                        <div class="exhibit-tier p-3">
                            <div class="tier-badge tier-gold">{{ svc.provider.tier|upper }}</div>
                        </div>

                        {# Breeze Preview #}
                        <div class="breeze-preview">
                            <div class="text-gold text-xxs fw-800 letter-spacing-2 mb-4">BREEZE PREVIEW</div>
                            <div class="breeze-stat">
                                <div class="label">Reliability</div>
                                <div class="value">98.4% Success Rate</div>
                            </div>
                            <div class="breeze-stat">
                                <div class="label">Response Time</div>
                                <div class="value">Avg. 45 Minutes</div>
                            </div>
                            <div class="breeze-stat">
                                <div class="label">Historical Log</div>
                                <div class="value">124 Missions Logged</div>
                            </div>
                            <a href="{{ path('app_service_show', {'id': svc.id}) }}" class="btn-luxury py-2 text-xxs mt-2">SECURE FULL MANIFEST</a>
                        </div>
                    </div>
                    
                    <div class="p-4 pt-5">
                        <div class="d-flex justify-content-between align-items-start mb-4">
                            <div>
                                <h3 class="luxury-serif text-pure mb-2" style="font-size: 1.5rem;">{{ svc.title }}</h3>
                                <span class="badge-status {{ loop.index is odd ? 'status-active' : 'status-pending' }}">{{ svc.category|upper }}</span>
                            </div>
                            <div class="text-end">
                                <div class="text-pure h4 mb-0 fw-800">₹{{ svc.price|number_format }}</div>
                                <div class="text-xxs text-dim fw-bold">BASE RESERVE</div>
                            </div>
                        </div>
                        
                        <div class="d-flex align-items-center justify-content-between pt-4" style="border-top: 1px solid var(--glass-border);">
                            <div class="d-flex align-items-center gap-3">
                                <div class="user-orb" style="width:32px; height:32px; font-size:0.7rem;">
                                    {{ svc.provider.fullName|slice(0,1)|upper }}
                                </div>
                                <div>
                                    <div class="text-xxs text-dim fw-800 mb-0">ARTISAN</div>
                                    <div class="text-xs text-pure fw-bold mt-n1">{{ svc.provider.fullName }}</div>
                                </div>
                            </div>
                            <a href="{{ path('app_service_show', {'id': svc.id}) }}" class="btn-outline py-2 px-3" style="font-size: 0.6rem;">EXAMINE</a>
                        </div>
                    </div>
                </div>
            {% else %}
                <div class="col-12 py-5 text-center">
                    <div class="glass-card py-5 border-dashed">
                        <i class="fas fa-search-minus text-dim mb-4" style="font-size: 3.5rem; opacity: 0.3;"></i>
                        <h4 class="luxury-serif text-silver">Archive Records Void</h4>
                        <p class="text-dim">Our curators are currently cataloging new protocols. Adjust your sensors.</p>
                        <a href="{{ path('app_service_list') }}" class="btn-luxury mt-4">RESET SENSORS</a>
                    </div>
                </div>
            {% endfor %}
        </div>

        <div id="mapContainer"></div>
    </main>
</div>
{% endblock %}

{% block javascripts %}
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script>
    let map = null;

    function initMap() {
        if(map) return;
        map = L.map('mapContainer', { zoomControl: false, attributionControl: false }).setView([21.1702, 72.8311], 13);
        L.tileLayer('https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png', { maxZoom: 20 }).addTo(map);

        const goldIcon = L.divIcon({
            className: 'custom-div-icon',
            html: `<div style="background: var(--accent-teal); width: 14px; height: 14px; border-radius: 50%; border: 3px solid #FFF; box-shadow: 0 0 15px var(--accent-teal-glow);"></div>`,
            iconSize: [14, 14]
        });

        {% for svc in services %}
            var lat = 21.1702 + (Math.random() - 0.5) * 0.08;
            var lng = 72.8311 + (Math.random() - 0.5) * 0.08;
            L.marker([lat, lng], {icon: goldIcon}).addTo(map)
                .bindPopup(`
                    <div class="glass-card p-3" style="background:#0a0e16; min-width:200px; border:1px solid var(--glass-border);">
                        <div class="text-gold text-xxs fw-800 mb-1">{{ svc.category|upper }}</div>
                        <div class="text-pure fw-bold mb-3">{{ svc.title|escape('js') }}</div>
                        <div class="d-flex justify-content-between align-items-center">
                            <div class="h6 text-pure mb-0">₹{{ svc.price }}</div>
                            <a href="{{ path('app_service_show', {'id': svc.id}) }}" class="text-teal text-xxs fw-800 text-decoration-none">EXAMINE PROTOCOL</a>
                        </div>
                    </div>
                `, { closeButton: false });
        {% endfor %}
    }

    function toggleView(view) {
        document.getElementById('btn-grid').classList.toggle('active', view === 'grid');
        document.getElementById('btn-map').classList.toggle('active', view === 'map');
        const grid = document.getElementById('gridContainer');
        const mapDiv = document.getElementById('mapContainer');
        if(view === 'map') {
            grid.style.display = 'none';
            mapDiv.style.display = 'block';
            initMap();
            setTimeout(() => { map.invalidateSize(); }, 200);
        } else {
            grid.style.display = 'grid';
            mapDiv.style.display = 'none';
        }
    }
</script>
{% endblock %}

