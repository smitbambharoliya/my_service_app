{% extends 'base.html.twig' %}

{% block title %}All Services{% endblock %}

{% block body %}
<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div class="d-flex align-items-center gap-3">
            <a href="{{ path('app_home') }}" class="btn btn-outline-secondary rounded-circle" style="width: 40px; height: 40px; display: flex; align-items: center; justify-content: center;" title="Go to Home">
                <i class="fas fa-home"></i>
            </a>
            <h1 class="text-primary fw-bold mb-0">Available Services</h1>
        </div>
        {% if is_granted('ROLE_PROVIDER') %}
            {% if app.user.services|length == 0 %}
                <a href="{{ path('app_provider_onboarding') }}" class="btn btn-success rounded-pill px-4 shadow-sm">
                    <i class="fas fa-route me-1"></i> Start provider setup
                </a>
            {% else %}
                <a href="{{ path('app_service_new') }}" class="btn btn-success rounded-pill px-4 shadow-sm">
                    <i class="fas fa-plus me-1"></i> Add My Service
                </a>
            {% endif %}
        {% endif %}
    </div>

    <div class="row">
        {# Loop ahiya thi sharu thay che #}
        {% for service in services %}
            <div class="col-md-4 mb-4">
                <div class="card h-100 {{ service.isPremium ? 'border-warning shadow-lg' : 'border-light shadow-sm' }} rounded-4">
                    
                    {% if service.isPremium %}
                        <div class="card-header bg-warning text-dark text-center fw-bold small">
                            ⭐ PREMIUM PARTNER
                        </div>
                    {% endif %}

                    <div class="card-body p-4">
                        {# AA LINE LOOP NI ANDAR J HOVI JOIE #}
                        <a href="{{ path('app_service_show', {id: service.id}) }}" class="text-decoration-none text-dark d-block">
                            <h5 class="card-title fw-bold text-uppercase">
                                {{ service.title }}
                                {% if service.isPremium %}
                                    <span class="badge bg-warning text-dark ms-2" title="Verified Provider">
                                        <i class="fas fa-star"></i> Verified
                                    </span>
                                {% endif %}
                            </h5>
                        </a>
                        
                        <h6 class="card-subtitle mb-3 text-muted">Category: {{ service.category.name }}</h6>
                        <p class="card-text text-muted small">{{ service.description }}</p>
                        <hr>
                        <div class="d-flex justify-content-between align-items-center mt-3">
                            <span class="h5 text-success mb-0 fw-bold">₹{{ service.price }}</span>
                            <a href="{{ path('app_service_book', {id: service.id}) }}" class="btn btn-outline-primary btn-sm rounded-pill px-3">Book Now</a>
                        </div>
                    </div>
                </div>
            </div>
        {% else %}
            <div class="col-12 text-center py-5">
                <div class="alert alert-info rounded-4 p-5 shadow-sm">
                    <i class="fas fa-search fa-3x mb-3 opacity-25"></i>
                    <h4>No services available yet.</h4>
                </div>
            </div>
        {% endfor %}
        {# Loop ahiya khatam thay che #}
    </div>
</div>
{% endblock %}