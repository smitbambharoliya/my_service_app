{% extends 'base.html.twig' %}

{% block title %}{{ service.title }} | Service Details{% endblock %}

{% block body %}
<section class="py-5" style="background: linear-gradient(180deg, #f8fbff 0%, #eef4ff 100%);">
    <div class="container">
        <nav aria-label="breadcrumb" class="mb-4">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a href="{{ path('app_home') }}" class="text-decoration-none">Home</a></li>
                <li class="breadcrumb-item"><a href="{{ path('app_service_list') }}" class="text-decoration-none">Services</a></li>
                <li class="breadcrumb-item active" aria-current="page">{{ service.title }}</li>
            </ol>
        </nav>

        <div class="row g-4 align-items-stretch">
            <div class="col-lg-7">
                <div class="card border-0 shadow-sm rounded-4 overflow-hidden h-100">
                    <div class="service-hero-image">
                        {% if service.image %}
                            <img src="{{ asset('uploads/services/' ~ service.image) }}" alt="{{ service.title }}">
                        {% else %}
                            <img src="https://images.unsplash.com/photo-1581578731548-c64695cc6952?q=80&w=1200&auto=format&fit=crop" alt="{{ service.title }}">
                        {% endif %}
                    </div>
                    <div class="card-body p-4 p-lg-5">
                        <div class="d-flex flex-wrap gap-2 mb-3">
                            <span class="badge rounded-pill text-bg-light border px-3 py-2">{{ service.category.name }}</span>
                            {% if service.isPremium %}
                                <span class="badge rounded-pill text-bg-warning px-3 py-2">Premium</span>
                            {% endif %}
                            <span class="badge rounded-pill text-bg-primary-subtle text-primary-emphasis px-3 py-2">Provider: {{ provider ? provider.tier : 'Verified' }}</span>
                        </div>

                        <div class="d-flex flex-column flex-md-row justify-content-between gap-3 mb-3">
                            <div>
                                <h1 class="fw-bold mb-2" style="color:#0f172a;">{{ service.title }}</h1>
                                <p class="text-muted mb-0">Service ID #{{ service.id }}</p>
                            </div>
                            <div class="text-md-end">
                                <div class="text-muted small text-uppercase fw-semibold">Starting Price</div>
                                <div class="fw-bold" style="font-size:2rem; color:#0f172a;">₹{{ service.price|number_format(2) }}</div>
                            </div>
                        </div>

                        <div class="row g-3 mb-4">
                            <div class="col-sm-4">
                                <div class="stat-chip">
                                    <div class="stat-label">Average Rating</div>
                                    <div class="stat-value">
                                        {% if provider_average_rating is not null %}
                                            {{ provider_average_rating|number_format(1) }}/5
                                        {% else %}
                                            New
                                        {% endif %}
                                    </div>
                                </div>
                            </div>
                            <div class="col-sm-4">
                                <div class="stat-chip">
                                    <div class="stat-label">Completed Jobs</div>
                                    <div class="stat-value">{{ provider_completed_jobs }}</div>
                                </div>
                            </div>
                            <div class="col-sm-4">
                                <div class="stat-chip">
                                    <div class="stat-label">Reviews</div>
                                    <div class="stat-value">{{ provider_review_count }}</div>
                                </div>
                            </div>
                        </div>

                        <h4 class="fw-bold mb-3" style="color:#0f172a;">About This Service</h4>
                        <p class="text-muted mb-0" style="line-height:1.8;">{{ service.description }}</p>
                    </div>
                </div>
            </div>

            <div class="col-lg-5">
                <div class="sticky-top" style="top: 100px;">
                    <div class="card border-0 shadow-sm rounded-4 mb-4">
                        <div class="card-body p-4">
                            <div class="d-flex align-items-center gap-3 mb-4">
                                <div class="provider-avatar">
                                    {{ provider and provider.fullName ? provider.fullName|slice(0, 1)|upper : 'P' }}
                                </div>
                                <div>
                                    <h4 class="fw-bold mb-1" style="color:#0f172a;">{{ provider ? provider.fullName : 'Service Provider' }}</h4>
                                    <div class="text-muted">{{ provider ? provider.tier : 'Verified' }} Provider</div>
                                </div>
                            </div>

                            <h5 class="fw-bold mb-3" style="color:#0f172a;">Provider Details</h5>
                            <div class="detail-list">
                                <div class="detail-row">
                                    <span>City</span>
                                    <strong>{{ provider and provider.city ? provider.city : 'Not added yet' }}</strong>
                                </div>
                                <div class="detail-row">
                                    <span>Mobile</span>
                                    <strong>{{ provider and provider.mobile ? provider.mobile : 'Available after booking' }}</strong>
                                </div>
                                <div class="detail-row">
                                    <span>Joined</span>
                                    <strong>{{ provider and provider.createdAt ? provider.createdAt|date('M Y') : 'Recently' }}</strong>
                                </div>
                                <div class="detail-row">
                                    <span>Active Services</span>
                                    <strong>{{ provider_active_services_count }}</strong>
                                </div>
                            </div>

                            <div class="booking-box mt-4">
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <span class="text-muted fw-semibold">Next Step</span>
                                    <span class="fw-bold" style="color:#0f172a;">Booking Form</span>
                                </div>
                                <p class="text-muted small mb-4">First review the provider profile, past work, and customer feedback below. Then continue to booking.</p>

                                <div class="d-grid gap-2">
                                    {% if is_granted('ROLE_USER') %}
                                        <a href="{{ path('app_service_book', {id: service.id}) }}" class="btn btn-primary btn-lg rounded-3">
                                            <i class="fas fa-calendar-check me-2"></i>Continue to Booking
                                        </a>
                                    {% else %}
                                        <a href="{{ path('app_login') }}" class="btn btn-primary btn-lg rounded-3">
                                            <i class="fas fa-right-to-bracket me-2"></i>Login to Book
                                        </a>
                                    {% endif %}
                                    <a href="{{ path('app_service_list') }}" class="btn btn-outline-secondary rounded-3">
                                        <i class="fas fa-arrow-left me-2"></i>Back to Services
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="card border-0 shadow-sm rounded-4">
                        <div class="card-body p-4">
                            <h5 class="fw-bold mb-3" style="color:#0f172a;">Booking Flow</h5>
                            <ul class="mb-0 text-muted small ps-3" style="line-height:1.8;">
                                <li>Provider's basic details are displayed first.</li>
                                <li>You can view their other services and portfolio.</li>
                                <li>After reviewing customer feedback, you can proceed to the booking page.</li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="py-5 bg-white">
    <div class="container">
        <div class="mb-4">
            <h2 class="fw-bold mb-1" style="color:#0f172a;">Previous Work</h2>
            <p class="text-muted mb-0">Explore other active services and portfolio items from this provider.</p>
        </div>

        <div class="row g-4">
            {% if provider_other_services is not empty %}
                {% for item in provider_other_services %}
                    <div class="col-md-6 col-xl-4">
                        <a href="{{ path('app_service_show', {id: item.id}) }}" class="card border-0 shadow-sm rounded-4 h-100 text-decoration-none overflow-hidden service-work-card">
                            <div class="work-image">
                                {% if item.image %}
                                    <img src="{{ asset('uploads/services/' ~ item.image) }}" alt="{{ item.title }}">
                                {% else %}
                                    <img src="https://images.unsplash.com/photo-1520607162513-77705c0f0d4a?q=80&w=900&auto=format&fit=crop" alt="{{ item.title }}">
                                {% endif %}
                            </div>
                            <div class="card-body p-4">
                                <div class="text-muted small mb-2">{{ item.category.name }}</div>
                                <h5 class="fw-bold mb-2" style="color:#0f172a;">{{ item.title }}</h5>
                                <p class="text-muted small mb-3">{{ item.description|slice(0, 100) }}{% if item.description|length > 100 %}...{% endif %}</p>
                                <div class="d-flex justify-content-between align-items-center">
                                    <strong style="color:#0f172a;">₹{{ item.price|number_format(2) }}</strong>
                                    <span class="text-primary fw-semibold">View service</span>
                                </div>
                            </div>
                        </a>
                    </div>
                {% endfor %}
            {% else %}
                <div class="col-12">
                    <div class="card border-0 shadow-sm rounded-4">
                        <div class="card-body p-4 text-center text-muted">
                            This is the primary service profile for this provider. Additional portfolio items will appear here once added.
                        </div>
                    </div>
                </div>
            {% endif %}
        </div>
    </div>
</section>

<section class="py-5" style="background:#f8fafc;">
    <div class="container">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
            <div>
                <h2 class="fw-bold mb-1" style="color:#0f172a;">Customer Reviews</h2>
                <p class="text-muted mb-0">Recent feedback and ratings received by this provider.</p>
            </div>
            <div class="text-muted">
                {% if provider_average_rating is not null %}
                    <i class="fas fa-star text-warning me-1"></i>{{ provider_average_rating|number_format(1) }} average from {{ provider_review_count }} review{{ provider_review_count == 1 ? '' : 's' }}
                {% else %}
                    No reviews yet
                {% endif %}
            </div>
        </div>

        <div class="row g-4">
            {% if provider_reviews is not empty %}
                {% for review in provider_reviews %}
                    <div class="col-md-6 col-xl-4">
                        <div class="card border-0 shadow-sm rounded-4 h-100">
                            <div class="card-body p-4">
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <div class="review-stars">
                                        {% for i in 1..5 %}
                                            <i class="fa{{ review.rating >= i ? 's' : 'r' }} fa-star"></i>
                                        {% endfor %}
                                    </div>
                                    <span class="text-muted small">{{ review.createdAt|date('d M Y') }}</span>
                                </div>
                                <p class="mb-3 text-muted" style="line-height:1.7;">
                                    {% if review.comment %}
                                        "{{ review.comment }}"
                                    {% else %}
                                        Customer left a rating for this provider.
                                    {% endif %}
                                </p>
                                <div class="fw-semibold" style="color:#0f172a;">{{ review.customer.fullName }}</div>
                            </div>
                        </div>
                    </div>
                {% endfor %}
            {% else %}
                <div class="col-12">
                    <div class="card border-0 shadow-sm rounded-4">
                        <div class="card-body p-4 text-center text-muted">
                            No reviews have been submitted for this provider yet.
                        </div>
                    </div>
                </div>
            {% endif %}
        </div>
    </div>
</section>

<style>
    .service-hero-image {
        height: 360px;
        background: #e2e8f0;
    }

    .service-hero-image img,
    .work-image img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }

    .provider-avatar {
        width: 68px;
        height: 68px;
        border-radius: 50%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, #1d4ed8, #0ea5e9);
        color: white;
        font-size: 1.5rem;
        font-weight: 700;
    }

    .stat-chip {
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 18px;
        padding: 1rem;
        height: 100%;
    }

    .stat-label {
        font-size: 0.75rem;
        font-weight: 700;
        color: #64748b;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        margin-bottom: 0.35rem;
    }

    .stat-value {
        font-size: 1.35rem;
        font-weight: 700;
        color: #0f172a;
    }

    .detail-list {
        display: grid;
        gap: 0.85rem;
    }

    .detail-row {
        display: flex;
        justify-content: space-between;
        gap: 1rem;
        padding-bottom: 0.85rem;
        border-bottom: 1px solid #e2e8f0;
    }

    .detail-row span {
        color: #64748b;
    }

    .detail-row strong {
        color: #0f172a;
        text-align: right;
    }

    .booking-box {
        background: linear-gradient(135deg, #eff6ff 0%, #dbeafe 100%);
        border: 1px solid #bfdbfe;
        border-radius: 20px;
        padding: 1.25rem;
    }

    .work-image {
        height: 220px;
        background: #e2e8f0;
    }

    .service-work-card {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .service-work-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 1rem 2rem rgba(15, 23, 42, 0.08) !important;
    }

    .review-stars {
        color: #f59e0b;
    }
</style>
{% endblock %}
