{% extends 'base.html.twig' %}

{% block title %}{{ service.title }} - Service Details{% endblock %}

{% block body %}
<div class="container py-5">
    <div class="row mb-4 align-items-center">
        <div class="col-md-8">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-2">
                    <li class="breadcrumb-item"><a href="{{ path('app_home') }}" class="text-decoration-none">Home</a></li>
                    <li class="breadcrumb-item"><a href="{{ path('app_service_list') }}" class="text-decoration-none">Services</a></li>
                    <li class="breadcrumb-item"><a href="{{ path('app_book_by_category', {'categoryName': service.category}) }}" class="text-decoration-none">{{ service.category }}</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Details</li>
                </ol>
            </nav>
            <h1 class="fw-bold mb-1">{{ service.title }}</h1>
            <div class="d-flex align-items-center gap-2 mb-3">
                <span class="badge bg-primary text-white px-3 py-2 rounded-pill"><i class="fas fa-tag me-1"></i>{{ service.category }}</span>
                {% if service.isPremium %}
                    <span class="badge bg-warning text-dark px-3 py-2 rounded-pill"><i class="fas fa-star me-1"></i>Premium Service</span>
                {% endif %}
            </div>
        </div>
        <div class="col-md-4 text-md-end mt-3 mt-md-0">
            <a href="{{ path('app_service_list') }}" class="btn btn-outline-secondary rounded-pill px-4">
                <i class="fas fa-arrow-left me-1"></i> Back to Services
            </a>
        </div>
    </div>

    <div class="row g-4">
        {# Left Column: Service Details #}
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
                <div class="bg-light p-5 text-center border-bottom">
                    <div class="display-1 text-primary mb-3">
                        {# Dynamic icon based on category #}
                        {% if service.category|lower == 'plumbing' %}<i class="fas fa-faucet text-primary"></i>
                        {% elseif service.category|lower == 'electrician' %}<i class="fas fa-bolt text-warning"></i>
                        {% elseif service.category|lower == 'carpentry' %}<i class="fas fa-hammer text-danger"></i>
                        {% elseif service.category|lower == 'cleaning' %}<i class="fas fa-broom text-info"></i>
                        {% else %}<i class="fas fa-tools text-secondary"></i>
                        {% endif %}
                    </div>
                </div>
                <div class="card-body p-4 p-md-5">
                    <h4 class="fw-bold border-bottom pb-3 mb-4">About this service</h4>
                    <p class="text-muted lh-lg" style="white-space: pre-line;">{{ service.description }}</p>
                    
                    <h5 class="fw-bold mt-5 mb-3">What's included?</h5>
                    <ul class="list-unstyled text-muted">
                        <li class="mb-2"><i class="fas fa-check text-success me-2"></i> Professional service by a verified expert</li>
                        <li class="mb-2"><i class="fas fa-check text-success me-2"></i> Quality workmanship guaranteed</li>
                        <li class="mb-2"><i class="fas fa-check text-success me-2"></i> Transparent pricing, no hidden fees</li>
                    </ul>
                </div>
            </div>
        </div>

        {# Right Column: Provider & Booking Card #}
        <div class="col-lg-4">
            <div class="card border-0 shadow-lg rounded-4 sticky-top" style="top: 20px;">
                <div class="card-body p-4 p-md-5">
                    <div class="text-center mb-4">
                        <p class="text-muted text-uppercase small fw-bold mb-1">Service Price</p>
                        <h2 class="display-5 fw-bold text-success mb-0">₹{{ service.price }}</h2>
                    </div>

                    <div class="d-grid mb-4">
                        <a href="{{ path('app_service_book', {id: service.id}) }}" class="btn btn-primary btn-lg rounded-pill fw-bold shadow-sm">
                            <i class="fas fa-calendar-check me-2"></i>Book This Service
                        </a>
                    </div>

                    <hr class="my-4">

                    <h6 class="fw-bold mb-3">About the Provider</h6>
                    <div class="d-flex align-items-center">
                        <div class="bg-primary text-white rounded-circle d-flex justify-content-center align-items-center shadow-sm me-3" style="width: 50px; height: 50px; font-size: 20px; font-weight: bold;">
                            {{ service.provider.fullName|default(service.provider.email)|slice(0,1)|upper }}
                        </div>
                        <div>
                            <h6 class="fw-bold mb-0 text-dark">{{ service.provider.fullName|default('Verified Expert') }}</h6>
                            <small class="text-muted">Member Since {{ '2023' }}</small>
                        </div>
                    </div>
                    
                    <div class="mt-4 bg-light p-3 rounded-3 text-center">
                        <small class="text-muted"><i class="fas fa-shield-alt text-success me-1"></i> 100% Secure Booking via ServiceHub</small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    body { background-color: #f8f9fa; }
</style>
{% endblock %}
