{% extends 'base-new.html.twig' %}

{% block title %}Manifest — ServiceHub Spatial Portal{% endblock %}

{% block body %}
<div class="dashboard-container reveal-3d">
    {# ── SPATIAL HEADER ── #}
    <div class="dashboard-header mb-5">
        <div class="text-xxs text-teal fw-900 letter-spacing-3 mb-2">USER OPERATIONAL MANIFEST</div>
        <h1 class="luxury-serif text-white mb-0" style="font-size: 3.5rem;">Manifest<span class="text-teal">.</span></h1>
        <p class="text-dim">Synchronizing personal discovery and mission intelligence.</p>
    </div>

    {# ── BENTO KPI GRID ── #}
    <div class="dashboard-widgets">
        <div class="widget-spatial border-teal-glow">
            <div class="widget-label">Active Expeditions</div>
            <div class="d-flex align-items-end justify-content-between">
                <div class="widget-value text-teal">
                    {{ bookings|filter(b => b.status|lower in ['confirmed', 'pending', 'on-the-way', 'accepted'])|length }}
                </div>
                <div class="status-pulse"></div>
            </div>
            <div class="widget-subtext mt-2">CURRENT LIVE NODES</div>
        </div>

        <div class="widget-spatial border-gold-glow">
            <div class="widget-label">Capital Deployed</div>
            {% set totalSpent = 0 %}
            {% for b in bookings|filter(b => b.status|lower == 'completed') %}
                {% set totalSpent = totalSpent + (b.estimatedCost|default(b.service.price)) %}
            {% endfor %}
            <div class="widget-value text-gold">₹{{ (totalSpent / 100000)|round(1) }}L</div>
            <div class="widget-subtext mt-2">LIFETIME ALLOCATION</div>
        </div>

        <div class="widget-spatial border-purple-glow">
            <div class="widget-label">Identity Tier</div>
            <div class="widget-value text-purple">{{ app.user.tier|upper }}</div>
            <div class="widget-subtext mt-2">{{ app.user.reputationPoints }} FIDELITY POINTS</div>
        </div>
    </div>

    {# ── ANALYTICS & DISCOVERY ROW ── #}
    <div class="dashboard-row">
        <div class="spatial-card-glass p-4">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h3 class="luxury-serif text-white h5 mb-1">Spending Velocity</h3>
                    <span class="text-xxs text-dim fw-800">MONTHLY TELEMETRY</span>
                </div>
                <div class="chart-legend-dot"></div>
            </div>
            <div class="chart-container" style="height: 300px;">
                <canvas id="spendingChart"></canvas>
            </div>
        </div>

        <div class="d-flex flex-column gap-3">
            <div class="spatial-card-glass p-4">
                <h3 class="luxury-serif text-white h6 mb-4">Discovery Hub</h3>
                <div class="discovery-hub">
                    <a href="{{ path('app_service_list') }}" class="discovery-node">
                        <div class="node-icon bg-teal-soft text-teal"><i class="fas fa-compass"></i></div>
                        <div>
                            <div class="fw-bold text-white small">Archive Curation</div>
                            <div class="text-xxs text-dim">Browse Services</div>
                        </div>
                    </a>
                    <a href="{{ path('app_billing_index') }}" class="discovery-node">
                        <div class="node-icon bg-gold-soft text-gold"><i class="fas fa-receipt"></i></div>
                        <div>
                            <div class="fw-bold text-white small">Audit Exchequer</div>
                            <div class="text-xxs text-dim">Financial Records</div>
                        </div>
                    </a>
                </div>
            </div>
            
            <div class="insight-spatial p-4">
                <div class="text-xxs text-purple fw-900 letter-spacing-2 mb-2">HERITAGE INSIGHT</div>
                <p class="text-xs text-dim mb-0 italic">High-tier members receive priority on-site arrivals and exclusive encrypted service packages.</p>
            </div>
        </div>
    </div>

    {# ── SESSION LOGS ── #}
    <div class="mt-5">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="luxury-serif text-white h4 m-0">Protocol Logs</h2>
            <a href="{{ path('app_service_list') }}" class="btn-outline-luxury py-2 px-4" style="font-size: 0.65rem;">INITIATE PROTOCOL</a>
        </div>

        <div class="row g-4">
            {% if bookings|length > 0 %}
                {% for booking in bookings|slice(0, 4) %}
                    <div class="col-md-6">
                        <div class="protocol-node {{ booking.status|lower }}">
                            <div class="d-flex justify-content-between align-items-start mb-3">
                                <div>
                                    <div class="text-white fw-bold small">{{ booking.service.title }}</div>
                                    <div class="text-xxs text-dim font-monospace">REF: #{{ booking.id|slice(0, 8)|upper }}</div>
                                </div>
                                <span class="badge-status {{ booking.status|lower == 'completed' ? 'status-active' : 'status-pending' }}">
                                    {{ booking.status|upper }}
                                </span>
                            </div>
                            <div class="text-xxs text-dim mb-3">
                                <i class="far fa-clock me-1"></i> {{ booking.bookingDate|date('d M Y') }} • ₹{{ (booking.estimatedCost|default(booking.service.price))|number_format }}
                            </div>
                            <div class="d-flex gap-2">
                                <a href="{{ path('app_booking_detail', {id: booking.id}) }}" class="btn-spatial-mini">DETAIL</a>
                                {% if booking.status|lower == 'completed' %}
                                    <a href="{{ path('app_booking_detail', {id: booking.id}) }}" class="btn-spatial-mini text-teal">REVIEW</a>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                {% endfor %}
            {% else %}
                <div class="col-12">
                    <div class="spatial-card-glass p-5 text-center border-dashed">
                        <p class="text-dim m-0">No operational logs found. Initialize your first protocol.</p>
                    </div>
                </div>
            {% endif %}
        </div>
    </div>
</div>

<style>
    /* ── SPATIAL WIDGETS ── */
    .widget-spatial {
        background: rgba(255, 255, 255, 0.02);
        backdrop-filter: blur(20px);
        padding: 25px;
        border-radius: 24px;
        border: 1px solid rgba(255, 255, 255, 0.08);
        transition: all 0.4s var(--ease-spatial);
    }
    .widget-spatial:hover { transform: translateY(-5px); background: rgba(255, 255, 255, 0.04); }
    
    .border-teal-glow:hover { border-color: var(--accent-teal); box-shadow: 0 0 30px rgba(0, 255, 213, 0.1); }
    .border-gold-glow:hover { border-color: var(--accent-gold); box-shadow: 0 0 30px rgba(245, 158, 11, 0.1); }
    .border-purple-glow:hover { border-color: var(--accent-purple); box-shadow: 0 0 30px rgba(157, 124, 255, 0.1); }

    /* ── DISCOVERY NODES ── */
    .discovery-node {
        display: flex; align-items: center; gap: 15px;
        padding: 15px; border-radius: 16px;
        background: rgba(255, 255, 255, 0.02);
        border: 1px solid rgba(255, 255, 255, 0.05);
        text-decoration: none; transition: 0.3s;
    }
    .discovery-node:hover { background: rgba(255, 255, 255, 0.06); transform: translateX(5px); border-color: rgba(255,255,255,0.15); }
    .node-icon { width: 40px; height: 40px; border-radius: 10px; display: flex; align-items: center; justify-content: center; }

    /* ── PROTOCOL NODES ── */
    .protocol-node {
        padding: 20px; border-radius: 20px;
        background: rgba(10, 15, 25, 0.4);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-left: 4px solid var(--accent-teal);
        transition: 0.3s;
    }
    .protocol-node.pending { border-left-color: var(--accent-gold); }
    .protocol-node.cancelled { border-left-color: #ff5d73; }
    .protocol-node:hover { background: rgba(255, 255, 255, 0.03); }

    .btn-spatial-mini {
        font-size: 0.55rem; font-weight: 900; letter-spacing: 1px;
        padding: 5px 12px; border-radius: 6px;
        background: rgba(255,255,255,0.05); color: #94a3b8;
        text-decoration: none; border: 1px solid transparent;
        transition: 0.3s;
    }
    .btn-spatial-mini:hover { background: rgba(255,255,255,0.1); color: #fff; border-color: rgba(255,255,255,0.2); }

    .status-pulse {
        width: 8px; height: 8px; border-radius: 50%;
        background: var(--accent-teal);
        box-shadow: 0 0 12px var(--accent-teal);
        animation: pulse-ring 2s infinite;
    }
    @keyframes pulse-ring { 0% { transform: scale(0.95); opacity: 1; } 50% { transform: scale(1.5); opacity: 0.5; } 100% { transform: scale(0.95); opacity: 1; } }
</style>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    document.addEventListener('DOMContentLoaded', () => {
        const ctx = document.getElementById('spendingChart').getContext('2d');
        const gradient = ctx.createLinearGradient(0, 0, 0, 300);
        gradient.addColorStop(0, 'rgba(0, 255, 213, 0.2)');
        gradient.addColorStop(1, 'rgba(0, 255, 213, 0)');

        new Chart(ctx, {
            type: 'line',
            data: {
                labels: ['JAN', 'FEB', 'MAR', 'APR', 'MAY', 'JUN'],
                datasets: [{
                    data: [2800, 4200, 3100, 4800, 3900, 5600],
                    borderColor: '#00ffd5',
                    backgroundColor: gradient,
                    fill: true,
                    tension: 0.4,
                    borderWidth: 3,
                    pointRadius: 0,
                    pointHoverRadius: 6
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { display: false } },
                scales: {
                    x: { grid: { display: false }, ticks: { color: '#64748b', font: { size: 10, weight: '800' } } },
                    y: { grid: { color: 'rgba(255,255,255,0.03)' }, ticks: { color: '#64748b', font: { size: 10 } } }
                }
            }
        });
    });
</script>
{% endblock %}