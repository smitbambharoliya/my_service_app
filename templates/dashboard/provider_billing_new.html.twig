{% extends 'dashboard_base.html.twig' %}

{% block title %}Draft Ledger — ServiceHub Atelier{% endblock %}
{% block page_title %}Exchequer Constructor{% endblock %}

{% block body %}
<div class="reveal-3d">
    {# ── 1. BIOMETRIC CLIENT SELECTOR ── #}
    <div class="mb-5">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <span class="text-xxs text-teal fw-900 letter-spacing-3">RECOGNIZED IDENTITY NODES</span>
            <span class="text-xxs text-dim fw-800">{{ customers|length }} NODES SYNCED</span>
        </div>
        <div class="client-nodes-scroller pb-2">
            {% for customer in customers %}
                <div class="client-identity-node" onclick="selectIdentity('{{ customer.id }}', this)">
                    <div class="identity-orb">{{ customer.fullName|slice(0,1)|upper }}</div>
                    <div class="identity-meta">
                        <div class="fw-bold text-white text-xxs">{{ customer.fullName|upper }}</div>
                        <div class="text-dim" style="font-size: 0.55rem;">{{ customer.tier|upper }} RANK</div>
                    </div>
                    <div class="node-check"><i class="fas fa-check"></i></div>
                </div>
            {% endfor %}
        </div>
    </div>

    <form action="{{ path('app_provider_billing_new') }}" method="post" class="spatial-form" id="constructor-form">
        <input type="hidden" name="_token" value="{{ csrf_token('create_bill') }}">
        <input type="hidden" name="customer_id" id="target-identity-input" required>

        <div class="row g-4">
            {# ── 2. CONSTRUCTOR PANEL ── #}
            <div class="col-lg-8">
                <div class="glass-card p-5 border-glow-hover h-100">
                    <div class="mb-5">
                        <label class="text-xxs text-dim fw-900 letter-spacing-1 d-block mb-3">PROTOCOL SPHERE</label>
                        <input type="text" name="category" class="cyber-input" placeholder="e.g. Structural Restoration" required>
                    </div>

                    <div class="mb-4">
                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <label class="text-xxs text-teal fw-900 letter-spacing-2">ARTIFACT COMPONENTS</label>
                            <button type="button" class="btn-outline-luxury py-1 px-3" style="font-size:0.65rem;" onclick="addLineItem()">
                                <i class="fas fa-plus me-2"></i> APPEND ITEM
                            </button>
                        </div>
                        
                        <div id="line-items-container" class="d-grid gap-3">
                            <div class="row g-3 line-item align-items-center reveal-3d">
                                <div class="col-md-8">
                                    <input type="text" name="item_name[]" class="cyber-input" placeholder="Artifact Description" required>
                                </div>
                                <div class="col-md-3">
                                    <div class="position-relative">
                                        <span class="position-absolute start-0 top-50 translate-middle-y ps-3 text-teal fw-bold">₹</span>
                                        <input type="number" name="item_amount[]" class="cyber-input ps-5 item-amount" placeholder="0.00" min="1" step="0.01" required oninput="updateTotal()">
                                    </div>
                                </div>
                                <div class="col-md-1 text-center">
                                    <button type="button" class="btn-action-spatial text-red delete-btn" onclick="removeLineItem(this)" disabled>
                                        <i class="fas fa-times"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="mb-0 pt-4">
                        <label class="text-xxs text-dim fw-900 letter-spacing-1 d-block mb-3">EDITORIAL LOG</label>
                        <textarea name="description" class="cyber-input" rows="3" placeholder="Append technical insights for the client..."></textarea>
                    </div>
                </div>
            </div>

            {# ── 3. LIVE HUD SIDEBAR ── #}
            <div class="col-lg-4">
                <div class="glass-card p-4 h-100 d-flex flex-column border-teal-glow">
                    <div class="text-xxs text-dim fw-900 letter-spacing-2 mb-4">SETTLEMENT HUD</div>
                    
                    <div class="p-4 rounded-4 bg-surface-dark border-glass mb-4 text-center">
                        <div class="text-xxs text-dim fw-800 mb-2">ALLOCATED CAPITAL</div>
                        <div class="h1 luxury-serif text-white fw-900 mb-0">
                            <span class="text-teal">₹</span><span id="total-amount-display">0.00</span>
                        </div>
                    </div>

                    <div class="flex-grow-1">
                        <div class="p-3 rounded-4 bg-surface border-glass mb-3">
                            <div class="text-xxxs text-dim fw-900 mb-2">TARGET IDENTITY</div>
                            <div id="selected-client-display" class="text-white small fw-bold">AWAITING SELECTION...</div>
                        </div>
                        <div class="insight-spatial p-3" style="background: rgba(0, 255, 213, 0.03);">
                            <p class="text-xxs text-dim mb-0 italic">Initial settlement transmission triggers a real-time notification to the client's Neural Dashboard.</p>
                        </div>
                    </div>

                    <div class="d-grid gap-2 pt-4">
                        <button type="submit" class="btn-luxury py-3">
                            EXECUTE SETTLEMENT
                        </button>
                        <a href="{{ path('app_provider_dashboard') }}" class="btn-outline-luxury py-3 text-center">
                            ABORT DRAFT
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

<style>
    /* ── CLIENT SELECTOR STYLES ── */
    .client-nodes-scroller { display: flex; gap: 15px; overflow-x: auto; scroll-behavior: smooth; }
    .client-identity-node {
        min-width: 140px; padding: 15px; border-radius: 20px;
        background: rgba(255,255,255,0.02); border: 1px solid rgba(255,255,255,0.08);
        text-align: center; cursor: pointer; transition: 0.4s var(--ease-spatial);
        position: relative;
    }
    .client-identity-node:hover { background: rgba(255,255,255,0.05); border-color: rgba(0,255,213,0.2); }
    .client-identity-node.active { background: rgba(0,255,213,0.1); border-color: var(--accent-teal); }
    
    .identity-orb { width: 40px; height: 40px; border-radius: 12px; background: var(--bg-obsidian); border: 1px solid rgba(255,255,255,0.1); display: flex; align-items: center; justify-content: center; margin: 0 auto 10px; color: var(--accent-teal); font-weight: 900; }
    
    .node-check { position: absolute; top: 10px; right: 10px; font-size: 0.6rem; color: var(--accent-teal); opacity: 0; transform: scale(0); transition: 0.3s; }
    .client-identity-node.active .node-check { opacity: 1; transform: scale(1); }

    .bg-surface-dark { background: rgba(0, 0, 0, 0.3); }
    .border-teal-glow { border-color: rgba(0, 255, 213, 0.2) !important; }
</style>

<script>
    function selectIdentity(id, el) {
        document.querySelectorAll('.client-identity-node').forEach(n => n.classList.remove('active'));
        el.classList.add('active');
        document.getElementById('target-identity-input').value = id;
        document.getElementById('selected-client-display').innerText = el.querySelector('.identity-meta .fw-bold').innerText;
    }

    function addLineItem() {
        const container = document.getElementById('line-items-container');
        const firstItem = container.querySelector('.line-item');
        const newItem = firstItem.cloneNode(true);
        newItem.querySelector('input').value = '';
        newItem.querySelector('.item-amount').value = '';
        container.appendChild(newItem);
        updateItemButtons();
    }
    
    function removeLineItem(btn) {
        const container = document.getElementById('line-items-container');
        if (container.querySelectorAll('.line-item').length > 1) {
            btn.closest('.line-item').remove();
            updateTotal();
            updateItemButtons();
        }
    }
    
    function updateItemButtons() {
        const items = document.querySelectorAll('.line-item');
        items.forEach((item) => {
            const btn = item.querySelector('.delete-btn');
            btn.disabled = items.length === 1;
        });
    }
    
    function updateTotal() {
        let total = 0;
        document.querySelectorAll('.item-amount').forEach(input => {
            const val = parseFloat(input.value);
            if (!isNaN(val)) total += val;
        });
        document.getElementById('total-amount-display').textContent = total.toLocaleString('en-IN', { minimumFractionDigits: 2 });
    }
</script>
{% endblock %}