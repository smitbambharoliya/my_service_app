{% extends 'dashboard_base.html.twig' %}

{% block title %}Draft Ledger — ServiceHub Luxury Dashboard{% endblock %}
{% block page_title %}Draft Ledger{% endblock %}

{% block body %}
<div class="animate-fade-in" style="max-width: 900px; margin: 0 auto;">
    <div class="mb-5">
        <h2 class="luxury-serif text-pure mb-2">Protocol Settlement</h2>
        <p class="text-silver">Generate a refined ledger for a client with custom line-item specificity.</p>
    </div>

    <div class="glass-card p-5">
        <form action="{{ path('app_provider_billing_new') }}" method="post">
            <input type="hidden" name="_token" value="{{ csrf_token('create_bill') }}">

            <div class="mb-5">
                <label class="stat-label mb-3">CLIENT SELECTION</label>
                <select name="customer_id" class="luxury-input" required>
                    <option value="">-- Choose a recognized client --</option>
                    {% for customer in customers %}
                        <option value="{{ customer.id }}">{{ customer.fullName }} ({{ customer.email }})</option>
                    {% else %}
                        <option value="" disabled>No active clients available in this sector.</option>
                    {% endfor %}
                </select>
                <div class="text-xs text-dim mt-2"><i class="fas fa-crown me-2"></i> Only clients with previous protocol history are listed.</div>
            </div>

            <div class="mb-5">
                <label class="stat-label mb-3">SPHERE OF INFLUENCE (CATEGORY)</label>
                <input type="text" name="category" class="luxury-input" placeholder="e.g. Structural Restoration" required>
            </div>

            <div class="mb-5">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <label class="stat-label mb-0">ARTIFACT LINE ITEMS</label>
                    <button type="button" class="btn-outline py-1 px-3" style="font-size:0.7rem;" onclick="addLineItem()">
                        <i class="fas fa-plus me-2"></i> Add Item
                    </button>
                </div>
                
                <div id="line-items-container">
                    <div class="row g-3 mb-3 line-item animate-fade-in">
                        <div class="col-md-8">
                            <input type="text" name="item_name[]" class="luxury-input mb-0" placeholder="Artifact Description" required>
                        </div>
                        <div class="col-md-3">
                            <div class="position-relative">
                                <span class="position-absolute start-0 top-50 translate-middle-y ps-3 text-gold">₹</span>
                                <input type="number" name="item_amount[]" class="luxury-input mb-0 ps-5 item-amount" placeholder="Capital" min="1" step="0.01" required oninput="updateTotal()">
                            </div>
                        </div>
                        <div class="col-md-1">
                            <button type="button" class="bg-transparent border-0 text-danger w-100 h-100 delete-btn" onclick="removeLineItem(this)" disabled>
                                <i class="fas fa-trash-can"></i>
                            </button>
                        </div>
                    </div>
                </div>
                
                <div class="d-flex justify-content-end align-items-center mt-4 pt-4" style="border-top: 1px solid var(--glass-border);">
                    <span class="stat-label me-4">TOTAL SETTLEMENT:</span>
                    <h2 class="luxury-serif text-gold mb-0">₹<span id="total-amount-display">0.00</span></h2>
                </div>
            </div>

            <div class="mb-5">
                <label class="stat-label mb-3">EDITORIAL NOTES</label>
                <textarea name="description" class="luxury-input" rows="3" placeholder="Additional sensory notes or specific details for the client..."></textarea>
            </div>

            <div class="d-flex justify-content-end gap-3 pt-4" style="border-top: 1px solid var(--glass-border);">
                <a href="{{ path('app_provider_dashboard') }}" class="btn-outline py-2 px-4 shadow-none">Retire Draft</a>
                <button type="submit" class="btn-luxury py-2 px-5 shadow-none" {% if customers is empty %}disabled{% endif %}>
                    Generate Ledger <i class="fas fa-arrow-right ms-2"></i>
                </button>
            </div>
        </form>
    </div>
</div>

<script>
    function addLineItem() {
        const container = document.getElementById('line-items-container');
        const firstItem = container.querySelector('.line-item');
        const newItem = firstItem.cloneNode(true);
        
        newItem.querySelector('input').value = '';
        newItem.querySelector('.item-amount').value = '';
        
        container.appendChild(newItem);
        updateItemButtons();
    }
    
    function removeLineItem(btn) {
        const container = document.getElementById('line-items-container');
        if (container.querySelectorAll('.line-item').length > 1) {
            btn.closest('.line-item').remove();
            updateTotal();
            updateItemButtons();
        }
    }
    
    function updateItemButtons() {
        const items = document.querySelectorAll('.line-item');
        items.forEach((item, index) => {
            const btn = item.querySelector('.delete-btn');
            btn.disabled = items.length === 1;
        });
    }
    
    function updateTotal() {
        let total = 0;
        document.querySelectorAll('.item-amount').forEach(input => {
            const val = parseFloat(input.value);
            if (!isNaN(val)) total += val;
        });
        document.getElementById('total-amount-display').textContent = total.toFixed(2);
    }
</script>
{% endblock %}
