{% extends 'dashboard_base.html.twig' %}

{% block title %}Operational Manifest — ServiceHub{% endblock %}
{% block page_title %}Operational Manifest{% endblock %}

{% block body %}
<div class="reveal-3d">
    {# ── BENTO KPI SECTOR ── #}
    <div class="row g-4 mb-5">
        <div class="col-md-4">
            <div class="glass-card p-4 border-glow-hover h-100 d-flex flex-column justify-content-between">
                <div>
                    <div class="text-xxs text-teal fw-900 letter-spacing-2 mb-3">ACTIVE EXPEDITIONS</div>
                    <div class="h1 fw-900 text-white mb-0">{{ bookings|filter(b => b.status|lower in ['confirmed', 'pending', 'on-the-way', 'accepted'])|length }}</div>
                </div>
                <div class="text-xxs text-dim mt-3"><i class="fas fa-satellite-dish animate-pulse me-1"></i> UPLINK ACTIVE</div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="glass-card p-4 border-glow-hover h-100 d-flex flex-column justify-content-between">
                <div>
                    <div class="text-xxs text-dim fw-800 letter-spacing-2 mb-3">CAPITAL DEPLOYED</div>
                    {% set totalSpent = 0 %}
                    {% for b in bookings|filter(b => b.status|lower == 'completed') %}
                        {% set totalSpent = totalSpent + (b.estimatedCost|default(b.service.price)) %}
                    {% endfor %}
                    <div class="h1 fw-900 text-white mb-0">₹{{ (totalSpent / 1000)|round(1) }}k</div>
                </div>
                <div class="text-xxs text-dim mt-3">SETTLED MISSIONS</div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="glass-card p-4 border-glow-hover h-100 d-flex flex-column justify-content-between border-purple-soft">
                <div>
                    <div class="text-xxs text-purple fw-900 letter-spacing-2 mb-3">IDENTITY TIER</div>
                    <div class="h1 fw-900 text-white mb-0">{{ app.user.tier|upper }}</div>
                </div>
                <div class="text-xxs text-dim mt-3">{{ app.user.reputationPoints }} FIDELITY POINTS</div>
            </div>
        </div>
    </div>

    <div class="row g-4 mb-5">
        {# ── SPENDING VELOCITY CORE ── #}
        <div class="col-xl-8">
            <div class="glass-card p-4 h-100">
                <div class="d-flex justify-content-between align-items-center mb-5">
                    <div>
                        <h3 class="luxury-serif text-white h4 mb-1">Expenditure Telemetry</h3>
                        <span class="text-xxs text-dim fw-800">REAL-TIME FINANCIAL TRACKING</span>
                    </div>
                    <div class="status-dot online"></div>
                </div>
                <div style="height: 320px;">
                    <canvas id="spendingVelocityChart"></canvas>
                </div>
            </div>
        </div>

        {# ── COMMAND ACTIONS ── #}
        <div class="col-xl-4">
            <div class="glass-card h-100 p-4 bg-surface-dark">
                <h3 class="luxury-serif text-white h5 mb-4">Command Terminal</h3>
                <div class="d-grid gap-3">
                    <a href="{{ path('app_service_list') }}" class="terminal-link">
                        <div class="node-icon bg-teal-soft text-teal"><i class="fas fa-search-plus"></i></div>
                        <div>
                            <div class="text-white fw-bold small">Synchronize Archive</div>
                            <div class="text-xxs text-dim">Browse Service Inventory</div>
                        </div>
                    </a>
                    <a href="{{ path('app_billing_index') }}" class="terminal-link">
                        <div class="node-icon bg-purple-soft text-purple"><i class="fas fa-vault"></i></div>
                        <div>
                            <div class="text-white fw-bold small">Audit Exchequer</div>
                            <div class="text-xxs text-dim">Financial Settlement Logs</div>
                        </div>
                    </a>
                </div>
                
                <div class="mt-5 p-4 rounded-4 border-glass" style="background: linear-gradient(135deg, rgba(0, 255, 213, 0.05), transparent);">
                    <div class="text-xxs text-teal fw-900 mb-2 letter-spacing-1">SYSTEM INSIGHT</div>
                    <p class="text-xs text-dim mb-0 italic">High-fidelity identities grant access to priority artisan dispatch and encrypted support links.</p>
                </div>
            </div>
        </div>
    </div>

    {# ── MISSION LOGS ── #}
    <div class="mb-5">
        <div class="d-flex align-items-center justify-content-between mb-4">
            <h2 class="luxury-serif text-white">Recent Mission Logs</h2>
            <a href="{{ path('app_service_list') }}" class="btn-luxury py-2 px-4" style="font-size:0.65rem;">NEW INITIALIZATION</a>
        </div>

        <div class="row g-4">
            {% for booking in bookings|slice(0, 4) %}
                <div class="col-xl-6">
                    <div class="glass-card p-0 border-glow-hover overflow-hidden h-100">
                        <div class="p-4 d-flex justify-content-between align-items-start">
                            <div class="d-flex gap-4">
                                <div class="p-3 rounded-4 bg-surface-dark border-glass text-teal">
                                    <i class="fas fa-microchip fs-5"></i>
                                </div>
                                <div>
                                    <h4 class="mb-1 fw-bold text-white small">{{ booking.service.title }}</h4>
                                    <div class="d-flex gap-2">
                                        <span class="badge-tag">{{ booking.service.category.name|upper }}</span>
                                        <span class="badge-tag">{{ booking.bookingType|upper }}</span>
                                    </div>
                                </div>
                            </div>
                            <div class="text-end">
                                {% if booking.status|lower == 'completed' %}
                                    <span class="badge-status status-active">SETTLED</span>
                                {% elseif booking.status|lower == 'pending' %}
                                    <span class="badge-status status-pending">AWAITING</span>
                                {% elseif booking.status|lower == 'on-the-way' %}
                                    <span class="badge-status status-active" style="background:rgba(0,255,213,0.1); color:var(--accent-cyan);">TRANSIT</span>
                                {% else %}
                                    <span class="badge-status status-alert">{{ booking.status|upper }}</span>
                                {% endif %}
                                <div class="text-xxs text-dim mt-2 font-monospace">{{ booking.bookingDate|date('d . m . Y') }}</div>
                            </div>
                        </div>

                        {# Provider Mini Sync #}
                        <div class="px-4 py-3 border-top border-white border-opacity-5" style="background: rgba(0,0,0,0.1);">
                            <div class="d-flex align-items-center justify-content-between">
                                <div class="d-flex align-items-center gap-2">
                                    <div class="user-orb" style="width:24px; height:24px; font-size:0.5rem;">{{ booking.service.provider.fullName|slice(0,1)|upper }}</div>
                                    <div class="text-xxs fw-800 text-dim">ARTISAN: <span class="text-white">{{ booking.service.provider.fullName|upper }}</span></div>
                                </div>
                                {% if booking.status|lower == 'on-the-way' %}
                                    <a href="{{ path('app_booking_track', {'id': booking.id}) }}" class="text-teal text-xxs fw-900 text-decoration-none animate-pulse"><i class="fas fa-location-arrow me-1"></i>TRACK FEED</a>
                                {% endif %}
                            </div>
                        </div>

                        {# Action Row #}
                        <div class="p-4 border-top border-white border-opacity-5 mt-auto">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <div class="text-xxs text-dim fw-800">ALLOCATED</div>
                                    <div class="text-white fw-900 small">₹{{ (booking.estimatedCost|default(booking.service.price))|number_format }}</div>
                                </div>
                                <div class="d-flex gap-2">
                                    <a href="{{ path('app_booking_detail', {id: booking.id}) }}" class="btn-spatial-mini">VIEW MANIFEST</a>
                                    {% if booking.status|lower == 'completed' and not booking.review %}
                                        <a href="{{ path('app_booking_detail', {id: booking.id}) }}" class="btn-spatial-mini text-teal border-teal">LEAVE FEEDBACK</a>
                                    {% endif %}
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    </div>
</div>

<style>
    .bg-surface-dark { background: rgba(0, 0, 0, 0.2); }
    .terminal-link {
        display: flex; align-items: center; gap: 15px; padding: 18px;
        border-radius: 16px; background: rgba(255,255,255,0.02);
        border: 1px solid rgba(255,255,255,0.05); text-decoration: none;
        transition: 0.3s var(--ease-spatial);
    }
    .terminal-link:hover { background: rgba(255,255,255,0.05); transform: translateX(5px); border-color: var(--accent-teal); }
    .node-icon { width: 42px; height: 42px; border-radius: 12px; display: flex; align-items: center; justify-content: center; }
    .badge-tag { font-size: 0.55rem; font-weight: 900; padding: 2px 8px; border-radius: 4px; background: rgba(255,255,255,0.05); color: #64748b; border: 1px solid rgba(255,255,255,0.05); }
    .btn-spatial-mini { font-size: 0.55rem; font-weight: 900; letter-spacing: 1px; padding: 6px 14px; border-radius: 8px; background: rgba(255,255,255,0.03); color: #94a3b8; text-decoration: none; border: 1px solid rgba(255,255,255,0.05); transition: 0.3s; }
    .btn-spatial-mini:hover { color: #fff; background: rgba(255,255,255,0.1); }
</style>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    document.addEventListener('DOMContentLoaded', function() {
        const ctx = document.getElementById('spendingVelocityChart').getContext('2d');
        const gradient = ctx.createLinearGradient(0, 0, 0, 400);
        gradient.addColorStop(0, 'rgba(0, 255, 213, 0.15)');
        gradient.addColorStop(1, 'rgba(0, 255, 213, 0)');

        new Chart(ctx, {
            type: 'line',
            data: {
                labels: ['NOV', 'DEC', 'JAN', 'FEB', 'MAR', 'APR'],
                datasets: [{
                    data: [12000, 8000, 25000, 15000, 32000, 20000],
                    borderColor: '#00ffd5',
                    backgroundColor: gradient,
                    borderWidth: 3,
                    fill: true,
                    tension: 0.4,
                    pointRadius: 0,
                    pointHoverRadius: 6
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { display: false } },
                scales: {
                    y: { grid: { color: 'rgba(255,255,255,0.03)' }, ticks: { color: '#64748B', font: { size: 10 } } },
                    x: { grid: { display: false }, ticks: { color: '#64748B', font: { size: 10, weight: '800' } } }
                }
            }
        });
    });
</script>
{% endblock %}