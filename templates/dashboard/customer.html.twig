{% extends 'dashboard_base.html.twig' %}

{% block title %}Manifest — ServiceHub Heritage{% endblock %}
{% block page_title %}Manifest{% endblock %}

{% block body %}
<div class="animate-fade-in">
    {# ── KPI WIDGETS ── #}
    <div class="widget-grid mb-5">
        <div class="glass-card stat-card customer-accent">
            <div class="stat-label">Active Expeditions</div>
            <div class="stat-value text-gradient">{{ bookings|filter(b => b.status|lower in ['confirmed', 'pending', 'on-the-way', 'accepted'])|length }}</div>
            <div class="text-xs text-dim">CURRENT OPERATIONS</div>
        </div>
        <div class="glass-card stat-card">
            <div class="stat-label">Capital Deployed</div>
            {% set totalSpent = 0 %}
            {% for b in bookings|filter(b => b.status|lower == 'completed') %}
                {% set totalSpent = totalSpent + (b.estimatedCost|default(b.service.price)) %}
            {% endfor %}
            <div class="stat-value text-pure">₹{{ totalSpent|number_format(0) }}</div>
            <div class="text-xs text-dim">LIFETIME EXPENDITURE</div>
        </div>
        <div class="glass-card stat-card admin-accent">
            <div class="stat-label">Member Tier</div>
            <div class="stat-value text-pure">{{ app.user.tier }}</div>
            <div class="text-xs text-dim">{{ app.user.reputationPoints }} REPUTATION POINTS</div>
        </div>
    </div>

    <div class="row g-5 mb-5">
        {# ── SPENDING VELOCITY CHART ── #}
        <div class="col-xl-8">
            <div class="glass-card h-100">
                <div class="d-flex justify-content-between align-items-center mb-5">
                    <div>
                        <h3 class="luxury-serif mb-1">Analytical Ingress</h3>
                        <p class="text-xs text-dim mb-0">MONTHLY CAPEX VELOCITY</p>
                    </div>
                </div>
                <div style="height: 350px;">
                    <canvas id="spendingVelocityChart"></canvas>
                </div>
            </div>
        </div>

        {# ── QUICK DISCOVERY ── #}
        <div class="col-xl-4">
            <div class="glass-card h-100 p-4">
                <h3 class="luxury-serif mb-4">Discovery Hub</h3>
                <div class="d-grid gap-3">
                    <a href="{{ path('app_service_list') }}" class="glass-card p-3 d-flex align-items-center gap-4 text-decoration-none border-0" style="background: rgba(16, 185, 129, 0.05);">
                        <div class="p-3 rounded-circle" style="background: rgba(16, 185, 129, 0.1);"><i class="fas fa-compass text-teal"></i></div>
                        <div>
                            <div class="text-pure fw-bold">Explore Curation</div>
                            <div class="text-xs text-dim">Browse premium services</div>
                        </div>
                    </a>
                    <a href="{{ path('app_billing_index') }}" class="glass-card p-3 d-flex align-items-center gap-4 text-decoration-none border-0" style="background: rgba(245, 158, 11, 0.05);">
                        <div class="p-3 rounded-circle" style="background: rgba(245, 158, 11, 0.1);"><i class="fas fa-receipt text-gold"></i></div>
                        <div>
                            <div class="text-pure fw-bold">Audit Exchequer</div>
                            <div class="text-xs text-dim">Review financial records</div>
                        </div>
                    </a>
                </div>
                <div class="mt-5 p-4 rounded-4" style="background: linear-gradient(135deg, rgba(139, 92, 246, 0.05), transparent); border: 1px solid var(--glass-border);">
                    <div class="fw-bold text-violet mb-2">Heritage Insight</div>
                    <p class="text-xs text-silver">High-tier members receive priority on-site arrivals and exclusive "Aurora Elite" service packages.</p>
                </div>
            </div>
        </div>
    </div>

    {# ── RECENT EXPEDITIONS ── #}
    <div class="mb-5">
        <div class="d-flex align-items-center justify-content-between mb-4">
            <h2 class="luxury-serif">Session Logs</h2>
            <a href="{{ path('app_service_list') }}" class="btn-outline-luxury py-2 px-4 shadow-none" style="font-size:0.7rem;">Initiate Protocol</a>
        </div>

        <div class="row g-4">
            {% for booking in bookings|slice(0, 6) %}
                <div class="col-xl-6">
                    <div class="glass-card p-0 border-0 overflow-hidden">
                        <div class="p-4 d-flex justify-content-between align-items-start">
                            <div class="d-flex gap-4">
                                <div class="p-3 rounded-4" style="background: rgba(255,255,255,0.03); border: 1px solid var(--glass-border);">
                                    <i class="fas fa-microchip text-teal fs-4"></i>
                                </div>
                                <div>
                                    <h4 class="mb-1 fw-bold">{{ booking.service.title }}</h4>
                                    <div class="d-flex gap-2">
                                        <span class="text-xxs text-dim fw-800 border px-2 py-1 rounded-pill">{{ booking.service.category|upper }}</span>
                                        <span class="text-xxs text-dim fw-800 border px-2 py-1 rounded-pill">{{ booking.bookingType|upper }}</span>
                                    </div>
                                </div>
                            </div>
                            <div class="text-end">
                                {% if booking.status|lower == 'completed' %}
                                    <span class="badge-status status-active">COMPLETED</span>
                                {% elseif booking.status|lower == 'pending' %}
                                    <span class="badge-status status-pending">PENDING</span>
                                {% elseif booking.status|lower == 'on-the-way' %}
                                    <span class="badge-status status-active">ON TRANSIT</span>
                                {% else %}
                                    <span class="badge-status {{ booking.status|lower == 'cancelled' ? 'status-alert' : 'status-active' }}">{{ booking.status|upper }}</span>
                                {% endif %}
                                <div class="text-xxs text-dim mt-2">{{ booking.bookingDate|date('d F Y') }}</div>
                            </div>
                        </div>

                        {# Provider Mini Profile #}
                        <div class="px-4 py-3" style="background: rgba(255,255,255,0.02); border-top: 1px solid var(--glass-border);">
                            <div class="d-flex align-items-center justify-content-between">
                                <div class="d-flex align-items-center gap-3">
                                    <div class="user-orb" style="width:28px; height:28px; font-size:0.6rem;">
                                        {{ booking.service.provider.fullName|slice(0,1)|upper }}
                                    </div>
                                    <div class="text-xxs"><span class="text-dim">ARTISAN LEAD:</span> <span class="text-pure fw-bold">{{ booking.service.provider.fullName }}</span></div>
                                </div>
                                {% if booking.status|lower == 'on-the-way' %}
                                    <a href="{{ path('app_booking_track', {'id': booking.id}) }}" class="text-teal text-xxs text-decoration-none fw-800"><i class="fas fa-location-arrow me-2"></i> TRACK NODE</a>
                                {% endif %}
                            </div>
                        </div>

                        {# Footer Actions & Review Logic #}
                        <div class="p-4" style="border-top: 1px solid var(--glass-border);">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <div>
                                    <div class="text-xxs text-dim fw-800">CAPITAL RESERVED</div>
                                    <div class="h5 text-pure fw-800 mb-0">₹{{ (booking.estimatedCost|default(booking.service.price))|number_format }}</div>
                                </div>
                                <div class="d-flex gap-2">
                                    {% if booking.status|lower == 'completed' %}
                                        <a href="{{ path('app_billing_index') }}" class="btn-luxury py-2 px-3" style="font-size:0.6rem;">View Ledger</a>
                                    {% elseif booking.status|lower == 'pending' %}
                                        <form action="{{ path('app_booking_cancel', {'id': booking.id}) }}" method="post" onsubmit="return confirm('Retire this protocol?');">
                                            <button class="bg-transparent border-0 text-red text-xxs fw-bold px-2">Retire Session</button>
                                        </form>
                                    {% endif %}
                                </div>
                            </div>

                            {# Review Section for Completed #}
                            {% if booking.status|lower == 'completed' and not booking.review %}
                                <div class="mt-4 p-3 rounded-4" style="background: rgba(16, 185, 129, 0.03); border: 1px dashed rgba(16, 185, 129, 0.2);">
                                    <div class="text-xxs text-teal fw-800 mb-3">APPRECIATION PROTOCOL REQUIRED</div>
                                    <form action="{{ path('app_customer_add_review', {id: booking.id}) }}" method="POST">
                                        <input type="hidden" name="_token" value="{{ csrf_token('review' ~ booking.id) }}">
                                        <div class="d-flex align-items-center gap-3 mb-3">
                                            <div class="rating-stars d-flex gap-1">
                                                {% for i in 1..5 %}
                                                    <input type="radio" name="rating" value="{{ i }}" id="star-{{ booking.id }}-{{ i }}" class="d-none star-radio" required>
                                                    <label for="star-{{ booking.id }}-{{ i }}" class="fa-solid fa-star text-dim cursor-pointer star-label" data-value="{{ i }}"></label>
                                                {% endfor %}
                                            </div>
                                            <span class="text-xxs text-dim fw-bold rating-text">Select rating</span>
                                        </div>
                                        <div class="d-flex gap-2">
                                            <input type="text" name="comment" class="luxury-input py-2 text-xs" placeholder="Archival comments (optional)..." style="flex: 1;">
                                            <button type="submit" class="btn-luxury py-2 px-3" style="font-size: 0.6rem;">Transmit</button>
                                        </div>
                                    </form>
                                </div>
                            {% elseif booking.review %}
                                <div class="mt-3 p-3 rounded-3" style="background: rgba(255,255,255,0.02);">
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <div class="text-gold" style="font-size: 0.7rem;">
                                            {% for i in 1..booking.review.rating %} <i class="fas fa-star"></i> {% endfor %}
                                        </div>
                                        <div class="text-xxs text-dim">ARCHIVED REVIEW</div>
                                    </div>
                                    <p class="text-xxs text-silver mb-0 italic">"{{ booking.review.comment }}"</p>
                                </div>
                            {% endif %}
                        </div>
                    </div>
                </div>
            {% else %}
                <div class="col-12 py-5 text-center">
                    <div class="mb-4 opacity-10"><i class="fas fa-microscope fs-1 text-teal"></i></div>
                    <h3 class="text-silver luxury-serif">Manifest is Void</h3>
                    <p class="text-dim">You have no active or historical service protocols registered in the ledger.</p>
                    <a href="{{ path('app_service_list') }}" class="btn-luxury mt-4">Initiate Protocol</a>
                </div>
            {% endfor %}
        </div>
    </div>
</div>

<style>
    .star-radio:checked ~ .star-label { color: var(--accent-gold); }
    .star-label:hover, .star-label:hover ~ .star-label { color: var(--accent-gold); opacity: 0.7; }
</style>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        // Star Selection Logic
        document.querySelectorAll('.star-label').forEach(label => {
            label.addEventListener('click', function() {
                const value = this.getAttribute('data-value');
                const container = this.closest('form');
                const labels = container.querySelectorAll('.star-label');
                const text = container.querySelector('.rating-text');
                
                labels.forEach(l => {
                    if(parseInt(l.getAttribute('data-value')) <= value) {
                        l.classList.remove('text-dim');
                        l.classList.add('text-gold');
                    } else {
                        l.classList.add('text-dim');
                        l.classList.remove('text-gold');
                    }
                });
                text.innerText = value + ' Star' + (value > 1 ? 's' : '');
            });
        });

        const ctx = document.getElementById('spendingVelocityChart').getContext('2d');
        const gradient = ctx.createLinearGradient(0, 0, 0, 400);
        gradient.addColorStop(0, 'rgba(16, 185, 129, 0.2)');
        gradient.addColorStop(1, 'rgba(16, 185, 129, 0)');

        new Chart(ctx, {
            type: 'line',
            data: {
                labels: ['Nov', 'Dec', 'Jan', 'Feb', 'Mar', 'Apr'],
                datasets: [{
                    label: 'Expenditure',
                    data: [12000, 8000, 25000, 15000, 32000, 20000],
                    borderColor: '#10b981',
                    backgroundColor: gradient,
                    borderWidth: 3,
                    fill: true,
                    tension: 0.4,
                    pointBackgroundColor: '#10b981',
                    pointRadius: 4
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { display: false } },
                scales: {
                    y: { 
                        beginAtZero: true, 
                        grid: { color: 'rgba(255,255,255,0.03)' },
                        ticks: { color: '#64748B', font: { size: 10 } }
                    },
                    x: { 
                        grid: { display: false },
                        ticks: { color: '#64748B', font: { size: 10 } }
                    }
                }
            }
        });
    });
</script>
{% endblock %}