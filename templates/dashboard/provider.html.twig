{% extends 'dashboard_base.html.twig' %}

{% block title %}Atelier Control — ServiceHub{% endblock %}
{% block page_title %}Atelier Control{% endblock %}

{% block body %}
<div class="animate-fade-in">
    {# ── WELCOME & REPUTATION ── #}
    <div class="row g-4 mb-5">
        <div class="col-xl-8">
            <div class="glass-card p-5 h-100 d-flex flex-column justify-content-center" style="background: linear-gradient(135deg, rgba(239, 68, 68, 0.10), transparent); border: 1px solid rgba(239, 68, 68, 0.32);">
                <div class="text-xxs text-admin fw-800 letter-spacing-2 mb-3">
                    {% if app.user.services|length == 0 %}
                        NEW PROVIDER: INITIALIZATION REQUIRED
                    {% else %}
                        PROTOCOL STATUS: OPERATIONAL
                    {% endif %}
                </div>
                <h1 class="luxury-serif text-pure mb-3" style="font-size: 3rem;">Salutations, {{ app.user.fullName }}</h1>
                <p class="text-silver mb-5 opacity-70" style="max-width:550px; line-height: 1.6;">
                    {% if app.user.services|length == 0 %}
                        Your atelier is offline. Publish your first technical artifact to integrate with the ServiceHub global network.
                    {% else %}
                        Your atelier is synchronized. Monitor live telemetry and legacy protocols through your high-fidelity dashboard.
                    {% endif %}
                </p>
                <div class="d-flex gap-3">
                    <a href="{{ path('app_service_new') }}" class="btn-luxury px-4 py-2" style="background: var(--admin-accent) !important; font-size: 0.75rem;">
                        <i class="fas fa-plus me-2"></i> UNVEIL NEW SERVICE
                    </a>
                    <a href="{{ path('app_provider_my_services') }}" class="btn-outline-luxury px-4 py-2" style="border-color: var(--admin-accent) !important; color: var(--admin-accent) !important; font-size: 0.75rem;">COLLECTION MANIFEST</a>
                </div>
            </div>
        </div>
        <div class="col-xl-4">
            <div class="glass-card p-5 h-100 d-flex flex-column align-items-center justify-content-center border-admin-glow">
                <div class="text-xxs text-admin fw-800 letter-spacing-3 mb-4">REPUTATION HERITAGE</div>
                <div class="user-orb" style="width:120px; height:120px; font-size:2.5rem; margin-bottom:24px; border-color: var(--admin-accent); box-shadow: 0 0 40px rgba(239, 68, 68, 0.15);">
                    {{ app.user.reputationPoints }}
                </div>
                <div class="badge-status status-active px-4 py-2" style="background: rgba(239,68,68,0.1); color: var(--admin-accent); border-color: rgba(239,68,68,0.3);">
                    {{ app.user.tier|upper }} ARCHITECT
                </div>
            </div>
        </div>
    </div>

    {# ── KPI ANALYTICS ── #}
    <div class="row g-4 mb-5">
        <div class="col-md-3">
            <div class="glass-card p-4">
                <div class="text-xxs text-dim fw-800 mb-2">ACTIVE PROTOCOLS</div>
                <div class="h2 text-pure fw-800 mb-0">{{ bookings|filter(b => b.status in ['Pending', 'Confirmed', 'on-the-way', 'Accepted'])|length }}</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="glass-card p-4">
                <div class="text-xxs text-dim fw-800 mb-2">LIFETIME YIELD</div>
                {% set totalRev = 0 %}
                {% for b in bookings|filter(b => b.status == 'Completed') %}{% set totalRev = totalRev + (b.estimatedCost|default(b.service.price)) %}{% endfor %}
                <div class="h2 text-pure fw-800 mb-0">₹{{ totalRev|number_format(0) }}</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="glass-card p-4">
                <div class="text-xxs text-dim fw-800 mb-2">HERITAGE SCORE</div>
                <div class="h2 text-teal fw-800 mb-0">9.8<span class="text-xxs text-dim">/10</span></div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="glass-card p-4">
                <div class="text-xxs text-dim fw-800 mb-2">PENDING ESTIMATES</div>
                <div class="h2 text-admin fw-800 mb-0">{{ bookings|filter(b => b.bookingType == 'visit' and b.estimatedCost is empty)|length }}</div>
            </div>
        </div>
    </div>

    <div class="row g-5 mb-5">
        {# ── PROTOCOL LEDGER ── #}
        <div class="col-xl-8">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2 class="luxury-serif text-pure mb-0">Protocol Ledger</h2>
                <a href="#all-logs" class="text-xxs text-admin fw-800 letter-spacing-1 text-decoration-none">VIEW ALL LOGS</a>
            </div>
            <div class="glass-card p-0 overflow-hidden">
                <div class="table-responsive">
                    <table class="table mb-0">
                        <thead>
                            <tr class="text-xxs text-dim fw-800">
                                <th class="ps-4 py-4">CLIENT NODE</th>
                                <th class="py-4">ARTIFACT</th>
                                <th class="py-4">STATUS</th>
                                <th class="pe-4 py-4 text-end">OPERATIONS</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for booking in bookings|slice(0, 5) %}
                                <tr class="border-top border-glass">
                                    <td class="ps-4 py-4">
                                        <div class="d-flex align-items-center gap-3">
                                            <div class="user-orb" style="width:36px; height:36px; font-size:0.8rem; background: var(--bg-deep);">{{ booking.customer.fullName|slice(0,1)|upper }}</div>
                                            <div>
                                                <div class="text-pure fw-bold" style="font-size:0.85rem;">{{ booking.customer.fullName }}</div>
                                                <div class="text-xxs text-dim">{{ booking.customer.tier|upper }}</div>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="py-4">
                                        <div class="text-pure fw-bold text-xxs mb-1">{{ booking.service.title|upper }}</div>
                                        <div class="text-xxs text-dim">{{ booking.bookingDate|date('d M Y') }}</div>
                                    </td>
                                    <td class="py-4">
                                        <span class="badge-status status-{{ booking.status|lower in ['completed', 'accepted'] ? 'active' : 'pending' }} px-3" 
                                              style="{{ booking.status|lower == 'completed' ? '' : 'background: rgba(239,68,68,0.1); color: var(--admin-accent); border-color: rgba(239,68,68,0.2);' }}">
                                            {{ booking.status|upper }}
                                        </span>
                                    </td>
                                    <td class="pe-4 py-4 text-end">
                                        <div class="d-flex justify-content-end gap-2">
                                            {% if booking.status == 'Confirmed' %}
                                                <form action="{{ path('app_provider_dispatch_booking', {'id': booking.id}) }}" method="post">
                                                    <input type="hidden" name="_token" value="{{ csrf_token('dispatch' ~ booking.id) }}">
                                                    <button type="submit" class="btn-luxury px-3 py-1" style="font-size: 0.6rem; background: var(--admin-accent) !important;">DISPATCH</button>
                                                </form>
                                            {% elseif booking.status == 'on-the-way' %}
                                                <form action="{{ path('app_provider_complete_booking', {'id': booking.id}) }}" method="post">
                                                    <input type="hidden" name="_token" value="{{ csrf_token('complete' ~ booking.id) }}">
                                                    <button type="submit" class="btn-luxury px-3 py-1" style="font-size: 0.6rem; background: var(--admin-accent) !important;">CONCLUDE</button>
                                                </form>
                                            {% endif %}
                                            
                                            {% if booking.bookingType == 'visit' and not booking.estimatedCost %}
                                                <form action="{{ path('app_provider_send_estimate', {'id': booking.id}) }}" method="post" class="d-flex gap-2">
                                                    <input type="hidden" name="_token" value="{{ csrf_token('estimate' ~ booking.id) }}">
                                                    <input type="number" name="estimatedCost" class="luxury-input py-1 px-2 mb-0" style="width:80px; font-size:0.65rem;" placeholder="₹ Est." required>
                                                    <button type="submit" class="btn-outline-luxury py-1 px-2" style="font-size:0.6rem; border-color: var(--admin-accent) !important; color: var(--admin-accent) !important;">PROPOSE</button>
                                                </form>
                                            {% endif %}
                                        </div>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        {# ── RECENT REVIEWS ── #}
        <div class="col-xl-4">
            <h2 class="luxury-serif text-pure mb-4">Heritage Voices</h2>
            <div class="glass-card p-4">
                <div class="d-flex flex-column gap-4">
                    {% set reviews = [] %}
                    {% for b in bookings %}{% if b.review is not empty %}{% set reviews = reviews|merge([b.review]) %}{% endif %}{% endfor %}
                    
                    {% for review in reviews|reverse|slice(0, 3) %}
                        <div class="review-feedback p-3 rounded-4" style="background: rgba(255,255,255,0.02); border: 1px solid var(--glass-border);">
                            <div class="d-flex justify-content-between mb-2">
                                <div class="text-gold" style="font-size: 0.7rem;">
                                    {% for i in 1..5 %}<i class="f{{ review.rating >= i ? 'as' : 'ar' }} fa-star"></i>{% endfor %}
                                </div>
                                <div class="text-xxs text-dim fw-800">{{ review.createdAt|date('d M Y') }}</div>
                            </div>
                            <p class="text-xs text-silver italic mb-2">"{{ review.comment|slice(0, 80) }}..."</p>
                            <div class="text-xxs text-pure fw-800">— {{ review.customer.fullName|upper }}</div>
                        </div>
                    {% else %}
                        <div class="text-center py-5 opacity-40">
                            <i class="fas fa-comment-slash fs-2 mb-3"></i>
                            <p class="text-xxs text-dim fw-800">NO RECENT FEEDBACK NODES</p>
                        </div>
                    {% endfor %}
                </div>
                <div class="mt-4 pt-4 border-top border-glass text-center">
                    <a href="#" class="btn-outline-luxury w-100 py-3" style="font-size: 0.65rem;">VIEW FULL REPUTATION MANIFEST</a>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    document.addEventListener('DOMContentLoaded', function() {
        // Analytics can be added here if needed in future
    });
</script>
{% endblock %}