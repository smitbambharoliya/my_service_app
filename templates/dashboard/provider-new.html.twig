{% extends 'dashboard_base.html.twig' %}

{% block title %}Atelier — ServiceHub Tactical Command{% endblock %}
{% block page_title %}Atelier Command{% endblock %}

{% block body %}
<div class="reveal-3d">
    {# ── BENTO OPERATIONAL NODES ── #}
    <div class="row g-4 mb-5">
        <div class="col-md-4">
            <div class="glass-card p-4 border-glow-hover h-100 d-flex flex-column justify-content-between border-red-soft">
                <div>
                    <div class="text-xxs text-red fw-900 letter-spacing-2 mb-3">ACTIVE MISSIONS</div>
                    <div class="h1 fw-900 text-white mb-0">
                        {{ bookings|filter(b => b.status|lower in ['confirmed', 'pending', 'accepted'])|length }}
                    </div>
                </div>
                <div class="text-xxs text-dim mt-3">↑ 12% VELOCITY INCREASE</div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="glass-card p-4 border-glow-hover h-100 d-flex flex-column justify-content-between border-gold-soft">
                <div>
                    <div class="text-xxs text-gold fw-900 letter-spacing-2 mb-3">NET YIELD (80%)</div>
                    {% set totalEarnings = 0 %}
                    {% for b in bookings|filter(b => b.status|lower == 'completed') %}
                        {% set totalEarnings = totalEarnings + (b.estimatedCost|default(b.service.price) * 0.8) %}
                    {% endfor %}
                    <div class="h1 fw-900 text-white mb-0">₹{{ (totalEarnings / 1000)|round(1) }}k</div>
                </div>
                <div class="text-xxs text-dim mt-3">LIFETIME REVENUE ARCHIVE</div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="glass-card p-4 border-glow-hover h-100 d-flex flex-column justify-content-between border-purple-soft">
                <div>
                    <div class="text-xxs text-purple fw-900 letter-spacing-2 mb-3">SUCCESS FIDELITY</div>
                    {% set completed = bookings|filter(b => b.status|lower == 'completed')|length %}
                    {% set total = bookings|length %}
                    <div class="h1 fw-900 text-white mb-0">
                        {% if total > 0 %}{{ ((completed / total) * 100)|round(0) }}%{% else %}0%{% endif %}
                    </div>
                </div>
                <div class="text-xxs text-dim mt-3">MISSION COMPLETION RATE</div>
            </div>
        </div>
    </div>

    <div class="row g-4 mb-5">
        {# ── EARNINGS TRAJECTORY CORE ── #}
        <div class="col-xl-8">
            <div class="glass-card p-4 h-100">
                <div class="d-flex justify-content-between align-items-center mb-5">
                    <div>
                        <h3 class="luxury-serif text-white h4 mb-1">Yield Trajectory</h3>
                        <span class="text-xxs text-dim fw-800">MONTHLY REVENUE ANALYTICS</span>
                    </div>
                    <div class="badge-status status-active" style="font-size: 0.55rem;">LIVE FEED</div>
                </div>
                <div style="height: 320px;">
                    <canvas id="earningsChart"></canvas>
                </div>
            </div>
        </div>

        {# ── PERFORMANCE TELEMETRY ── #}
        <div class="col-xl-4">
            <div class="glass-card h-100 p-4 bg-surface-dark">
                <h3 class="luxury-serif text-white h5 mb-4">Performance Metrics</h3>
                <div class="d-grid gap-3">
                    <div class="metric-node-spatial">
                        <div class="node-icon bg-gold-soft text-gold"><i class="fas fa-star"></i></div>
                        <div class="flex-grow-1">
                            <div class="text-xxs text-dim fw-800">AVERAGE RATING</div>
                            <div class="text-white fw-bold">4.8 <span class="text-dim">/ 5.0</span></div>
                        </div>
                    </div>
                    <div class="metric-node-spatial">
                        <div class="node-icon bg-teal-soft text-teal"><i class="fas fa-bolt-lightning"></i></div>
                        <div class="flex-grow-1">
                            <div class="text-xxs text-dim fw-800">RESPONSE LATENCY</div>
                            <div class="text-white fw-bold">&lt; 2 HOURS</div>
                        </div>
                    </div>
                    <div class="metric-node-spatial">
                        <div class="node-icon bg-purple-soft text-purple"><i class="fas fa-user-check"></i></div>
                        <div class="flex-grow-1">
                            <div class="text-xxs text-dim fw-800">REPEAT IDENTITIES</div>
                            <div class="text-white fw-bold">42 NODES</div>
                        </div>
                    </div>
                </div>
                
                <div class="mt-4 pt-4 border-top border-white border-opacity-5">
                    <a href="{{ path('app_service_new') }}" class="btn-luxury w-100 py-3">DEPLOY NEW UNIT</a>
                </div>
            </div>
        </div>
    </div>

    {# ── MISSION INTERCEPT (Requests) ── #}
    <div class="mb-5">
        <div class="d-flex align-items-center justify-content-between mb-4">
            <h2 class="luxury-serif text-white">Mission Intercepts</h2>
            <div class="text-xxs text-dim fw-800 letter-spacing-1">PENDING AUTHORIZATION</div>
        </div>

        <div class="row g-4">
            {% for booking in bookings|slice(0, 4) %}
                <div class="col-xl-6">
                    <div class="glass-card p-0 border-glow-hover overflow-hidden h-100">
                        <div class="p-4 d-flex justify-content-between align-items-start">
                            <div class="d-flex gap-4">
                                <div class="user-orb" style="width: 48px; height: 48px; border-color: var(--accent-gold);">
                                    {{ booking.customer.fullName|slice(0,1)|upper }}
                                </div>
                                <div>
                                    <h4 class="mb-1 fw-bold text-white small">{{ booking.customer.fullName|upper }}</h4>
                                    <div class="text-xxs text-teal fw-900 letter-spacing-1">{{ booking.service.title|upper }}</div>
                                </div>
                            </div>
                            <div class="text-end">
                                <span class="badge-status {{ booking.status|lower == 'pending' ? 'status-pending' : 'status-active' }}">
                                    {{ booking.status|upper }}
                                </span>
                                <div class="text-xxs text-dim mt-2 font-monospace">{{ booking.bookingDate|date('d . m . y') }}</div>
                            </div>
                        </div>

                        <div class="px-4 py-3 bg-surface-dark border-top border-white border-opacity-5">
                            <div class="row text-center g-0">
                                <div class="col-6 border-end border-white border-opacity-10">
                                    <div class="text-xxxs text-dim fw-800">GROSS ALLOCATION</div>
                                    <div class="text-white small fw-bold">₹{{ (booking.estimatedCost|default(booking.service.price))|number_format }}</div>
                                </div>
                                <div class="col-6">
                                    <div class="text-xxxs text-gold fw-900">NET YIELD</div>
                                    <div class="text-gold small fw-bold">₹{{ ((booking.estimatedCost|default(booking.service.price)) * 0.8)|number_format }}</div>
                                </div>
                            </div>
                        </div>

                        <div class="p-4 border-top border-white border-opacity-5 mt-auto">
                            <div class="d-flex justify-content-end gap-2">
                                <a href="{{ path('app_booking_detail', {id: booking.id}) }}" class="btn-spatial-mini">VIEW LOG</a>
                                {% if booking.status|lower == 'pending' %}
                                    <button class="btn-spatial-mini text-teal border-teal">ACCEPT MISSION</button>
                                    <button class="btn-spatial-mini text-red border-red">DECLINE</button>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    </div>
</div>

<style>
    .border-red-soft { border-color: rgba(255, 93, 115, 0.2) !important; }
    .bg-surface-dark { background: rgba(0, 0, 0, 0.2); }
    .metric-node-spatial {
        display: flex; align-items: center; gap: 15px; padding: 15px;
        border-radius: 16px; background: rgba(255,255,255,0.02);
        border: 1px solid rgba(255,255,255,0.05); transition: 0.3s;
    }
    .metric-node-spatial:hover { background: rgba(255,255,255,0.05); transform: translateX(5px); }
    .node-icon { width: 40px; height: 40px; border-radius: 10px; display: flex; align-items: center; justify-content: center; }
    .btn-spatial-mini { font-size: 0.55rem; font-weight: 900; letter-spacing: 1px; padding: 6px 14px; border-radius: 8px; background: rgba(255,255,255,0.03); color: #94a3b8; text-decoration: none; border: 1px solid rgba(255,255,255,0.05); transition: 0.3s; }
    .btn-spatial-mini:hover { color: #fff; background: rgba(255,255,255,0.1); }
</style>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    document.addEventListener('DOMContentLoaded', function() {
        const ctx = document.getElementById('earningsChart').getContext('2d');
        new Chart(ctx, {
            type: 'bar',
            data: {
                labels: ['JAN', 'FEB', 'MAR', 'APR', 'MAY', 'JUN'],
                datasets: [{
                    data: [45000, 52000, 48000, 61000, 75000, 68000],
                    backgroundColor: 'rgba(212, 175, 55, 0.2)',
                    borderColor: '#ffd166',
                    borderWidth: 2,
                    borderRadius: 12,
                    hoverBackgroundColor: '#ffd166'
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { display: false } },
                scales: {
                    y: { grid: { color: 'rgba(255,255,255,0.03)' }, ticks: { color: '#64748B', font: { size: 10 } } },
                    x: { grid: { display: false }, ticks: { color: '#64748B', font: { size: 10, weight: '800' } } }
                }
            }
        });
    });
</script>
{% endblock %}