{% extends 'dashboard_base.html.twig' %}

{% block title %}My Services - ServiceHub{% endblock %}
{% block page_title %}My Services{% endblock %}

{% block body %}
<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <h4 style="font-weight:700;color:#0f172a;margin:0;">My Services</h4>
        <p style="color:#94a3b8;font-size:0.85rem;margin:4px 0 0;">Manage all your listed services</p>
    </div>
    {% if app.user.services|length == 0 %}
        <a href="{{ path('app_provider_onboarding') }}" class="btn btn-primary rounded-pill px-4 shadow-sm" style="font-size:0.875rem;font-weight:600;">
            <i class="fas fa-route me-2"></i> Start setup
        </a>
    {% else %}
        <a href="{{ path('app_service_new') }}" class="btn btn-primary rounded-pill px-4 shadow-sm" style="font-size:0.875rem;font-weight:600;">
            <i class="fas fa-plus me-2"></i>Add New Service
        </a>
    {% endif %}
</div>

<div class="card border-0 rounded-4 shadow-sm" style="background:#fff;overflow:hidden;">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0" style="font-size:0.875rem;">
            <thead style="background:#f8fafc;">
                <tr>
                    <th style="padding:14px 20px;font-size:0.72rem;text-transform:uppercase;letter-spacing:1px;color:#94a3b8;font-weight:600;border-bottom:1px solid #f1f5f9;">Service</th>
                    <th style="padding:14px 20px;font-size:0.72rem;text-transform:uppercase;letter-spacing:1px;color:#94a3b8;font-weight:600;border-bottom:1px solid #f1f5f9;">Category</th>
                    <th style="padding:14px 20px;font-size:0.72rem;text-transform:uppercase;letter-spacing:1px;color:#94a3b8;font-weight:600;border-bottom:1px solid #f1f5f9;">Price</th>
                    <th style="padding:14px 20px;font-size:0.72rem;text-transform:uppercase;letter-spacing:1px;color:#94a3b8;font-weight:600;border-bottom:1px solid #f1f5f9;">Status</th>
                    <th style="padding:14px 20px;font-size:0.72rem;text-transform:uppercase;letter-spacing:1px;color:#94a3b8;font-weight:600;border-bottom:1px solid #f1f5f9;text-align:right;">Action</th>
                </tr>
            </thead>
            <tbody>
                {% for service in services %}
                <tr style="border-bottom:1px solid #f8fafc;">
                    <td style="padding:14px 20px;">
                        <div style="font-weight:600;color:#0f172a;">{{ service.title }}</div>
                        <div style="font-size:0.75rem;color:#94a3b8;margin-top:2px;">{{ service.description|slice(0,50) }}{% if service.description|length > 50 %}...{% endif %}</div>
                    </td>
                    <td style="padding:14px 20px;">
                        <span style="background:#eff6ff;color:#2563eb;border:1px solid #bfdbfe;padding:4px 12px;border-radius:30px;font-size:0.72rem;font-weight:600;">{{ service.category }}</span>
                    </td>
                    <td style="padding:14px 20px;font-weight:700;color:#16a34a;font-size:0.95rem;">₹{{ service.price }}</td>
                    <td style="padding:14px 20px;">
                        {% if service.isPremium %}
                            <span style="background:#fef9c3;color:#a16207;border:1px solid #fde047;padding:4px 12px;border-radius:30px;font-size:0.72rem;font-weight:600;">
                                <i class="fas fa-crown me-1"></i>Premium
                            </span>
                        {% else %}
                            <span style="background:#f1f5f9;color:#64748b;border:1px solid #e2e8f0;padding:4px 12px;border-radius:30px;font-size:0.72rem;font-weight:600;">
                                Standard
                            </span>
                        {% endif %}
                    </td>
                    <td style="padding:14px 20px;text-align:right;">
                        <a href="{{ path('app_service_show', {'id': service.id}) }}"
                           style="padding:6px 16px;border:1px solid #e2e8f0;border-radius:8px;font-size:0.78rem;font-weight:600;color:#64748b;text-decoration:none;display:inline-flex;align-items:center;gap:5px;transition:all 0.2s;"
                           onmouseover="this.style.borderColor='#2563eb';this.style.color='#2563eb';"
                           onmouseout="this.style.borderColor='#e2e8f0';this.style.color='#64748b';">
                            <i class="fas fa-eye"></i> View
                        </a>
                    </td>
                </tr>
                {% else %}
                <tr>
                    <td colspan="5">
                        <div style="text-align:center;padding:70px 30px;color:#94a3b8;">
                            <div style="width:72px;height:72px;background:#f1f5f9;border-radius:18px;display:inline-flex;align-items:center;justify-content:center;margin-bottom:16px;">
                                <i class="fas fa-cogs fa-2x" style="color:#cbd5e1;"></i>
                            </div>
                            <h6 style="color:#0f172a;font-weight:700;margin-bottom:6px;">No Services Yet</h6>
                            <p style="font-size:0.85rem;margin-bottom:18px;">You haven't added any services. Start listing to attract customers!</p>
                            {% if app.user.services|length == 0 %}
                                <a href="{{ path('app_provider_onboarding') }}" class="btn btn-primary rounded-pill px-4" style="font-weight:600;font-size:0.875rem;">
                                    <i class="fas fa-route me-2"></i>Start provider setup
                                </a>
                            {% else %}
                                <a href="{{ path('app_service_new') }}" class="btn btn-primary rounded-pill px-4" style="font-weight:600;font-size:0.875rem;">
                                    <i class="fas fa-plus me-2"></i>Add Your First Service
                                </a>
                            {% endif %}
                        </div>
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}