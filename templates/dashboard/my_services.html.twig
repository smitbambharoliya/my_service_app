{% extends 'dashboard_base.html.twig' %}

{% block title %}My Services - ServiceHub{% endblock %}
{% block page_title %}My Services{% endblock %}

{% block body %}
<div class="d-flex align-items-center justify-content-between mb-5">
    <div>
        <h2 class="h3 mb-1">My Services</h2>
        <p class="font-label text-xxs text-dim mb-0 text-uppercase letter-spacing-1">TOTAL SERVICES: {{ services|length }}</p>
    </div>
    {% if app.user.services|length == 0 %}
        <a href="{{ path('app_provider_onboarding') }}" class="btn-luxury px-4 py-2">
            <i class="fas fa-route me-2"></i> START SETUP
        </a>
    {% else %}
        <a href="{{ path('app_service_new') }}" class="btn-luxury px-4 py-2">
            <i class="fas fa-plus me-2"></i> ADD NEW SERVICE
        </a>
    {% endif %}
</div>

<div class="glass-card p-0 overflow-hidden border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr class="font-label text-xxxs text-dim fw-800 text-uppercase letter-spacing-1 border-0" style="background: #faf9fa;">
                    <th class="ps-4 py-4">SERVICE</th>
                    <th class="py-4">CATEGORY</th>
                    <th class="py-4 text-center">PRICE</th>
                    <th class="py-4 text-center">STATUS</th>
                    <th class="pe-4 py-4 text-end">ACTIONS</th>
                </tr>
            </thead>
            <tbody>
                {% for service in services %}
                <tr class="border-top border-light">
                    <td class="ps-4 py-4">
                        <div class="text-pure fw-bold" style="font-size:0.9rem;">{{ service.title }}</div>
                        <div class="text-xxs text-dim mt-1" style="max-width: 300px;">{{ service.description|slice(0,60) }}...</div>
                    </td>
                    <td class="py-4">
                        <span class="font-label text-xxxs px-3 py-1 rounded-full d-inline-block" style="background: rgba(0, 107, 90, 0.05); color: #006b5a; border: 1px solid rgba(0, 107, 90, 0.1);">
                            {{ service.category.name|upper }}
                        </span>
                    </td>
                    <td class="py-4 text-center">
                        <div class="fw-bold" style="color: #006b5a;">₹{{ service.price|number_format }}</div>
                    </td>
                    <td class="py-4 text-center">
                        {% if service.isPremium %}
                            <span class="font-label text-xxxs px-3 py-1 rounded-full d-inline-block" style="background: #fef9c3; color: #a16207; border: 1px solid #fde047;">
                                <i class="fas fa-crown me-1"></i>PREMIUM
                            </span>
                        {% else %}
                            <span class="font-label text-xxxs px-3 py-1 rounded-full d-inline-block" style="background: #f1f5f9; color: #64748b; border: 1px solid #e2e8f0;">
                                STANDARD
                            </span>
                        {% endif %}
                    </td>
                    <td class="pe-4 py-4 text-end">
                        <div class="d-flex justify-content-end gap-2">
                            <a href="{{ path('app_service_show', {'id': service.id}) }}" class="btn-outline-luxury px-3 py-2" style="font-size: 0.65rem;">
                                <i class="fas fa-eye me-1"></i> VIEW
                            </a>
                        </div>
                    </td>
                </tr>
                {% else %}
                <tr>
                    <td colspan="5">
                        <div class="text-center py-5">
                            <i class="fas fa-box-open fs-1 text-light mb-3"></i>
                            <h5 class=" luxury-serif mb-2">No Highlighted Services</h5>
                            <p class="text-dim text-sm mb-4">You haven't listed any services in your profile yet.</p>
                        </div>
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}