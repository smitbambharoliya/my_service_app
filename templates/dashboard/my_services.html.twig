{% extends 'dashboard_base.html.twig' %}

{% block title %}Inventory Archives — ServiceHub Atelier{% endblock %}
{% block page_title %}Service Inventory{% endblock %}

{% block body %}
<div class="reveal-3d">
    {# ── ACTION HEADER ── #}
    <div class="d-flex align-items-center justify-content-between mb-5">
        <div>
            <span class="text-xxs text-teal fw-800 letter-spacing-3 d-block mb-1">UNIT INVENTORY</span>
            <h2 class="luxury-serif text-white mb-0">My Service Archives</h2>
            <p class="text-dim text-xs mt-2">Currently Synchronized: <strong class="text-white">{{ services|length }} Units</strong></p>
        </div>
        
        <div class="d-flex gap-3">
            {% if services|length == 0 %}
                <a href="{{ path('app_provider_onboarding') }}" class="btn-luxury py-2 px-4">
                    <i class="fas fa-route me-2"></i> INITIALIZE SETUP
                </a>
            {% else %}
                <a href="{{ path('app_service_new') }}" class="btn-luxury py-2 px-4">
                    <i class="fas fa-plus me-2"></i> DEPLOY NEW UNIT
                </a>
            {% endif %}
        </div>
    </div>

    {# ── SPATIAL SERVICE GRID ── #}
    <div class="row g-4">
        {% for service in services %}
            <div class="col-xl-6 col-xxl-4">
                <div class="glass-card p-0 overflow-hidden border-glow-hover h-100 d-flex flex-column {{ service.isPremium ? 'border-premium-glow' : '' }}">
                    
                    {# Unit Status Header #}
                    <div class="p-4 d-flex justify-content-between align-items-center border-bottom border-white border-opacity-5">
                        <div class="d-flex align-items-center gap-3">
                            <div class="p-2 rounded-3 bg-surface border-glass text-teal">
                                <i class="fas {{ service.isPremium ? 'fa-crown text-gold' : 'fa-cube' }}"></i>
                            </div>
                            <div>
                                <div class="text-xxs text-dim fw-800">UNIT ID</div>
                                <code class="text-white small">#{{ service.id|slice(-6) }}</code>
                            </div>
                        </div>
                        {% if service.isPremium %}
                            <span class="badge-status" style="background: rgba(212, 175, 55, 0.1); color: #ffd166; border-color: rgba(212, 175, 55, 0.2);">PREMIUM FIDELITY</span>
                        {% else %}
                            <span class="badge-status status-pending" style="font-size: 0.55rem;">STANDARD</span>
                        {% endif %}
                    </div>

                    {# Unit Body #}
                    <div class="p-4 flex-grow-1">
                        <div class="mb-4">
                            <div class="text-xxs text-teal fw-900 letter-spacing-1 mb-1">{{ service.category.name|upper }}</div>
                            <h4 class="luxury-serif text-white h5 mb-2">{{ service.title }}</h4>
                            <p class="text-dim text-xs line-clamp-2 mb-0">{{ service.description }}</p>
                        </div>

                        <div class="p-3 rounded-4 bg-surface border-glass d-flex justify-content-between align-items-center">
                            <div>
                                <div class="text-xxs text-dim fw-800 mb-1">RESERVE PRICE</div>
                                <div class="text-white fw-900 h5 mb-0">₹{{ service.price|number_format }}</div>
                            </div>
                            <i class="fas fa-barcode text-dim opacity-20 fs-2"></i>
                        </div>
                    </div>

                    {# Action Command Bar #}
                    <div class="p-3 bg-surface border-top border-white border-opacity-5 mt-auto">
                        <div class="d-flex justify-content-center gap-3">
                            <a href="{{ path('app_service_show', {'id': service.id}) }}" class="btn-action-spatial text-teal" title="View Public Archive">
                                <i class="fas fa-eye"></i>
                            </a>
                            <a href="#" class="btn-action-spatial text-blue" title="Calibrate Unit">
                                <i class="fas fa-sliders"></i>
                            </a>
                            <a href="#" class="btn-action-spatial text-red" title="Decommission Unit">
                                <i class="fas fa-power-off"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        {% else %}
            <div class="col-12">
                <div class="glass-card py-5 text-center border-dashed">
                    <i class="fas fa-box-open fs-1 text-dim mb-4 opacity-30"></i>
                    <h4 class="luxury-serif text-white">Archives Empty</h4>
                    <p class="text-dim small">No service units have been deployed to your provider profile.</p>
                    <a href="{{ path('app_service_new') }}" class="text-teal fw-800 text-xxs letter-spacing-2 text-decoration-none">
                        INITIALIZE DEPLOYMENT <i class="fas fa-arrow-right ms-2"></i>
                    </a>
                </div>
            </div>
        {% endfor %}
    </div>
</div>

<style>
    /* ── INVENTORY SPATIAL STYLES ── */
    .bg-surface { background: rgba(255, 255, 255, 0.02); }
    .border-glass { border: 1px solid rgba(255, 255, 255, 0.08); }
    
    .border-premium-glow {
        border-color: rgba(212, 175, 55, 0.3) !important;
        box-shadow: 0 0 30px rgba(212, 175, 55, 0.05);
    }

    .border-glow-hover:hover {
        border-color: rgba(0, 255, 213, 0.3) !important;
        transform: translateY(-5px);
        box-shadow: 0 20px 40px rgba(0,0,0,0.3);
    }

    .btn-action-spatial {
        width: 40px; height: 40px;
        border-radius: 10px;
        display: flex; align-items: center; justify-content: center;
        background: rgba(255, 255, 255, 0.04);
        border: 1px solid rgba(255, 255, 255, 0.08);
        transition: all 0.3s var(--ease-spatial);
        cursor: pointer;
        text-decoration: none;
    }
    .btn-action-spatial:hover {
        background: rgba(255, 255, 255, 0.1);
        transform: scale(1.1);
        border-color: currentColor;
    }

    .line-clamp-2 {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;  
        overflow: hidden;
    }
</style>
{% endblock %}