{% extends 'base.html.twig' %}

{% block title %}Scale Your Influence — ServiceHub Atelier Collective{% endblock %}

{% block stylesheets %}
<style>
    /* ── ATELIER COLLECTIVE SPATIAL UI ── */
    .expert-hero {
        min-height: 100vh;
        background: radial-gradient(circle at 100% 0%, rgba(0, 255, 213, 0.05) 0%, transparent 50%);
        position: relative;
        display: flex;
        align-items: center;
        padding: 100px 0;
    }
    
    .hero-visual-orb {
        position: absolute;
        right: -10%;
        top: 50%;
        transform: translateY(-50%);
        width: 50vw;
        height: 50vw;
        background: radial-gradient(circle, rgba(0, 255, 213, 0.03) 0%, transparent 70%);
        z-index: 0;
        pointer-events: none;
    }

    .expert-title {
        font-size: clamp(3rem, 6vw, 5rem);
        line-height: 0.95;
        margin-bottom: 2rem;
        color: #fff;
    }

    /* ── BENTO BENEFITS ── */
    .benefit-grid {
        display: grid;
        grid-template-columns: repeat(12, 1fr);
        gap: 20px;
    }

    .benefit-node {
        grid-column: span 4;
        padding: 40px;
        background: rgba(255, 255, 255, 0.02);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 32px;
        transition: all 0.5s var(--ease-spatial);
    }

    .benefit-node:hover {
        transform: translateY(-10px);
        border-color: var(--accent-teal);
        box-shadow: 0 30px 60px rgba(0,0,0,0.4);
    }

    .benefit-icon-spatial {
        width: 50px; height: 50px;
        background: rgba(0, 255, 213, 0.1);
        border-radius: 12px;
        display: flex; align-items: center; justify-content: center;
        color: var(--accent-teal);
        font-size: 1.2rem;
        margin-bottom: 30px;
        box-shadow: 0 0 20px rgba(0, 255, 213, 0.2);
    }

    /* ── ARTISAN EXHIBITS ── */
    .artisan-orb-portrait {
        width: 240px;
        height: 240px;
        border-radius: 40px;
        overflow: hidden;
        border: 1px solid rgba(255, 255, 255, 0.1);
        position: relative;
        transition: 0.6s var(--ease-spatial);
    }
    .artisan-orb-portrait::after {
        content: ''; position: absolute; inset: 0;
        border: 2px solid var(--accent-teal);
        border-radius: 38px; opacity: 0; transition: 0.4s;
    }
    .artisan-orb-portrait:hover { transform: scale(1.05) rotate(2deg); }
    .artisan-orb-portrait:hover::after { opacity: 0.4; }
    .artisan-orb-portrait img { width: 100%; height: 100%; object-fit: cover; filter: grayscale(1); transition: 0.6s; }
    .artisan-orb-portrait:hover img { filter: grayscale(0); }

    /* ── INITIALIZATION STEPS ── */
    .step-node-mini {
        width: 48px; height: 48px;
        border-radius: 14px;
        background: rgba(0, 255, 213, 0.1);
        border: 1px solid var(--accent-teal);
        display: flex; align-items: center; justify-content: center;
        font-family: monospace; font-weight: 900; color: var(--accent-teal);
        margin: 0 auto 20px;
    }

    /* ── CTA SECTOR ── */
    .collective-cta {
        background: radial-gradient(circle at center, rgba(157, 124, 255, 0.15) 0%, #080a0f 100%);
        border: 1px solid rgba(157, 124, 255, 0.2);
        border-radius: 60px;
        padding: 100px 40px;
        text-align: center;
        position: relative;
        overflow: hidden;
    }

    @media (max-width: 992px) {
        .benefit-node { grid-column: span 12; }
    }
</style>
{% endblock %}

{% block body %}
<main class="reveal-3d">
    {# ── 1. HERO ── #}
    <section class="expert-hero">
        <div class="hero-visual-orb"></div>
        <div class="container">
            <div class="row align-items-center">
                <div class="col-lg-7">
                    <span class="text-xxs text-teal fw-900 letter-spacing-4 mb-4 d-block">ATELIER ACCESS: BY SELECTION</span>
                    <h1 class="expert-title luxury-serif">Scale Your <span class="text-teal">Mastery.</span> Join the Global Archive.</h1>
                    <p class="text-dim fs-5 mb-5" style="max-width: 600px; line-height: 1.8;">
                        ServiceHub Atelier is a protected ecosystem for elite artisans. We provide the digital infrastructure to synchronize your craft with the world's most discerning patrons.
                    </p>
                    <div class="d-flex align-items-center flex-wrap gap-4">
                        {% include 'components/button.html.twig' with {'text': 'Enter Selection Process', 'url': path('app_register'), 'style': 'luxury'} %}
                        <a href="#charter" class="text-xxs text-white fw-800 letter-spacing-2 text-decoration-none opacity-50 hover-100 transition-all">CONSULT THE CHARTER <i class="fas fa-arrow-down ms-2"></i></a>
                    </div>
                </div>
            </div>
        </div>
    </section>

    {# ── 2. BENTO ARCHIVE ── #}
    <section class="py-5" id="charter">
        <div class="container mb-5">
            <div class="text-center">
                <h2 class="luxury-serif text-white display-4 mb-4">Operational Standards</h2>
                <p class="text-dim mx-auto" style="max-width: 700px;">We reject the friction of legacy marketplaces. Our environment is designed strictly for high-fidelity service deployment.</p>
            </div>
            
            <div class="benefit-grid mt-5">
                <div class="benefit-node">
                    <div class="benefit-icon-spatial"><i class="fas fa-globe"></i></div>
                    <h4 class="text-white fw-900 small letter-spacing-1 mb-3">GLOBAL TELEMETRY</h4>
                    <p class="text-dim text-sm mb-0">Represent your craft to institutional leaders and high-fidelity patrons across six continents via our live dashboard.</p>
                </div>
                <div class="benefit-node">
                    <div class="benefit-icon-spatial"><i class="fas fa-pen-nib"></i></div>
                    <h4 class="text-white fw-900 small letter-spacing-1 mb-3">EDITORIAL Curation</h4>
                    <p class="text-dim text-sm mb-0">Collaborate with our digital curators to refine your artifact listings and ensure your expertise is presented with reverence.</p>
                </div>
                <div class="benefit-node">
                    <div class="benefit-icon-spatial"><i class="fas fa-vault"></i></div>
                    <h4 class="text-white fw-900 small letter-spacing-1 mb-3">EXCHEQUER SYSTEM</h4>
                    <p class="text-dim text-sm mb-0">Custom protocol ledgers, multi-currency custody, and instant capital settlement through our secure financial network.</p>
                </div>
            </div>
        </div>
    </section>

    {# ── 3. AN ASSEMBLY OF MINDS ── #}
    <section class="py-5" style="background: rgba(255,255,255,0.01);">
        <div class="container text-center mb-5">
            <span class="text-xxs text-teal fw-900 letter-spacing-3 d-block mb-3">THE FELLOWSHIP</span>
            <h2 class="luxury-serif text-white h2">Active Collective Nodes</h2>
        </div>
        <div class="container">
            <div class="row g-5">
                <div class="col-lg-6">
                    <div class="glass-card p-4 d-flex gap-4 align-items-center border-0 bg-surface">
                        <div class="artisan-orb-portrait">
                            <img src="https://images.unsplash.com/photo-1560250097-0b93528c311a?q=80&w=400&auto=format&fit=crop" alt="Dr Alistair Thorne">
                        </div>
                        <div>
                            <span class="text-teal fw-900 text-xxs letter-spacing-2">DR. ALISTAIR THORNE</span>
                            <p class="text-white text-sm italic mt-3 mb-0">"The system treats expertise as an artifact to be preserved, not just a service to be sold."</p>
                        </div>
                    </div>
                </div>
                <div class="col-lg-6">
                    <div class="glass-card p-4 d-flex gap-4 align-items-center border-0 bg-surface">
                        <div class="artisan-orb-portrait">
                            <img src="https://images.unsplash.com/photo-1573496359142-b8d87734a5a2?q=80&w=400&auto=format&fit=crop" alt="Elena Vance">
                        </div>
                        <div>
                            <span class="text-teal fw-900 text-xxs letter-spacing-2">ELENA VANCE</span>
                            <p class="text-white text-sm italic mt-3 mb-0">"The caliber of the network is unparalleled. It is where true technical legacies are curated."</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    {# ── 4. PATH TO MEMBERSHIP ── #}
    <section class="py-5">
        <div class="container text-center mb-5">
            <h2 class="luxury-serif text-white display-5">Initialization Sequence</h2>
        </div>
        <div class="container">
            <div class="row g-4 text-center">
                <div class="col-md-4">
                    <div class="step-node-mini">01</div>
                    <h5 class="text-white fw-bold mb-3 small">Submission</h5>
                    <p class="text-dim text-xs">Submit your professional portfolio and technical artifacts for algorithmic review.</p>
                </div>
                <div class="col-md-4">
                    <div class="step-node-mini">02</div>
                    <h5 class="text-white fw-bold mb-3 small">Curation Audit</h5>
                    <p class="text-dim text-xs">Our peer board evaluates your specialty against current collective cohorts.</p>
                </div>
                <div class="col-md-4">
                    <div class="step-node-mini">03</div>
                    <h5 class="text-white fw-bold mb-3 small">Uplink</h5>
                    <p class="text-dim text-xs">Initialize your workspace and engage with high-fidelity service patrons.</p>
                </div>
            </div>
        </div>
    </section>

    {# ── 5. FINAL CALL ── #}
    <section class="container py-5">
        <div class="collective-cta">
            <div class="position-relative z-index-10">
                <span class="text-xxs text-white opacity-50 fw-900 letter-spacing-3 mb-4 d-block">WINTER COHORT OPEN</span>
                <h2 class="luxury-serif text-white display-4 mb-4">Initialize Your Legacy.</h2>
                <p class="text-dim fs-6 mb-5 mx-auto" style="max-width: 600px;">
                    Reviewing credentials for the next cohort of Distinguished Fellows. Secure your node in the network.
                </p>
                <div class="d-flex justify-content-center gap-3">
                    <a href="{{ path('app_register') }}" class="btn-luxury py-3 px-5">BEGIN APPLICATION</a>
                    <button class="btn-outline-luxury py-3 px-5">CONSULT ADMISSIONS</button>
                </div>
            </div>
        </div>
    </section>
</main>
{% endblock %}