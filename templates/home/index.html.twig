{% extends 'base.html.twig' %}

{% block title %}ServiceHub — Spatial Discovery Portal 2026{% endblock %}

{% block stylesheets %}
<style>
    /* ── SPATIAL FOUNDATION ── */
    .hero-luxury {
        position: relative;
        padding: 160px 0 100px;
        min-height: 100vh;
        display: flex;
        align-items: center;
        overflow: hidden;
    }
    
    .hero-bloom-glow {
        position: absolute;
        width: 100vw; height: 100vh;
        background: radial-gradient(circle at 80% 20%, rgba(0, 255, 213, 0.07) 0%, transparent 50%),
                    radial-gradient(circle at 20% 80%, rgba(157, 124, 255, 0.04) 0%, transparent 50%);
        z-index: 1; pointer-events: none;
    }

    /* ── FINDER CONSOLE (SOMMELIER) ── */
    .sommelier-console {
        background: rgba(255, 255, 255, 0.02);
        backdrop-filter: blur(40px);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 40px;
        padding: 40px;
        box-shadow: 0 40px 100px rgba(0,0,0,0.4);
        position: relative;
        z-index: 10;
    }

    .mood-node {
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(255, 255, 255, 0.05);
        padding: 30px 20px;
        border-radius: 24px;
        cursor: pointer;
        transition: all 0.5s var(--ease-spatial);
        text-align: center;
    }

    .mood-node:hover {
        background: rgba(0, 255, 213, 0.05);
        border-color: var(--accent-teal);
        transform: translateY(-8px) scale(1.02);
        box-shadow: 0 20px 40px rgba(0, 255, 213, 0.15);
    }

    .mood-node i {
        font-size: 2rem;
        margin-bottom: 20px;
        color: var(--accent-teal);
        filter: drop-shadow(0 0 10px rgba(0, 255, 213, 0.5));
    }

    /* ── SERVICE ARTIFACTS (BENTO) ── */
    .archive-section { padding: 120px 0; }
    
    .artifact-card {
        background: rgba(255, 255, 255, 0.02);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 32px;
        overflow: hidden;
        transition: all 0.6s var(--ease-spatial);
        height: 100%;
    }

    .artifact-card:hover {
        border-color: var(--accent-teal);
        transform: translateY(-12px) rotateX(4deg);
        box-shadow: 0 40px 80px rgba(0,0,0,0.5);
    }

    .artifact-visual {
        height: 240px;
        background-size: cover;
        background-position: center;
        position: relative;
    }

    .artifact-visual::after {
        content: ''; position: absolute; inset: 0;
        background: linear-gradient(to bottom, transparent 30%, #080a0f 100%);
    }

    .price-tag-spatial {
        font-family: 'Plus Jakarta Sans', sans-serif;
        font-weight: 900;
        font-size: 1.4rem;
        color: #fff;
    }

    /* ── ANIMATIONS ── */
    .discovery-step { display: none; }
    .discovery-step.active { display: block; animation: spatialReveal 0.8s var(--ease-spatial) forwards; }

    @keyframes spatialReveal {
        from { opacity: 0; transform: translateY(30px) scale(0.98); filter: blur(10px); }
        to { opacity: 1; transform: translateY(0) scale(1); filter: blur(0); }
    }

    #three-canvas {
        position: absolute; top: 0; left: 0;
        width: 100%; height: 100%;
        z-index: 0; pointer-events: none;
        opacity: 0.4;
    }
</style>
{% endblock %}

{% block body %}
<main class="reveal-3d">
    {# ── 1. SPATIAL HERO & FINDER ── #}
    <section class="hero-luxury">
        <canvas id="three-canvas"></canvas>
        <div class="hero-bloom-glow"></div>
        
        <div class="container position-relative z-index-10">
            <div class="row g-5 align-items-center">
                <div class="col-xl-6">
                    <div class="hero-copy">
                        <span class="badge-status status-active mb-4" style="letter-spacing: 3px;">UPLINK: 2026.04.27</span>
                        <h1 class="luxury-serif text-white mb-4" style="font-size: clamp(3.5rem, 6vw, 5.5rem); line-height: 0.9;">
                            Discover<br><span class="text-teal">The Future</span><br>of Services.
                        </h1>
                        <p class="text-dim fs-5 mb-5" style="max-width: 500px; line-height: 1.8;">
                            A decentralized sanctuary for verified artisans. Synchronize your requirements with our archival network.
                        </p>
                        
                        <div class="row g-3">
                            {% set stats = [
                                {i: 'fa-microchip', l: 'LIVE NODES', v: 'Telemetry Active'},
                                {i: 'fa-shield-halved', l: 'TRUST LAYER', v: 'Verified IDs'}
                            ] %}
                            {% for stat in stats %}
                                <div class="col-6">
                                    <div class="glass-card p-3 border-0 bg-surface">
                                        <i class="fas {{ stat.i }} text-teal mb-2"></i>
                                        <div class="text-xxs text-dim fw-800">{{ stat.l }}</div>
                                        <div class="text-white small fw-bold">{{ stat.v }}</div>
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    </div>
                </div>

                <div class="col-xl-6">
                    {# AI FINDER CONSOLE #}
                    <div class="sommelier-console border-beam">
                        <div id="sommelier-content">
                            <div class="discovery-step active" id="step-1">
                                <div class="d-flex justify-content-between align-items-center mb-5">
                                    <div>
                                        <h3 class="luxury-serif text-white h4 mb-1">Discovery Console</h3>
                                        <div class="text-xxs text-teal fw-900 letter-spacing-2">PHASE 01: INTENT</div>
                                    </div>
                                    <div class="pulse-indicator"></div>
                                </div>
                                
                                <div class="row g-3">
                                    {% set intents = [
                                        {m: 'Urgent', i: 'fa-bolt-lightning', t: 'URGENT REPAIR', d: 'Fast-response technical aid.'},
                                        {m: 'Upgrade', i: 'fa-wand-magic-sparkles', t: 'HOME UPGRADE', d: 'Premium aesthetic evolution.'},
                                        {m: 'Routine', i: 'fa-leaf', t: 'ROUTINE CARE', d: 'Maintenance & preservation.'}
                                    ] %}
                                    {% for item in intents %}
                                        <div class="col-md-4">
                                            <div class="mood-node" onclick="nextStep('{{ item.m }}', '{{ item.t }} Protocol Selected')">
                                                <i class="fas {{ item.i }}"></i>
                                                <div class="text-white fw-900 text-xxs letter-spacing-1 mb-2">{{ item.t }}</div>
                                                <div class="text-dim" style="font-size: 0.6rem;">{{ item.d }}</div>
                                            </div>
                                        </div>
                                    {% endfor %}
                                </div>
                            </div>

                            <div class="discovery-step" id="step-2">
                                <div class="d-flex align-items-center gap-4 mb-5">
                                    <button class="btn-action-spatial" onclick="prevStep()"><i class="fas fa-arrow-left"></i></button>
                                    <div>
                                        <h3 class="luxury-serif text-white h4 mb-1">Refine Archives</h3>
                                        <div class="text-xxs text-teal fw-900 letter-spacing-2" id="intent-display">PHASE 02: PARAMETERS</div>
                                    </div>
                                </div>
                                
                                <form action="{{ path('app_service_list') }}" method="GET" class="spatial-form">
                                    <input type="hidden" name="mood" id="mood-input">
                                    <div class="row g-4">
                                        <div class="col-md-12">
                                            <label class="text-xxs text-dim fw-900 mb-2 d-block">SERVICE SECTOR</label>
                                            <select name="category" class="cyber-input form-select">
                                                <option value="">Scan All Categories...</option>
                                                <option value="Plumbing">Plumbing</option>
                                                <option value="Electrical">Electrical</option>
                                                <option value="Cleaning">Cleaning</option>
                                            </select>
                                        </div>
                                        <div class="col-md-12">
                                            <label class="text-xxs text-dim fw-900 mb-2 d-block">SEARCH STRING</label>
                                            <input type="text" name="q" class="cyber-input" placeholder="e.g. Molecular Hygiene, AC Calibration...">
                                        </div>
                                        <div class="col-12 mt-4">
                                            <button type="submit" class="btn-luxury w-100 py-3">SYNCHRONIZE SEARCH</button>
                                        </div>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    {# ── 2. TRENDING ARCHIVES ── #}
    <section class="archive-section">
        <div class="container">
            <div class="d-flex justify-content-between align-items-end mb-5">
                <div>
                    <span class="text-teal text-xxs fw-900 letter-spacing-3 mb-2 d-block">CURATED ARTIFACTS</span>
                    <h2 class="luxury-serif text-white mb-0" style="font-size: 3rem;">Popular Services</h2>
                </div>
                <a href="{{ path('app_service_list') }}" class="btn-outline-luxury py-2 px-4">BROWSE FULL INDEX</a>
            </div>

            <div class="row g-4">
                {% for s in sections.trending|default([])|slice(0, 3) %}
                    <div class="col-lg-4">
                        <article class="artifact-card">
                            <div class="artifact-visual" style="background-image: url('https://images.unsplash.com/photo-1581578731548-c64695cc6952?q=80&w=800&auto=format&fit=crop');">
                                <div class="position-absolute top-0 end-0 p-3">
                                    <span class="badge-status status-active">{{ s.category.name|upper }}</span>
                                </div>
                            </div>
                            <div class="p-4">
                                <h4 class="luxury-serif text-white h5 mb-3">{{ s.title }}</h4>
                                <p class="text-dim text-xs mb-4 line-clamp-2">{{ s.description|default('Artifact description pending synchronization.') }}</p>
                                
                                <div class="d-flex justify-content-between align-items-center pt-4 border-top border-white border-opacity-5">
                                    <div>
                                        <div class="text-xxs text-dim fw-800">RESERVE PRICE</div>
                                        <div class="price-tag-spatial">₹{{ s.price|number_format }}</div>
                                    </div>
                                    <a href="{{ path('app_service_show', {'id': s.id}) }}" class="btn-action-spatial text-teal"><i class="fas fa-arrow-right"></i></a>
                                </div>
                            </div>
                        </article>
                    </div>
                {% endfor %}
            </div>
        </div>
    </section>
</main>

<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
<script>
    function nextStep(mood, description) {
        document.getElementById('mood-input').value = mood;
        document.getElementById('intent-display').innerText = description.toUpperCase();
        document.getElementById('step-1').classList.remove('active');
        document.getElementById('step-2').classList.add('active');
    }

    function prevStep() {
        document.getElementById('step-2').classList.remove('active');
        document.getElementById('step-1').classList.add('active');
    }

    // --- Three.js Obsidian Background ---
    document.addEventListener('DOMContentLoaded', () => {
        const canvas = document.getElementById('three-canvas');
        if(!canvas) return;

        const scene = new THREE.Scene();
        const camera = new THREE.PerspectiveCamera(75, window.innerWidth/window.innerHeight, 0.1, 1000);
        const renderer = new THREE.WebGLRenderer({ canvas: canvas, alpha: true, antialias: true });
        renderer.setSize(window.innerWidth, window.innerHeight);

        // Particles
        const geom = new THREE.BufferGeometry();
        const count = 1200;
        const pos = new Float32Array(count * 3);
        for(let i=0; i<count*3; i++) pos[i] = (Math.random() - 0.5) * 12;
        geom.setAttribute('position', new THREE.BufferAttribute(pos, 3));
        
        const mat = new THREE.PointsMaterial({ size: 0.015, color: 0x00ffd5, transparent: true, opacity: 0.6 });
        const points = new THREE.Points(geom, mat);
        scene.add(points);

        // Abstract Wireframe
        const wireGeom = new THREE.TorusKnotGeometry(2, 0.6, 100, 16);
        const wireMat = new THREE.MeshBasicMaterial({ color: 0x8b5cf6, wireframe: true, transparent: true, opacity: 0.05 });
        const mesh = new THREE.Mesh(wireGeom, wireMat);
        scene.add(mesh);

        camera.position.z = 5;

        let mouseX = 0, mouseY = 0;
        document.addEventListener('mousemove', (e) => {
            mouseX = (e.clientX / window.innerWidth) - 0.5;
            mouseY = (e.clientY / window.innerHeight) - 0.5;
        });

        function animate() {
            requestAnimationFrame(animate);
            points.rotation.y += 0.001;
            points.position.x += (mouseX * 0.5 - points.position.x) * 0.05;
            points.position.y += (-mouseY * 0.5 - points.position.y) * 0.05;
            mesh.rotation.x += 0.002;
            mesh.rotation.y += 0.003;
            renderer.render(scene, camera);
        }
        animate();

        window.addEventListener('resize', () => {
            camera.aspect = window.innerWidth / window.innerHeight;
            camera.updateProjectionMatrix();
            renderer.setSize(window.innerWidth, window.innerHeight);
        });
    });
</script>
{% endblock %}