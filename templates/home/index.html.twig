{% extends 'base.html.twig' %}

{% block title %}ServiceHub — Trusted Professional Services{% endblock %}

{% block stylesheets %}
<style>
    /* ── ALEXANDRIA LAYOUT SYSTEM ── */
    .alex-section { padding: var(--space-lg) 0; }
    .alex-section-lg { padding: var(--space-xl) 0; }
    
    /* Hero */
    .alex-hero {
        position: relative;
        min-height: 90vh;
        display: flex;
        align-items: center;
        overflow: hidden;
        background-color: var(--color-background);
    }
    .hero-visual {
        position: absolute;
        inset: 0;
        z-index: 0;
    }
    .hero-visual img {
        width: 100%; height: 100%;
        object-cover: cover;
        filter: grayscale(20%) brightness(0.7);
    }
    .hero-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(to right, var(--color-background) 0%, rgba(250, 249, 250, 0.4) 50%, transparent 100%);
    }
    .hero-content {
        position: relative;
        z-index: 10;
        max-width: 850px;
    }
    .hero-tagline {
        font-family: var(--font-label);
        font-size: 0.75rem;
        letter-spacing: 0.3em;
        color: var(--color-primary);
        margin-bottom: 1.5rem;
        display: block;
    }
    .hero-title {
        font-size: clamp(3.5rem, 8vw, 6rem);
        line-height: 1.1;
        margin-bottom: 2rem;
    }
    .hero-description {
        font-size: 1.25rem;
        color: var(--color-on-surface-variant);
        max-width: 600px;
        margin-bottom: 2.5rem;
    }

    /* Philosophy */
    .philosophy-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: var(--space-lg);
        align-items: center;
    }
    .philosophy-image-container {
        position: relative;
        aspect-ratio: 4/5;
        background: var(--surface-low);
        border-radius: var(--radius-lg);
        overflow: hidden;
    }
    .philosophy-image-container img {
        width: 100%; height: 100%;
        object-fit: cover;
        mix-blend-mode: multiply;
        opacity: 0.8;
    }
    .philosophy-border {
        position: absolute;
        inset: 3rem;
        border: 1px solid rgba(0, 107, 90, 0.2);
        pointer-events: none;
    }

    /* Bento Grid (Categories) */
    .bento-grid {
        display: grid;
        grid-template-columns: repeat(12, 1fr);
        grid-template-rows: repeat(2, 400px);
        gap: 1.5rem;
    }
    .bento-item {
        position: relative;
        border-radius: var(--radius-lg);
        overflow: hidden;
        background: var(--surface-mid);
    }
    .bento-item img {
        position: absolute;
        inset: 0;
        width: 100%; height: 100%;
        object-fit: cover;
        transition: transform 0.7s var(--ease-luxury);
    }
    .bento-item:hover img { transform: scale(1.05); }
    .bento-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(to top, rgba(0,0,0,0.8) 0%, transparent 60%);
    }
    .bento-content {
        position: absolute;
        bottom: 2rem; left: 2rem;
        color: #ffffff;
    }
    .bento-tag {
        font-family: var(--font-label);
        font-size: 0.65rem;
        letter-spacing: 0.3em;
        opacity: 0.7;
    }
    .bento-title { font-size: 1.8rem; margin-top: 0.5rem; color: #fff !important; }

    .col-span-8 { grid-column: span 8; }
    .col-span-4 { grid-column: span 4; }

    /* Experts / Fellows */
    .expert-card {
        transition: all 0.5s var(--ease-luxury);
    }
    .expert-portrait {
        aspect-ratio: 3/4;
        background: var(--surface-high);
        border-radius: var(--radius-lg);
        overflow: hidden;
        margin-bottom: 2rem;
    }
    .expert-portrait img {
        width: 100%; height: 100%;
        object-fit: cover;
        filter: grayscale(1) brightness(0.9);
        transition: all 0.5s var(--ease-luxury);
    }
    .expert-card:hover .expert-portrait img { filter: grayscale(0) brightness(1); }
    .expert-discipline {
        font-family: var(--font-label);
        font-size: 0.65rem;
        color: var(--color-primary);
        font-weight: 700;
        letter-spacing: 0.3em;
    }
    .expert-quote {
        font-size: 1rem;
        font-style: italic;
        color: var(--color-on-surface-variant);
        line-height: 1.6;
    }

    /* CTA Card */
    .cta-card {
        background: #1b1c1d;
        border-radius: 2rem;
        padding: 5rem;
        text-align: center;
        position: relative;
        overflow: hidden;
    }
    .cta-bg {
        position: absolute;
        inset: 0;
        opacity: 0.1;
        pointer-events: none;
    }
    .cta-bg img { width: 100%; height: 100%; object-fit: cover; }
    .cta-content { position: relative; z-index: 10; }
    .cta-title { color: #ffffff !important; font-size: 3rem; margin-bottom: 2rem; }
    .cta-text { color: #a3a3a3; font-size: 1.125rem; max-width: 600px; margin: 0 auto 3rem; }

    /* Responsive */
    @media (max-width: 992px) {
        .philosophy-grid { grid-template-columns: 1fr; }
        .bento-grid { grid-template-rows: auto; }
        .col-span-8, .col-span-4 { grid-column: span 12; height: 350px; }
        .cta-card { padding: 3rem 1.5rem; }
    }
</style>
{% endblock %}

