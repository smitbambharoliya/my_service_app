{% extends 'base.html.twig' %}

{% block title %}ServiceHub — Luxury Digital Heritage Redefined{% endblock %}

{% block stylesheets %}
<style>
    /* ── IMMERSIVE HERO ── */
    .hero-luxury {
        position: relative;
        padding: 240px 0 180px;
        background: transparent;
        min-height: 100vh;
        display: flex;
        align-items: center;
        overflow: hidden;
    }
    
    .hero-bg-bloom {
        position: absolute;
        width: 1200px; height: 1200px;
        background: radial-gradient(circle, rgba(16, 185, 129, 0.05) 0%, transparent 70%);
        top: -400px; right: -400px;
        z-index: 1; pointer-events: none;
    }

    .hero-bg-bloom-alt {
        position: absolute;
        width: 800px; height: 800px;
        background: radial-gradient(circle, rgba(139, 92, 246, 0.03) 0%, transparent 70%);
        bottom: -200px; left: -200px;
        z-index: 1; pointer-events: none;
    }

    .hero-content { position: relative; z-index: 10; }

    /* AI Sommelier Interface */
    .sommelier-interface {
        max-width: 850px;
        margin: 80px auto 0;
        background: var(--glass-bg);
        backdrop-filter: blur(var(--glass-blur));
        -webkit-backdrop-filter: blur(var(--glass-blur));
        border: 1px solid var(--glass-border);
        border-radius: 32px;
        padding: 50px;
        text-align: left;
        box-shadow: var(--shadow-elevated);
    }

    .discovery-step { display: none; }
    .discovery-step.active { display: block; animation: fadeInUp 0.8s var(--ease-luxury); }

    .mood-option {
        background: var(--glass-bg);
        border: 1px solid var(--glass-border);
        padding: 25px;
        border-radius: 20px;
        cursor: pointer;
        transition: all 0.5s var(--ease-luxury);
        text-align: center;
        height: 100%;
    }
    .mood-option:hover {
        border-color: var(--color-primary);
        background: var(--glass-bg-hover);
        transform: translateY(-8px);
        box-shadow: var(--shadow-elevated);
    }

    /* Exhibits Gallery */
    .archive-section { padding: 180px 0; background: transparent; border-top: 1px solid var(--glass-border); }
    
    .heritage-exhibit {
        background: var(--glass-bg);
        border-radius: 28px;
        overflow: hidden;
        border: 1px solid var(--glass-border);
        transition: all 0.6s var(--ease-luxury);
        height: 100%;
    }
    .heritage-exhibit:hover {
        border-color: var(--accent-gold);
        transform: translateY(-12px);
        box-shadow: 0 40px 80px rgba(0,0,0,0.7);
    }
    .heritage-view {
        height: 280px;
        background-size: cover;
        background-position: center;
        position: relative;
    }
    .heritage-view::after {
        content: ''; position: absolute; inset: 0;
        background: linear-gradient(to bottom, transparent 20%, rgba(10, 14, 22, 0.95) 100%);
    }

    @keyframes fadeInUp {
        from { opacity: 0; transform: translateY(40px); }
        to { opacity: 1; transform: translateY(0); }
    }
</style>
{% endblock %}

{% block body %}

<main>
    {# ── 1. LUXURY HERO ── #}
    <div class="cyber-grid"></div>
    <section class="hero-luxury">
        <div class="hero-bg-bloom"></div>
        <div class="hero-bg-bloom-alt"></div>
        
        <div class="container hero-content text-center">
            <div class="fade-up float-element">
                <span class="text-holographic text-xxs fw-800 letter-spacing-4 mb-4 d-inline-block px-3 py-1" style="background-color: var(--glass-bg); border-radius: 20px; border: 1px solid var(--glass-border);">ESTABLISHED 2024</span>
                <h1 class="luxury-serif text-holographic mb-4" style="font-size: clamp(3.5rem, 10vw, 6rem); line-height: 0.9;">
                    The Digital <span style="color: var(--color-on-surface); -webkit-text-fill-color: var(--color-on-surface);">Heritage</span><br>Concierge.
                </h1>
                <p class="text-on-surface-variant mx-auto mb-5 opacity-70" style="max-width:750px; font-size: 1.25rem; letter-spacing: 0.02em; line-height: 1.6;">
                    Connect with elite technical curators through our high-fidelity ecosystem. <br class="d-none d-md-block"> Engineering excellence, delivered with artisanal precision.
                </p>
            </div>

            {# AI SOMMELIER INTERFACE #}
            <div class="sommelier-interface glow-border fade-up" style="animation-delay: 0.4s;">
                <div id="sommelier-content">
                    <!-- Step 1: Intent Selection -->
                    <div class="discovery-step active" id="step-1">
                        <div class="d-flex justify-content-between align-items-center mb-5">
                            <div>
                                <h3 class="luxury-serif mb-1">AI Sommelier Protocol</h3>
                                <div class="text-xxs text-on-surface-variant fw-800 letter-spacing-1">SELECT OPERATIONAL INTENT</div>
                            </div>
                            <div class="text-xxs text-teal fw-800 letter-spacing-2">PHASE 01 / 02</div>
                        </div>
                        
                        <div class="row g-4">
                            <div class="col-md-4">
                                <div class="mood-option glow-border" onclick="nextStep('Emergent', 'High-priority restoration required.')">
                                    <i class="fas fa-bolt-lightning text-holographic mb-4 fs-3"></i>
                                    <div class="fw-800 text-on-surface text-xs letter-spacing-2 mb-2">EMERGENT</div>
                                    <div class="text-xxs text-on-surface-variant">Urgent structural or electrical restoration nodes.</div>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="mood-option glow-border" onclick="nextStep('Curated', 'Bespoke professional consultation.')">
                                    <i class="fas fa-chess-knight text-holographic mb-4 fs-3"></i>
                                    <div class="fw-800 text-on-surface text-xs letter-spacing-2 mb-2">CURATED</div>
                                    <div class="text-xxs text-on-surface-variant">Specialized engineering and aesthetic architectural updates.</div>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="mood-option glow-border" onclick="nextStep('Routine', 'Seamless preventive maintenance.')">
                                    <i class="fas fa-leaf text-holographic mb-4 fs-3"></i>
                                    <div class="fw-800 text-on-surface text-xs letter-spacing-2 mb-2">ROUTINE</div>
                                    <div class="text-xxs text-on-surface-variant">Standardized hygiene and climate control preservation.</div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Step 2: Parameter Refinement -->
                    <div class="discovery-step" id="step-2">
                        <div class="d-flex justify-content-between align-items-center mb-5">
                            <div class="d-flex align-items-center gap-4">
                                <button class="bg-transparent border-0 text-on-surface-variant hover:text-on-surface transition-all" onclick="prevStep()"><i class="fas fa-arrow-left"></i></button>
                                <div>
                                    <h3 class="luxury-serif mb-1">Refine Parameters</h3>
                                    <div class="text-xxs text-teal fw-800 letter-spacing-1" id="intent-display">PHASE 02 / 02</div>
                                </div>
                            </div>
                        </div>
                        
                        <form action="{{ path('app_service_list') }}" method="GET">
                            <input type="hidden" name="mood" id="mood-input">
                            <div class="row g-4">
                                <div class="col-md-6">
                                    <label class="text-xxs text-on-surface-variant fw-800 letter-spacing-2 mb-3 d-block">TECHNICAL SECTOR</label>
                                    <select name="category" class="luxury-input py-3">
                                        <option value="">Scanning all sectors...</option>
                                        <option value="Structural">Structural (Hydraulics & Drainage)</option>
                                        <option value="Electrical">Electrical (Power & Photonics)</option>
                                        <option value="Sanitization">Sanitization (Molecular Hygiene)</option>
                                        <option value="Climate">Climate (HVAC Control)</option>
                                    </select>
                                </div>
                                <div class="col-md-6">
                                    <label class="text-xxs text-on-surface-variant fw-800 letter-spacing-2 mb-3 d-block">SENSORY ANALYTICS</label>
                                    <input type="text" name="q" class="luxury-input py-3" placeholder="Identify specific symptoms or requirements...">
                                </div>
                                <div class="col-12 mt-4 text-end">
                                    <button type="submit" class="btn-luxury px-5 py-3">INITIATE ARCHIVE SCAN <i class="fas fa-chevron-right ms-2"></i></button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </section>

    {# ── 2. ARCHIVE PREVIEW ── #}
    <section class="archive-section">
        <div class="container">
            <div class="d-flex justify-content-between align-items-end mb-5 pb-4">
                <div>
                    <span class="text-gold text-xxs fw-800 letter-spacing-3 mb-3 d-block">THE ARCHIVE</span>
                    <h2 class="luxury-serif text-on-surface mb-0" style="font-size: 3rem;">Executive Exhibits</h2>
                </div>
                <a href="{{ path('app_service_list') }}" class="btn-outline-luxury py-2 px-4 shadow-none" style="font-size:0.7rem;">ACCESS FULL COLLECTION</a>
            </div>

            <div class="row g-5">
                {% if sections.trending is defined and sections.trending|length > 0 %}
                    {% for s in sections.trending|slice(0, 3) %}
                        <div class="col-lg-4 float-element" style="animation-delay: {{ loop.index0 * 0.2 }}s;">
                            <div class="heritage-exhibit glow-border">
                                <div class="heritage-view" style="background-image: url('https://images.unsplash.com/photo-1581578731548-c64695cc6952?q=80&w=800&auto=format&fit=crop');">
                                    <div class="position-absolute bottom-0 start-0 p-4 w-100 d-flex justify-content-between align-items-end">
                                        <span class="badge-status status-active">{{ s.category.name|upper }}</span>
                                        <div class="text-xxs text-on-surface-variant fw-800">ARTIFACT #{{ s.id }}</div>
                                    </div>
                                </div>
                                <div class="p-4 pt-5">
                                    <h4 class="luxury-serif text-on-surface mb-3" style="font-size: 1.4rem;">{{ s.title }}</h4>
                                    <p class="text-xs text-on-surface-variant opacity-60 mb-5" style="height: 40px; overflow: hidden; line-height: 1.6;">{{ s.description|slice(0, 90) }}...</p>
                                    
                                    <div class="d-flex justify-content-between align-items-center pt-4" style="border-top: 1px solid var(--glass-border);">
                                        <div>
                                            <div class="text-on-surface h5 mb-0 fw-800">₹{{ s.price|number_format }}</div>
                                            <div class="text-xxs text-on-surface-variant fw-800 mt-1">BASE RESERVE</div>
                                        </div>
                                        <a href="{{ path('app_service_show', {'id': s.id}) }}" class="btn-outline py-2 px-3" style="font-size: 0.65rem;">EXAMINE</a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                {% else %}
                    <div class="col-12 text-center py-5">
                        <div class="glass-card py-5 border-dashed">
                            <p class="text-on-surface-variant mb-0">The Archive is currently undergoing synchronization. Return momentarily.</p>
                            <a href="{{ path('app_service_list') }}" class="btn-luxury mt-4">FORCE SCAN</a>
                        </div>
                    </div>
                {% endif %}
            </div>
        </div>
    </section>
</main>

<script>
    function nextStep(mood, description) {
        document.getElementById('mood-input').value = mood;
        document.getElementById('intent-display').innerText = description;
        document.getElementById('step-1').classList.remove('active');
        document.getElementById('step-2').classList.add('active');
    }

    function prevStep() {
        document.getElementById('step-2').classList.remove('active');
        document.getElementById('step-1').classList.add('active');
    }
</script>

{% endblock %}