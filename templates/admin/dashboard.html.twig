{% extends 'admin/admin_base.html.twig' %}

{% block title %}Admin Dashboard - ServiceHub{% endblock %}
{% block page_title %}Dashboard{% endblock %}
{% block breadcrumb %}<li class="breadcrumb-item active">Overview</li>{% endblock %}

{% block body %}
{# Stats Row #}
<div class="row g-4 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-glow" style="background:#3b82f6;"></div>
            <div class="stat-icon" style="background:rgba(59,130,246,0.15); color:#60a5fa;">
                <i class="fas fa-users"></i>
            </div>
            <div class="stat-value">{{ users_count }}</div>
            <div class="stat-label">Total Users</div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-glow" style="background:#22c55e;"></div>
            <div class="stat-icon" style="background:rgba(34,197,94,0.15); color:#4ade80;">
                <i class="fas fa-cogs"></i>
            </div>
            <div class="stat-value">{{ services_count }}</div>
            <div class="stat-label">Active Services</div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-glow" style="background:#a855f7;"></div>
            <div class="stat-icon" style="background:rgba(168,85,247,0.15); color:#c084fc;">
                <i class="fas fa-calendar-check"></i>
            </div>
            <div class="stat-value">{{ bookings_count }}</div>
            <div class="stat-label">Total Bookings</div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-glow" style="background:#f59e0b;"></div>
            <div class="stat-icon" style="background:rgba(245,158,11,0.15); color:#fbbf24;">
                <i class="fas fa-rupee-sign"></i>
            </div>
            <div class="stat-value">₹{{ revenue|number_format }}</div>
            <div class="stat-label">Est. Revenue</div>
        </div>
    </div>
</div>

{# Quick Actions #}
<div class="row g-4">
    <div class="col-md-4">
        <div class="admin-card h-100">
            <div class="p-5 text-center">
                <div style="width:64px;height:64px;background:rgba(59,130,246,0.15);border-radius:16px;display:inline-flex;align-items:center;justify-content:center;margin-bottom:16px;">
                    <i class="fas fa-users-cog fa-2x" style="color:#60a5fa;"></i>
                </div>
                <h5 style="color:var(--admin-text);font-weight:700;margin-bottom:8px;">Manage Users</h5>
                <p style="color:var(--admin-text-muted);font-size:0.85rem;margin-bottom:20px;">View, promote, or remove user accounts.</p>
                <a href="{{ path('app_admin_users') }}" class="btn-admin btn-admin-blue">
                    <i class="fas fa-arrow-right"></i> Open Users
                </a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="admin-card h-100">
            <div class="p-5 text-center">
                <div style="width:64px;height:64px;background:rgba(34,197,94,0.15);border-radius:16px;display:inline-flex;align-items:center;justify-content:center;margin-bottom:16px;">
                    <i class="fas fa-cogs fa-2x" style="color:#4ade80;"></i>
                </div>
                <h5 style="color:var(--admin-text);font-weight:700;margin-bottom:8px;">Manage Services</h5>
                <p style="color:var(--admin-text-muted);font-size:0.85rem;margin-bottom:20px;">Review services, toggle premium, or delete.</p>
                <a href="{{ path('app_admin_services') }}" class="btn-admin btn-admin-green">
                    <i class="fas fa-arrow-right"></i> Open Services
                </a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="admin-card h-100">
            <div class="p-5 text-center">
                <div style="width:64px;height:64px;background:rgba(168,85,247,0.15);border-radius:16px;display:inline-flex;align-items:center;justify-content:center;margin-bottom:16px;">
                    <i class="fas fa-calendar-alt fa-2x" style="color:#c084fc;"></i>
                </div>
                <h5 style="color:var(--admin-text);font-weight:700;margin-bottom:8px;">Manage Bookings</h5>
                <p style="color:var(--admin-text-muted);font-size:0.85rem;margin-bottom:20px;">Monitor all bookings and resolve disputes.</p>
                <a href="{{ path('app_admin_bookings') }}" class="btn-admin" style="background:rgba(168,85,247,0.12);color:#c084fc;border-color:rgba(168,85,247,0.2);">
                    <i class="fas fa-arrow-right"></i> Open Bookings
                </a>
            </div>
        </div>
    </div>
</div>

{# Top Providers Section #}
<div class="row">
    <div class="col-12">
        <div class="admin-card">
            <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:20px;">
                <h2 style="margin:0;font-size:1.3rem;font-weight:700;">Top Performers (Service Providers)</h2>
                <a href="{{ path('app_admin_providers') }}" class="btn-admin btn-admin-outline" style="font-size:0.75rem;">View All</a>
            </div>
            <div style="overflow-x:auto;">
                <table class="admin-table">
                    <thead>
                        <tr>
                            <th>Provider</th>
                            <th>Services</th>
                            <th>Status</th>
                            <th style="text-align:right;">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for provider in top_providers %}
                        <tr>
                            <td>
                                <div style="display:flex;align-items:center;gap:10px;">
                                    <div class="user-avatar" style="background:linear-gradient(135deg, #10b981, #3b82f6);">{{ provider.email|slice(0,1)|upper }}</div>
                                    <div>
                                        <div style="font-size:0.875rem;font-weight:600;color:var(--admin-text);">{{ provider.fullName|default('N/A') }}</div>
                                        <div style="font-size:0.75rem;color:var(--admin-text-muted);">{{ provider.email }}</div>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <span class="badge-admin badge-admin-gray">{{ provider.services|length }} Active Listings</span>
                            </td>
                            <td>
                                {% if provider.isActive %}
                                    <span class="badge-admin badge-admin-green">Active</span>
                                {% else %}
                                    <span class="badge-admin badge-admin-red">Suspended</span>
                                {% endif %}
                            </td>
                            <td style="text-align:right;">
                                <form action="{{ path('app_admin_user_toggle_status', {id: provider.id}) }}" method="POST">
                                    <button type="submit" class="btn-admin btn-admin-outline" style="padding:4px 8px;font-size:0.7rem;">
                                        <i class="fas {{ provider.isActive ? 'fa-user-slash text-danger' : 'fa-user-check text-success' }}"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                        {% else %}
                        <tr><td colspan="4" style="text-align:center;padding:20px;color:var(--admin-text-muted);">Launch your platform to see top performers here!</td></tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
{% endblock %}
