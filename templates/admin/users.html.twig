{% extends 'admin/admin_base.html.twig' %}

{% block title %}Identity Index — ServiceHub Admin{% endblock %}
{% block page_title %}Identity Index{% endblock %}

{% block body %}
<div class="reveal-3d">
    {# ── ACTION HEADER ── #}
    <div class="d-flex align-items-center justify-content-between mb-5">
        <div>
            <span class="text-xxs fw-800 letter-spacing-2 text-teal d-block mb-1">USER REPOSITORY</span>
            <h2 class="luxury-serif text-pure mb-0">Identity Management</h2>
            <p class="text-dim text-xs mt-2">
                Active Nodes: <strong class="text-white">{{ users.getTotalItemCount() }}</strong> Registered Identities
            </p>
        </div>
        <div class="d-flex gap-3">
            <a href="{{ path('app_admin_users_export') }}" class="btn-outline-luxury py-2 px-4" style="font-size: 0.75rem;">
                <i class="fas fa-file-export me-2"></i> EXPORT LEDGER
            </a>
            <a href="{{ path('app_admin_user_new') }}" class="btn-luxury py-2 px-4" style="font-size: 0.75rem;">
                <i class="fas fa-user-plus me-2"></i> INITIALIZE NEW NODE
            </a>
        </div>
    </div>

    <div class="admin-filter-console">
        <form method="GET" class="row g-3 align-items-end">
            <div class="col-lg-4">
                <label for="user-search">Search</label>
                <input id="user-search" type="text" name="search" class="form-control" placeholder="Name, email, mobile..." value="{{ search|default('') }}">
            </div>
            <div class="col-md-3 col-lg-2">
                <label for="user-role">Role</label>
                <select id="user-role" name="role" class="form-select">
                    <option value="">All roles</option>
                    <option value="ROLE_ADMIN" {{ role_filter|default('') == 'ROLE_ADMIN' ? 'selected' : '' }}>Admins</option>
                    <option value="ROLE_PROVIDER" {{ role_filter|default('') == 'ROLE_PROVIDER' ? 'selected' : '' }}>Providers</option>
                    <option value="ROLE_USER" {{ role_filter|default('') == 'ROLE_USER' ? 'selected' : '' }}>Customers</option>
                </select>
            </div>
            <div class="col-md-3 col-lg-2">
                <label for="user-status">Status</label>
                <select id="user-status" name="status" class="form-select">
                    <option value="">All status</option>
                    <option value="active" {{ status_filter|default('') == 'active' ? 'selected' : '' }}>Active</option>
                    <option value="inactive" {{ status_filter|default('') == 'inactive' ? 'selected' : '' }}>Suspended</option>
                </select>
            </div>
            <div class="col-md-3 col-lg-2">
                <label for="user-sort">Sort</label>
                <select id="user-sort" name="sort" class="form-select">
                    <option value="newest" {{ sort_filter|default('newest') == 'newest' ? 'selected' : '' }}>Newest first</option>
                    <option value="oldest" {{ sort_filter|default('newest') == 'oldest' ? 'selected' : '' }}>Oldest first</option>
                </select>
            </div>
            <div class="col-md-3 col-lg-2 admin-filter-actions">
                <button type="submit" class="btn-luxury w-100 py-2">FILTER</button>
                <a href="{{ path('app_admin_users') }}" class="btn-outline-luxury py-2 px-3" title="Clear filters"><i class="fas fa-rotate-left"></i></a>
            </div>
        </form>
    </div>

    {# ── IDENTITY GRID ── #}
    <div class="row g-4">
        {% for user in users %}
            <div class="col-xl-6 col-xxl-4">
                <div class="glass-card p-0 overflow-hidden border-glow-hover h-100 d-flex flex-column">
                    {# Node Header #}
                    <div class="p-4 d-flex justify-content-between align-items-center border-bottom border-white border-opacity-5">
                        <div class="d-flex align-items-center gap-3">
                            <div class="user-orb-wrap">
                                <div class="user-orb" style="width: 52px; height: 52px; font-size: 1.3rem; background: linear-gradient(135deg, #6366f1, #4f46e5);">
                                    {{ user.email|slice(0,1)|upper }}
                                </div>
                                <div class="status-dot {{ user.isActive ? 'online' : 'offline' }}"></div>
                            </div>
                            <div>
                                <div class="fw-bold text-white small">{{ user.fullName|default('Identity Unknown') }}</div>
                                <div class="text-dim font-monospace" style="font-size: 0.65rem;">{{ user.email }}</div>
                            </div>
                        </div>
                        <div class="text-end">
                            <div class="text-xxs text-dim fw-800 mb-1">DESIGNATION</div>
                            {% if 'ROLE_ADMIN' in user.roles %}
                                <span class="badge-status" style="background:rgba(255,93,115,0.1); color:#ff5d73; border-color:rgba(255,93,115,0.2);">ADMIN</span>
                            {% elseif 'ROLE_PROVIDER' in user.roles %}
                                <span class="badge-status" style="background:rgba(0,255,213,0.1); color:#00ffd5; border-color:rgba(0,255,213,0.2);">PROVIDER</span>
                            {% else %}
                                <span class="badge-status" style="background:rgba(255,255,255,0.05); color:#a9b7c8; border-color:rgba(255,255,255,0.1);">CUSTOMER</span>
                            {% endif %}
                        </div>
                    </div>

                    {# Node Metadata #}
                    <div class="p-4 flex-grow-1">
                        <div class="row g-3 mb-4">
                            <div class="col-6">
                                <div class="text-xxs text-dim fw-800 mb-1">VERIFICATION</div>
                                {% if user.isVerified %}
                                    <span class="text-teal text-xxs fw-bold"><i class="fas fa-check-circle me-1"></i> VERIFIED</span>
                                {% else %}
                                    <span class="text-muted text-xxs fw-bold"><i class="fas fa-circle-notch me-1"></i> PENDING</span>
                                {% endif %}
                            </div>
                            <div class="col-6 text-end">
                                <div class="text-xxs text-dim fw-800 mb-1">FIDELITY (TIER)</div>
                                <span class="text-white small fw-bold">{{ user.tier|upper }}</span>
                            </div>
                        </div>

                        <div class="p-2 rounded-3 bg-surface border-glass text-center mb-0">
                            <span class="text-xxs text-dim fw-800 me-2">NODE JOINED:</span>
                            <span class="text-white font-monospace small">{{ user.dot ? user.dot|date('M d, Y') : '—' }}</span>
                        </div>
                    </div>

                    {# Action Terminal #}
                    <div class="p-3 bg-surface border-top border-white border-opacity-5 mt-auto">
                        <div class="d-flex justify-content-center gap-3">
                            <form action="{{ path('app_admin_user_toggle_status', {id: user.id}) }}" method="POST" class="m-0" onsubmit="return confirm('Toggle node connectivity?');">
                                <button type="submit" class="btn-action-spatial {{ user.isActive ? 'text-red' : 'text-teal' }}" title="{{ user.isActive ? 'Sever Link' : 'Restore Link' }}">
                                    <i class="fas {{ user.isActive ? 'fa-user-slash' : 'fa-user-check' }}"></i>
                                </button>
                            </form>

                            {% if 'ROLE_ADMIN' not in user.roles %}
                                <form action="{{ path('app_admin_user_promote', {id: user.id}) }}" method="POST" class="m-0">
                                    <input type="hidden" name="_token" value="{{ csrf_token('promote' ~ user.id) }}">
                                    <button type="submit" class="btn-action-spatial text-blue" title="Elevate to Admin">
                                        <i class="fas fa-level-up-alt"></i>
                                    </button>
                                </form>
                            {% endif %}
                            
                            <form action="{{ path('app_admin_user_delete', {id: user.id}) }}" method="POST" class="m-0" onsubmit="return confirm('Purge node from database?');">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ user.id) }}">
                                <button type="submit" class="btn-action-spatial text-red" title="Purge Identity">
                                    <i class="fas fa-trash-alt"></i>
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        {% else %}
            <div class="col-12">
                <div class="glass-card py-5 text-center border-dashed">
                    <i class="fas fa-users-slash fs-1 text-dim mb-4"></i>
                    <h4 class="luxury-serif">Identity Index Empty</h4>
                    <p class="text-dim small">No user nodes detected in the current matrix.</p>
                </div>
            </div>
        {% endfor %}
    </div>

    {# ── PAGINATION ── #}
    <div class="d-flex justify-content-center mt-5">
        <div class="glass-card p-2 border-0 shadow-none">
            {{ knp_pagination_render(users) }}
        </div>
    </div>
</div>

<style>
    .user-orb-wrap { position: relative; }
    .status-dot {
        position: absolute; bottom: 2px; right: 2px;
        width: 12px; height: 12px; border-radius: 50%;
        border: 2px solid #080a0f;
    }
    .status-dot.online { background: var(--accent-cyan); box-shadow: 0 0 10px var(--accent-cyan); }
    .status-dot.offline { background: var(--accent-red); }

    .border-glow-hover:hover {
        border-color: rgba(0, 255, 213, 0.3) !important;
        box-shadow: 0 20px 50px rgba(0, 0, 0, 0.4) !important;
        transform: translateY(-5px);
    }
    .bg-surface { background: rgba(255, 255, 255, 0.02); }
    .border-glass { border: 1px solid rgba(255, 255, 255, 0.1); }
    
    .btn-action-spatial {
        width: 40px; height: 40px;
        border-radius: 10px;
        display: flex; align-items: center; justify-content: center;
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.1);
        transition: all 0.3s var(--ease-spatial);
        cursor: pointer;
    }
    .btn-action-spatial:hover {
        background: rgba(255, 255, 255, 0.1);
        transform: scale(1.1);
        border-color: currentColor;
    }
</style>
{% endblock %}
