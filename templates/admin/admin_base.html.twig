<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>{% block title %}System Command — ServiceHub Admin{% endblock %}</title>
        
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700;800&family=Playfair+Display:ital,wght@0,700;1,700&display=swap" rel="stylesheet">
        
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
        <link rel="stylesheet" href="{{ asset('styles/app.css') }}">

        <style>
            :root {
                --accent-cyan: #00ffd5;
                --accent-blue: #4ca7ff;
                --accent-red: #ff5d73;
                --bg-obsidian: #05070a;
                --glass-border: rgba(255, 255, 255, 0.12);
                --radius-cyber: 28px;
                --ease-spatial: cubic-bezier(0.23, 1, 0.32, 1);
            }

            body {
                background: var(--bg-obsidian);
                /* Cyber Grid & Ambient Glows */
                background-image: 
                    radial-gradient(at 0% 0%, rgba(0, 255, 213, 0.07) 0px, transparent 40%),
                    radial-gradient(at 100% 100%, rgba(255, 93, 115, 0.05) 0px, transparent 40%),
                    linear-gradient(rgba(255, 255, 255, 0.015) 1px, transparent 1px),
                    linear-gradient(90deg, rgba(255, 255, 255, 0.015) 1px, transparent 1px);
                background-size: 100% 100%, 100% 100%, 60px 60px, 60px 60px;
                color: #f7fbff;
                height: 100vh;
                margin: 0; padding: 0;
                display: flex; align-items: center; justify-content: center;
                overflow: hidden;
            }

            .app-container {
                width: calc(100% - 40px);
                height: calc(100vh - 40px);
                max-width: 1720px;
                display: flex;
                gap: 20px;
            }

            /* ── SPATIAL SIDEBAR ── */
            #admin-sidebar {
                width: 280px;
                background: rgba(10, 15, 25, 0.75);
                backdrop-filter: blur(40px) saturate(150%);
                -webkit-backdrop-filter: blur(40px) saturate(150%);
                border: 1px solid var(--glass-border);
                border-radius: var(--radius-cyber);
                display: flex;
                flex-direction: column;
                flex-shrink: 0;
                box-shadow: 0 30px 60px rgba(0,0,0,0.5), inset 0 1px 1px rgba(255,255,255,0.1);
            }

            .sidebar-brand {
                padding: 35px 30px;
                border-bottom: 1px solid var(--glass-border);
            }
            .brand-logo {
                font-family: 'Playfair Display', serif;
                font-weight: 800; font-size: 1.5rem;
                color: #fff;
            }
            .brand-logo span { color: var(--accent-cyan); text-shadow: 0 0 15px rgba(0,255,213,0.4); }

            .admin-profile {
                padding: 25px 30px;
                background: rgba(255,255,255,0.03);
                border-bottom: 1px solid var(--glass-border);
            }
            .admin-avatar {
                width: 50px; height: 50px;
                border-radius: 14px;
                background: linear-gradient(135deg, #4ca7ff, var(--accent-cyan));
                display: flex; align-items: center; justify-content: center;
                font-weight: 800; color: #000; font-size: 1.3rem;
                box-shadow: 0 0 20px rgba(0, 255, 213, 0.2);
            }

            .nav-item-link {
                margin: 4px 15px;
                padding: 13px 18px;
                border-radius: 14px;
                color: rgba(247,251,255,0.65);
                font-weight: 600; font-size: 0.88rem;
                transition: all 0.3s var(--ease-spatial);
                display: flex; align-items: center; gap: 14px;
                text-decoration: none;
            }
            .nav-item-link i { font-size: 1.1rem; color: #475569; transition: inherit; }

            .nav-item-link:hover {
                background: rgba(255,255,255,0.05);
                color: #fff;
                transform: translateX(5px);
            }

            .nav-item-link.active {
                background: rgba(0, 255, 213, 0.1);
                color: var(--accent-cyan);
                border: 1px solid rgba(0, 255, 213, 0.2);
                box-shadow: 0 0 25px rgba(0, 255, 213, 0.05);
            }
            .nav-item-link.active i { color: var(--accent-cyan); }

            /* ── MAIN COMMAND AREA ── */
            #admin-content {
                flex: 1;
                background: rgba(10, 15, 25, 0.55);
                backdrop-filter: blur(34px);
                -webkit-backdrop-filter: blur(34px);
                border: 1px solid var(--glass-border);
                border-radius: var(--radius-cyber);
                display: flex;
                flex-direction: column;
                overflow-y: auto;
                padding: 40px;
                box-shadow: 0 24px 70px rgba(0,0,0,0.3);
            }

            #admin-content::-webkit-scrollbar { width: 6px; }
            #admin-content::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.1); border-radius: 10px; }

            .admin-topbar {
                display: flex; align-items: center; justify-content: space-between;
                margin-bottom: 40px;
                padding-bottom: 20px;
                border-bottom: 1px solid var(--glass-border);
            }
            .page-title { font-weight: 800; font-size: 1.75rem; letter-spacing: -0.5px; }

            .notif-badge {
                width: 38px; height: 38px;
                border-radius: 12px;
                background: rgba(0, 255, 213, 0.1);
                color: var(--accent-cyan);
                display: flex; align-items: center; justify-content: center;
                text-decoration: none; font-weight: 800;
                border: 1px solid rgba(0, 255, 213, 0.2);
            }

            /* ── SHARED SPATIAL COMPONENTS ── */
            .alert-admin {
                background: rgba(255,255,255,0.05);
                border: 1px solid var(--glass-border);
                border-radius: 16px;
                padding: 16px 20px;
                color: #fff;
                margin-bottom: 25px;
                backdrop-filter: blur(10px);
            }
            .alert-admin-success { border-left: 4px solid #10b981; color: #86efac; }
            .alert-admin-danger { border-left: 4px solid var(--accent-red); color: #fca5a5; }

            .admin-filter-console {
                background: rgba(255,255,255,0.035);
                border: 1px solid var(--glass-border);
                border-radius: 18px;
                padding: 18px;
                margin-bottom: 28px;
            }
            .admin-filter-console label {
                display: block;
                margin-bottom: 8px;
                color: rgba(169, 183, 200, 0.9);
                font-size: 0.65rem;
                font-weight: 800;
                letter-spacing: 0.08em;
                text-transform: uppercase;
            }
            .admin-filter-console .form-control,
            .admin-filter-console .form-select {
                min-height: 42px;
                background: rgba(5, 7, 10, 0.65);
                border: 1px solid rgba(255, 255, 255, 0.12);
                color: #f7fbff;
                border-radius: 12px;
                font-size: 0.82rem;
            }
            .admin-filter-console .form-control::placeholder { color: rgba(169, 183, 200, 0.55); }
            .admin-filter-console .form-control:focus,
            .admin-filter-console .form-select:focus {
                border-color: var(--accent-cyan);
                box-shadow: 0 0 0 0.2rem rgba(0, 255, 213, 0.08);
            }
            .admin-filter-console .form-select option {
                background: #080a0f;
                color: #f7fbff;
            }
            .admin-filter-actions {
                display: flex;
                align-items: end;
                gap: 10px;
            }

            .reveal-3d {
                opacity: 0;
                transform: translateY(20px) scale(0.98);
                transition: all 0.6s var(--ease-spatial);
            }
            .reveal-3d.is-visible {
                opacity: 1;
                transform: translateY(0) scale(1);
            }

            @media (max-width: 1024px) {
                body { overflow: auto; height: auto; padding: 20px 0; }
                .app-container { flex-direction: column; height: auto; }
                #admin-sidebar { width: 100%; height: auto; }
                #admin-content { height: auto; padding: 25px; }
            }
        </style>
        {% block stylesheets %}{% endblock %}
    </head>
    <body>
        <div class="app-container">
            {# ── COMMAND SIDEBAR ── #}
            <nav id="admin-sidebar">
                <div class="sidebar-brand">
                    <div class="brand-logo">Service<span>Hub</span></div>
                </div>

                <div class="admin-profile d-flex align-items-center gap-3">
                    <div class="admin-avatar">{{ app.user.email|slice(0,1)|upper }}</div>
                    <div>
                        <div class="fw-bold" style="font-size: 0.9rem;">{{ app.user.fullName|default('Admin') }}</div>
                        <div class="text-dim" style="font-size: 0.7rem; font-weight: 700; letter-spacing: 1px;">SYSTEM OVERSEER</div>
                    </div>
                </div>

                <div class="sidebar-nav mt-3">
                    <a href="{{ path('app_admin_dashboard') }}" class="nav-item-link {{ app.request.get('_route') == 'app_admin_dashboard' ? 'active' : '' }}">
                        <i class="fas fa-terminal"></i> <span>Telemetry</span>
                    </a>
                    <a href="{{ path('app_admin_users') }}" class="nav-item-link {{ 'user' in app.request.get('_route') ? 'active' : '' }}">
                        <i class="fas fa-user-astronaut"></i> <span>Identity Index</span>
                    </a>
                    <a href="{{ path('app_admin_providers') }}" class="nav-item-link {{ 'provider' in app.request.get('_route') ? 'active' : '' }}">
                        <i class="fas fa-user-tie"></i> <span>Artisan Fleet</span>
                    </a>
                    <a href="{{ path('app_admin_services') }}" class="nav-item-link {{ 'service' in app.request.get('_route') ? 'active' : '' }}">
                        <i class="fas fa-microchip"></i> <span>Archive Units</span>
                    </a>
                    <a href="{{ path('app_admin_categories') }}" class="nav-item-link {{ 'category' in app.request.get('_route') ? 'active' : '' }}">
                        <i class="fas fa-layer-group"></i> <span>Spheres</span>
                    </a>
                    <a href="{{ path('app_admin_bookings') }}" class="nav-item-link {{ 'booking' in app.request.get('_route') ? 'active' : '' }}">
                        <i class="fas fa-satellite"></i> <span>Mission Logs</span>
                    </a>
                </div>

                <div class="sidebar-footer mt-auto p-4 border-top border-white border-opacity-10">
                    <a href="{{ path('app_home') }}" class="nav-item-link m-0 mb-2">
                        <i class="fas fa-door-open"></i> Return to Portal
                    </a>
                    <a href="{{ path('app_logout') }}" class="nav-item-link m-0 text-red" style="background: rgba(255,93,115,0.05);">
                        <i class="fas fa-power-off"></i> Terminate Session
                    </a>
                </div>
            </nav>

            {# ── COMMAND CONTENT AREA ── #}
            <div id="admin-content">
                <header class="admin-topbar">
                    <h1 class="page-title">{% block page_title %}Operational Overview{% endblock %}</h1>
                    <div class="top-actions d-flex gap-3 align-items-center">
                        <div class="d-none d-md-block text-xxs fw-bold text-dim letter-spacing-2"><i class="fas fa-wifi text-teal me-2"></i>SECURE UPLINK</div>
                        <a href="#" class="notif-badge">1</a>
                    </div>
                </header>

                {# Flash Messenger #}
                <div class="reveal-3d is-visible">
                    {% for label, messages in app.flashes %}
                        {% for message in messages %}
                            {% set alertClass = label == 'success' ? 'alert-admin-success' : (label == 'danger' ? 'alert-admin-danger' : '') %}
                            <div class="alert-admin {{ alertClass }} d-flex align-items-center gap-3">
                                <i class="fas {{ label == 'success' ? 'fa-circle-check' : 'fa-triangle-exclamation' }}"></i>
                                {{ message }}
                            </div>
                        {% endfor %}
                    {% endfor %}
                </div>

                <div class="spatial-grid">
                    {% block body %}{% endblock %}
                </div>
            </div>
        </div>

        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
        <script>
            document.addEventListener('DOMContentLoaded', () => {
                const revealObserver = new IntersectionObserver((entries) => {
                    entries.forEach(entry => {
                        if (entry.isIntersecting) {
                            entry.target.classList.add('is-visible');
                            revealObserver.unobserve(entry.target);
                        }
                    });
                }, { threshold: 0.1 });

                document.querySelectorAll('.admin-card, .metric-box, .upgrade-widget, .performer-row, .reveal-3d').forEach((el, i) => {
                    el.classList.add('reveal-3d');
                    el.style.transitionDelay = `${Math.min(i * 50, 400)}ms`;
                    revealObserver.observe(el);
                });
            });
        </script>
        {% block javascripts %}{% endblock %}
    </body>
</html>
