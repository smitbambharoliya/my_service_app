<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>{% block title %}Admin Panel - ServiceHub{% endblock %}</title>
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
        <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
        <style>
            :root {
                --admin-bg: #0f1117;
                --admin-sidebar: #161b27;
                --admin-sidebar-border: rgba(255,255,255,0.06);
                --admin-accent: #ef4444;
                --admin-accent-light: rgba(239, 68, 68, 0.12);
                --admin-text: #e2e8f0;
                --admin-text-muted: #64748b;
                --admin-hover: rgba(255,255,255,0.05);
                --admin-card: #1e2435;
                --admin-card-border: rgba(255,255,255,0.08);
            }

            * { box-sizing: border-box; }

            body {
                font-family: 'Inter', sans-serif;
                background-color: var(--admin-bg);
                color: var(--admin-text);
                overflow-x: hidden;
                min-height: 100vh;
            }

            /* ── Sidebar ── */
            #admin-sidebar {
                min-width: 270px;
                max-width: 270px;
                min-height: 100vh;
                background: var(--admin-sidebar);
                border-right: 1px solid var(--admin-sidebar-border);
                display: flex;
                flex-direction: column;
                position: fixed;
                top: 0; left: 0; bottom: 0;
                z-index: 1000;
                transition: transform 0.3s ease;
            }

            .sidebar-brand {
                padding: 28px 24px 20px;
                border-bottom: 1px solid var(--admin-sidebar-border);
            }
            .sidebar-brand .brand-logo {
                font-size: 1.4rem;
                font-weight: 700;
                letter-spacing: -0.5px;
            }
            .sidebar-brand .brand-logo span { color: var(--admin-accent); }
            .sidebar-brand .brand-badge {
                display: inline-block;
                background: var(--admin-accent-light);
                color: var(--admin-accent);
                font-size: 0.65rem;
                font-weight: 600;
                padding: 2px 8px;
                border-radius: 30px;
                border: 1px solid rgba(239,68,68,0.3);
                letter-spacing: 1px;
                text-transform: uppercase;
            }

            .admin-profile {
                padding: 20px 24px;
                border-bottom: 1px solid var(--admin-sidebar-border);
                display: flex;
                align-items: center;
                gap: 12px;
            }
            .admin-avatar {
                width: 42px; height: 42px;
                background: linear-gradient(135deg, var(--admin-accent), #b91c1c);
                border-radius: 12px;
                display: flex;
                align-items: center;
                justify-content: center;
                font-weight: 700;
                font-size: 1rem;
                flex-shrink: 0;
            }
            .admin-info .name { font-size: 0.9rem; font-weight: 600; color: var(--admin-text); }
            .admin-info .role { font-size: 0.72rem; color: var(--admin-accent); font-weight: 500; }

            /* Nav Menu */
            .sidebar-nav {
                flex: 1;
                padding: 16px 0;
                overflow-y: auto;
            }
            .nav-section-title {
                padding: 12px 24px 6px;
                font-size: 0.65rem;
                text-transform: uppercase;
                letter-spacing: 1.5px;
                color: var(--admin-text-muted);
                font-weight: 600;
            }
            .nav-item-link {
                display: flex;
                align-items: center;
                gap: 12px;
                padding: 11px 24px;
                color: var(--admin-text-muted);
                text-decoration: none;
                font-size: 0.875rem;
                font-weight: 500;
                border-right: 3px solid transparent;
                transition: all 0.2s;
            }
            .nav-item-link i {
                width: 20px;
                font-size: 0.95rem;
                text-align: center;
                transition: color 0.2s;
            }
            .nav-item-link:hover {
                color: var(--admin-text);
                background: var(--admin-hover);
            }
            .nav-item-link.active {
                color: var(--admin-accent);
                background: var(--admin-accent-light);
                border-right-color: var(--admin-accent);
            }
            .nav-item-link.active i { color: var(--admin-accent); }

            .sidebar-footer {
                padding: 16px 24px;
                border-top: 1px solid var(--admin-sidebar-border);
            }
            .sidebar-footer a {
                display: flex;
                align-items: center;
                gap: 10px;
                color: var(--admin-text-muted);
                text-decoration: none;
                font-size: 0.875rem;
                font-weight: 500;
                padding: 8px 0;
                transition: color 0.2s;
            }
            .sidebar-footer a:hover { color: var(--admin-accent); }

            /* ── Main Content ── */
            #admin-content {
                margin-left: 270px;
                min-height: 100vh;
                display: flex;
                flex-direction: column;
            }

            /* Top Bar */
            .admin-topbar {
                background: var(--admin-card);
                border-bottom: 1px solid var(--admin-card-border);
                padding: 14px 32px;
                display: flex;
                align-items: center;
                justify-content: space-between;
                position: sticky;
                top: 0;
                z-index: 100;
            }
            .admin-topbar .page-title {
                font-size: 1rem;
                font-weight: 600;
                color: var(--admin-text);
            }
            .admin-topbar .breadcrumb-item, .admin-topbar .breadcrumb-item a {
                font-size: 0.8rem;
                color: var(--admin-text-muted);
                text-decoration: none;
            }
            .admin-topbar .breadcrumb-item.active { color: var(--admin-accent); }
            .topbar-actions .btn-topbar {
                background: var(--admin-hover);
                border: 1px solid var(--admin-card-border);
                color: var(--admin-text-muted);
                padding: 7px 14px;
                border-radius: 8px;
                font-size: 0.8rem;
                font-weight: 500;
                text-decoration: none;
                display: inline-flex;
                align-items: center;
                gap: 6px;
                transition: all 0.2s;
            }
            .topbar-actions .btn-topbar:hover { color: var(--admin-accent); border-color: var(--admin-accent); }

            /* Page Content */
            .admin-page-content {
                flex: 1;
                padding: 32px;
            }

            /* Cards */
            .admin-card {
                background: var(--admin-card);
                border: 1px solid var(--admin-card-border);
                border-radius: 16px;
                overflow: hidden;
            }
            .admin-card .card-header-custom {
                padding: 20px 24px;
                border-bottom: 1px solid var(--admin-card-border);
                display: flex;
                align-items: center;
                justify-content: space-between;
            }
            .admin-card .card-header-custom .title {
                font-size: 1rem;
                font-weight: 600;
                color: var(--admin-text);
            }

            /* Stats Cards */
            .stat-card {
                background: var(--admin-card);
                border: 1px solid var(--admin-card-border);
                border-radius: 16px;
                padding: 24px;
                position: relative;
                overflow: hidden;
            }
            .stat-card .stat-icon {
                width: 48px; height: 48px;
                border-radius: 12px;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 1.3rem;
                margin-bottom: 16px;
            }
            .stat-card .stat-value {
                font-size: 2rem;
                font-weight: 700;
                color: var(--admin-text);
                line-height: 1;
                margin-bottom: 6px;
            }
            .stat-card .stat-label {
                font-size: 0.78rem;
                color: var(--admin-text-muted);
                font-weight: 500;
                text-transform: uppercase;
                letter-spacing: 0.5px;
            }
            .stat-card .stat-glow {
                position: absolute;
                top: -30px; right: -30px;
                width: 120px; height: 120px;
                border-radius: 50%;
                filter: blur(40px);
                opacity: 0.15;
            }

            /* Table */
            .admin-table { width: 100%; margin: 0; }
            .admin-table thead th {
                padding: 14px 20px;
                font-size: 0.72rem;
                text-transform: uppercase;
                letter-spacing: 1px;
                color: var(--admin-text-muted);
                font-weight: 600;
                background: rgba(255,255,255,0.02);
                border-bottom: 1px solid var(--admin-card-border);
                white-space: nowrap;
            }
            .admin-table tbody tr {
                border-bottom: 1px solid var(--admin-card-border);
                transition: background 0.15s;
            }
            .admin-table tbody tr:last-child { border-bottom: none; }
            .admin-table tbody tr:hover { background: var(--admin-hover); }
            .admin-table tbody td {
                padding: 14px 20px;
                font-size: 0.875rem;
                color: var(--admin-text);
                vertical-align: middle;
            }

            /* Badges */
            .badge-admin { padding: 5px 12px; border-radius: 30px; font-size: 0.72rem; font-weight: 600; }
            .badge-admin-red { background: rgba(239,68,68,0.15); color: #f87171; border: 1px solid rgba(239,68,68,0.2); }
            .badge-admin-green { background: rgba(34,197,94,0.15); color: #4ade80; border: 1px solid rgba(34,197,94,0.2); }
            .badge-admin-blue { background: rgba(59,130,246,0.15); color: #60a5fa; border: 1px solid rgba(59,130,246,0.2); }
            .badge-admin-yellow { background: rgba(234,179,8,0.15); color: #facc15; border: 1px solid rgba(234,179,8,0.2); }
            .badge-admin-gray { background: rgba(100,116,139,0.15); color: #94a3b8; border: 1px solid rgba(100,116,139,0.2); }

            /* Buttons */
            .btn-admin { padding: 7px 14px; border-radius: 8px; font-size: 0.8rem; font-weight: 500; border: 1px solid transparent; display: inline-flex; align-items: center; gap: 6px; transition: all 0.2s; cursor: pointer; }
            .btn-admin-red { background: rgba(239,68,68,0.12); color: #f87171; border-color: rgba(239,68,68,0.2); }
            .btn-admin-red:hover { background: rgba(239,68,68,0.22); color: #fca5a5; }
            .btn-admin-blue { background: rgba(59,130,246,0.12); color: #60a5fa; border-color: rgba(59,130,246,0.2); }
            .btn-admin-blue:hover { background: rgba(59,130,246,0.22); color: #93c5fd; }
            .btn-admin-green { background: rgba(34,197,94,0.12); color: #4ade80; border-color: rgba(34,197,94,0.2); }
            .btn-admin-green:hover { background: rgba(34,197,94,0.22); color: #86efac; }
            .btn-admin-yellow { background: rgba(234,179,8,0.12); color: #facc15; border-color: rgba(234,179,8,0.2); }
            .btn-admin-yellow:hover { background: rgba(234,179,8,0.22); color: #fde047; }

            /* Avatar */
            .user-avatar {
                width: 36px; height: 36px;
                border-radius: 10px;
                display: flex; align-items: center; justify-content: center;
                font-weight: 700; font-size: 0.875rem;
                background: linear-gradient(135deg, #3b82f6, #1d4ed8);
                color: white;
                flex-shrink: 0;
            }

            /* Alert */
            .alert-admin {
                border-radius: 12px;
                border: 1px solid;
                padding: 12px 16px;
                font-size: 0.875rem;
                display: flex;
                align-items: center;
                gap: 10px;
                margin-bottom: 16px;
            }
            .alert-admin-success { background: rgba(34,197,94,0.1); border-color: rgba(34,197,94,0.2); color: #4ade80; }
            .alert-admin-danger { background: rgba(239,68,68,0.1); border-color: rgba(239,68,68,0.2); color: #f87171; }
            .alert-admin-info { background: rgba(59,130,246,0.1); border-color: rgba(59,130,246,0.2); color: #60a5fa; }
            .alert-admin-warning { background: rgba(234,179,8,0.1); border-color: rgba(234,179,8,0.2); color: #facc15; }

            /* Empty state */
            .empty-state {
                text-align: center;
                padding: 60px 30px;
                color: var(--admin-text-muted);
            }
            .empty-state i { font-size: 3rem; opacity: 0.3; margin-bottom: 16px; display: block; }
            .empty-state p { font-size: 0.9rem; margin: 0; }

            /* Mobile */
            .admin-sidebar-toggle {
                display: none;
                position: fixed;
                bottom: 24px;
                right: 24px;
                z-index: 999;
                width: 52px; height: 52px;
                border-radius: 14px;
                background: var(--admin-accent);
                color: white;
                border: none;
                box-shadow: 0 8px 24px rgba(239,68,68,0.4);
                font-size: 1.1rem;
                cursor: pointer;
            }

            @media (max-width: 768px) {
                #admin-sidebar { transform: translateX(-270px); }
                #admin-sidebar.open { transform: translateX(0); }
                #admin-content { margin-left: 0; }
                .admin-page-content { padding: 20px 16px; }
                .admin-topbar { padding: 12px 16px; }
                .admin-sidebar-toggle { display: flex; align-items: center; justify-content: center; }
            }
        </style>
        {% block stylesheets %}{% endblock %}
    </head>
    <body>

        {# ── Sidebar ── #}
        <nav id="admin-sidebar">
            <div class="sidebar-brand">
                <div class="brand-logo"><span>Service</span>Hub</div>
                <div class="mt-1">
                    <span class="brand-badge"><i class="fas fa-shield-alt me-1"></i>Admin Panel</span>
                </div>
            </div>

            <div class="admin-profile">
                <div class="admin-avatar">{{ app.user.email|slice(0,1)|upper }}</div>
                <div class="admin-info">
                    <div class="name">{{ app.user.fullName|default(app.user.email|split('@')[0]) }}</div>
                    <div class="role">Super Administrator</div>
                </div>
            </div>

            <div class="sidebar-nav">
                <div class="nav-section-title">Overview</div>
                <a href="{{ path('app_admin_dashboard') }}" class="nav-item-link {{ app.request.get('_route') == 'app_admin_dashboard' ? 'active' : '' }}">
                    <i class="fas fa-chart-pie"></i> Dashboard
                </a>
                <a href="{{ path('app_admin_users') }}" class="nav-item-link {{ app.request.get('_route') == 'app_admin_users' ? 'active' : '' }}">
                    <i class="fas fa-users"></i> Customers
                </a>
                <a href="{{ path('app_admin_providers') }}" class="nav-item-link {{ app.request.get('_route') == 'app_admin_providers' ? 'active' : '' }}">
                    <i class="fas fa-user-tie"></i> Service Providers
                </a>

                <div class="nav-section-title mt-2">Management</div>
                <a href="{{ path('app_admin_users') }}" class="nav-item-link {{ 'app_admin_user' in app.request.get('_route') ? 'active' : '' }}">
                    <i class="fas fa-users-cog"></i> Manage Users
                </a>
                <a href="{{ path('app_admin_services') }}" class="nav-item-link {{ 'app_admin_service' in app.request.get('_route') ? 'active' : '' }}">
                    <i class="fas fa-cogs"></i> Manage Services
                </a>
                <a href="{{ path('app_admin_bookings') }}" class="nav-item-link {{ 'app_admin_booking' in app.request.get('_route') ? 'active' : '' }}">
                    <i class="fas fa-calendar-alt"></i> Manage Bookings
                </a>

                <div class="nav-section-title mt-2">Site</div>
                <a href="{{ path('app_home') }}" class="nav-item-link">
                    <i class="fas fa-globe"></i> View Live Site
                </a>
                <a href="{{ path('app_service_list') }}" class="nav-item-link">
                    <i class="fas fa-search"></i> Browse Services
                </a>
            </div>

            <div class="sidebar-footer">
                <a href="{{ path('app_logout') }}">
                    <i class="fas fa-sign-out-alt"></i> Logout
                </a>
            </div>
        </nav>

        {# ── Main Area ── #}
        <div id="admin-content">
            {# Top Bar #}
            <div class="admin-topbar">
                <div>
                    <div class="page-title">{% block page_title %}Admin Panel{% endblock %}</div>
                    <nav aria-label="breadcrumb">
                        <ol class="breadcrumb mb-0">
                            <li class="breadcrumb-item"><a href="{{ path('app_admin_dashboard') }}">Dashboard</a></li>
                            {% block breadcrumb %}{% endblock %}
                        </ol>
                    </nav>
                </div>
                <div class="topbar-actions">
                    <a href="{{ path('app_home') }}" class="btn-topbar">
                        <i class="fas fa-external-link-alt"></i> Live Site
                    </a>
                </div>
            </div>

            {# Flash Messages #}
            <div class="admin-page-content pb-0">
                {% for label, messages in app.flashes %}
                    {% for message in messages %}
                        {% set alertClass = label == 'success' ? 'alert-admin-success' : (label == 'danger' ? 'alert-admin-danger' : (label == 'warning' ? 'alert-admin-warning' : 'alert-admin-info')) %}
                        {% set alertIcon = label == 'success' ? 'fa-check-circle' : (label == 'danger' ? 'fa-exclamation-circle' : (label == 'warning' ? 'fa-exclamation-triangle' : 'fa-info-circle')) %}
                        <div class="alert-admin {{ alertClass }}">
                            <i class="fas {{ alertIcon }}"></i>
                            {{ message }}
                            <button type="button" onclick="this.parentElement.remove()" style="margin-left: auto; background: none; border: none; color: inherit; cursor: pointer; font-size: 1rem;">&times;</button>
                        </div>
                    {% endfor %}
                {% endfor %}
            </div>

            {# Page Content #}
            <div class="admin-page-content">
                {% block body %}{% endblock %}
            </div>
        </div>

        {# Mobile Toggle #}
        <button class="admin-sidebar-toggle" id="adminToggle" onclick="document.getElementById('admin-sidebar').classList.toggle('open')">
            <i class="fas fa-bars"></i>
        </button>

        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
        {% block javascripts %}{% endblock %}
    </body>
</html>
