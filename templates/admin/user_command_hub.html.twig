{% extends 'admin/admin_base.html.twig' %}

{% block title %}Identity Index — ServiceHub Admin{% endblock %}
{% block page_title %}Identity Index{% endblock %}

{% block body %}
<div class="reveal-3d">
    {# ── STATS COMMAND BAR ── #}
    <div class="row g-3 mb-5">
        {% set stat_items = [
            {label: 'TOTAL IDENTITIES', val: stats.total, icon: 'fa-users', color: 'cyan'},
            {label: 'VERIFIED NODES', val: stats.verified, icon: 'fa-check-double', color: 'emerald'},
            {label: 'ARTISAN FLEET', val: stats.providers, icon: 'fa-user-tie', color: 'blue'},
            {label: 'COMMAND DECK', val: stats.admins, icon: 'fa-shield-halved', color: 'pink'}
        ] %}
        {% for stat in stat_items %}
            <div class="col-md-3">
                <div class="glass-card p-3 border-0 d-flex align-items-center gap-3" style="background: rgba(255,255,255,0.02);">
                    <div class="p-2 rounded-3 bg-surface border-glass text-{{ stat.color }}"><i class="fas {{ stat.icon }}"></i></div>
                    <div>
                        <div class="text-xxs text-dim fw-800">{{ stat.label }}</div>
                        <div class="text-white fw-900 h5 mb-0">{{ stat.val }}</div>
                    </div>
                </div>
            </div>
        {% endfor %}
    </div>

    {# ── SEARCH & FILTER CONSOLE ── #}
    <div class="glass-card p-4 mb-5 border-glow-hover">
        <form method="GET" class="row g-3 align-items-end">
            <div class="col-md-4">
                <label class="text-xxs text-dim fw-800 mb-2 d-block">FILTER BY KEYWORD</label>
                <div class="position-relative">
                    <i class="fas fa-search position-absolute top-50 translate-middle-y ms-3 text-teal"></i>
                    <input type="text" name="search" class="form-control ps-5" placeholder="Scanning identities..." value="{{ search }}">
                </div>
            </div>
            <div class="col-md-3">
                <label class="text-xxs text-dim fw-800 mb-2 d-block">ROLE SENSORS</label>
                <select name="role" class="form-select">
                    <option value="">All Roles</option>
                    <option value="ROLE_ADMIN" {{ role_filter == 'ROLE_ADMIN' ? 'selected' : '' }}>Admins</option>
                    <option value="ROLE_PROVIDER" {{ role_filter == 'ROLE_PROVIDER' ? 'selected' : '' }}>Providers</option>
                    <option value="ROLE_USER" {{ role_filter == 'ROLE_USER' ? 'selected' : '' }}>Customers</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="text-xxs text-dim fw-800 mb-2 d-block">CONNECTION STATUS</label>
                <select name="status" class="form-select">
                    <option value="">All States</option>
                    <option value="active" {{ status_filter == 'active' ? 'selected' : '' }}>Active</option>
                    <option value="inactive" {{ status_filter == 'inactive' ? 'selected' : '' }}>Suspended</option>
                </select>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn-luxury w-100 py-2">EXECUTE SCAN</button>
            </div>
        </form>
    </div>

    {# ── IDENTITY GRID ── #}
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="luxury-serif text-white h5 m-0">Synchronized Entities</h3>
        <a href="{{ path('app_admin_user_new') }}" class="btn-outline-luxury py-1 px-3" style="font-size: 0.7rem;">
            <i class="fas fa-plus me-2"></i> NEW IDENTITY
        </a>
    </div>

    <div class="row g-4">
        {% for user in users %}
            <div class="col-xl-6 col-xxl-4">
                <div class="glass-card p-0 overflow-hidden border-glow-hover h-100 d-flex flex-column">
                    {# User Header #}
                    <div class="p-4 d-flex justify-content-between align-items-center border-bottom border-white border-opacity-5">
                        <div class="d-flex align-items-center gap-3">
                            <div class="user-orb" style="width: 48px; height: 48px; font-size: 1.2rem; background: var(--bg-obsidian); border-color: {{ user.tierColor }}; color: {{ user.tierColor }};">
                                {{ user.email|slice(0,1)|upper }}
                            </div>
                            <div>
                                <div class="fw-bold text-white small">{{ user.fullName|default('Anonymous') }}</div>
                                <div class="text-dim" style="font-size: 0.65rem; font-family: monospace;">{{ user.email }}</div>
                            </div>
                        </div>
                        <div class="text-end">
                            <div class="text-xxs fw-800 mb-1" style="color: {{ user.tierColor }}">TIER: {{ user.tier|upper }}</div>
                            <span class="badge-status {{ user.isActive ? 'status-active' : 'status-alert' }}" style="font-size: 0.55rem;">
                                {{ user.isActive ? 'ACTIVE' : 'SEVERED' }}
                            </span>
                        </div>
                    </div>

                    {# Details Section #}
                    <div class="p-4 flex-grow-1">
                        <div class="row g-3 mb-4">
                            <div class="col-6">
                                <span class="text-xxs text-dim fw-800 d-block mb-1">ROLES DETECTED</span>
                                <div class="d-flex flex-wrap gap-1">
                                    {% for role in user.roles %}
                                        {% if role == 'ROLE_ADMIN' %}
                                            <span class="badge-status" style="background:rgba(255,93,115,0.1); color:var(--accent-red); border-color:rgba(255,93,115,0.2);">ADMIN</span>
                                        {% elseif role == 'ROLE_PROVIDER' %}
                                            <span class="badge-status" style="background:rgba(76,167,255,0.1); color:var(--accent-blue); border-color:rgba(76,167,255,0.2);">PROVIDER</span>
                                        {% endif %}
                                    {% endfor %}
                                    {% if user.roles|length == 1 %}<span class="badge-status status-pending">CUSTOMER</span>{% endif %}
                                </div>
                            </div>
                            <div class="col-6 text-end">
                                <span class="text-xxs text-dim fw-800 d-block mb-1">FIDELITY SCORE</span>
                                <span class="text-white fw-bold">{{ user.reputationPoints }} <small class="text-dim">PTS</small></span>
                            </div>
                        </div>

                        {% if user.mobile %}
                            <div class="p-2 rounded-3 mb-3 bg-surface border-glass text-center">
                                <span class="text-xxs text-dim fw-800 me-2">COMM-LINK:</span>
                                <span class="text-white font-monospace small">{{ user.mobile }}</span>
                            </div>
                        {% endif %}
                    </div>

                    {# Action Terminal #}
                    <div class="p-3 bg-surface border-top border-white border-opacity-5 mt-auto">
                        <div class="d-flex justify-content-center gap-2">
                            <form action="{{ path('app_admin_user_toggle_status', {id: user.id}) }}" method="POST" class="m-0">
                                <button type="submit" class="btn-action-spatial {{ user.isActive ? 'text-red' : 'text-teal' }}" title="Toggle Link">
                                    <i class="fas {{ user.isActive ? 'fa-user-slash' : 'fa-user-check' }}"></i>
                                </button>
                            </form>

                            <button class="btn-action-spatial text-blue" data-bs-toggle="modal" data-bs-target="#resetModal{{ user.id }}" title="Reset Cipher">
                                <i class="fas fa-key"></i>
                            </button>

                            {% if 'ROLE_ADMIN' not in user.roles %}
                                <form action="{{ path('app_admin_user_promote', {id: user.id}) }}" method="POST" class="m-0">
                                    <input type="hidden" name="_token" value="{{ csrf_token('promote' ~ user.id) }}">
                                    <button type="submit" class="btn-action-spatial text-amber" title="Promote to Command">
                                        <i class="fas fa-shield-halved"></i>
                                    </button>
                                </form>
                            {% endif %}

                            {% if user != app.user %}
                                <form action="{{ path('app_admin_user_delete', {id: user.id}) }}" method="POST" class="m-0" onsubmit="return confirm('Purge identity permanently?');">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ user.id) }}">
                                    <button type="submit" class="btn-action-spatial text-red">
                                        <i class="fas fa-trash-alt"></i>
                                    </button>
                                </form>
                            {% endif %}
                        </div>
                    </div>
                </div>
            </div>
        {% else %}
            <div class="col-12 text-center py-5 glass-card border-dashed">
                <i class="fas fa-user-secret fs-1 text-dim mb-4"></i>
                <h4 class="luxury-serif">Identity Index Empty</h4>
                <p class="text-dim">No user nodes detected in the current matrix.</p>
            </div>
        {% endfor %}
    </div>

    {# ── PAGINATION ── #}
    <div class="d-flex justify-content-center mt-5">
        <div class="glass-card p-2 border-0 shadow-none">
            {{ knp_pagination_render(users) }}
        </div>
    </div>
</div>

{# ── RESET CIPHER MODALS ── #}
{% for user in users %}
<div class="modal fade" id="resetModal{{ user.id }}" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content glass-card" style="background: rgba(8,10,15,0.95);">
            <div class="modal-header border-bottom border-white border-opacity-10 p-4">
                <h5 class="modal-title luxury-serif text-white">Reset Access Cipher</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <p class="text-dim small mb-4">Generating new private pass-key for node: <strong class="text-white">{{ user.email }}</strong></p>
                <form method="POST" action="{{ path('app_admin_user_reset_password', {id: user.id}) }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('reset_password' ~ user.id) }}">
                    <div class="mb-4">
                        <label class="text-xxs text-dim fw-800 d-block mb-2">NEW CIPHER STRING</label>
                        <input type="password" name="new_password" class="form-control" placeholder="••••••••" required>
                    </div>
                    <div class="d-flex gap-3">
                        <button type="button" class="btn-outline-luxury flex-fill" data-bs-dismiss="modal">ABORT</button>
                        <button type="submit" class="btn-luxury flex-fill">OVERWRITE</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
{% endfor %}

<style>
    .border-glow-hover:hover {
        border-color: rgba(0, 255, 213, 0.3) !important;
        box-shadow: 0 0 40px rgba(0, 255, 213, 0.08) !important;
        transform: translateY(-5px);
    }
    .bg-surface { background: rgba(255, 255, 255, 0.02); }
    .border-glass { border: 1px solid rgba(255, 255, 255, 0.1); }
    
    .btn-action-spatial {
        width: 40px; height: 40px;
        border-radius: 10px;
        display: flex; align-items: center; justify-content: center;
        background: rgba(255, 255, 255, 0.04);
        border: 1px solid rgba(255, 255, 255, 0.08);
        transition: all 0.3s var(--ease-spatial);
        cursor: pointer;
    }
    .btn-action-spatial:hover {
        background: rgba(255, 255, 255, 0.1);
        transform: scale(1.1);
        border-color: currentColor;
    }
    .text-teal { color: var(--accent-cyan) !important; }
    .text-red { color: var(--accent-red) !important; }
    .text-amber { color: #ffd166 !important; }
    .text-blue { color: #4ca7ff !important; }
</style>
{% endblock %}