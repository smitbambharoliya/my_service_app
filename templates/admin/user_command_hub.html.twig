{% extends 'admin/admin_base.html.twig' %}

{% block title %}User Command Hub - Admin{% endblock %}
{% block page_title %}User Command Hub{% endblock %}
{% block breadcrumb %}
    <li class="breadcrumb-item active">User Management</li>
{% endblock %}

{% block body %}
<!-- Stats Row -->
<div class="row g-4 mb-4">
    <div class="col-md-2 col-6">
        <div class="stat-card">
            <div class="stat-icon violet"><i class="fas fa-users"></i></div>
            <div class="stat-value">{{ stats.total }}</div>
            <div class="stat-label">Total Users</div>
        </div>
    </div>
    <div class="col-md-2 col-6">
        <div class="stat-card">
            <div class="stat-icon emerald"><i class="fas fa-check-circle"></i></div>
            <div class="stat-value">{{ stats.verified }}</div>
            <div class="stat-label">Verified</div>
        </div>
    </div>
    <div class="col-md-2 col-6">
        <div class="stat-card">
            <div class="stat-icon blue"><i class="fas fa-user-tie"></i></div>
            <div class="stat-value">{{ stats.providers }}</div>
            <div class="stat-label">Providers</div>
        </div>
    </div>
    <div class="col-md-2 col-6">
        <div class="stat-card">
            <div class="stat-icon pink"><i class="fas fa-shield-alt"></i></div>
            <div class="stat-value">{{ stats.admins }}</div>
            <div class="stat-label">Admins</div>
        </div>
    </div>
    <div class="col-md-2 col-6">
        <div class="stat-card">
            <div class="stat-icon amber"><i class="fas fa-clock"></i></div>
            <div class="stat-value">{{ stats.total - stats.verified }}</div>
            <div class="stat-label">Pending</div>
        </div>
    </div>
    <div class="col-md-2 col-6">
        <div class="stat-card">
            <div class="stat-icon" style="background: linear-gradient(135deg, #EF4444, #DC2626);"><i class="fas fa-ban"></i></div>
            <div class="stat-value">{{ stats.suspended }}</div>
            <div class="stat-label">Suspended</div>
        </div>
    </div>
</div>

<!-- Filters & Search -->
<div class="admin-card mb-4">
    <div class="p-4">
        <form method="GET" class="row g-3">
            <div class="col-md-4">
                <div class="input-group">
                    <span class="input-group-text" style="background: var(--admin-bg); border: 1px solid var(--text-muted); border-right: none; color: var(--text-main-muted);">
                        <i class="fas fa-search"></i>
                    </span>
                    <input type="text" name="search" class="form-control" style="border-top-left-radius: 0; border-bottom-left-radius: 0;" placeholder="Search users..." value="{{ search }}">
                </div>
            </div>
            <div class="col-md-3">
                <select name="role" class="form-control">
                    <option value="">All Roles</option>
                    <option value="ROLE_ADMIN" {{ role_filter == 'ROLE_ADMIN' ? 'selected' : '' }}>Admin</option>
                    <option value="ROLE_PROVIDER" {{ role_filter == 'ROLE_PROVIDER' ? 'selected' : '' }}>Provider</option>
                    <option value="ROLE_USER" {{ role_filter == 'ROLE_USER' ? 'selected' : '' }}>Customer Only</option>
                </select>
            </div>
            <div class="col-md-3">
                <select name="status" class="form-control">
                    <option value="">All Status</option>
                    <option value="active" {{ status_filter == 'active' ? 'selected' : '' }}>Active</option>
                    <option value="inactive" {{ status_filter == 'inactive' ? 'selected' : '' }}>Suspended</option>
                </select>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn-admin btn-admin-gradient w-100">
                    <i class="fas fa-filter"></i> Filter
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Users Table -->
<div class="admin-card">
    <div class="card-header-custom">
        <span class="title"><i class="fas fa-users-cog me-2" style="color: var(--accent-blue);"></i>User Management</span>
        <a href="{{ path('app_admin_user_new') }}" class="btn-admin btn-admin-gradient">
            <i class="fas fa-plus"></i> Add User
        </a>
    </div>
    <div class="table-responsive">
        <table class="admin-table">
            <thead>
                <tr>
                    <th>User</th>
                    <th>Roles</th>
                    <th>Status</th>
                    <th>Tier</th>
                    <th>Joined</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for user in users %}
                    <tr>
                        <td>
                            <div class="d-flex align-items-center gap-3">
                                <div class="user-avatar">{{ user.email|slice(0,1)|upper }}</div>
                                <div>
                                    <div style="font-weight: 700; color: var(--text-main);">{{ user.fullName|default('N/A') }}</div>
                                    <div style="font-size: 0.8rem; color: var(--text-main-muted);">{{ user.email }}</div>
                                    {% if user.mobile %}
                                        <div style="font-size: 0.75rem; color: var(--text-main-muted);"><i class="fas fa-phone me-1"></i>{{ user.mobile }}</div>
                                    {% endif %}
                                </div>
                            </div>
                        </td>
                        <td>
                            {% for role in user.roles %}
                                {% if role != 'ROLE_USER' %}
                                    {% if role == 'ROLE_ADMIN' %}
                                        <span class="badge-admin badge-admin-pink me-1"><i class="fas fa-shield-alt me-1"></i>Admin</span>
                                    {% elseif role == 'ROLE_PROVIDER' %}
                                        <span class="badge-admin badge-admin-blue me-1"><i class="fas fa-user-tie me-1"></i>Provider</span>
                                    {% endif %}
                                {% endif %}
                            {% endfor %}
                            {% if 'ROLE_ADMIN' not in user.roles and 'ROLE_PROVIDER' not in user.roles %}
                                <span class="badge-admin badge-admin-gray">Customer</span>
                            {% endif %}
                        </td>
                        <td>
                            {% if user.isActive %}
                                <span class="badge-admin badge-admin-emerald"><i class="fas fa-check me-1"></i>Active</span>
                            {% else %}
                                <span class="badge-admin" style="background: rgba(239, 68, 68, 0.1); color: #EF4444; border-color: rgba(239, 68, 68, 0.2);"><i class="fas fa-ban me-1"></i>Suspended</span>
                            {% endif %}
                            {% if user.isVerified %}
                                <span class="badge-admin badge-admin-blue ms-1"><i class="fas fa-check-circle"></i></span>
                            {% else %}
                                <span class="badge-admin badge-admin-amber ms-1"><i class="fas fa-clock"></i></span>
                            {% endif %}
                        </td>
                        <td>
                            <span class="badge-admin" style="background: {{ user.tierColor }}20; color: {{ user.tierColor }}; border-color: {{ user.tierColor }}40;">
                                <i class="fas fa-crown me-1"></i>{{ user.tier }}
                            </span>
                            <small class="d-block mt-1" style="color: var(--text-main-muted);">{{ user.reputationPoints }} pts</small>
                        </td>
                        <td>
                            <span style="color: var(--text-main-secondary); font-size: 0.85rem;">{{ user.createdAt|date('M d, Y') }}</span>
                        </td>
                        <td>
                            <div class="d-flex gap-1 flex-wrap">
                                {% if not user.isVerified %}
                                    <form method="POST" action="{{ path('app_admin_user_verify', {id: user.id}) }}" class="d-inline">
                                        <input type="hidden" name="_token" value="{{ csrf_token('verify' ~ user.id) }}">
                                        <button type="submit" class="btn-admin btn-admin-emerald" title="Verify User">
                                            <i class="fas fa-check-circle"></i>
                                        </button>
                                    </form>
                                {% endif %}

                                {% if 'ROLE_PROVIDER' not in user.roles %}
                                    <form method="POST" action="{{ path('app_admin_user_promote_provider', {id: user.id}) }}" class="d-inline">
                                        <input type="hidden" name="_token" value="{{ csrf_token('promote_provider' ~ user.id) }}">
                                        <button type="submit" class="btn-admin btn-admin-blue" title="Promote to Provider">
                                            <i class="fas fa-user-tie"></i>
                                        </button>
                                    </form>
                                {% else %}
                                    <form method="POST" action="{{ path('app_admin_user_demote_provider', {id: user.id}) }}" class="d-inline">
                                        <input type="hidden" name="_token" value="{{ csrf_token('demote_provider' ~ user.id) }}">
                                        <button type="submit" class="btn-admin btn-admin-amber" title="Remove Provider Role">
                                            <i class="fas fa-user"></i>
                                        </button>
                                    </form>
                                {% endif %}

                                {% if 'ROLE_ADMIN' not in user.roles %}
                                    <form method="POST" action="{{ path('app_admin_user_promote', {id: user.id}) }}" class="d-inline">
                                        <input type="hidden" name="_token" value="{{ csrf_token('promote' ~ user.id) }}">
                                        <button type="submit" class="btn-admin btn-admin-violet" title="Promote to Admin">
                                            <i class="fas fa-shield-alt"></i>
                                        </button>
                                    </form>
                                {% endif %}

                                <button type="button" class="btn-admin btn-admin-blue" data-bs-toggle="modal" data-bs-target="#resetModal{{ user.id }}" title="Reset Password">
                                    <i class="fas fa-key"></i>
                                </button>

                                <form method="POST" action="{{ path('app_admin_user_toggle_status', {id: user.id}) }}" class="d-inline">
                                    <button type="submit" class="btn-admin {{ user.isActive ? 'btn-admin-amber' : 'btn-admin-emerald' }}" title="{{ user.isActive ? 'Suspend' : 'Activate' }}">
                                        <i class="fas {{ user.isActive ? 'fa-pause' : 'fa-play' }}"></i>
                                    </button>
                                </form>

                                {% if user != app.user %}
                                    <form method="POST" action="{{ path('app_admin_user_delete', {id: user.id}) }}" class="d-inline" onsubmit="return confirm('Permanently delete this user?')">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ user.id) }}">
                                        <button type="submit" class="btn-admin btn-admin-pink" title="Delete User">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </form>
                                {% endif %}
                            </div>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="6">
                            <div class="empty-state">
                                <i class="fas fa-users"></i>
                                <p>No users found matching your criteria.</p>
                            </div>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>

<!-- Reset Password Modals -->
{% for user in users %}
<div class="modal fade" id="resetModal{{ user.id }}" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="border-radius: 20px; border: 1px solid var(--text-muted); background: var(--glass-bg); backdrop-filter: blur(20px);">
            <div class="modal-header" style="border-bottom: 1px solid var(--text-muted); padding: 20px 24px;">
                <h5 class="modal-title" style="font-weight: 700; color: var(--text-main);">
                    <i class="fas fa-key me-2" style="color: var(--accent-blue);"></i>Reset Password
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" style="padding: 24px;">
                <p style="color: var(--text-main-secondary);">Reset password for <strong>{{ user.email }}</strong></p>
                <form method="POST" action="{{ path('app_admin_user_reset_password', {id: user.id}) }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('reset_password' ~ user.id) }}">

                    <div class="mb-4">
                        <label class="form-label" style="font-weight: 600; font-size: 0.85rem;">New Password</label>
                        <input type="password" name="new_password" class="form-control" placeholder="Enter new password" minlength="6" required>
                        <small class="text-muted">Minimum 6 characters</small>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="button" class="btn-admin btn-admin-gray flex-fill" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn-admin btn-admin-gradient flex-fill">
                            <i class="fas fa-save"></i> Reset Password
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
{% endfor %}
{% endblock %}
