{% extends 'admin/admin_base.html.twig' %}

{% block title %}Manage Providers - Admin Panel{% endblock %}

{% block body %}
<div class="admin-card">
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:20px;">
        <h2 style="margin:0;font-size:1.5rem;font-weight:700;">Service Providers</h2>
        <div style="display:flex;gap:10px;">
            <span class="badge-admin badge-admin-blue" style="font-size:0.8rem;padding:6px 12px;display:flex;align-items:center;gap:6px;">
                <i class="fas fa-user-tie"></i> {{ providers|length }} Total Providers
            </span>
        </div>
    </div>

    <div style="overflow-x:auto;">
        <table class="admin-table">
            <thead>
                <tr>
                    <th style="width:60px;">ID</th>
                    <th>Provider Info</th>
                    <th>Services</th>
                    <th>Status</th>
                    <th style="text-align:right;">Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for provider in providers %}
                <tr>
                    <td style="color:var(--admin-text-muted);font-size:0.8rem;">{{ provider.id }}</td>
                    <td>
                        <div style="display:flex;align-items:center;gap:12px;">
                            <div class="user-avatar" style="background:linear-gradient(135deg, #10b981, #059669);">{{ provider.email|slice(0,1)|upper }}</div>
                            <div>
                                <div style="font-weight:600;color:var(--admin-text);font-size:0.875rem;">{{ provider.fullName|default('No Name') }}</div>
                                <div style="font-size:0.75rem;color:var(--admin-text-muted);">{{ provider.email }}</div>
                            </div>
                        </div>
                    </td>
                    <td>
                        <span class="badge-admin badge-admin-gray" style="font-size:0.75rem;">
                            <i class="fas fa-tools me-1"></i> {{ provider.services|length }} Listings
                        </span>
                    </td>
                    <td>
                        {% if provider.isActive %}
                            <span class="badge-admin badge-admin-green"><i class="fas fa-check-circle me-1"></i>Active</span>
                        {% else %}
                            <span class="badge-admin badge-admin-red"><i class="fas fa-ban me-1"></i>Suspended</span>
                        {% endif %}
                    </td>
                    <td style="text-align:right;">
                        <div style="display:flex;justify-content:flex-end;gap:8px;">
                            <form action="{{ path('app_admin_user_toggle_status', {id: provider.id}) }}" method="POST" style="display:inline;">
                                <button type="submit" class="btn-admin {{ provider.isActive ? 'btn-admin-outline' : 'btn-admin-green' }}" title="{{ provider.isActive ? 'Suspend' : 'Activate' }}" style="padding:6px 10px;font-size:0.75rem;">
                                    <i class="fas {{ provider.isActive ? 'fa-user-slash text-danger' : 'fa-user-check' }}"></i>
                                </button>
                            </form>
                            <a href="{{ path('app_service_list') }}" class="btn-admin btn-admin-blue" title="View Services" style="padding:6px 10px;font-size:0.75rem;">
                                <i class="fas fa-eye"></i>
                            </a>
                        </div>
                    </td>
                </tr>
                {% else %}
                <tr>
                    <td colspan="5" style="text-align:center;padding:40px;color:var(--admin-text-muted);">No service providers found.</td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
