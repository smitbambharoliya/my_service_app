{% extends 'admin/admin_base.html.twig' %}

{% block title %}Mission Logs — ServiceHub Admin{% endblock %}
{% block page_title %}Mission Control{% endblock %}
{% block breadcrumb %}<li class="breadcrumb-item active text-teal">Mission Logs</li>{% endblock %}

{% block stylesheets %}
<style>
    .border-glow-hover:hover {
        border-color: rgba(0, 255, 213, 0.3) !important;
        box-shadow: 0 0 40px rgba(0, 255, 213, 0.08) !important;
        transform: translateY(-5px);
    }
    .bg-surface { 
        background: rgba(255, 255, 255, 0.03); 
    }
    .btn-action-spatial {
        width: 38px;
        height: 38px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.1);
        transition: all 0.3s var(--ease-spatial);
        cursor: pointer;
    }
    .btn-action-spatial:hover {
        background: rgba(255, 255, 255, 0.1);
        transform: scale(1.1);
        border-color: currentColor;
    }
    /* Pagination Overrides to match theme */
    .pagination .page-link {
        background: transparent;
        border: none;
        color: var(--theme-muted);
        margin: 0 5px;
        border-radius: 8px;
    }
    .pagination .active .page-link {
        background: var(--theme-primary-soft);
        color: var(--accent-cyan);
        font-weight: 800;
    }
</style>
{% endblock %}

{% block body %}
<div class="reveal-3d">
    {# ── ANALYTICS HEADER ── #}
    <div class="d-flex align-items-center justify-content-between mb-5">
        <div>
            <span class="text-xxs fw-800 letter-spacing-2 text-teal d-block mb-1">GLOBAL LEDGER</span>
            <h2 class="luxury-serif text-pure mb-0">Platform Expeditions</h2>
            <p class="text-dim text-xs mt-2">
                Total synchronized nodes: <strong class="text-white">{{ bookings.getTotalItemCount() }}</strong>
            </p>
        </div>
        <div class="d-flex gap-3">
            <a href="{{ path('app_admin_bookings_export') }}" class="btn-luxury py-2 px-4" style="font-size: 0.75rem; background: rgba(0,255,213,0.1); border-color: var(--accent-cyan); color: var(--accent-cyan) !important;">
                <i class="fas fa-file-export me-2"></i> EXPORT DATA
            </a>
        </div>
    </div>

    <div class="admin-filter-console">
        <form method="GET" class="row g-3 align-items-end">
            <div class="col-lg-5">
                <label for="booking-search">Search</label>
                <input id="booking-search" type="text" name="search" class="form-control" placeholder="Tracking, customer, provider, service..." value="{{ search|default('') }}">
            </div>
            <div class="col-md-3 col-lg-3">
                <label for="booking-status">Status</label>
                <select id="booking-status" name="status" class="form-select">
                    <option value="">All status</option>
                    {% for status in ['pending', 'confirmed', 'accepted', 'in_progress', 'on-the-way', 'completed', 'cancelled'] %}
                        <option value="{{ status }}" {{ status_filter|default('') == status ? 'selected' : '' }}>{{ status|replace({'_': ' ', '-': ' '})|title }}</option>
                    {% endfor %}
                </select>
            </div>
            <div class="col-md-3 col-lg-2">
                <label for="booking-sort">Sort</label>
                <select id="booking-sort" name="sort" class="form-select">
                    <option value="newest" {{ sort_filter|default('newest') == 'newest' ? 'selected' : '' }}>Newest first</option>
                    <option value="oldest" {{ sort_filter|default('newest') == 'oldest' ? 'selected' : '' }}>Oldest first</option>
                </select>
            </div>
            <div class="col-md-3 col-lg-2 admin-filter-actions">
                <button type="submit" class="btn-luxury w-100 py-2">FILTER</button>
                <a href="{{ path('app_admin_bookings') }}" class="btn-outline-luxury py-2 px-3" title="Clear filters"><i class="fas fa-rotate-left"></i></a>
            </div>
        </form>
    </div>

    {# ── MISSION GRID ── #}
    <div class="row g-4">
        {% for booking in bookings %}
            <div class="col-xl-6 col-xxl-4">
                <div class="glass-card p-0 overflow-hidden border-glow-hover h-100 d-flex flex-column">
                    {# Card Header #}
                    <div class="p-4 d-flex justify-content-between align-items-start border-bottom border-white border-opacity-5">
                        <div class="d-flex align-items-center gap-3">
                            <div class="p-2 rounded-3 bg-surface border-glass">
                                <i class="fas fa-satellite text-teal"></i>
                            </div>
                            <div>
                                <div class="text-xxs text-dim fw-800">NODE ID</div>
                                <code class="text-white small">#{{ booking.id|slice(0,8) }}</code>
                            </div>
                        </div>
                        {% if booking.status == 'pending' %}
                            <span class="badge-status status-pending">PENDING</span>
                        {% elseif booking.status == 'confirmed' %}
                            <span class="badge-status status-active">ACTIVE</span>
                        {% else %}
                            <span class="badge-status status-confirmed">CONCLUDED</span>
                        {% endif %}
                    </div>

                    {# Card Body #}
                    <div class="p-4 flex-grow-1">
                        <div class="mb-4">
                            <h4 class="luxury-serif text-white h5 mb-1">{{ booking.service.title }}</h4>
                            <span class="text-teal fw-bold" style="font-size: 0.9rem;">₹{{ booking.service.price|number_format }}</span>
                        </div>

                        <div class="d-flex align-items-center gap-3 p-3 rounded-4 bg-surface mb-3">
                            <div class="user-avatar" style="width: 38px; height: 38px; font-size: 0.8rem; background: linear-gradient(135deg, #4ca7ff, #00ffd5);">
                                {{ booking.customer.email|slice(0,1)|upper }}
                            </div>
                            <div class="overflow-hidden">
                                <div class="text-xxs text-dim fw-800">CLIENT IDENTITY</div>
                                <div class="text-white text-truncate small fw-600">{{ booking.customer.email }}</div>
                            </div>
                        </div>

                        <div class="row g-3">
                            <div class="col-6">
                                <div class="text-xxs text-dim fw-800 mb-1">STAMP</div>
                                <div class="text-white small fw-bold"><i class="far fa-calendar me-2"></i>{{ booking.bookingDate|date('d M, Y') }}</div>
                            </div>
                            <div class="col-6 text-end">
                                <div class="text-xxs text-dim fw-800 mb-1">TELEMETRY</div>
                                <div class="text-white small fw-bold"><i class="far fa-clock me-2"></i>{{ booking.bookingDate|date('H:i') }}</div>
                            </div>
                        </div>
                    </div>

                    {# Card Footer / Actions #}
                    <div class="p-3 bg-surface border-top border-white border-opacity-5 mt-auto">
                        <div class="d-flex justify-content-between align-items-center">
                            <div class="d-flex gap-2">
                                {# Status Transition Controls #}
                                {% if booking.status == 'pending' %}
                                    <form action="{{ path('app_admin_booking_status', {'id': booking.id}) }}" method="post" class="m-0">
                                        <input type="hidden" name="_token" value="{{ csrf_token('status' ~ booking.id) }}">
                                        <input type="hidden" name="status" value="confirmed">
                                        <button class="btn-action-spatial text-teal" title="Confirm Link">
                                            <i class="fas fa-check"></i>
                                        </button>
                                    </form>
                                {% elseif booking.status == 'confirmed' %}
                                    <form action="{{ path('app_admin_booking_status', {'id': booking.id}) }}" method="post" class="m-0">
                                        <input type="hidden" name="_token" value="{{ csrf_token('status' ~ booking.id) }}">
                                        <input type="hidden" name="status" value="completed">
                                        <button class="btn-action-spatial text-blue" title="Finalize Mission">
                                            <i class="fas fa-check-double"></i>
                                        </button>
                                    </form>
                                {% endif %}
                                
                                <form action="{{ path('app_admin_booking_delete', {'id': booking.id}) }}" method="post" class="m-0" onsubmit="return confirm('Terminate this mission log?');">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ booking.id) }}">
                                    <button class="btn-action-spatial text-red" title="Decommission">
                                        <i class="fas fa-trash-alt"></i>
                                    </button>
                                </form>
                            </div>
                            <span class="text-xxs text-dim italic">SECURE LOG ACTIVE</span>
                        </div>
                    </div>
                </div>
            </div>
        {% else %}
            <div class="col-12">
                <div class="glass-card py-5 text-center border-dashed">
                    <i class="fas fa-inbox fs-1 text-dim mb-4"></i>
                    <h4 class="luxury-serif">Void detected</h4>
                    <p class="text-dim small">No mission protocols have been initialized on the platform.</p>
                </div>
            </div>
        {% endfor %}
    </div>

    {# ── PAGINATION ── #}
    <div class="d-flex justify-content-center mt-5">
        <div class="glass-card p-2 border-0 shadow-none">
            {{ knp_pagination_render(bookings) }}
        </div>
    </div>
</div>
{% endblock %}
