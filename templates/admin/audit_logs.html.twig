{% extends 'admin/admin_base.html.twig' %}

{% block title %}Telemetry Logs — ServiceHub Admin{% endblock %}
{% block page_title %}System Telemetry{% endblock %}

{% block body %}
<div class="reveal-3d">
    {# ── TOP CONTROL BAR ── #}
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div class="glass-card px-4 py-2 border-0 d-flex align-items-center gap-3">
            <div class="pulse-indicator"></div>
            <span class="text-xxs fw-800 letter-spacing-1 text-dim">LIVE AUDIT STREAM</span>
            <span class="badge-status status-active">{{ logs.getTotalItemCount() }} NODES</span>
        </div>
        <a href="{{ path('app_admin_audit_logs') }}" class="btn-luxury py-2 px-4" style="font-size: 0.7rem;">
            <i class="fas fa-sync-alt me-2"></i> RESYNC FEED
        </a>
    </div>

    <div class="admin-filter-console">
        <form method="GET" class="row g-3 align-items-end">
            <div class="col-lg-5">
                <label for="audit-search">Search</label>
                <input id="audit-search" type="text" name="search" class="form-control" placeholder="Action, admin email, entity, IP..." value="{{ search|default('') }}">
            </div>
            <div class="col-md-4 col-lg-3">
                <label for="audit-action">Action</label>
                <select id="audit-action" name="action" class="form-select">
                    <option value="">All actions</option>
                    {% for action in actions|default([]) %}
                        <option value="{{ action }}" {{ action_filter|default('') == action ? 'selected' : '' }}>{{ action|replace({'_': ' '})|title }}</option>
                    {% endfor %}
                </select>
            </div>
            <div class="col-md-4 col-lg-2">
                <label for="audit-sort">Sort</label>
                <select id="audit-sort" name="sort" class="form-select">
                    <option value="newest" {{ sort_filter|default('newest') == 'newest' ? 'selected' : '' }}>Newest first</option>
                    <option value="oldest" {{ sort_filter|default('newest') == 'oldest' ? 'selected' : '' }}>Oldest first</option>
                </select>
            </div>
            <div class="col-md-4 col-lg-2 admin-filter-actions">
                <button type="submit" class="btn-luxury w-100 py-2">FILTER</button>
                <a href="{{ path('app_admin_audit_logs') }}" class="btn-outline-luxury py-2 px-3" title="Clear filters"><i class="fas fa-rotate-left"></i></a>
            </div>
        </form>
    </div>

    {# ── SPATIAL LOG GRID ── #}
    <div class="row g-4">
        {% for log in logs %}
            <div class="col-xl-6 col-xxl-4">
                <div class="glass-card p-4 h-100 border-glow-hover">
                    <div class="d-flex justify-content-between align-items-start mb-4">
                        <div class="d-flex align-items-center gap-3">
                            <div class="user-orb" style="width: 38px; height: 38px; font-size: 0.8rem;">
                                {{ log.admin_email|slice(0,1)|upper }}
                            </div>
                            <div>
                                <div class="fw-bold text-white small">{{ log.admin_email }}</div>
                                <div class="text-dim" style="font-size: 0.65rem; font-family: monospace;">IP: {{ log.ip_address }}</div>
                            </div>
                        </div>
                        
                        {% set actionColors = {
                            'CATEGORY_DELETE': 'status-alert',
                            'USER_DELETE': 'status-alert',
                            'CATEGORY_CREATE': 'status-active',
                            'USER_VERIFY': 'status-active'
                        } %}
                        <span class="badge-status {{ actionColors[log.action]|default('status-pending') }}" style="font-size: 0.6rem;">
                            {{ log.action|replace({'_': ' '}) }}
                        </span>
                    </div>

                    <div class="p-3 rounded-4 mb-3" style="background: rgba(255,255,255,0.02); border: 1px solid rgba(255,255,255,0.05);">
                        <div class="row g-2">
                            <div class="col-5">
                                <span class="text-xxs text-dim fw-800 d-block mb-1">ENTITY TYPE</span>
                                <span class="text-teal small fw-bold">{{ log.entity_type|default('SYSTEM') }}</span>
                            </div>
                            <div class="col-7 text-end">
                                <span class="text-xxs text-dim fw-800 d-block mb-1">ENTITY ID</span>
                                <code class="text-white small" style="background: rgba(0,255,213,0.1); padding: 2px 6px; border-radius: 4px;">
                                    {{ log.entity_id|default('N/A')|slice(0,12) }}
                                </code>
                            </div>
                        </div>
                    </div>

                    {% if log.details %}
                        <div class="mb-3">
                            <span class="text-xxs text-dim fw-800 d-block mb-2">TELEMETRY DATA</span>
                            <div class="p-2 rounded-3 text-xxs" style="background: rgba(0,0,0,0.2); font-family: monospace; color: #a9b7c8;">
                                {% for key, value in log.details %}
                                    <div class="mb-1"><span class="text-teal">> {{ key }}:</span> {{ value }}</div>
                                {% endfor %}
                            </div>
                        </div>
                    {% endif %}

                    <div class="d-flex justify-content-between align-items-center pt-3 border-top border-white border-opacity-10">
                        <span class="text-xxs text-dim fw-800"><i class="far fa-clock me-1"></i> {{ log.timestamp }}</span>
                        <i class="fas fa-fingerprint text-dim opacity-30"></i>
                    </div>
                </div>
            </div>
        {% else %}
            <div class="col-12">
                <div class="glass-card py-5 text-center border-dashed">
                    <i class="fas fa-satellite-dish fs-1 text-dim mb-4"></i>
                    <h4 class="luxury-serif">Silence in the Aether</h4>
                    <p class="text-dim small">No telemetry logs have been recorded in the current cycle.</p>
                </div>
            </div>
        {% endfor %}
    </div>

    <div class="d-flex justify-content-center mt-5">
        <div class="glass-card p-2 border-0 shadow-none">
            {{ knp_pagination_render(logs) }}
        </div>
    </div>
</div>

{# ── LOGIC INFO SECTION ── #}
<div class="row g-4 mt-5">
    <div class="col-md-12">
        <div class="glass-card p-4 border-0" style="background: linear-gradient(135deg, rgba(76, 167, 255, 0.05), transparent);">
            <div class="row align-items-center">
                <div class="col-lg-8">
                    <h5 class="luxury-serif text-white mb-2">Archive Retention Protocol</h5>
                    <p class="text-dim small mb-0">Logs are cryptographically signed and stored at <code>var/logs/admin_actions.log</code>. 
                    The dashboard displays the last 500 state transitions for security compliance.</p>
                </div>
                <div class="col-lg-4 text-lg-end mt-3 mt-lg-0">
                    <div class="d-inline-flex gap-2">
                        <div class="p-3 rounded-4 bg-surface"><i class="fas fa-shield-halved text-teal"></i></div>
                        <div class="p-3 rounded-4 bg-surface"><i class="fas fa-server text-blue"></i></div>
                        <div class="p-3 rounded-4 bg-surface"><i class="fas fa-vault text-purple"></i></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .pulse-indicator {
        width: 8px; height: 8px;
        background: var(--accent-cyan);
        border-radius: 50%;
        box-shadow: 0 0 10px var(--accent-cyan);
        animation: pulse-ring 2s infinite;
    }
    @keyframes pulse-ring {
        0% { transform: scale(1); opacity: 1; }
        100% { transform: scale(2.5); opacity: 0; }
    }
    .border-glow-hover:hover {
        border-color: rgba(0, 255, 213, 0.3) !important;
        box-shadow: 0 0 30px rgba(0, 255, 213, 0.05) !important;
    }
    .bg-surface { background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.05); }
</style>
{% endblock %}
