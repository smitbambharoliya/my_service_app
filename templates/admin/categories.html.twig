{% extends 'admin/admin_base.html.twig' %}

{% block title %}Spheres Management — ServiceHub Admin{% endblock %}
{% block page_title %}Service Spheres{% endblock %}

{% block stylesheets %}
<style>
    /* ── ICON GRID STYLING ── */
    .category-icon-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(45px, 1fr));
        gap: 10px;
        max-height: 200px;
        overflow-y: auto;
        padding: 10px;
        background: rgba(0,0,0,0.2);
        border-radius: 12px;
        border: 1px solid var(--glass-border);
    }
    .category-icon-option {
        width: 40px; height: 40px;
        display: flex; align-items: center; justify-content: center;
        background: rgba(255,255,255,0.03);
        border: 1px solid transparent;
        border-radius: 10px;
        cursor: pointer;
        transition: all 0.3s var(--ease-spatial);
        color: var(--text-muted);
    }
    .category-icon-option:hover { background: rgba(255,255,255,0.08); color: #fff; }
    .category-icon-option.selected {
        border-color: var(--accent-cyan);
        background: rgba(0, 255, 213, 0.1);
        color: var(--accent-cyan);
        box-shadow: 0 0 15px rgba(0, 255, 213, 0.2);
    }

    /* ── COLOR SELECTOR ── */
    .color-options { display: flex; gap: 8px; flex-wrap: wrap; }
    .color-option {
        width: 24px; height: 24px;
        border-radius: 50%;
        cursor: pointer;
        border: 2px solid transparent;
        transition: transform 0.2s;
    }
    .color-option.selected { transform: scale(1.3); border-color: #fff; box-shadow: 0 0 10px rgba(255,255,255,0.3); }

    /* ── SPATIAL OVERRIDES ── */
    .btn-admin-gradient {
        background: var(--gradient-aurora);
        color: #000; font-weight: 800; border: none;
        box-shadow: 0 0 20px rgba(0, 255, 213, 0.2);
    }
    .btn-admin-gradient:hover { transform: translateY(-2px); box-shadow: 0 0 30px rgba(0, 255, 213, 0.4); }

    /* ── SYNCHRONIZED SPHERES TABLE ── */
    .spheres-card {
        min-height: 0;
    }
    .spheres-table-wrap {
        overflow-x: auto;
    }
    .spheres-table {
        width: 100%;
        min-width: 760px;
        table-layout: fixed;
        border-collapse: collapse;
    }
    .spheres-table th,
    .spheres-table td {
        padding: 16px 18px;
        vertical-align: middle;
        border-bottom: 1px solid rgba(255, 255, 255, 0.08);
        line-height: 1.35;
    }
    .spheres-table th {
        color: rgba(247, 251, 255, 0.78);
        font-size: 0.7rem;
        font-weight: 800;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        white-space: nowrap;
    }
    .spheres-table tbody tr:last-child td {
        border-bottom: 0;
    }
    .sphere-identity-col { width: 36%; }
    .sphere-code-col { width: 18%; }
    .sphere-load-col { width: 13%; }
    .sphere-status-col { width: 15%; }
    .sphere-actions-col { width: 18%; }
    .sphere-icon {
        width: 44px;
        height: 44px;
        border-radius: 10px;
        background: rgba(0, 255, 213, 0.1);
        border: 1px solid rgba(0, 255, 213, 0.2);
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--accent-cyan);
        flex: 0 0 44px;
    }
    .sphere-name {
        max-width: 220px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }
    .sphere-slug {
        max-width: 220px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        font-size: 0.68rem;
    }
    .sphere-code {
        display: inline-block;
        max-width: 100%;
        overflow: hidden;
        text-overflow: ellipsis;
        vertical-align: middle;
    }
    .sphere-actions {
        display: flex;
        justify-content: flex-end;
        gap: 8px;
        flex-wrap: nowrap;
    }
    .btn-action-spatial {
        width: 38px;
        height: 38px;
        border-radius: 10px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.1);
        transition: all 0.25s var(--ease-spatial);
        cursor: pointer;
        padding: 0;
        flex: 0 0 38px;
    }
    .btn-action-spatial:hover {
        background: rgba(255, 255, 255, 0.1);
        border-color: currentColor;
        transform: translateY(-1px);
    }
    .text-amber { color: #ffd166 !important; }

    @media (max-width: 1199px) {
        .sphere-identity-col { width: 34%; }
        .sphere-actions-col { width: 20%; }
    }
</style>
{% endblock %}

{% block body %}
<div class="row g-4 reveal-3d">
    <div class="col-lg-4">
        <div class="glass-card p-4 h-100 border-glow-hover">
            <div class="d-flex align-items-center gap-3 mb-4">
                <div class="p-2 rounded-3 bg-surface border-glass"><i class="fas fa-plus-circle text-teal"></i></div>
                <h4 class="luxury-serif text-white m-0">Initialize Sphere</h4>
            </div>

            <form method="POST" action="{{ path('app_admin_category_new') }}">
                <input type="hidden" name="_token" value="{{ csrf_token('category_new') }}">

                <div class="mb-4">
                    <label class="text-xxs text-dim fw-800 letter-spacing-1 d-block mb-2">SPHERE DESIGNATION</label>
                    <input type="text" name="name" class="form-control" placeholder="e.g. Molecular Hygiene" required>
                </div>

                <div class="mb-4">
                    <label class="text-xxs text-dim fw-800 letter-spacing-1 d-block mb-2">TECHNICAL SCOPE</label>
                    <textarea name="description" class="form-control" rows="3" placeholder="Define operational parameters..."></textarea>
                </div>

                <div class="row mb-4">
                    <div class="col-6">
                        <label class="text-xxs text-dim fw-800 letter-spacing-1 d-block mb-2">INDEX ORDER</label>
                        <input type="number" name="sortOrder" class="form-control" value="0" min="0">
                    </div>
                </div>

                <div class="mb-4">
                    <label class="text-xxs text-dim fw-800 letter-spacing-1 d-block mb-2">VISUAL IDENTIFIER (ICON)</label>
                    <div class="category-icon-grid" id="iconGrid">
                        {% set icons = ['fa-home', 'fa-broom', 'fa-wrench', 'fa-paint-roller', 'fa-laptop', 'fa-spa', 'fa-car', 'fa-tools', 'fa-bolt', 'fa-lock', 'fa-microchip', 'fa-satellite'] %}
                        {% for icon in icons %}
                            <div class="category-icon-option" data-icon="{{ icon }}" onclick="selectIcon(this)">
                                <i class="fas {{ icon }}"></i>
                            </div>
                        {% endfor %}
                    </div>
                    <input type="hidden" name="icon" id="selectedIcon" value="fa-tag">
                </div>

                <div class="mb-5">
                    <label class="text-xxs text-dim fw-800 letter-spacing-1 d-block mb-3">SPECTRUM TINT</label>
                    <div class="color-options">
                        {% set colors = [
                            {name: 'cyan', hex: '#00ffd5'},
                            {name: 'violet', hex: '#8B5CF6'},
                            {name: 'pink', hex: '#EC4899'},
                            {name: 'emerald', hex: '#10B981'},
                            {name: 'amber', hex: '#F59E0B'}
                        ] %}
                        {% for color in colors %}
                            <div class="color-option {{ loop.first ? 'selected' : '' }}" 
                                 style="background: {{ color.hex }};" 
                                 data-color="{{ color.name }}" 
                                 onclick="selectColor(this)"></div>
                        {% endfor %}
                    </div>
                    <input type="hidden" name="color" id="selectedColor" value="cyan">
                </div>

                <button type="submit" class="btn-luxury w-100 py-3">
                    <i class="fas fa-plus me-2"></i> DEPLOY SPHERE
                </button>
            </form>
        </div>
    </div>

    <div class="col-lg-8">
        <div class="glass-card spheres-card p-0 overflow-hidden border-glow-hover">
            <div class="p-4 d-flex justify-content-between align-items-center border-bottom border-white border-opacity-5">
                <div class="d-flex align-items-center gap-3">
                    <div class="p-2 rounded-3 bg-surface border-glass"><i class="fas fa-layer-group text-teal"></i></div>
                    <h4 class="luxury-serif text-white m-0">Synchronized Spheres</h4>
                </div>
                <span class="badge-status status-active">{{ categories.getTotalItemCount() }} UNITS</span>
            </div>

            <div class="admin-filter-console m-4">
                <form method="GET" class="row g-3 align-items-end">
                    <div class="col-lg-4">
                        <label for="category-search">Search</label>
                        <input id="category-search" type="text" name="search" class="form-control" placeholder="Name, slug, description..." value="{{ search|default('') }}">
                    </div>
                    <div class="col-md-4 col-lg-3">
                        <label for="category-status">Status</label>
                        <select id="category-status" name="status" class="form-select">
                            <option value="">All status</option>
                            <option value="active" {{ status_filter|default('') == 'active' ? 'selected' : '' }}>Online</option>
                            <option value="inactive" {{ status_filter|default('') == 'inactive' ? 'selected' : '' }}>Dormant</option>
                        </select>
                    </div>
                    <div class="col-md-4 col-lg-3">
                        <label for="category-sort">Sort</label>
                        <select id="category-sort" name="sort" class="form-select">
                            <option value="sort_order" {{ sort_filter|default('sort_order') == 'sort_order' ? 'selected' : '' }}>Display order</option>
                            <option value="name" {{ sort_filter|default('sort_order') == 'name' ? 'selected' : '' }}>Name A-Z</option>
                            <option value="newest" {{ sort_filter|default('sort_order') == 'newest' ? 'selected' : '' }}>Newest first</option>
                            <option value="oldest" {{ sort_filter|default('sort_order') == 'oldest' ? 'selected' : '' }}>Oldest first</option>
                        </select>
                    </div>
                    <div class="col-md-4 col-lg-2 admin-filter-actions">
                        <button type="submit" class="btn-luxury w-100 py-2">FILTER</button>
                        <a href="{{ path('app_admin_categories') }}" class="btn-outline-luxury py-2 px-3" title="Clear filters"><i class="fas fa-rotate-left"></i></a>
                    </div>
                </form>
            </div>

            <div class="spheres-table-wrap">
                <table class="spheres-table m-0">
                    <colgroup>
                        <col class="sphere-identity-col">
                        <col class="sphere-code-col">
                        <col class="sphere-load-col">
                        <col class="sphere-status-col">
                        <col class="sphere-actions-col">
                    </colgroup>
                    <thead>
                        <tr>
                            <th class="ps-4">SPHERE IDENTITY</th>
                            <th>ENCODING</th>
                            <th>LOAD</th>
                            <th>STATUS</th>
                            <th class="pe-4 text-end">ACTIONS</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for category in categories %}
                            <tr class="reveal-3d">
                                <td class="ps-4">
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="sphere-icon">
                                            <i class="fas {{ category.icon }}"></i>
                                        </div>
                                        <div>
                                            <div class="sphere-name fw-bold text-white small">{{ category.name }}</div>
                                            <div class="sphere-slug text-dim">{{ category.slug }}</div>
                                        </div>
                                    </div>
                                </td>
                                <td><code class="sphere-code text-teal" style="font-size: 0.7rem;">{{ category.icon }}</code></td>
                                <td><span class="text-white fw-bold">{{ category.serviceCount }}</span> <span class="text-dim text-xxs">UNITS</span></td>
                                <td>
                                    {% if category.isActive %}
                                        <span class="text-teal text-xxs fw-800"><i class="fas fa-circle me-1" style="font-size: 6px;"></i> ONLINE</span>
                                    {% else %}
                                        <span class="text-dim text-xxs fw-800"><i class="fas fa-circle me-1" style="font-size: 6px;"></i> DORMANT</span>
                                    {% endif %}
                                </td>
                                <td class="pe-4 text-end">
                                    <div class="sphere-actions">
                                        <button class="btn-action-spatial text-blue" data-bs-toggle="modal" data-bs-target="#editModal{{ category.id }}">
                                            <i class="fas fa-edit"></i>
                                        </button>
                                        <form method="POST" action="{{ path('app_admin_category_toggle', {id: category.id}) }}" class="m-0">
                                            <input type="hidden" name="_token" value="{{ csrf_token('category_toggle' ~ category.id) }}">
                                            <button type="submit" class="btn-action-spatial {{ category.isActive ? 'text-amber' : 'text-teal' }}">
                                                <i class="fas {{ category.isActive ? 'fa-pause' : 'fa-play' }}"></i>
                                            </button>
                                        </form>
                                        {% if category.serviceCount == 0 %}
                                            <form method="POST" action="{{ path('app_admin_category_delete', {id: category.id}) }}" class="m-0" onsubmit="return confirm('Purge this sphere?')">
                                                <input type="hidden" name="_token" value="{{ csrf_token('category_delete' ~ category.id) }}">
                                                <button type="submit" class="btn-action-spatial text-red">
                                                    <i class="fas fa-trash"></i>
                                                </button>
                                            </form>
                                        {% endif %}
                                    </div>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>

            <div class="d-flex justify-content-center p-4 border-top border-white border-opacity-10">
                {{ knp_pagination_render(categories) }}
            </div>
        </div>
    </div>
</div>

{% for category in categories %}
<div class="modal fade" id="editModal{{ category.id }}" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content glass-card border-glow" style="background: rgba(8,10,15,0.95);">
            <div class="modal-header border-bottom border-white border-opacity-10 p-4">
                <h5 class="modal-title luxury-serif text-white">Calibrate Sphere #{{ category.id }}</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <form method="POST" action="{{ path('app_admin_category_edit', {id: category.id}) }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('category_edit' ~ category.id) }}">
                    
                    <div class="mb-4">
                        <label class="text-xxs text-dim fw-800 letter-spacing-1 d-block mb-2">DESIGNATION</label>
                        <input type="text" name="name" class="form-control" value="{{ category.name }}" required>
                    </div>

                    <div class="d-flex gap-3">
                        <button type="button" class="btn-outline-luxury flex-fill py-3" data-bs-dismiss="modal">ABORT</button>
                        <button type="submit" class="btn-luxury flex-fill py-3">SAVE CHANGES</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
{% endfor %}

<script>
function selectIcon(element) {
    document.querySelectorAll('.category-icon-option').forEach(el => el.classList.remove('selected'));
    element.classList.add('selected');
    document.getElementById('selectedIcon').value = element.dataset.icon;
}

function selectColor(element) {
    document.querySelectorAll('.color-option').forEach(el => el.classList.remove('selected'));
    element.classList.add('selected');
    document.getElementById('selectedColor').value = element.dataset.color;
}
</script>
{% endblock %}
