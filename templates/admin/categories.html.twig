{% extends 'admin/admin_base.html.twig' %}

{% block title %}Category Manager - Admin{% endblock %}
{% block page_title %}Category Manager{% endblock %}
{% block breadcrumb %}
    <li class="breadcrumb-item active">Categories</li>
{% endblock %}

{% block body %}
<div class="row g-4">
    <!-- Add New Category -->
    <div class="col-lg-4">
        <div class="admin-card">
            <div class="card-header-custom">
                <span class="title"><i class="fas fa-plus-circle me-2" style="color: var(--accent-blue);"></i>Add Category</span>
            </div>
            <div class="p-4">
                <form method="POST" action="{{ path('app_admin_category_new') }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('category_new') }}">

                    <div class="mb-3">
                        <label class="form-label" style="font-weight: 600; color: var(--text-main); font-size: 0.85rem;">Category Name</label>
                        <input type="text" name="name" class="form-control" placeholder="e.g., Home Cleaning" required>
                    </div>

                    <div class="mb-3">
                        <label class="form-label" style="font-weight: 600; color: var(--text-main); font-size: 0.85rem;">Description</label>
                        <textarea name="description" class="form-control" rows="3" placeholder="Brief description..."></textarea>
                    </div>

                    <div class="mb-3">
                        <label class="form-label" style="font-weight: 600; color: var(--text-main); font-size: 0.85rem;">Sort Order</label>
                        <input type="number" name="sortOrder" class="form-control" value="0" min="0">
                    </div>

                    <div class="mb-3">
                        <label class="form-label" style="font-weight: 600; color: var(--text-main); font-size: 0.85rem;">Select Icon</label>
                        <div class="category-icon-grid" id="iconGrid">
                            {% set icons = ['fa-home', 'fa-broom', 'fa-wrench', 'fa-paint-roller', 'fa-truck-moving', 'fa-laptop', 'fa-camera', 'fa-spa',
                                           'fa-cut', 'fa-car', 'fa-dog', 'fa-baby', 'fa-utensils', 'fa-tshirt', 'fa-tools', 'fa-bolt',
                                           'fa-tree', 'fa-lock', 'fa-music', 'fa-dumbbell', 'fa-graduation-cap', 'fa-heart', 'fa-plane', 'fa-gift'] %}
                            {% for icon in icons %}
                                <div class="category-icon-option" data-icon="{{ icon }}" onclick="selectIcon(this)">
                                    <i class="fas {{ icon }}"></i>
                                </div>
                            {% endfor %}
                        </div>
                        <input type="hidden" name="icon" id="selectedIcon" value="fa-tag">
                    </div>

                    <div class="mb-4">
                        <label class="form-label" style="font-weight: 600; color: var(--text-main); font-size: 0.85rem;">Theme Color</label>
                        <div class="color-options">
                            {% set colors = [
                                {name: 'violet', hex: '#8B5CF6'},
                                {name: 'blue', hex: '#3B82F6'},
                                {name: 'pink', hex: '#EC4899'},
                                {name: 'cyan', hex: '#06B6D4'},
                                {name: 'emerald', hex: '#10B981'},
                                {name: 'amber', hex: '#F59E0B'},
                                {name: 'red', hex: '#EF4444'},
                                {name: 'indigo', hex: '#6366F1'}
                            ] %}
                            {% for color in colors %}
                                <div class="color-option color-{{ color.name }} {{ loop.first ? 'selected' : '' }}" data-color="{{ color.name }}" onclick="selectColor(this)"></div>
                            {% endfor %}
                        </div>
                        <input type="hidden" name="color" id="selectedColor" value="violet">
                    </div>

                    <button type="submit" class="btn-admin btn-admin-gradient w-100">
                        <i class="fas fa-plus"></i> Create Category
                    </button>
                </form>
            </div>
        </div>
    </div>

    <!-- Categories List -->
    <div class="col-lg-8">
        <div class="admin-card">
            <div class="card-header-custom">
                <span class="title"><i class="fas fa-tags me-2" style="color: var(--accent-blue);"></i>All Categories</span>
                <span class="badge-admin badge-admin-violet">{{ categories|length }} Total</span>
            </div>
            <div class="table-responsive">
                <table class="admin-table">
                    <thead>
                        <tr>
                            <th>Category</th>
                            <th>Icon</th>
                            <th>Services</th>
                            <th>Status</th>
                            <th>Order</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for category in categories %}
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center gap-3">
                                        <div style="width: 44px; height: 44px; border-radius: 12px; background: linear-gradient(135deg, var(--aurora-{{ category.color }}), var(--aurora-{{ category.color }})); display: flex; align-items: center; justify-content: center; color: white; font-size: 1.1rem;">
                                            <i class="fas {{ category.icon }}"></i>
                                        </div>
                                        <div>
                                            <div style="font-weight: 700; color: var(--text-main);">{{ category.name }}</div>
                                            <div style="font-size: 0.8rem; color: var(--text-main-muted);">{{ category.slug }}</div>
                                        </div>
                                    </div>
                                </td>
                                <td><code style="background: var(--admin-bg); padding: 4px 8px; border-radius: 6px; font-size: 0.8rem;">{{ category.icon }}</code></td>
                                <td>
                                    <span class="badge-admin badge-admin-blue">{{ category.serviceCount }} services</span>
                                </td>
                                <td>
                                    {% if category.isActive %}
                                        <span class="badge-admin badge-admin-emerald"><i class="fas fa-check me-1"></i> Active</span>
                                    {% else %}
                                        <span class="badge-admin badge-admin-gray"><i class="fas fa-pause me-1"></i> Inactive</span>
                                    {% endif %}
                                </td>
                                <td>{{ category.sortOrder }}</td>
                                <td>
                                    <div class="d-flex gap-2">
                                        <button type="button" class="btn-admin btn-admin-blue" data-bs-toggle="modal" data-bs-target="#editModal{{ category.id }}">
                                            <i class="fas fa-edit"></i>
                                        </button>
                                        <form method="POST" action="{{ path('app_admin_category_toggle', {id: category.id}) }}" class="d-inline">
                                            <input type="hidden" name="_token" value="{{ csrf_token('category_toggle' ~ category.id) }}">
                                            <button type="submit" class="btn-admin {{ category.isActive ? 'btn-admin-amber' : 'btn-admin-emerald' }}">
                                                <i class="fas {{ category.isActive ? 'fa-pause' : 'fa-play' }}"></i>
                                            </button>
                                        </form>
                                        {% if category.serviceCount == 0 %}
                                            <form method="POST" action="{{ path('app_admin_category_delete', {id: category.id}) }}" class="d-inline" onsubmit="return confirm('Delete this category?')">
                                                <input type="hidden" name="_token" value="{{ csrf_token('category_delete' ~ category.id) }}">
                                                <button type="submit" class="btn-admin btn-admin-pink">
                                                    <i class="fas fa-trash"></i>
                                                </button>
                                            </form>
                                        {% endif %}
                                    </div>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="6">
                                    <div class="empty-state">
                                        <i class="fas fa-tags"></i>
                                        <p>No categories found. Create your first category!</p>
                                    </div>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Edit Modals -->
{% for category in categories %}
<div class="modal fade" id="editModal{{ category.id }}" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="border-radius: 20px; border: 1px solid var(--text-muted); background: var(--glass-bg); backdrop-filter: blur(20px);">
            <div class="modal-header" style="border-bottom: 1px solid var(--text-muted); padding: 20px 24px;">
                <h5 class="modal-title" style="font-weight: 700; color: var(--text-main);">
                    <i class="fas fa-edit me-2" style="color: var(--accent-blue);"></i>Edit Category
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" style="padding: 24px;">
                <form method="POST" action="{{ path('app_admin_category_edit', {id: category.id}) }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('category_edit' ~ category.id) }}">

                    <div class="mb-3">
                        <label class="form-label" style="font-weight: 600; font-size: 0.85rem;">Category Name</label>
                        <input type="text" name="name" class="form-control" value="{{ category.name }}" required>
                    </div>

                    <div class="mb-3">
                        <label class="form-label" style="font-weight: 600; font-size: 0.85rem;">Description</label>
                        <textarea name="description" class="form-control" rows="2">{{ category.description }}</textarea>
                    </div>

                    <div class="mb-3">
                        <label class="form-label" style="font-weight: 600; font-size: 0.85rem;">Sort Order</label>
                        <input type="number" name="sortOrder" class="form-control" value="{{ category.sortOrder }}" min="0">
                    </div>

                    <div class="mb-3">
                        <label class="form-label" style="font-weight: 600; font-size: 0.85rem;">Icon Class</label>
                        <input type="text" name="icon" class="form-control" value="{{ category.icon }}" placeholder="fa-tag">
                        <small class="text-muted">Font Awesome icon class (e.g., fa-home, fa-broom)</small>
                    </div>

                    <div class="mb-4">
                        <label class="form-label" style="font-weight: 600; font-size: 0.85rem;">Theme Color</label>
                        <select name="color" class="form-control">
                            {% set colorOptions = ['violet', 'blue', 'pink', 'cyan', 'emerald', 'amber', 'red', 'indigo'] %}
                            {% for color in colorOptions %}
                                <option value="{{ color }}" {{ category.color == color ? 'selected' : '' }}>{{ color|capitalize }}</option>
                            {% endfor %}
                        </select>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="button" class="btn-admin btn-admin-gray flex-fill" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn-admin btn-admin-gradient flex-fill">
                            <i class="fas fa-save"></i> Save Changes
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
{% endfor %}

<script>
function selectIcon(element) {
    document.querySelectorAll('.category-icon-option').forEach(el => el.classList.remove('selected'));
    element.classList.add('selected');
    document.getElementById('selectedIcon').value = element.dataset.icon;
}

function selectColor(element) {
    document.querySelectorAll('.color-option').forEach(el => el.classList.remove('selected'));
    element.classList.add('selected');
    document.getElementById('selectedColor').value = element.dataset.color;
}

// Select first icon by default
document.querySelector('.category-icon-option').classList.add('selected');
</script>
{% endblock %}
