<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>{% block title %}Command Center — ServiceHub Aurora{% endblock %}</title>

        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;600;800&family=Playfair+Display:ital,wght@0,600;1,600&display=swap" rel="stylesheet">

        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
        <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

        <style>
            /* ── 2026 AURORA SPATIAL SYSTEM ── */
            :root {
                --aurora-bg: #F9FAFB;
                --aurora-violet: #8B5CF6;
                --aurora-cyan: #06B6D4;
                --aurora-pink: #EC4899;
                --aurora-emerald: #10B981;
                --aurora-text: #0F172A;
                --glass-frost: rgba(255, 255, 255, 0.65);
                --glass-border: rgba(139, 92, 246, 0.25);
                --sb-w: 260px;
                --tb-h: 80px;
                --ease-spatial: cubic-bezier(0.23, 1, 0.32, 1);
                --gradient-violet-cyan: linear-gradient(135deg, var(--aurora-violet) 0%, var(--aurora-cyan) 100%);
                --gradient-pink-amber: linear-gradient(135deg, var(--aurora-pink) 0%, #F59E0B 100%);
            }

            body {
                font-family: 'Plus Jakarta Sans', sans-serif;
                background: linear-gradient(135deg, var(--aurora-bg) 0%, #F3F4F6 100%);
                color: var(--aurora-text);
                min-height: 100vh;
                display: flex;
                overflow-x: hidden;
            }

            /* ── Animated Aurora Blobs Background ── */
            .aurora-bg {
                position: fixed;
                inset: 0;
                z-index: -1;
                filter: blur(120px);
                opacity: 0.7;
                pointer-events: none;
            }

            .aurora-blob {
                position: absolute;
                border-radius: 50%;
                animation: spatial-float 25s infinite alternate ease-in-out;
            }

            .blob-1 { 
                width: 600px; height: 600px; 
                background: radial-gradient(circle, rgba(139, 92, 246, 0.3) 0%, transparent 70%);
                top: -10%; right: -5%;
            }

            .blob-2 { 
                width: 500px; height: 500px; 
                background: radial-gradient(circle, rgba(236, 72, 153, 0.25) 0%, transparent 70%);
                bottom: -5%; left: -5%; 
                animation-delay: -5s; 
            }

            .blob-3 {
                width: 400px; height: 400px;
                background: radial-gradient(circle, rgba(6, 182, 212, 0.2) 0%, transparent 70%);
                top: 50%; right: 10%;
                animation-delay: -10s;
            }

            @keyframes spatial-float {
                0% { transform: translate(0, 0) rotate(0deg); }
                100% { transform: translate(80px, 60px) rotate(20deg); }
            }

            /* ── Floating Sidebar ── */
            #sidebar-aurora {
                width: var(--sb-w);
                background: var(--glass-frost);
                backdrop-filter: blur(40px) saturate(200%);
                -webkit-backdrop-filter: blur(40px) saturate(200%);
                border: 2px solid var(--glass-border);
                border-radius: 28px;
                margin: 16px;
                height: calc(100vh - 32px);
                position: fixed;
                z-index: 1000;
                display: flex;
                flex-direction: column;
                box-shadow: 0 20px 60px rgba(139, 92, 246, 0.12), inset 0 1px 1px rgba(255,255,255,0.3);
                transition: all var(--ease-spatial);
                overflow-y: auto;
            }

            .sb-brand-aurora {
                padding: 30px 24px;
                font-family: 'Playfair Display', serif;
                font-weight: 800;
                font-size: 1.6rem;
                background: var(--gradient-violet-cyan);
                -webkit-background-clip: text;
                -webkit-text-fill-color: transparent;
                background-clip: text;
                border-bottom: 2px solid var(--glass-border);
                margin-bottom: 12px;
            }

            .sb-link-aurora {
                margin: 6px 14px;
                padding: 12px 18px;
                border-radius: 16px;
                color: #64748b;
                font-weight: 600;
                font-size: 0.9rem;
                display: flex;
                align-items: center;
                gap: 12px;
                text-decoration: none;
                transition: all 0.3s var(--ease-spatial);
                position: relative;
                overflow: hidden;
            }

            .sb-link-aurora::before {
                content: '';
                position: absolute;
                left: 0;
                top: 0;
                height: 100%;
                width: 4px;
                background: var(--gradient-violet-cyan);
                opacity: 0;
                transition: opacity 0.3s;
            }

            .sb-link-aurora i { 
                font-size: 1.1rem; 
                color: var(--aurora-violet);
                transition: all 0.3s;
            }

            .sb-link-aurora:hover, .sb-link-aurora.active {
                background: linear-gradient(135deg, rgba(139, 92, 246, 0.15), rgba(6, 182, 212, 0.1));
                color: var(--aurora-violet);
                transform: translateX(5px);
                border: 2px solid rgba(139, 92, 246, 0.2);
            }

            .sb-link-aurora:hover::before, .sb-link-aurora.active::before {
                opacity: 1;
            }

            .sb-nav-label {
                font-size: 0.65rem; 
                font-weight: 800; 
                color: var(--aurora-violet);
                letter-spacing: 0.2em; 
                margin: 25px 14px 12px 14px;
                text-transform: uppercase;
            }

            .sb-nav {
                flex: 1;
                overflow-y: auto;
                padding-bottom: 20px;
            }

            .sb-nav::-webkit-scrollbar { width: 6px; }
            .sb-nav::-webkit-scrollbar-track { background: transparent; }
            .sb-nav::-webkit-scrollbar-thumb { 
                background: var(--aurora-violet);
                border-radius: 999px;
                opacity: 0.3;
            }

            .sb-user-card {
                padding: 16px 14px;
                margin: 20px 14px;
                background: linear-gradient(135deg, rgba(139, 92, 246, 0.08), rgba(6, 182, 212, 0.08));
                border: 2px solid var(--glass-border);
                border-radius: 16px;
                backdrop-filter: blur(10px);
                transition: all 0.3s;
            }

            .sb-user-card:hover {
                background: linear-gradient(135deg, rgba(139, 92, 246, 0.12), rgba(6, 182, 212, 0.12));
                border-color: rgba(139, 92, 246, 0.4);
            }
            
            .sb-user-orb {
                width: 52px; height: 52px;
                border-radius: 14px;
                background: var(--gradient-violet-cyan);
                display: flex; align-items: center; justify-content: center;
                font-weight: 800; color: white; font-size: 1.4rem;
                margin-bottom: 12px;
                box-shadow: 0 10px 25px rgba(139, 92, 246, 0.3);
                border: 2px solid rgba(255, 255, 255, 0.5);
            }

            /* ── Topbar (Glass Island) ── */
            #main-wrapper {
                margin-left: calc(var(--sb-w) + 32px);
                flex: 1;
                padding: 16px 32px;
            }

            .dashboard-topbar-aurora {
                height: var(--tb-h);
                background: var(--glass-frost);
                backdrop-filter: blur(30px) saturate(180%);
                -webkit-backdrop-filter: blur(30px) saturate(180%);
                border: 2px solid var(--glass-border);
                border-radius: 24px;
                display: flex;
                align-items: center;
                justify-content: space-between;
                padding: 0 30px;
                margin-bottom: 30px;
                position: sticky;
                top: 16px;
                z-index: 900;
                box-shadow: 0 15px 40px rgba(139, 92, 246, 0.08);
            }

            /* ── Aurora Card Styles ── */
            .aurora-card {
                background: linear-gradient(135deg, rgba(255, 255, 255, 0.98), rgba(255, 255, 255, 0.95));
                border: 2px solid rgba(139, 92, 246, 0.12);
                border-radius: 24px;
                box-shadow: 0 15px 35px rgba(139, 92, 246, 0.08);
                transition: all 0.4s var(--ease-spatial);
                padding: 2rem;
                position: relative;
                overflow: hidden;
            }

            .aurora-card::before {
                content: '';
                position: absolute;
                top: 0;
                left: 0;
                right: 0;
                height: 4px;
                background: var(--gradient-violet-cyan);
                opacity: 0;
                transition: opacity 0.3s;
            }

            .aurora-card:hover {
                transform: translateY(-10px) scale(1.02);
                box-shadow: 0 30px 60px rgba(139, 92, 246, 0.15);
                border-color: rgba(139, 92, 246, 0.25);
            }

            .aurora-card:hover::before {
                opacity: 1;
            }

            .aurora-card h3, .aurora-card h4 {
                background: var(--gradient-violet-cyan);
                -webkit-background-clip: text;
                -webkit-text-fill-color: transparent;
                background-clip: text;
                font-weight: 700;
            }

            /* ── Badge Glow ── */
            .badge-aurora-violet {
                background: var(--gradient-violet-cyan);
                color: white;
                padding: 8px 16px;
                border-radius: 20px;
                box-shadow: 0 6px 20px rgba(139, 92, 246, 0.35);
                font-weight: 700;
                font-size: 0.75rem;
                text-transform: uppercase;
                letter-spacing: 0.05em;
            }

            .badge-emerald {
                background: linear-gradient(135deg, var(--aurora-emerald), var(--aurora-cyan));
                color: white;
                padding: 8px 16px;
                border-radius: 20px;
                box-shadow: 0 6px 20px rgba(16, 185, 129, 0.35);
                font-weight: 700;
                font-size: 0.75rem;
                text-transform: uppercase;
                letter-spacing: 0.05em;
            }

            .badge-pink {
                background: var(--gradient-pink-amber);
                color: white;
                padding: 8px 16px;
                border-radius: 20px;
                box-shadow: 0 6px 20px rgba(236, 72, 153, 0.35);
                font-weight: 700;
                font-size: 0.75rem;
                text-transform: uppercase;
                letter-spacing: 0.05em;
            }

            @media (max-width: 1100px) {
                #sidebar-aurora { transform: translateX(-110%); }
                #sidebar-aurora.open { transform: translateX(0); margin: 10px; height: calc(100vh - 20px); }
                #main-wrapper { margin-left: 0; padding: 10px 16px; }
                .dashboard-topbar-aurora { flex-direction: column; height: auto; gap: 1rem; }
            }
        </style>
        {% block stylesheets %}{% endblock %}
    </head>
    <body>
        <div class="aurora-bg">
            <div class="aurora-blob blob-1"></div>
            <div class="aurora-blob blob-2"></div>
            <div class="aurora-blob blob-3"></div>
        </div>

        {# ── FLOATING SIDEBAR ── #}
        <aside id="sidebar-aurora">
            <div class="sb-brand-aurora">
                ServiceHub<span style="color: var(--aurora-cyan)">.</span>
            </div>

            <div class="px-4 mb-4">
                <div class="d-flex align-items-center gap-3 p-3 rounded-4" style="background: rgba(139,92,246,0.05)">
                    <div class="sb-user-avatar" style="width:44px; height:44px; background: var(--gradient-violet); border-radius:12px; display:flex; align-items:center; justify-content:center; color:white; font-weight:800;">
                        {{ app.user.fullName|slice(0,1)|upper }}
                    </div>
                    <div>
                        <div style="font-weight:800; font-size:0.85rem;">{{ app.user.fullName }}</div>
                        <div style="font-size:0.65rem; color:var(--aurora-violet); font-weight:700; letter-spacing:1px;">{{ app.user.tier|upper }} MEMBER</div>
                    </div>
                </div>
            </div>

            <nav class="sb-nav-aurora">
                <div class="sb-nav-label">Navigation</div>
                <a href="{{ path('app_home') }}" class="sb-link-aurora">
                    <i class="fas fa-compass"></i> Portal
                </a>

                <div class="sb-nav-label">Management</div>
                {% if is_granted('ROLE_PROVIDER') %}
                    <a href="{{ path('app_provider_dashboard') }}" class="sb-link-aurora {{ app.request.get('_route') == 'app_provider_dashboard' ? 'active' : '' }}">
                        <i class="fas fa-terminal"></i> Command
                    </a>
                    <a href="{{ path('app_provider_my_services') }}" class="sb-link-aurora {{ app.request.get('_route') == 'app_provider_my_services' ? 'active' : '' }}">
                        <i class="fas fa-box-archive"></i> Inventory
                    </a>
                {% else %}
                    <a href="{{ path('app_customer_dashboard') }}" class="sb-link-aurora {{ app.request.get('_route') == 'app_customer_dashboard' ? 'active' : '' }}">
                        <i class="fas fa-user-astronaut"></i> Manifest
                    </a>
                    <a href="{{ path('app_service_list') }}" class="sb-link-aurora">
                        <i class="fas fa-search"></i> Archive
                    </a>
                {% endif %}

                <div class="sb-nav-label">Personal</div>
                <a href="{{ path('app_profile') }}" class="sb-link-aurora {{ app.request.get('_route') == 'app_profile' ? 'active' : '' }}">
                    <i class="fas fa-fingerprint"></i> Identity
                </a>
                <a href="{{ path('app_billing_index') }}" class="sb-link-aurora {{ app.request.get('_route') == 'app_billing_index' ? 'active' : '' }}">
                    <i class="fas fa-wallet"></i> Exchequer
                </a>

                <div class="mt-auto p-3">
                    <a href="{{ path('app_logout') }}" class="sb-link-aurora text-danger" style="background: rgba(239,68,68,0.05)">
                        <i class="fas fa-power-off text-danger"></i> Logout
                    </a>
                </div>
            </nav>
        </aside>

        <div id="main-wrapper">
            <header class="dashboard-topbar-aurora">
                <div class="d-flex align-items-center gap-3">
                    <button class="bg-transparent border-0 text-violet d-xl-none fs-4" onclick="document.getElementById('sidebar-aurora').classList.toggle('open')">
                        <i class="fas fa-bars-staggered"></i>
                    </button>
                    <div class="page-title-aurora">{% block page_title %}Dashboard{% endblock %}</div>
                </div>
                <div class="d-flex align-items-center gap-3">
                    <span class="badge-aurora-violet">
                        <i class="fas fa-shield-halved me-1"></i> {{ app.user.tier }}
                    </span>
                </div>
            </header>

            <main class="content-area-aurora animate-spatial">
                {% block body %}{% endblock %}
            </main>
        </div>

        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
        <script>
            // Simple Mobile Toggle
            document.querySelector('.text-violet').addEventListener('click', function() {
                document.getElementById('sidebar-aurora').classList.toggle('open');
            });
        </script>
        {% block javascripts %}{% endblock %}
    </body>
</html>