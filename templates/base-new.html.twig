<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <meta name="theme-color" content="#05070a">
        <title>{% block title %}ServiceHub — Spatial UI Portal{% endblock %}</title>
        
        {# ── FONTS ── #}
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;600;800&family=Playfair+Display:ital,wght@0,700;1,700&display=swap" rel="stylesheet">

        {# ── ICONS & BOOTSTRAP ── #}
        <script src="https://cdn.jsdelivr.net/npm/lucide@latest"></script>
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
        
        {# ── FUTURISTIC CORE STYLES ── #}
        <style>
            :root {
                --bg-cyber: #05070a;
                --accent-teal: #00ffd5;
                --accent-purple: #8b5cf6;
                --glass-bg: rgba(255, 255, 255, 0.03);
                --glass-border: rgba(255, 255, 255, 0.1);
                --transition-warp: all 0.5s cubic-bezier(0.23, 1, 0.32, 1);
            }

            body {
                background-color: var(--bg-cyber);
                color: #e2e8f0;
                font-family: 'Plus Jakarta Sans', sans-serif;
                overflow-x: hidden;
                padding-top: 110px;
                /* Cyber Grid Background */
                background-image: 
                    linear-gradient(rgba(0, 255, 213, 0.02) 1px, transparent 1px),
                    linear-gradient(90deg, rgba(0, 255, 213, 0.02) 1px, transparent 1px);
                background-size: 50px 50px;
            }

            /* Custom Futuristic Cursor */
            #custom-cursor {
                width: 10px; height: 10px;
                background: var(--accent-teal);
                border-radius: 50%;
                position: fixed;
                pointer-events: none;
                z-index: 9999;
                transition: transform 0.1s ease;
                box-shadow: 0 0 15px var(--accent-teal);
            }

            /* Floating Spatial Navbar */
            .navbar-spatial {
                position: fixed;
                top: 25px;
                left: 50%;
                transform: translateX(-50%);
                width: 90%;
                max-width: 1200px;
                background: rgba(10, 15, 25, 0.7);
                backdrop-filter: blur(40px);
                -webkit-backdrop-filter: blur(40px);
                border: 1px solid var(--glass-border);
                border-radius: 20px;
                padding: 12px 30px;
                display: flex;
                align-items: center;
                justify-content: space-between;
                z-index: 1000;
                transition: var(--transition-warp);
            }

            .navbar-spatial.scrolled {
                width: 95%;
                top: 15px;
                border-color: var(--accent-teal);
                box-shadow: 0 10px 40px rgba(0,0,0,0.5);
            }

            .nav-brand-spatial {
                font-family: 'Playfair Display', serif;
                font-size: 1.5rem;
                font-weight: 800;
                color: #fff !important;
                text-decoration: none;
                letter-spacing: -1px;
            }

            .nav-brand-spatial span {
                color: var(--accent-teal);
                text-shadow: 0 0 10px rgba(0, 255, 213, 0.5);
            }

            .nav-link-spatial {
                color: #94a3b8 !important;
                font-weight: 600;
                font-size: 0.85rem;
                text-transform: uppercase;
                letter-spacing: 1px;
                padding: 10px 15px;
                transition: var(--transition-warp);
                text-decoration: none;
            }

            .nav-link-spatial:hover, .nav-link-spatial.active {
                color: var(--accent-teal) !important;
                text-shadow: 0 0 8px rgba(0, 255, 213, 0.3);
            }

            /* User Orb Component */
            .user-orb-spatial {
                width: 40px; height: 40px;
                border-radius: 12px;
                background: linear-gradient(135deg, var(--accent-teal), var(--accent-purple));
                display: flex; align-items: center; justify-content: center;
                font-weight: 800; color: #000;
                box-shadow: 0 4px 15px rgba(0, 255, 213, 0.3);
                border: 1px solid rgba(255,255,255,0.2);
            }

            /* Content Fade In */
            .animate-spatial {
                animation: spatialUp 0.8s var(--transition-warp) forwards;
            }

            @keyframes spatialUp {
                from { opacity: 0; transform: translateY(30px) scale(0.98); }
                to { opacity: 1; transform: translateY(0) scale(1); }
            }
        </style>
        
        {% block stylesheets %}{% endblock %}
    </head>
    <body class="customer-accent">
        <div id="custom-cursor" class="d-none d-md-block"></div>

        {% if app.request.get('_route') not in ['app_login', 'app_register', 'app_verify_otp'] %}
        <nav class="navbar-spatial" id="mainNavbar">
            <a class="nav-brand-spatial" href="{{ path('app_home') }}">
                Service<span>Hub</span>
            </a>

            <div class="nav-links d-none d-lg-flex gap-3">
                <a href="{{ path('app_home') }}" class="nav-link-spatial {{ app.request.get('_route') == 'app_home' ? 'active' : '' }}">Portal</a>
                <a href="{{ path('app_service_list') }}" class="nav-link-spatial {{ app.request.get('_route') == 'app_service_list' ? 'active' : '' }}">Archive</a>
                {% if app.user %}
                    {% if is_granted('ROLE_PROVIDER') %}
                        <a href="{{ path('app_provider_dashboard') }}" class="nav-link-spatial {{ app.request.get('_route') == 'app_provider_dashboard' ? 'active' : '' }}">Command</a>
                    {% else %}
                        <a href="{{ path('app_customer_dashboard') }}" class="nav-link-spatial {{ app.request.get('_route') == 'app_customer_dashboard' ? 'active' : '' }}">Manifest</a>
                    {% endif %}
                {% endif %}
            </div>

            <div class="d-flex align-items-center gap-3">
                {% if app.user %}
                    <div class="dropdown">
                        <button class="bg-transparent border-0 p-0 d-flex align-items-center gap-3" data-bs-toggle="dropdown">
                            <div class="user-orb-spatial">{{ app.user.fullName|slice(0,1)|upper }}</div>
                            <div class="text-start d-none d-md-block">
                                <div style="font-size: 0.6rem; color: var(--accent-teal); font-weight: 800; letter-spacing: 1px;">{{ app.user.tier|upper }} ACTIVE</div>
                                <div style="color: #fff; font-weight: bold; font-size: 0.85rem;">{{ app.user.fullName|split(' ')[0] }}</div>
                            </div>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end p-2 mt-4" style="background: rgba(10,15,25,0.9); border: 1px solid var(--glass-border); border-radius: 15px; backdrop-filter: blur(20px);">
                            <li><a class="dropdown-item text-white py-2" href="{{ path('app_profile') }}"><i data-lucide="user" class="me-2 size-4"></i> Identity</a></li>
                            <li><hr class="dropdown-divider" style="border-color: var(--glass-border);"></li>
                            <li><a class="dropdown-item text-danger py-2" href="{{ path('app_logout') }}"><i data-lucide="log-out" class="me-2 size-4"></i> Terminate</a></li>
                        </ul>
                    </div>
                {% else %}
                    <a href="{{ path('app_login') }}" class="btn btn-luxury">Initialize Access</a>
                {% endif %}
            </div>
        </nav>
        {% endif %}

        <main class="container animate-spatial">
            {# ── FLASH MESSAGES ── #}
            {% for label, messages in app.flashes %}
                {% for message in messages %}
                    <div class="glass-card mb-4 border-0 p-3 d-flex align-items-center gap-3" style="background: rgba(0, 255, 213, 0.05); border-left: 3px solid var(--accent-teal) !important;">
                        <i data-lucide="zap" class="text-teal"></i>
                        <div style="font-weight: 600; font-size: 0.9rem; color: var(--accent-teal);">{{ message }}</div>
                    </div>
                {% endfor %}
            {% endfor %}

            {% block body %}{% endblock %}
        </main>

        {# ── SCRIPTS ── #}
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
        <script>
            // Custom Cursor Logic
            const cursor = document.getElementById('custom-cursor');
            document.addEventListener('mousemove', e => {
                cursor.style.left = e.clientX + 'px';
                cursor.style.top = e.clientY + 'px';
            });

            // Navbar Scroll Effect
            window.addEventListener('scroll', () => {
                const nav = document.getElementById('mainNavbar');
                if (window.scrollY > 50) nav.classList.add('scrolled');
                else nav.classList.remove('scrolled');
            });

            // Initialize Lucide icons
            lucide.createIcons();
        </script>
        
        {% block javascripts %}{% endblock %}
    </body>
</html>