{% extends 'dashboard_base.html.twig' %}

{% block title %}My Profile{% endblock %}

{% block body %}
<div class="container py-4">
    <div class="row mb-5">
        <div class="col-12">
            <h2 class="fw-bold mb-0">My Account Settings</h2>
            <p class="text-muted">Manage your personal information, history, and payment methods.</p>
        </div>
    </div>

    <div class="row">
        {# ટોપ નેવિગેશન ટેબ્સ (Horizontal Tabs) #}
        <div class="col-12 mb-4">
            <ul class="nav nav-pills nav-fill bg-white shadow-sm rounded-pill p-1" id="pills-tab" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active rounded-pill fw-bold" id="pills-profile-tab" data-bs-toggle="pill" data-bs-target="#pills-profile" type="button" role="tab" aria-controls="pills-profile" aria-selected="true">
                        <i class="fas fa-user-circle me-2"></i>Personal Details
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link rounded-pill fw-bold" id="pills-history-tab" data-bs-toggle="pill" data-bs-target="#pills-history" type="button" role="tab" aria-controls="pills-history" aria-selected="false">
                        <i class="fas fa-history me-2"></i>Activity History
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link rounded-pill fw-bold" id="pills-payment-tab" data-bs-toggle="pill" data-bs-target="#pills-payment" type="button" role="tab" aria-controls="pills-payment" aria-selected="false">
                        <i class="fas fa-credit-card me-2"></i>Payment Methods
                    </button>
                </li>
            </ul>
        </div>

        {# ટેબ્સનું કન્ટેન્ટ #}
        <div class="col-12">
            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-body p-4 p-md-5">
                    <div class="tab-content" id="pills-tabContent">
                        
                        {# ૧. પ્રોફાઈલ ડીટેલ્સ ટેબ #}
                        <div class="tab-pane fade show active" id="pills-profile" role="tabpanel" aria-labelledby="pills-profile-tab">
                            <div class="d-flex justify-content-between align-items-center mb-5 pb-3 border-bottom">
                                <div>
                                    <h4 class="fw-bold mb-1">Personal Information</h4>
                                    <p class="text-muted small mb-0">Update your photo and personal details here.</p>
                                </div>
                                <button class="btn btn-outline-primary rounded-pill px-4">
                                    <i class="fas fa-edit me-2"></i>Edit Profile
                                </button>
                            </div>
                            
                            <div class="row align-items-center mb-5">
                                <div class="col-sm-3 text-muted fw-semibold">Avatar</div>
                                <div class="col-sm-9">
                                    <div class="d-flex align-items-center">
                                        <div class="bg-primary text-white rounded-circle d-flex justify-content-center align-items-center shadow-sm me-4" style="width: 80px; height: 80px; font-size: 30px; font-weight: bold;">
                                            {{ app.user.email|slice(0,1)|upper }}
                                        </div>
                                        <div>
                                            <button class="btn btn-sm btn-outline-secondary rounded-pill me-2">Change</button>
                                            <button class="btn btn-sm btn-link text-danger text-decoration-none">Remove</button>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="row mb-4">
                                <div class="col-sm-3 text-muted fw-semibold">Full Name</div>
                                <div class="col-sm-9 fw-bold text-dark">{{ app.user.fullName|default(app.user.email|split('@')[0]) }}</div>
                            </div>
                            <div class="row mb-4">
                                <div class="col-sm-3 text-muted fw-semibold">Email Address</div>
                                <div class="col-sm-9 fw-bold text-dark">{{ app.user.email }}</div>
                            </div>
                            <div class="row mb-4">
                                <div class="col-sm-3 text-muted fw-semibold">Mobile Number</div>
                                <div class="col-sm-9 fw-bold text-dark">{{ app.user.mobile|default('Not Added') }}</div>
                            </div>
                            <div class="row mb-4">
                                <div class="col-sm-3 text-muted fw-semibold">Date of Birth</div>
                                <div class="col-sm-9 fw-bold text-dark">{{ app.user.dot ? app.user.dot|date('d M, Y') : 'Not Added' }}</div>
                            </div>
                            <div class="row mb-4">
                                <div class="col-sm-3 text-muted fw-semibold">Gender</div>
                                <div class="col-sm-9 fw-bold text-dark">{{ app.user.gender|default('Not Added') }}</div>
                            </div>
                            <div class="row mb-0">
                                <div class="col-sm-3 text-muted fw-semibold">City</div>
                                <div class="col-sm-9 fw-bold text-dark">{{ app.user.city|default('Not Added') }}</div>
                            </div>
                        </div>

                        {# ૨. હિસ્ટ્રી ટેબ (અત્યારે ડેમો ડેટા છે) #}
                        <div class="tab-pane fade" id="pills-history" role="tabpanel" aria-labelledby="pills-history-tab">
                            <h4 class="fw-bold mb-4 pb-3 border-bottom">Recent Activity</h4>
                            <div class="timeline mt-4">
                                <div class="d-flex mb-4">
                                    <div class="mt-1 me-4 text-primary"><i class="fas fa-circle ms-1"></i></div>
                                    <div>
                                        <h6 class="fw-bold mb-1">Account Creation</h6>
                                        <p class="text-muted small mb-0">You successfully joined ServiceHub.</p>
                                        <small class="text-primary fw-bold">10th Feb, 2024</small>
                                    </div>
                                </div>
                                <div class="d-flex mb-4">
                                    <div class="mt-1 me-4 text-success"><i class="fas fa-circle ms-1"></i></div>
                                    <div>
                                        <h6 class="fw-bold mb-1">Profile Updated</h6>
                                        <p class="text-muted small mb-0">You updated your personal information.</p>
                                        <small class="text-success fw-bold">Last Week</small>
                                    </div>
                                </div>
                            </div>
                        </div>

                        {# ૩. પેમેન્ટ ટેબ (અત્યારે ડેમો ડિઝાઇન છે) #}
                        <div class="tab-pane fade" id="pills-payment" role="tabpanel" aria-labelledby="pills-payment-tab">
                            <div class="d-flex justify-content-between align-items-center mb-5 pb-3 border-bottom">
                                <div>
                                    <h4 class="fw-bold mb-1">Payment Methods</h4>
                                    <p class="text-muted small mb-0">Manage your saved cards and payment options.</p>
                                </div>
                                <button class="btn btn-primary rounded-pill px-4">
                                    <i class="fas fa-plus me-2"></i>Add Card
                                </button>
                            </div>
                            
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="card bg-dark text-white rounded-4 border-0 shadow-sm position-relative overflow-hidden">
                                        <div class="position-absolute end-0 top-0 opacity-25 p-3">
                                            <i class="fab fa-cc-visa fa-4x"></i>
                                        </div>
                                        <div class="card-body p-4 p-md-5 position-relative z-1">
                                            <h5 class="mb-4 fw-normal opacity-75">HDFC Bank</h5>
                                            <h3 class="mb-4 fw-bold letter-spacing-2">**** **** **** 4589</h3>
                                            <div class="d-flex justify-content-between align-items-end">
                                                <div>
                                                    <small class="d-block opacity-75 mb-1 text-uppercase" style="font-size: 0.7rem;">Card Holder</small>
                                                    <div class="fw-bold">{{ app.user.email|split('@')[0]|upper }}</div>
                                                </div>
                                                <div>
                                                    <small class="d-block opacity-75 mb-1 text-uppercase" style="font-size: 0.7rem;">Expires</small>
                                                    <div class="fw-bold">12/28</div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>
        
    </div>
</div>
{% endblock %}