{% extends 'dashboard_base.html.twig' %}

{% block title %}Profile - {{ app.user.fullName|default(app.user.email) }}{% endblock %}
{% block page_title %}Profile Overview{% endblock %}

{% block stylesheets %}
<style>
    .profile-shell {
        max-width: 1280px;
        margin: 0 auto;
        display: grid;
        gap: 24px;
    }
    .profile-hero {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        gap: 28px;
        align-items: stretch;
        padding: clamp(24px, 4vw, 42px);
        position: relative;
        overflow: hidden;
    }
    .profile-hero::before {
        content: '';
        position: absolute;
        inset: 0;
        background:
            radial-gradient(circle at 14% 20%, rgba(0,255,213,0.18), transparent 34%),
            radial-gradient(circle at 88% 82%, rgba(157,124,255,0.16), transparent 32%);
        pointer-events: none;
    }
    .profile-hero > * { position: relative; z-index: 1; }
    .profile-identity {
        display: flex;
        align-items: center;
        gap: 24px;
        min-width: 0;
    }
    .profile-avatar-xl {
        width: 112px;
        height: 112px;
        border-radius: 28px;
        display: grid;
        place-items: center;
        color: #061015;
        background: linear-gradient(135deg, #00ffd5, #9d7cff);
        font-size: 3rem;
        font-weight: 900;
        box-shadow: 0 0 34px rgba(0,255,213,0.32);
        flex: 0 0 auto;
    }
    .profile-name {
        font-size: clamp(2rem, 5vw, 4rem);
        line-height: 0.96;
        margin: 0 0 10px;
        color: #fff;
    }
    .profile-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        color: var(--portal-muted);
        font-size: 0.84rem;
        font-weight: 800;
    }
    .profile-action-stack {
        display: flex;
        flex-direction: column;
        justify-content: center;
        gap: 12px;
        min-width: 220px;
    }
    .profile-stat-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 16px;
    }
    .profile-stat {
        padding: 22px;
        min-height: 132px;
    }
    .profile-stat .label {
        color: var(--portal-muted);
        font-size: 0.68rem;
        font-weight: 900;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        margin-bottom: 12px;
    }
    .profile-stat .value {
        color: #fff;
        font-size: 2rem;
        font-weight: 900;
        line-height: 1;
    }
    .profile-grid {
        display: grid;
        grid-template-columns: 1.1fr 0.9fr;
        gap: 24px;
        align-items: start;
    }
    .profile-panel {
        padding: 28px;
    }
    .profile-panel-title {
        color: #fff;
        font-size: 1rem;
        font-weight: 900;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        margin: 0 0 22px;
    }
    .info-list {
        display: grid;
        gap: 14px;
    }
    .info-row {
        display: grid;
        grid-template-columns: 170px minmax(0, 1fr);
        gap: 16px;
        align-items: center;
        padding: 14px 0;
        border-bottom: 1px solid rgba(255,255,255,0.08);
    }
    .info-label {
        color: var(--portal-muted);
        font-size: 0.72rem;
        font-weight: 900;
        letter-spacing: 0.12em;
        text-transform: uppercase;
    }
    .info-value {
        color: #fff;
        font-weight: 750;
        word-break: break-word;
    }
    .quick-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 14px;
    }
    .quick-card {
        padding: 18px;
        border: 1px solid rgba(255,255,255,0.12);
        border-radius: 18px;
        background: rgba(255,255,255,0.055);
        color: #fff;
        text-decoration: none;
        transition: all 0.25s ease;
    }
    .quick-card:hover {
        transform: translateY(-3px);
        border-color: rgba(0,255,213,0.36);
        box-shadow: 0 0 26px rgba(0,255,213,0.14);
        color: #fff;
    }
    .quick-card i {
        color: var(--portal-cyan);
        margin-bottom: 12px;
        font-size: 1.2rem;
    }
    .quick-card strong {
        display: block;
        margin-bottom: 4px;
    }
    .quick-card span {
        color: var(--portal-muted);
        font-size: 0.78rem;
    }
    .verify-list {
        display: grid;
        gap: 12px;
    }
    .verify-item {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        padding: 14px 16px;
        border-radius: 16px;
        background: rgba(255,255,255,0.055);
        border: 1px solid rgba(255,255,255,0.10);
    }
    .verify-item span {
        color: #fff;
        font-weight: 800;
    }
    .verify-item small {
        color: var(--portal-muted);
        display: block;
        margin-top: 3px;
    }
    .verify-ok { color: var(--portal-success); }
    .verify-warn { color: var(--portal-amber); }
    @media (max-width: 1100px) {
        .profile-hero,
        .profile-grid {
            grid-template-columns: 1fr;
        }
        .profile-action-stack {
            min-width: 0;
            flex-direction: row;
            flex-wrap: wrap;
        }
        .profile-stat-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }
    @media (max-width: 640px) {
        .profile-identity {
            flex-direction: column;
            align-items: flex-start;
        }
        .profile-stat-grid,
        .quick-grid,
        .info-row {
            grid-template-columns: 1fr;
        }
    }
</style>
{% endblock %}

{% block body %}
{% set user = app.user %}
{% set isProvider = is_granted('ROLE_PROVIDER') %}
{% set bookings = user.bookings %}
{% set services = user.services %}
{% set billings = user.billings %}
{% set reviewsGiven = user.reviewsGiven %}
{% set reviewsReceived = user.reviewsReceived %}
{% set completedBookings = bookings|filter(b => b.status|lower == 'completed') %}
{% set activeBookings = bookings|filter(b => b.status|lower in ['pending', 'confirmed', 'accepted', 'on-the-way']) %}
{% set unreadNotifications = user.notifications|filter(n => not n.isRead) %}

<div class="profile-shell reveal-3d">
    <section class="glass-card profile-hero">
        <div class="profile-identity">
            <div class="profile-avatar-xl">
                {{ user.fullName|default(user.email)|slice(0, 1)|upper }}
            </div>
            <div>
                <div class="text-xxs text-teal fw-900 letter-spacing-4 mb-2">SERVICEHUB ACCOUNT</div>
                <h1 class="profile-name">{{ user.fullName|default('ServiceHub User') }}</h1>
                <div class="profile-meta">
                    <span class="badge-status status-active">{{ user.tier|default('Bronze') }} Tier</span>
                    <span class="badge-status {{ user.isVerified ? 'status-active' : 'status-pending' }}">{{ user.isVerified ? 'Verified' : 'OTP Pending' }}</span>
                    <span class="badge-status {{ user.isActive ? 'status-active' : 'status-alert' }}">{{ user.isActive ? 'Active' : 'Suspended' }}</span>
                    {% if isProvider %}<span class="badge-status status-pending">Provider</span>{% else %}<span class="badge-status">Customer</span>{% endif %}
                </div>
            </div>
        </div>

        <div class="profile-action-stack">
            <a href="{{ path('app_profile_edit') }}" class="btn-luxury py-3 text-center">
                <i class="fas fa-pen-to-square me-2"></i>Edit Profile
            </a>
            {% if isProvider %}
                <a href="{{ path('app_service_new') }}" class="btn-outline-luxury py-3 text-center">
                    <i class="fas fa-circle-plus me-2"></i>Add Service
                </a>
            {% else %}
                <a href="{{ path('app_service_list') }}" class="btn-outline-luxury py-3 text-center">
                    <i class="fas fa-magnifying-glass me-2"></i>Book Service
                </a>
            {% endif %}
        </div>
    </section>

    <section class="profile-stat-grid">
        <div class="glass-card profile-stat">
            <div class="label">{{ isProvider ? 'Listed Services' : 'Total Bookings' }}</div>
            <div class="value">{{ isProvider ? services|length : bookings|length }}</div>
        </div>
        <div class="glass-card profile-stat">
            <div class="label">{{ isProvider ? 'Reviews Received' : 'Completed Jobs' }}</div>
            <div class="value">{{ isProvider ? reviewsReceived|length : completedBookings|length }}</div>
        </div>
        <div class="glass-card profile-stat">
            <div class="label">Reputation</div>
            <div class="value">{{ user.reputationPoints|default(0) }}</div>
        </div>
        <div class="glass-card profile-stat">
            <div class="label">Unread Alerts</div>
            <div class="value">{{ unreadNotifications|length }}</div>
        </div>
    </section>

    <section class="profile-grid">
        <div class="glass-card profile-panel">
            <h2 class="profile-panel-title">Account Details</h2>
            <div class="info-list">
                <div class="info-row">
                    <div class="info-label">Email</div>
                    <div class="info-value">{{ user.email }}</div>
                </div>
                <div class="info-row">
                    <div class="info-label">Mobile</div>
                    <div class="info-value">{{ user.mobile|default('Not added yet') }}</div>
                </div>
                <div class="info-row">
                    <div class="info-label">City</div>
                    <div class="info-value">{{ user.city|default('Not added yet') }}</div>
                </div>
                <div class="info-row">
                    <div class="info-label">Address</div>
                    <div class="info-value">{{ user.address|default('Not added yet') }}</div>
                </div>
                <div class="info-row">
                    <div class="info-label">Pincode</div>
                    <div class="info-value">{{ user.pincode|default('Not added yet') }}</div>
                </div>
                <div class="info-row">
                    <div class="info-label">Member Since</div>
                    <div class="info-value">{{ user.createdAt ? user.createdAt|date('d M Y') : 'Recently' }}</div>
                </div>
            </div>
        </div>

        <div class="glass-card profile-panel">
            <h2 class="profile-panel-title">Quick Actions</h2>
            <div class="quick-grid">
                {% if isProvider %}
                    <a class="quick-card" href="{{ path('app_provider_dashboard') }}">
                        <i class="fas fa-chart-line"></i>
                        <strong>Provider Dashboard</strong>
                        <span>Bookings, earnings and reviews</span>
                    </a>
                    <a class="quick-card" href="{{ path('app_provider_my_services') }}">
                        <i class="fas fa-layer-group"></i>
                        <strong>My Services</strong>
                        <span>Manage your listings</span>
                    </a>
                    <a class="quick-card" href="{{ path('app_booking_provider_bookings') }}">
                        <i class="fas fa-calendar-check"></i>
                        <strong>Provider Bookings</strong>
                        <span>Dispatch and complete jobs</span>
                    </a>
                    <a class="quick-card" href="{{ path('app_provider_billing_new') }}">
                        <i class="fas fa-file-invoice"></i>
                        <strong>Create Bill</strong>
                        <span>Send invoice to customers</span>
                    </a>
                {% else %}
                    <a class="quick-card" href="{{ path('app_customer_dashboard') }}">
                        <i class="fas fa-gauge-high"></i>
                        <strong>Dashboard</strong>
                        <span>Overview of your service activity</span>
                    </a>
                    <a class="quick-card" href="{{ path('app_booking_my_bookings') }}">
                        <i class="fas fa-calendar-days"></i>
                        <strong>My Bookings</strong>
                        <span>Track and manage bookings</span>
                    </a>
                    <a class="quick-card" href="{{ path('app_service_list') }}">
                        <i class="fas fa-screwdriver-wrench"></i>
                        <strong>Browse Services</strong>
                        <span>Find verified professionals</span>
                    </a>
                    <a class="quick-card" href="{{ path('app_billing_index') }}">
                        <i class="fas fa-receipt"></i>
                        <strong>Billing</strong>
                        <span>Invoices and payment history</span>
                    </a>
                {% endif %}
                <a class="quick-card" href="{{ path('app_message_inbox') }}">
                    <i class="fas fa-comments"></i>
                    <strong>Messages</strong>
                    <span>Chat with customers or providers</span>
                </a>
                <a class="quick-card" href="{{ path('app_notification_index') }}">
                    <i class="fas fa-bell"></i>
                    <strong>Notifications</strong>
                    <span>Alerts and service updates</span>
                </a>
            </div>
        </div>
    </section>

    <section class="profile-grid">
        <div class="glass-card profile-panel">
            <h2 class="profile-panel-title">Verification & Preferences</h2>
            <div class="verify-list">
                <div class="verify-item">
                    <div>
                        <span>Email Verification</span>
                        <small>{{ user.isVerified ? 'Your account email is verified.' : 'Please verify OTP to unlock all features.' }}</small>
                    </div>
                    <i class="fas {{ user.isVerified ? 'fa-circle-check verify-ok' : 'fa-clock verify-warn' }}"></i>
                </div>
                <div class="verify-item">
                    <div>
                        <span>Profile Completion</span>
                        <small>{{ user.mobile and user.city and user.address ? 'Basic contact and address details are complete.' : 'Add mobile, city and address for smoother bookings.' }}</small>
                    </div>
                    <i class="fas {{ user.mobile and user.city and user.address ? 'fa-circle-check verify-ok' : 'fa-triangle-exclamation verify-warn' }}"></i>
                </div>
                <div class="verify-item">
                    <div>
                        <span>Booking Alerts</span>
                        <small>In-app {{ user.bookingInAppNotifications ? 'on' : 'off' }}, email {{ user.bookingEmailNotifications ? 'on' : 'off' }}.</small>
                    </div>
                    <a href="{{ path('app_profile_edit') }}#notification-preferences" class="text-teal text-decoration-none fw-900">Edit</a>
                </div>
                <div class="verify-item">
                    <div>
                        <span>Message Alerts</span>
                        <small>In-app {{ user.messageInAppNotifications ? 'on' : 'off' }}, email {{ user.messageEmailNotifications ? 'on' : 'off' }}.</small>
                    </div>
                    <a href="{{ path('app_profile_edit') }}#notification-preferences" class="text-teal text-decoration-none fw-900">Edit</a>
                </div>
            </div>
        </div>

        <div class="glass-card profile-panel">
            <h2 class="profile-panel-title">Recent Activity</h2>
            {% if isProvider and services|length > 0 %}
                <div class="info-list">
                    {% for service in services|slice(0, 4) %}
                        <div class="info-row">
                            <div class="info-label">{{ service.category.name|default('Service') }}</div>
                            <div class="info-value">
                                <a href="{{ path('app_service_show', {id: service.id}) }}" class="text-white text-decoration-none">{{ service.title }}</a>
                                <div class="text-dim small">₹{{ service.price|number_format }} · {{ service.isActive ? 'Visible' : 'Hidden' }}</div>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            {% elseif not isProvider and bookings|length > 0 %}
                <div class="info-list">
                    {% for booking in bookings|slice(0, 4) %}
                        <div class="info-row">
                            <div class="info-label">{{ booking.status|replace({'-': ' '})|upper }}</div>
                            <div class="info-value">
                                <a href="{{ path('app_booking_detail', {id: booking.id}) }}" class="text-white text-decoration-none">{{ booking.service.title }}</a>
                                <div class="text-dim small">{{ booking.bookingDate|date('d M Y') }} · ₹{{ (booking.estimatedCost|default(booking.service.price))|number_format }}</div>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            {% else %}
                <div class="empty-state text-center py-4">
                    <i class="fas fa-inbox fa-2x mb-3"></i>
                    <p class="mb-3">No activity yet.</p>
                    {% if isProvider %}
                        <a href="{{ path('app_service_new') }}" class="btn-luxury py-2 px-4">Add First Service</a>
                    {% else %}
                        <a href="{{ path('app_service_list') }}" class="btn-luxury py-2 px-4">Browse Services</a>
                    {% endif %}
                </div>
            {% endif %}
        </div>
    </section>
</div>
{% endblock %}
