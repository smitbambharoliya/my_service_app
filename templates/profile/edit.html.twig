{% extends 'dashboard_base.html.twig' %}

{% block page_title %}Identity Calibration{% endblock %}

{% block stylesheets %}
<style>
    /* ── SPATIAL IDENTITY INTERFACE ── */
    .profile-canvas {
        max-width: 900px;
        margin: 0 auto;
    }

    .identity-core-wrap {
        position: relative;
        display: inline-block;
        margin-bottom: 50px;
    }

    .profile-avatar-spatial {
        width: 140px; height: 140px;
        background: var(--bg-obsidian);
        border-radius: 40px;
        border: 2px solid var(--accent-teal);
        color: #fff;
        display: flex; align-items: center; justify-content: center;
        font-family: 'Plus Jakarta Sans', sans-serif;
        font-size: 3.5rem;
        font-weight: 900;
        position: relative;
        box-shadow: 0 0 40px rgba(0, 255, 213, 0.15);
        transition: all 0.5s var(--ease-spatial);
    }

    .avatar-edit-trigger {
        position: absolute;
        bottom: -10px; right: -10px;
        width: 44px; height: 44px;
        background: var(--accent-teal);
        color: #05070a;
        border-radius: 12px;
        display: flex; align-items: center; justify-content: center;
        cursor: pointer;
        box-shadow: 0 10px 20px rgba(0, 255, 213, 0.3);
        transition: 0.3s;
        z-index: 2;
    }
    .avatar-edit-trigger:hover { transform: scale(1.1) rotate(5deg); }

    .identity-segment {
        background: rgba(255, 255, 255, 0.02);
        border: 1px solid rgba(255, 255, 255, 0.05);
        border-radius: 32px;
        padding: 40px;
        margin-bottom: 30px;
        transition: 0.4s;
    }
    .identity-segment:hover { border-color: rgba(255, 255, 255, 0.1); background: rgba(255, 255, 255, 0.03); }

    .segment-header {
        display: flex; align-items: center; gap: 15px; margin-bottom: 35px;
    }
    .segment-header i { color: var(--accent-teal); font-size: 1.2rem; opacity: 0.6; }
    .segment-title {
        font-family: 'Plus Jakarta Sans', sans-serif;
        font-weight: 800;
        font-size: 0.75rem;
        letter-spacing: 3px;
        color: var(--text-dim);
        text-transform: uppercase;
        margin: 0;
    }

    /* ── PREFERENCE NODES ── */
    .preference-node {
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 20px;
        padding: 24px;
        transition: all 0.3s;
        height: 100%;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
    }
    .preference-node:hover { border-color: var(--accent-teal); background: rgba(0, 255, 213, 0.02); }

    .pref-label { font-weight: 800; color: #fff; font-size: 0.9rem; margin-bottom: 8px; letter-spacing: 0.5px; }
    .pref-desc { color: var(--text-dim); font-size: 0.75rem; line-height: 1.6; margin-bottom: 20px; }

    /* Custom Switch Styling */
    .form-switch .form-check-input {
        width: 3em; height: 1.6em;
        background-color: rgba(255,255,255,0.1);
        border-color: rgba(255,255,255,0.2);
        cursor: pointer;
    }
    .form-switch .form-check-input:checked { background-color: var(--accent-teal); border-color: var(--accent-teal); }
</style>
{% endblock %}

{% block body %}

<div class="profile-canvas reveal-3d">
    {# ── 1. BIOMETRIC HEADER ── #}
    <div class="text-center mb-5">
        <div class="identity-core-wrap">
            <div class="profile-avatar-spatial">
                {{ app.user.fullName|slice(0,1)|upper }}
            </div>
            <div class="avatar-edit-trigger">
                <i class="fas fa-fingerprint"></i>
            </div>
        </div>
        <div class="text-xxs text-teal fw-900 letter-spacing-4 mb-2">IDENTITY ARCHIVE SINCE {{ app.user.createdAt|date('Y') }}</div>
        <h1 class="luxury-serif text-white h2">{{ app.user.fullName|upper }}</h1>
    </div>

    {{ form_start(form, {'attr': {'class': 'spatial-form'}}) }}
        
        {# ── 2. CORE DESIGNATION ── #}
        <div class="identity-segment border-glow-hover">
            <div class="segment-header">
                <i class="fas fa-id-card-clip"></i>
                <h3 class="segment-title">Core Designation</h3>
            </div>
            <div class="row g-4">
                <div class="col-md-6">
                    <label class="text-xxs text-dim fw-800 mb-2 d-block">PUBLIC DESIGNATION NAME</label>
                    {{ form_widget(form.fullName, {'attr': {'class': 'cyber-input'}}) }}
                </div>
                <div class="col-md-6">
                    <label class="text-xxs text-dim fw-800 mb-2 d-block">ESTABLISHMENT ID (EMAIL)</label>
                    {{ form_widget(form.email, {'attr': {'class': 'cyber-input'}}) }}
                </div>
            </div>
        </div>

        {# ── 3. NEURAL COORDINATES ── #}
        <div class="identity-segment border-glow-hover">
            <div class="segment-header">
                <i class="fas fa-microchip"></i>
                <h3 class="segment-title">Neural Coordinates</h3>
            </div>
            <div class="row g-4">
                <div class="col-md-6">
                    <label class="text-xxs text-dim fw-800 mb-2 d-block">COMM-LINK (PHONE)</label>
                    {{ form_widget(form.phoneNumber, {'attr': {'class': 'cyber-input'}}) }}
                </div>
                <div class="col-md-6">
                    <label class="text-xxs text-dim fw-800 mb-2 d-block">CURRENT SECTOR</label>
                    <input type="text" class="cyber-input opacity-50" value="Global Sector G-Alpha" readonly>
                </div>
            </div>
        </div>

        {# ── 4. NOTIFICATION RELAY NODES ── #}
        <div class="identity-segment border-glow-hover" id="notification-preferences">
            <div class="segment-header">
                <i class="fas fa-satellite-dish"></i>
                <h3 class="segment-title">Notification Relay</h3>
            </div>
            <div class="row g-4">
                {# Node 1: In-App Booking #}
                <div class="col-md-6">
                    <div class="preference-node">
                        <div>
                            <div class="pref-label">In-App Protocols</div>
                            <p class="pref-desc">Real-time status shifts, mission cancellations, and estimate activity inside the Portal.</p>
                        </div>
                        <div class="form-check form-switch p-0 m-0 d-flex justify-content-end">
                            {{ form_widget(form.bookingInAppNotifications, {'attr': {'class': 'form-check-input'}}) }}
                        </div>
                    </div>
                </div>
                {# Node 2: Email Booking #}
                <div class="col-md-6">
                    <div class="preference-node">
                        <div>
                            <div class="pref-label">Email Transmissions</div>
                            <p class="pref-desc">Receive encrypted logs when providers dispatch units or finalize mission estimates.</p>
                        </div>
                        <div class="form-check form-switch p-0 m-0 d-flex justify-content-end">
                            {{ form_widget(form.bookingEmailNotifications, {'attr': {'class': 'form-check-input'}}) }}
                        </div>
                    </div>
                </div>
                {# Node 3: In-App Messages #}
                <div class="col-md-6">
                    <div class="preference-node">
                        <div>
                            <div class="pref-label">Messaging Uplink</div>
                            <p class="pref-desc">Surface active chat transmissions in the HUD as soon as they reach the node.</p>
                        </div>
                        <div class="form-check form-switch p-0 m-0 d-flex justify-content-end">
                            {{ form_widget(form.messageInAppNotifications, {'attr': {'class': 'form-check-input'}}) }}
                        </div>
                    </div>
                </div>
                {# Node 4: Email Messages #}
                <div class="col-md-6">
                    <div class="preference-node">
                        <div>
                            <div class="pref-label">External Nudges</div>
                            <p class="pref-desc">Receive a system ping via email when an artisan initializes a new secure channel.</p>
                        </div>
                        <div class="form-check form-switch p-0 m-0 d-flex justify-content-end">
                            {{ form_widget(form.messageEmailNotifications, {'attr': {'class': 'form-check-input'}}) }}
                        </div>
                    </div>
                </div>
            </div>
        </div>

        {# ── 5. SECURITY CIPHER ── #}
        {% if form.plainPassword is defined %}
            <div class="identity-segment border-glow-hover">
                <div class="segment-header">
                    <i class="fas fa-shield-halved"></i>
                    <h3 class="segment-title">Security Cipher</h3>
                </div>
                <div class="row g-4">
                    <div class="col-md-12">
                        <label class="text-xxs text-dim fw-800 mb-2 d-block">NEW PRIVATE CIPHER (LEAVE BLANK TO MAINTAIN)</label>
                        {{ form_widget(form.plainPassword, {'attr': {'class': 'cyber-input', 'placeholder': '••••••••••••'}}) }}
                    </div>
                </div>
            </div>
        {% endif %}

        {# ── 6. COMMAND ACTIONS ── #}
        <div class="mt-5 d-flex gap-3 justify-content-center">
            <button type="submit" class="btn-luxury py-3 px-5">CALIBRATE IDENTITY</button>
            <a href="{{ path('app_profile') }}" class="btn-outline-luxury py-3 px-5">ABORT PROTOCOL</a>
        </div>
    {{ form_end(form) }}
</div>

{% endblock %}