{% extends 'base.html.twig' %}

{% block title %}Verify Identity - ServiceHub{% endblock %}

{% block stylesheets %}
<style>
    :root {
        --accent-teal: #00ffd5;
        --aurora-violet: #8B5CF6;
        --aurora-pink: #EC4899;
        --aurora-amber: #F59E0B;
        --bg-obsidian: #080a0f;
        --glass-frost: rgba(255, 255, 255, 0.04);
        --ease-spatial: cubic-bezier(0.23, 1, 0.32, 1);
    }
    
    /* ── SPATIAL SECURITY TERMINAL ── */
    html, body { min-height: 100vh; background-color: #05070a; }

    .portal-wrapper {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        position: relative;
        padding: 2rem 1rem;
        box-sizing: border-box;
    }

    .cyber-grid-bg {
        position: absolute; inset: 0;
        background: radial-gradient(circle at center, rgba(0, 255, 213, 0.05) 0%, #05070a 100%);
        z-index: 0;
    }
    
    .cyber-grid-bg::after {
        content: ''; position: absolute; inset: 0;
        background: url('data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHdpZHRoPSI0IiBoZWlnaHQ9IjQiPgo8cmVjdCB3aWR0aD0iNCIgaGVpZ2h0PSI0IiBmaWxsPSIjZmZmIiBmaWxsLW9wYWNpdHk9IjAuMDIiLz4KPC9zdmc+') repeat;
        mix-blend-mode: overlay;
    }

    .security-card {
        width: 100%;
        max-width: 480px;
        background: rgba(10, 15, 25, 0.6);
        backdrop-filter: blur(30px);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 32px;
        padding: 50px 40px;
        position: relative;
        z-index: 10;
        box-shadow: 0 40px 100px rgba(0,0,0,0.6);
        text-align: center;
    }

    .icon-node {
        width: 72px; height: 72px;
        border-radius: 20px;
        background: rgba(0, 255, 213, 0.05);
        border: 1px solid rgba(0, 255, 213, 0.2);
        display: flex; align-items: center; justify-content: center;
        color: var(--accent-teal);
        font-size: 2rem;
        margin: 0 auto 30px;
        box-shadow: 0 0 30px rgba(0, 255, 213, 0.1);
    }

    /* ── TELEMETRY ALERTS ── */
    .alert-spatial {
        display: flex; align-items: flex-start; gap: 12px;
        padding: 16px; border-radius: 12px;
        font-size: 0.8rem; font-weight: 600;
        margin-bottom: 24px; text-align: left;
        background: rgba(255,255,255,0.02);
        position: relative;
        overflow: hidden;
    }
    .alert-spatial::before { content: ''; position: absolute; left: 0; top: 0; bottom: 0; width: 3px; }
    
    .alert-warning { border: 1px solid rgba(255, 209, 102, 0.1); color: #ffd166; }
    .alert-warning::before { background: #ffd166; box-shadow: 0 0 15px #ffd166; }
    
    .alert-success { border: 1px solid rgba(0, 255, 213, 0.1); color: var(--accent-teal); }
    .alert-success::before { background: var(--accent-teal); box-shadow: 0 0 15px var(--accent-teal); }
    
    .alert-error { border: 1px solid rgba(255, 93, 115, 0.1); color: #ff5d73; }
    .alert-error::before { background: #ff5d73; box-shadow: 0 0 15px #ff5d73; }

    /* ── CIPHER INPUT ── */
    .cipher-input {
        width: 100%;
        background: rgba(0, 0, 0, 0.3) !important;
        border: 1px dashed rgba(255, 255, 255, 0.2) !important;
        border-radius: 16px !important;
        color: var(--accent-teal) !important;
        font-size: 2.5rem !important;
        font-family: 'Fira Code', 'Courier New', monospace !important;
        font-weight: 900 !important;
        letter-spacing: 15px !important;
        text-align: center !important;
        padding: 20px !important;
        outline: none;
        transition: all 0.3s var(--ease-spatial);
        margin-bottom: 30px;
    }
    .cipher-input::placeholder { color: rgba(255,255,255,0.05) !important; }
    .cipher-input:focus {
        border-color: var(--accent-teal) !important;
        border-style: solid !important;
        background: rgba(0, 255, 213, 0.02) !important;
        box-shadow: 0 0 30px rgba(0, 255, 213, 0.1) !important;
        text-shadow: 0 0 15px rgba(0, 255, 213, 0.4);
    }
</style>
{% endblock %}

{% block body %}
<div class="portal-wrapper reveal-3d">
    <div class="cyber-grid-bg"></div>

    <div class="security-card border-glow-hover">
        
        {# ── ICON & HEADER ── #}
        <div class="icon-node">
            <i class="fas fa-shield-halved"></i>
        </div>

        <div class="text-xxs text-teal fw-900 letter-spacing-4 mb-2">SECURITY PROTOCOL</div>
        <h1 class="luxury-serif text-white mb-3" style="font-size: 2.2rem;">Identity Verification</h1>
        
        <p class="text-dim text-sm mb-4" style="line-height: 1.6;">
            A one-time authorization cipher has been transmitted to your comm-link at<br>
            <strong class="text-teal font-monospace mt-2 d-block">{{ email }}</strong>
        </p>

        {# ── TELEMETRY ALERTS ── #}
        {% if app.session.get('login_unverified_flash') %}
            {% do app.session.remove('login_unverified_flash') %}
            <div class="alert-spatial alert-warning">
                <i class="fas fa-triangle-exclamation mt-1"></i>
                <span>Node unverified. Input cipher to activate your account.</span>
            </div>
        {% endif %}

        {% for message in app.flashes('success') %}
            <div class="alert-spatial alert-success">
                <i class="fas fa-check-circle mt-1"></i>
                <span>{{ message|raw }}</span>
            </div>
        {% endfor %}

        {% for message in app.flashes('error') %}
            <div class="alert-spatial alert-error">
                <i class="fas fa-circle-xmark mt-1"></i>
                <span>{{ message }}</span>
            </div>
        {% endfor %}

        {% for message in app.flashes('warning') %}
            <div class="alert-spatial alert-warning">
                <i class="fas fa-triangle-exclamation mt-1"></i>
                <span>{{ message|raw }}</span>
            </div>
        {% endfor %}

        {# ── AUTHORIZATION FORM ── #}
        <form method="post" class="spatial-form mt-4">
            <label class="text-xxs text-dim fw-900 letter-spacing-2 d-block mb-3">INPUT CIPHER CODE</label>
            <input 
                type="text" 
                name="otp" 
                id="otp" 
                class="cipher-input" 
                placeholder="000000" 
                maxlength="6" 
                pattern="\d{6}" 
                required 
                autofocus
                autocomplete="one-time-code"
                inputmode="numeric"
            >
            
            <button type="submit" class="btn-luxury w-100 py-3" style="font-size: 0.85rem;">
                AUTHORIZE ACCESS <i class="fas fa-unlock ms-2"></i>
            </button>
        </form>

        {# ── FALLBACK ACTIONS ── #}
        <div class="mt-4 pt-4 border-top border-white border-opacity-5">
            <p class="text-xxs text-dim fw-800 letter-spacing-1 mb-2">CIPHER NOT RECEIVED?</p>
            <a href="{{ path('app_resend_otp') }}" class="text-teal text-xs fw-900 text-decoration-none d-block mb-3" style="transition: 0.3s; text-shadow: 0 0 10px rgba(0,255,213,0); hover: text-shadow: 0 0 10px rgba(0,255,213,0.5);">
                REQUEST NEW TRANSMISSION
            </a>
            <a href="{{ path('app_login') }}" class="text-dim text-xxs fw-800 text-decoration-none" style="transition: 0.3s;">
                ← ABORT & RETURN
            </a>
        </div>

    </div>
</div>
{% endblock %}
