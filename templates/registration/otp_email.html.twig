<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ServiceHub Authorization Cipher</title>
</head>
<body style="margin:0;padding:0;background-color:#05070a;font-family:'Plus Jakarta Sans',Helvetica,Arial,sans-serif;">
    <table width="100%" cellpadding="0" cellspacing="0" style="background-color:#05070a;padding:60px 20px;">
        <tr>
            <td align="center">
                <table width="100%" cellpadding="0" cellspacing="0" style="max-width:580px;background:#0b111a;border-radius:16px;border:1px solid #1a2636;overflow:hidden;box-shadow:0 20px 40px rgba(0,0,0,0.5);">
                    
                    <tr>
                        <td style="background:radial-gradient(circle at top, rgba(0, 255, 213, 0.05), transparent 80%);padding:40px 40px 30px;text-align:center;border-bottom:1px solid #1a2636;">
                            <div style="color:#00ffd5;font-family:'Fira Code','Courier New',Courier,monospace;font-size:11px;font-weight:900;letter-spacing:4px;margin-bottom:12px;">SECURITY PROTOCOL</div>
                            <h1 style="color:#ffffff;margin:0;font-size:24px;font-weight:900;letter-spacing:1px;text-transform:uppercase;">Identity Verification</h1>
                        </td>
                    </tr>

                    <tr>
                        <td style="padding:40px;">
                            <h2 style="color:#ffffff;font-size:18px;margin:0 0 16px;font-weight:800;">Greetings, {{ name|upper }}<span style="color:#00ffd5;">.</span></h2>
                            <p style="color:#94a3b8;font-size:15px;line-height:1.7;margin:0 0 32px;">
                                Your node has been registered on the <strong>ServiceHub</strong> network. To finalize your access clearance, input the authorization cipher provided below.
                            </p>

                            <div style="background-color:#05070a;border:1px dashed #00ffd5;border-radius:12px;text-align:center;padding:32px;margin-bottom:32px;">
                                <p style="color:#64748b;font-size:11px;margin:0 0 12px;text-transform:uppercase;letter-spacing:3px;font-weight:800;font-family:'Fira Code','Courier New',Courier,monospace;">ONE-TIME CIPHER</p>
                                <h1 style="color:#00ffd5;font-size:42px;font-weight:900;margin:0;letter-spacing:12px;font-family:'Fira Code','Courier New',Courier,monospace;text-shadow:0 0 15px rgba(0,255,213,0.3);">{{ otp }}</h1>
                            </div>

                            <table width="100%" cellpadding="0" cellspacing="0">
                                <tr>
                                    <td style="padding:16px;background:rgba(255,93,115,0.05);border:1px solid rgba(255,93,115,0.2);border-radius:8px;margin-bottom:20px;display:block;">
                                        <p style="color:#ff5d73;font-size:12px;line-height:1.6;margin:0;font-weight:700;">
                                            <strong style="letter-spacing:1px;">CRITICAL:</strong> Never transmit this cipher over unsecured channels. ServiceHub will never request this code via external comms.
                                        </p>
                                    </td>
                                </tr>
                            </table>

                            <p style="color:#475569;font-size:12px;line-height:1.6;margin:20px 0 0;text-align:center;">
                                Cipher expires in <strong style="color:#ffffff;">10 minutes</strong>.<br>
                                If you did not initiate this sequence, delete this transmission immediately.
                            </p>
                        </td>
                    </tr>

                    <tr>
                        <td style="background-color:#05070a;padding:24px 40px;border-top:1px solid #1a2636;text-align:center;">
                            <p style="color:#334155;font-size:10px;margin:0;font-family:'Fira Code','Courier New',Courier,monospace;letter-spacing:2px;text-transform:uppercase;">
                                &copy; {{ "now"|date("Y") }} ServiceHub Obsidian X<br>
                                AUTOMATED SYSTEM TRANSMISSION
                            </p>
                        </td>
                    </tr>

                </table>
            </td>
        </tr>
    </table>
</body>
</html>