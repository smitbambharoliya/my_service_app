<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Your ServiceHub OTP</title>
</head>
<body style="margin:0;padding:0;background-color:#f4f7fb;font-family:'Segoe UI',Arial,sans-serif;">
    <table width="100%" cellpadding="0" cellspacing="0" style="background-color:#f4f7fb;padding:40px 0;">
        <tr>
            <td align="center">
                <table width="580" cellpadding="0" cellspacing="0" style="background:#ffffff;border-radius:16px;overflow:hidden;box-shadow:0 4px 24px rgba(0,0,0,0.08);">
                    
                    <!-- Header -->
                    <tr>
                        <td style="background:linear-gradient(135deg,#4f46e5,#7c3aed);padding:40px 40px 36px;text-align:center;">
                            <h1 style="color:#ffffff;margin:0;font-size:28px;font-weight:700;letter-spacing:-0.5px;">ServiceHub</h1>
                            <p style="color:rgba(255,255,255,0.8);margin:6px 0 0;font-size:14px;">Email Verification</p>
                        </td>
                    </tr>

                    <!-- Body -->
                    <tr>
                        <td style="padding:40px;">
                            <h2 style="color:#1e293b;font-size:22px;margin:0 0 12px;">Hello, {{ name }}! 👋</h2>
                            <p style="color:#64748b;font-size:15px;line-height:1.6;margin:0 0 28px;">
                                Welcome to <strong>ServiceHub</strong>! Your account has been created successfully.<br>
                                Use the verification code below to complete your registration:
                            </p>

                            <!-- OTP Box -->
                            <div style="background:linear-gradient(135deg,#eff6ff,#f0fdf4);border:2px dashed #6366f1;border-radius:12px;text-align:center;padding:28px;">
                                <p style="color:#64748b;font-size:13px;margin:0 0 10px;text-transform:uppercase;letter-spacing:2px;font-weight:600;">Your OTP Code</p>
                                <h1 style="color:#4f46e5;font-size:48px;font-weight:700;margin:0;letter-spacing:10px;font-family:'Courier New',monospace;">{{ otp }}</h1>
                                <p style="color:#94a3b8;font-size:12px;margin:12px 0 0;">Valid for 10 minutes only</p>
                            </div>

                            <p style="color:#64748b;font-size:14px;line-height:1.6;margin:28px 0 0;">
                                ⚠️ <strong>Security Notice:</strong> Never share this OTP with anyone. ServiceHub will never ask for your OTP via phone or chat.
                            </p>

                            <p style="color:#94a3b8;font-size:13px;margin:20px 0 0;">
                                If you didn't create an account on ServiceHub, please ignore this email.
                            </p>
                        </td>
                    </tr>

                    <!-- Footer -->
                    <tr>
                        <td style="background:#f8fafc;padding:24px 40px;border-top:1px solid #e2e8f0;text-align:center;">
                            <p style="color:#94a3b8;font-size:12px;margin:0;">
                                © {{ "now"|date("Y") }} ServiceHub. All rights reserved.<br>
                                This is an automated message, please do not reply.
                            </p>
                        </td>
                    </tr>

                </table>
            </td>
        </tr>
    </table>
</body>
</html>
