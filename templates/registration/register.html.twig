{% extends 'base.html.twig' %}

{% block title %}Establish Identity — ServiceHub Luxury Portal{% endblock %}

{% block stylesheets %}
<style>
    html { scroll-behavior: smooth; }

    .portal-wrapper {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        position: relative;
        padding: 2rem 1rem;
        box-sizing: border-box;
    }

    .portal-card {
        width: 100%;
        max-width: 1200px;
        display: grid;
        grid-template-columns: 1fr 1.3fr;
        background: var(--glass-bg);
        backdrop-filter: blur(var(--glass-blur));
        -webkit-backdrop-filter: blur(var(--glass-blur));
        border: 1px solid var(--glass-border);
        border-radius: 28px;
        overflow: hidden;
        position: relative;
        z-index: 10;
        box-shadow: var(--shadow-elevated);
    }

    /* Left Panel */
    .portal-visual {
        background: linear-gradient(135deg, #0ea5e9 0%, #8b5cf6 100%);
        padding: 56px;
        display: flex;
        flex-direction: column;
        justify-content: center;
    }
    .portal-visual h2, .portal-visual p, .portal-visual span { color: #ffffff !important; }
    
    .heritage-step {
        display: flex;
        gap: 20px;
        margin-bottom: 32px;
        align-items: flex-start;
    }
    .step-node {
        width: 40px; height: 40px;
        border: 2px solid rgba(255,255,255,0.4);
        border-radius: 50%;
        display: flex; align-items: center; justify-content: center;
        color: #ffffff;
        font-weight: 800; font-size: 0.8rem;
        flex-shrink: 0;
        background: rgba(255,255,255,0.2);
    }
    .heritage-step h4 { color: #ffffff; margin-bottom: 6px; font-size: 1.05rem; font-weight: 700; }
    .heritage-step p { color: rgba(255,255,255,0.75); font-size: 0.85rem; margin: 0; line-height: 1.5; }

    /* Right Panel */
    .portal-form-side {
        padding: 48px 52px;
        background: rgba(255, 255, 255, 0.7);
        backdrop-filter: blur(10px);
        overflow-y: auto;
        max-height: 95vh;
    }

    .input-label {
        font-size: 0.6rem;
        font-weight: 800;
        color: var(--color-on-surface-variant);
        text-transform: uppercase;
        letter-spacing: 0.15em;
        margin-bottom: 8px;
        display: block;
    }

    .auth-input {
        width: 100%;
        background: rgba(255, 255, 255, 0.6);
        border: 1px solid var(--glass-border);
        border-radius: 12px;
        padding: 12px 16px;
        color: var(--color-on-surface);
        font-size: 0.875rem;
        transition: all 0.3s var(--ease-luxury);
        margin-bottom: 18px;
        font-family: 'Outfit', sans-serif;
    }
    .auth-input:focus {
        background: rgba(255, 255, 255, 0.9);
        border-color: var(--color-primary);
        outline: none;
        box-shadow: 0 0 0 4px rgba(14, 165, 233, 0.12);
    }
    .auth-input::placeholder { color: #94a3b8; }

    /* Role Selector */
    .luxury-role-selector {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 16px;
        margin-bottom: 24px;
    }
    .role-option { cursor: pointer; position: relative; }
    .role-option input { display: none; }
    .role-ui {
        background: rgba(255,255,255,0.5);
        border: 1px solid var(--glass-border);
        padding: 18px;
        border-radius: 14px;
        text-align: center;
        transition: all 0.3s var(--ease-luxury);
    }
    .role-option:hover .role-ui { border-color: var(--color-primary); transform: translateY(-3px); box-shadow: 0 8px 20px rgba(14,165,233,0.1); }
    .role-option input:checked + .role-ui {
        background: rgba(14, 165, 233, 0.08);
        border-color: var(--color-primary);
        box-shadow: 0 0 0 3px rgba(14, 165, 233, 0.15);
    }
    .role-ui i { display: block; font-size: 1.4rem; color: #94a3b8; margin-bottom: 8px; transition: color 0.3s; }
    .role-option input:checked + .role-ui i { color: var(--color-primary); }
    .role-ui .title { display: block; font-weight: 700; font-size: 0.75rem; color: var(--color-on-surface); letter-spacing: 0.05em; }

    .submit-btn {
        width: 100%;
        background: linear-gradient(135deg, var(--color-primary), var(--color-secondary));
        color: #ffffff;
        border: none;
        border-radius: 50px;
        padding: 14px;
        font-size: 0.85rem;
        font-weight: 700;
        cursor: pointer;
        transition: all 0.3s var(--ease-luxury);
        box-shadow: 0 8px 25px rgba(14,165,233,0.25);
    }
    .submit-btn:hover { transform: translateY(-2px); box-shadow: 0 12px 30px rgba(14,165,233,0.35); }
    .link-accent { color: var(--color-primary); font-weight: 700; text-decoration: none; }
    .link-accent:hover { color: var(--color-secondary); }

    @media (max-width: 992px) {
        .portal-card { grid-template-columns: 1fr; max-width: 500px; }
        .portal-visual { display: none; }
        .portal-form-side { padding: 36px 28px; border-radius: 28px; max-height: none; }
    }
</style>
{% endblock %}

{% block body %}
<div class="portal-wrapper">

    <div class="portal-card animate-fade-in text-start">
        {# ── LEFT PANEL ── #}
        <div class="portal-visual">
            <div class="mb-5">
                <span class="text-gold text-xs fw-800 letter-spacing-2 mb-3 d-block" style="text-shadow: 0 0 10px rgba(56, 189, 248, 0.5);">HERITAGE ONBOARDING</span>
                <h2 class="luxury-serif text-pure mb-5" style="font-size: 2.5rem; text-shadow: 0 4px 15px rgba(255, 255, 255, 0.3);">Initialize Your<br>Service Legacy.</h2>
            </div>
            
            <div class="heritage-step">
                <div class="step-node">01</div>
                <div>
                    <h4>Identity Synchronization</h4>
                    <p>Establish your unique cryptographic profile within the Obsidian matrix.</p>
                </div>
            </div>

            <div class="heritage-step">
                <div class="step-node">02</div>
                <div>
                    <h4>Territory Mapping</h4>
                    <p>Define your operational zone for high-fidelity service matches.</p>
                </div>
            </div>

            <div class="heritage-step mb-0">
                <div class="step-node">03</div>
                <div>
                    <h4>Access Elevation</h4>
                    <p>Secure your pass-key for immediate collection exploration.</p>
                </div>
            </div>
        </div>

        {# ── RIGHT PANEL ── #}
        <div class="portal-form-side">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h3 class="mb-1" style="color: var(--color-on-surface); font-family: Outfit, sans-serif; font-weight: 800;">Create Account</h3>
                    <p class="text-xxs fw-bold letter-spacing-1 mb-0" style="color: var(--color-on-surface-variant);">JOIN SERVICEHUB</p>
                </div>
                <a href="{{ path('app_login') }}" class="text-xxs link-accent">Sign in instead</a>
            </div>

            {{ form_start(registrationForm, {'attr': {'novalidate': 'novalidate'}}) }}
                
                {# Luxury Role Selector (Dropdown) #}
                <div class="mb-4">
                    <label class="input-label">Register as:</label>
                    {{ form_widget(registrationForm.roles, {'attr': {'class': 'auth-input'}}) }}
                    <div class="text-xxs text-danger fw-bold mt-1">{{ form_errors(registrationForm.roles) }}</div>
                </div>

                <div class="row">
                    <div class="col-md-12 mb-4">
                        <label class="input-label">Full Sovereign Name</label>
                        {{ form_widget(registrationForm.fullName, {'attr': {'class': 'auth-input', 'placeholder': 'Alexander Pierce'}}) }}
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6">
                        <div class="mb-4">
                            <label class="input-label">Email Matrix</label>
                            {{ form_widget(registrationForm.email, {'attr': {'class': 'auth-input', 'placeholder': 'alexander@pierce.com'}}) }}
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="mb-4">
                            <label class="input-label">Satellite Contact</label>
                            {{ form_widget(registrationForm.mobile, {'attr': {'class': 'auth-input', 'placeholder': '+1 555 0000'}}) }}
                        </div>
                    </div>
                </div>

                {# Demographic Details #}
                <div class="row">
                    <div class="col-md-6">
                        <div class="mb-4">
                            <label class="input-label">Gender</label>
                            {{ form_widget(registrationForm.gender, {'attr': {'class': 'auth-input'}}) }}
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="mb-4">
                            <label class="input-label">Date of Birth</label>
                            {{ form_widget(registrationForm.dot, {'attr': {'class': 'auth-input'}}) }}
                        </div>
                    </div>
                </div>

                {# Gentry Address #}
                <div class="row">
                    <div class="col-md-12">
                        <div class="mb-4">
                            <label class="input-label">Residential Address</label>
                            {{ form_widget(registrationForm.address, {'attr': {'class': 'auth-input', 'placeholder': 'Estate Avenue 42'}}) }}
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="mb-4">
                            <label class="input-label">City</label>
                            {{ form_widget(registrationForm.city, {'attr': {'class': 'auth-input', 'placeholder': 'Metropolis'}}) }}
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="mb-4">
                            <label class="input-label">Pincode</label>
                            {{ form_widget(registrationForm.pincode, {'attr': {'class': 'auth-input', 'placeholder': '000-000'}}) }}
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6">
                        <div class="mb-4">
                            <label class="input-label">Secure Pass-Key</label>
                            {{ form_widget(registrationForm.plainPassword.first, {'attr': {'class': 'auth-input', 'placeholder': '••••••••'}}) }}
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="mb-4">
                            <label class="input-label">Confirm Pass-Key</label>
                            {{ form_widget(registrationForm.plainPassword.second, {'attr': {'class': 'auth-input', 'placeholder': '••••••••'}}) }}
                        </div>
                    </div>
                </div>

                <div class="mb-5 d-flex align-items-center gap-3">
                    {{ form_widget(registrationForm.agreeTerms, {'attr': {'class': 'form-check-input bg-transparent', 'style': 'border-color: #cbd5e1;'}}) }}
                    <label class="text-xxs text-dim fw-bold cursor-pointer">I AGREE TO THE <a href="#" class="text-gold text-decoration-none">HERITAGE BYLAWS</a></label>
                </div>

                {{ form_rest(registrationForm) }}

                <button type="submit" class="submit-btn mb-0">
                    Create Account <i class="fas fa-arrow-right ms-2"></i>
                </button>
            {{ form_end(registrationForm) }}
        </div>
    </div>
</div>
{% endblock %}