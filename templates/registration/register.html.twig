{% extends 'base.html.twig' %}

{% block title %}Establish Identity — ServiceHub Luxury Portal{% endblock %}

{% block stylesheets %}
<style>
    html { scroll-behavior: smooth; }
    body {
        background: var(--bg-deep, #121826);
        overflow-x: hidden;
        overflow-y: auto;
        min-height: 100vh;
    }

    .portal-wrapper {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        position: relative;
        padding: clamp(1.5rem, 4vw, 2.5rem) clamp(1rem, 3vw, 2.5rem) clamp(2.5rem, 6vh, 4rem);
        box-sizing: border-box;
    }

    .portal-bg-accent {
        position: absolute;
        width: 1200px; height: 1200px;
        background: radial-gradient(circle, rgba(124, 58, 237, 0.05) 0%, transparent 70%);
        bottom: -400px; left: -400px;
        z-index: 1;
        pointer-events: none;
    }

    .portal-card {
        width: 100%;
        max-width: 1250px;
        display: grid;
        grid-template-columns: 1fr 1.3fr;
        background: rgba(26, 34, 51, 0.5);
        backdrop-filter: blur(40px);
        border: 1px solid var(--gold-border);
        border-radius: var(--r-xl);
        overflow: hidden;
        position: relative;
        z-index: 10;
        box-shadow: 0 50px 100px rgba(0,0,0,0.8), 0 0 40px var(--gold-glow);
    }

    /* Left Panel: The Heritage Story */
    .portal-visual {
        background: linear-gradient(rgba(7, 8, 15, 0.8), rgba(7, 8, 15, 0.8)), url('https://images.unsplash.com/photo-1581578731548-c64695cc6952?q=80&w=1200&auto=format&fit=crop');
        background-size: cover;
        background-position: center;
        padding: 60px;
        display: flex;
        flex-direction: column;
        justify-content: center;
    }
    
    .heritage-step {
        display: flex;
        gap: 24px;
        margin-bottom: 40px;
        align-items: flex-start;
    }
    .step-node {
        width: 40px; height: 40px;
        border: 1px solid var(--accent-gold);
        border-radius: 50%;
        display: flex; align-items: center; justify-content: center;
        color: var(--accent-gold);
        font-weight: 800; font-size: 0.8rem;
        flex-shrink: 0;
        background: rgba(212, 175, 55, 0.1);
    }
    .heritage-step h4 { font-family: 'Playfair Display', serif; color: var(--text-pure); margin-bottom: 8px; font-size: 1.2rem; }
    .heritage-step p { color: var(--text-dim); font-size: 0.85rem; margin: 0; line-height: 1.5; }

    /* Right Panel: The Matrix Form */
    .portal-form-side {
        padding: 60px;
        background: rgba(15, 23, 42, 0.25);
    }

    .input-label {
        font-size: 0.6rem;
        font-weight: 800;
        color: var(--text-dim);
        text-transform: uppercase;
        letter-spacing: 0.2em;
        margin-bottom: 10px;
        display: block;
    }

    .auth-input {
        width: 100%;
        background: var(--bg-elevated) !important;
        border: 1px solid var(--glass-border);
        border-radius: var(--r-md);
        padding: 14px 20px;
        color: var(--text-pure) !important;
        font-size: 0.85rem;
        transition: all 0.4s var(--ease-luxury);
        margin-bottom: 20px;
    }
    .auth-input:focus {
        background: var(--bg-surface) !important;
        border-color: var(--accent-gold);
        outline: none;
        box-shadow: 0 0 15px var(--gold-glow);
    }

    /* Elegant Role Selector */
    .luxury-role-selector {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
        margin-bottom: 30px;
    }
    .role-option { cursor: pointer; position: relative; }
    .role-option input { display: none; }
    .role-ui {
        background: rgba(255,255,255,0.02);
        border: 1px solid var(--glass-border);
        padding: 20px;
        border-radius: var(--r-md);
        text-align: center;
        transition: all 0.4s var(--ease-luxury);
    }
    .role-option:hover .role-ui { border-color: var(--gold-border); transform: translateY(-5px); }
    .role-option input:checked + .role-ui {
        background: rgba(212, 175, 55, 0.08);
        border-color: var(--accent-gold);
        box-shadow: 0 0 20px var(--gold-glow);
    }
    .role-ui i { display: block; font-size: 1.5rem; color: var(--text-dim); margin-bottom: 10px; transition: color 0.4s; }
    .role-option input:checked + .role-ui i { color: var(--accent-gold); }
    .role-ui .title { display: block; font-weight: 800; font-size: 0.7rem; color: var(--text-pure); letter-spacing: 0.1em; }

    @media (max-width: 992px) {
        .portal-card { grid-template-columns: 1fr; max-width: 500px; }
        .portal-visual { display: none; }
        .portal-form-side { padding: 40px; }
    }
</style>
{% endblock %}

{% block body %}
<div class="portal-wrapper">
    <div class="portal-bg-accent"></div>

    <div class="portal-card animate-fade-in text-start">
        {# ── LEFT PANEL ── #}
        <div class="portal-visual">
            <div class="mb-5">
                <span class="text-gold text-xs fw-800 letter-spacing-2 mb-3 d-block">HERITAGE ONBOARDING</span>
                <h2 class="luxury-serif text-pure mb-5" style="font-size: 2.5rem;">Initialize Your<br>Service Legacy.</h2>
            </div>
            
            <div class="heritage-step">
                <div class="step-node">01</div>
                <div>
                    <h4>Identity Synchronization</h4>
                    <p>Establish your unique cryptographic profile within the Obsidian matrix.</p>
                </div>
            </div>

            <div class="heritage-step">
                <div class="step-node">02</div>
                <div>
                    <h4>Territory Mapping</h4>
                    <p>Define your operational zone for high-fidelity service matches.</p>
                </div>
            </div>

            <div class="heritage-step mb-0">
                <div class="step-node">03</div>
                <div>
                    <h4>Access Elevation</h4>
                    <p>Secure your pass-key for immediate collection exploration.</p>
                </div>
            </div>
        </div>

        {# ── RIGHT PANEL ── #}
        <div class="portal-form-side">
            <div class="d-flex justify-content-between align-items-center mb-5">
                <div>
                    <h3 class="luxury-serif text-pure mb-1">Establish Identity</h3>
                    <p class="text-xxs text-dim fw-bold letter-spacing-1 mb-0">HERITAGE REGISTRATION MATRIX</p>
                </div>
                <a href="{{ path('app_login') }}" class="text-xxs text-gold fw-bold text-decoration-none">OR SIGN IN</a>
            </div>

            {{ form_start(registrationForm, {'attr': {'novalidate': 'novalidate'}}) }}
                
                {# Luxury Role Selector (Dropdown) #}
                <div class="mb-4">
                    <label class="input-label">Register as:</label>
                    {{ form_widget(registrationForm.roles, {'attr': {'class': 'auth-input'}}) }}
                    <div class="text-xxs text-danger fw-bold mt-1">{{ form_errors(registrationForm.roles) }}</div>
                </div>

                <div class="row">
                    <div class="col-md-12 mb-4">
                        <label class="input-label">Full Sovereign Name</label>
                        {{ form_widget(registrationForm.fullName, {'attr': {'class': 'auth-input', 'placeholder': 'Alexander Pierce'}}) }}
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6">
                        <div class="mb-4">
                            <label class="input-label">Email Matrix</label>
                            {{ form_widget(registrationForm.email, {'attr': {'class': 'auth-input', 'placeholder': 'alexander@pierce.com'}}) }}
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="mb-4">
                            <label class="input-label">Satellite Contact</label>
                            {{ form_widget(registrationForm.mobile, {'attr': {'class': 'auth-input', 'placeholder': '+1 555 0000'}}) }}
                        </div>
                    </div>
                </div>

                {# Demographic Details #}
                <div class="row">
                    <div class="col-md-6">
                        <div class="mb-4">
                            <label class="input-label">Gender</label>
                            {{ form_widget(registrationForm.gender, {'attr': {'class': 'auth-input'}}) }}
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="mb-4">
                            <label class="input-label">Date of Birth</label>
                            {{ form_widget(registrationForm.dot, {'attr': {'class': 'auth-input'}}) }}
                        </div>
                    </div>
                </div>

                {# Gentry Address #}
                <div class="row">
                    <div class="col-md-12">
                        <div class="mb-4">
                            <label class="input-label">Residential Address</label>
                            {{ form_widget(registrationForm.address, {'attr': {'class': 'auth-input', 'placeholder': 'Estate Avenue 42'}}) }}
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="mb-4">
                            <label class="input-label">City</label>
                            {{ form_widget(registrationForm.city, {'attr': {'class': 'auth-input', 'placeholder': 'Metropolis'}}) }}
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="mb-4">
                            <label class="input-label">Pincode</label>
                            {{ form_widget(registrationForm.pincode, {'attr': {'class': 'auth-input', 'placeholder': '000-000'}}) }}
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6">
                        <div class="mb-4">
                            <label class="input-label">Secure Pass-Key</label>
                            {{ form_widget(registrationForm.plainPassword.first, {'attr': {'class': 'auth-input', 'placeholder': '••••••••'}}) }}
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="mb-4">
                            <label class="input-label">Confirm Pass-Key</label>
                            {{ form_widget(registrationForm.plainPassword.second, {'attr': {'class': 'auth-input', 'placeholder': '••••••••'}}) }}
                        </div>
                    </div>
                </div>

                <div class="mb-5 d-flex align-items-center gap-3">
                    {{ form_widget(registrationForm.agreeTerms, {'attr': {'class': 'form-check-input bg-transparent border-glass'}}) }}
                    <label class="text-xxs text-dim fw-bold cursor-pointer">I AGREE TO THE <a href="#" class="text-gold">HERITAGE BYLAWS</a></label>
                </div>

                {{ form_rest(registrationForm) }}

                <button type="submit" class="btn-luxury w-100 py-3 mb-0 justify-content-center">
                    INITIALIZE LEGACY <i class="fas fa-rocket ms-2"></i>
                </button>
            {{ form_end(registrationForm) }}
        </div>
    </div>
</div>
{% endblock %}