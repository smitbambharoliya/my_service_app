{% extends 'base.html.twig' %}

{% block title %}Create Account — ServiceHub{% endblock %}

{% block stylesheets %}
<style>
    body { background: var(--bg-base); overflow-x: hidden; }
    
    .auth-container {
        display: flex;
        min-height: 100vh;
        width: 100%;
    }

    /* ── Left: Form Side ── */
    .auth-side-form {
        flex: 1.2;
        background: var(--bg-base);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 40px;
        position: relative;
        z-index: 10;
    }
    
    .auth-card { 
        width: 100%; 
        max-width: 480px; 
        max-height: 90vh;
        overflow-y: auto;
        padding-right: 12px;
    }
    .auth-card::-webkit-scrollbar { width: 4px; }
    .auth-card::-webkit-scrollbar-thumb { background: var(--border-subtle); border-radius: 4px; }
    
    .auth-header { margin-bottom: 32px; }
    .auth-header h1 { font-size: 2.2rem; margin-bottom: 8px; letter-spacing: -0.04em; }
    .auth-header p { color: var(--text-muted); font-size: 0.95rem; }

    /* ── Role Selector ── */
    .role-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 24px; }
    .role-item {
        position: relative;
        cursor: pointer;
    }
    .role-item input { display: none; }
    .role-box {
        background: rgba(255,255,255,0.03);
        border: 1px solid var(--border-default);
        border-radius: var(--r-lg);
        padding: 20px;
        text-align: center;
        transition: all var(--duration-base) var(--ease-spring);
    }
    .role-item:hover .role-box { border-color: var(--border-brand); transform: translateY(-2px); }
    .role-item input:checked + .role-box {
        background: rgba(124, 58, 237, 0.1);
        border-color: var(--brand-1);
        box-shadow: var(--glow-brand);
    }
    .role-box i { font-size: 1.5rem; color: var(--text-muted); margin-bottom: 12px; transition: color 0.3s; }
    .role-item input:checked + .role-box i { color: var(--brand-1); }
    .role-box .title { display: block; font-weight: 800; font-size: 0.9rem; color: var(--text-primary); text-transform: uppercase; margin-bottom: 4px; }
    .role-box .desc { font-size: 0.75rem; color: var(--text-muted); }

    /* ── Right: Brand Side ── */
    .auth-side-brand {
        flex: 1;
        background: linear-gradient(225deg, #1A103D 0%, #07080F 100%);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 60px;
        position: relative;
        overflow: hidden;
    }

    .brand-content { position: relative; z-index: 2; width: 100%; max-width: 500px; }
    
    .benefit-card {
        background: rgba(255,255,255,0.03);
        backdrop-filter: blur(12px);
        border: 1px solid var(--border-subtle);
        border-radius: var(--r-xl);
        padding: 32px;
    }

    .step-item { display: flex; gap: 20px; margin-bottom: 30px; }
    .step-icon { 
        width: 48px; height: 48px; border-radius: 12px; 
        background: rgba(124, 58, 237, 0.15); color: var(--brand-1);
        display: flex; align-items: center; justify-content: center; font-size: 1.2rem; flex-shrink: 0;
    }
    .step-text h4 { font-size: 1.1rem; margin-bottom: 4px; }
    .step-text p { font-size: 0.85rem; color: var(--text-muted); margin-bottom: 0; }

    @media (max-width: 992px) {
        .auth-side-brand { display: none; }
        .auth-side-form { max-width: 100%; }
    }
</style>
{% endblock %}

{% block body %}
<div class="auth-container">
    
    {# ── FORM SIDE ── #}
    <div class="auth-side-form">
        <div class="auth-card fade-up">
            
            <div class="auth-header">
                <a href="{{ path('app_home') }}" class="nav-brand mb-4 d-inline-flex">
                    ServiceHub<span class="brand-dot">.</span>
                </a>
                <h1>Get Started</h1>
                <p>Join the ecosystem of elite service delivery.</p>
            </div>

            {{ form_start(registrationForm, {'attr': {'novalidate': 'novalidate'}}) }}
                
                <div class="input-group-x">
                    <label>Full Identity</label>
                    {{ form_widget(registrationForm.fullName, {'attr': {'class': 'form-input', 'placeholder': 'Alexander Pierce'}}) }}
                    <div class="text-xs text-danger mt-1 fw-bold">{{ form_errors(registrationForm.fullName) }}</div>
                </div>

                <div class="row">
                    <div class="col-md-6">
                        <div class="input-group-x">
                            <label>Email Access</label>
                            {{ form_widget(registrationForm.email, {'attr': {'class': 'form-input', 'placeholder': 'name@hub.com'}}) }}
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="input-group-x">
                            <label>Contact Number</label>
                            {{ form_widget(registrationForm.mobile, {'attr': {'class': 'form-input', 'placeholder': '+1 (555) 000-0000'}}) }}
                        </div>
                    </div>
                </div>

                <div class="input-group-x">
                    <label>Select Your Path</label>
                    <div class="role-grid">
                        <label class="role-item">
                            <input type="radio" name="{{ registrationForm.roles.vars.full_name }}[]" value="ROLE_USER" checked onchange="handleRole(this)">
                            <div class="role-box">
                                <i class="fas fa-user-tie"></i>
                                <span class="title">Customer</span>
                                <span class="desc">Hire Pros</span>
                            </div>
                        </label>
                        <label class="role-item">
                            <input type="radio" name="{{ registrationForm.roles.vars.full_name }}[]" value="ROLE_PROVIDER" onchange="handleRole(this)">
                            <div class="role-box">
                                <i class="fas fa-toolbox"></i>
                                <span class="title">Provider</span>
                                <span class="desc">Earn Money</span>
                            </div>
                        </label>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6">
                        <div class="input-group-x">
                            <label>Security Key</label>
                            {{ form_widget(registrationForm.plainPassword.first, {'attr': {'class': 'form-input', 'placeholder': '••••••••', 'id': 'p1'}}) }}
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="input-group-x">
                            <label>Confirm Key</label>
                            {{ form_widget(registrationForm.plainPassword.second, {'attr': {'class': 'form-input', 'placeholder': '••••••••', 'id': 'p2'}}) }}
                        </div>
                    </div>
                </div>

                <div class="mb-4 d-flex align-items-center gap-2">
                    {{ form_widget(registrationForm.agreeTerms, {'attr': {'class': 'form-check-input bg-transparent border-subtle'}}) }}
                    <label class="text-xs text-muted fw-bold">I AGREE TO THE <a href="#" class="text-brand-1">SERVICE PROTOCOLS</a></label>
                </div>

                {{ form_rest(registrationForm) }}

                <button type="submit" class="btn-violet w-100 py-3 mb-4">
                    Initialize Account <i class="fas fa-rocket ms-2"></i>
                </button>
            {{ form_end(registrationForm) }}

            <div class="auth-footer pt-3">
                <p class="text-sm text-muted">
                    Already a member? <a href="{{ path('app_login') }}" class="text-primary fw-bold">Sign In</a>
                </p>
            </div>
        </div>
    </div>

    {# ── BRAND SIDE ── #}
    <div class="auth-side-brand">
        <div class="brand-content fade-up" style="transition-delay: 200ms;">
            <div class="benefit-card">
                <h2 class="text-xl fw-800 text-white mb-5 text-uppercase letter-spacing">The Obsidian Advantage</h2>
                
                <div class="step-item">
                    <div class="step-icon"><i class="fas fa-bolt"></i></div>
                    <div class="step-text">
                        <h4>Ultra-Fast Deployment</h4>
                        <p>Match with pros in under 2 minutes using our AI matching engine.</p>
                    </div>
                </div>

                <div class="step-item">
                    <div class="step-icon"><i class="fas fa-shield-halved"></i></div>
                    <div class="step-text">
                        <h4>Guaranteed Quality</h4>
                        <p>Every service is covered by the Hub Protection Plan up to $10k.</p>
                    </div>
                </div>

                <div class="step-item mb-0">
                    <div class="step-icon"><i class="fas fa-chart-line-up"></i></div>
                    <div class="step-text">
                        <h4>Reputation Engine</h4>
                        <div class="mt-2 d-flex gap-2">
                            <span class="badge-pill badge-completed" style="font-size:0.6rem">Bronze</span>
                            <span class="badge-pill badge-confirmed" style="font-size:0.6rem">Gold</span>
                            <span class="badge-pill badge-pending" style="font-size:0.6rem">Elite</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>

<script>
    function handleRole(radio) {
        // Just visual effect? The CSS handles the :checked state
    }
</script>
{% endblock %}