{% extends 'base.html.twig' %}

{% block title %}Establish Identity — ServiceHub Luxury Portal{% endblock %}

{% block stylesheets %}
<style>
    html { scroll-behavior: smooth; }
    body {
        background: #040812;
        overflow-x: hidden;
        overflow-y: auto;
        min-height: 100vh;
    }

    /* Dark Theme Typography Overrides */
    :root {
        --text-pure: #ffffff;
        --text-silver: #94a3b8;
        --text-dim: #64748b;
    }
    h1, h2, h3, h4, h5, h6, .luxury-serif, .text-pure { color: #ffffff !important; }
    .text-silver { color: var(--text-silver) !important; }
    .text-dim { color: var(--text-dim) !important; }
    .text-gold { color: #38bdf8 !important; }

    .portal-wrapper {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        position: relative;
        padding: clamp(1.5rem, 4vw, 2.5rem) clamp(1rem, 3vw, 2.5rem) clamp(2.5rem, 6vh, 4rem);
        box-sizing: border-box;
    }

    .portal-bg-accent {
        position: absolute;
        width: 1200px; height: 1200px;
        background: radial-gradient(circle, rgba(59, 130, 246, 0.04) 0%, transparent 70%);
        bottom: -400px; left: -400px;
        z-index: 1;
        pointer-events: none;
    }

    .portal-card {
        width: 100%;
        max-width: 1250px;
        display: grid;
        grid-template-columns: 1fr 1.3fr;
        background: #0f172a;
        border: 1px solid rgba(255,255,255,0.05);
        border-radius: var(--r-xl);
        overflow: hidden;
        position: relative;
        z-index: 10;
        box-shadow: 0 20px 50px rgba(0,0,0,0.5), 0 0 40px rgba(59, 130, 246, 0.15);
    }

    /* Left Panel: The Heritage Story */
    .portal-visual {
        background: linear-gradient(rgba(15, 23, 42, 0.95), rgba(15, 23, 42, 0.8)), url('https://images.unsplash.com/photo-1600585154340-be6161a56a0c?q=80&w=1200&auto=format&fit=crop');
        background-size: cover;
        background-position: center;
        padding: 60px;
        display: flex;
        flex-direction: column;
        justify-content: center;
    }
    
    .heritage-step {
        display: flex;
        gap: 24px;
        margin-bottom: 40px;
        align-items: flex-start;
    }
    .step-node {
        width: 40px; height: 40px;
        border: 1px solid #3b82f6;
        border-radius: 50%;
        display: flex; align-items: center; justify-content: center;
        color: #3b82f6;
        font-weight: 800; font-size: 0.8rem;
        flex-shrink: 0;
        background: rgba(59, 130, 246, 0.1);
    }
    .heritage-step h4 { font-family: 'Playfair Display', serif; color: #ffffff; margin-bottom: 8px; font-size: 1.2rem; }
    .heritage-step p { color: #94a3b8; font-size: 0.85rem; margin: 0; line-height: 1.5; }

    /* Right Panel: The Matrix Form */
    .portal-form-side {
        padding: 60px;
        background: #0f172a;
    }

    .input-label {
        font-size: 0.6rem;
        font-weight: 800;
        color: var(--text-dim);
        text-transform: uppercase;
        letter-spacing: 0.2em;
        margin-bottom: 10px;
        display: block;
    }

    .auth-input {
        width: 100%;
        background: rgba(0,0,0,0.2) !important;
        border: 1px solid rgba(255,255,255,0.1);
        border-radius: var(--r-md);
        padding: 14px 20px;
        color: #ffffff !important;
        font-size: 0.85rem;
        transition: all 0.4s var(--ease-luxury);
        margin-bottom: 20px;
        font-family: 'Plus Jakarta Sans', sans-serif;
    }
    .auth-input:focus {
        background: rgba(0,0,0,0.4) !important;
        border-color: #38bdf8;
        outline: none;
        box-shadow: 0 0 0 3px rgba(56, 189, 248, 0.2);
    }

    /* Elegant Role Selector */
    .luxury-role-selector {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
        margin-bottom: 30px;
    }
    .role-option { cursor: pointer; position: relative; }
    .role-option input { display: none; }
    .role-ui {
        background: rgba(0,0,0,0.2);
        border: 1px solid rgba(255,255,255,0.1);
        padding: 20px;
        border-radius: var(--r-md);
        text-align: center;
        transition: all 0.4s var(--ease-luxury);
    }
    .role-option:hover .role-ui { border-color: #38bdf8; transform: translateY(-5px); box-shadow: 0 10px 20px rgba(56, 189, 248, 0.15); }
    .role-option input:checked + .role-ui {
        background: rgba(56, 189, 248, 0.1);
        border-color: #38bdf8;
        box-shadow: 0 0 0 3px rgba(56, 189, 248, 0.2);
    }
    .role-ui i { display: block; font-size: 1.5rem; color: #64748b; margin-bottom: 10px; transition: color 0.4s; }
    .role-option input:checked + .role-ui i { color: #38bdf8; }
    .role-ui .title { display: block; font-weight: 800; font-size: 0.7rem; color: #ffffff; letter-spacing: 0.1em; }

    @media (max-width: 992px) {
        .portal-card { grid-template-columns: 1fr; max-width: 500px; }
        .portal-visual { display: none; }
        .portal-form-side { padding: 40px; }
    }
</style>
{% endblock %}

{% block body %}
<div class="portal-wrapper">
    <div class="portal-bg-accent"></div>

    <div class="portal-card animate-fade-in text-start">
        {# ── LEFT PANEL ── #}
        <div class="portal-visual">
            <div class="mb-5">
                <span class="text-gold text-xs fw-800 letter-spacing-2 mb-3 d-block" style="text-shadow: 0 0 10px rgba(56, 189, 248, 0.5);">HERITAGE ONBOARDING</span>
                <h2 class="luxury-serif text-pure mb-5" style="font-size: 2.5rem; text-shadow: 0 4px 15px rgba(255, 255, 255, 0.3);">Initialize Your<br>Service Legacy.</h2>
            </div>
            
            <div class="heritage-step">
                <div class="step-node">01</div>
                <div>
                    <h4>Identity Synchronization</h4>
                    <p>Establish your unique cryptographic profile within the Obsidian matrix.</p>
                </div>
            </div>

            <div class="heritage-step">
                <div class="step-node">02</div>
                <div>
                    <h4>Territory Mapping</h4>
                    <p>Define your operational zone for high-fidelity service matches.</p>
                </div>
            </div>

            <div class="heritage-step mb-0">
                <div class="step-node">03</div>
                <div>
                    <h4>Access Elevation</h4>
                    <p>Secure your pass-key for immediate collection exploration.</p>
                </div>
            </div>
        </div>

        {# ── RIGHT PANEL ── #}
        <div class="portal-form-side">
            <div class="d-flex justify-content-between align-items-center mb-5">
                <div>
                    <h3 class="luxury-serif text-pure mb-1">Establish Identity</h3>
                    <p class="text-xxs text-dim fw-bold letter-spacing-1 mb-0">HERITAGE REGISTRATION MATRIX</p>
                </div>
                <a href="{{ path('app_login') }}" class="text-xxs text-gold fw-bold text-decoration-none">OR SIGN IN</a>
            </div>

            {{ form_start(registrationForm, {'attr': {'novalidate': 'novalidate'}}) }}
                
                {# Luxury Role Selector (Dropdown) #}
                <div class="mb-4">
                    <label class="input-label">Register as:</label>
                    {{ form_widget(registrationForm.roles, {'attr': {'class': 'auth-input'}}) }}
                    <div class="text-xxs text-danger fw-bold mt-1">{{ form_errors(registrationForm.roles) }}</div>
                </div>

                <div class="row">
                    <div class="col-md-12 mb-4">
                        <label class="input-label">Full Sovereign Name</label>
                        {{ form_widget(registrationForm.fullName, {'attr': {'class': 'auth-input', 'placeholder': 'Alexander Pierce'}}) }}
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6">
                        <div class="mb-4">
                            <label class="input-label">Email Matrix</label>
                            {{ form_widget(registrationForm.email, {'attr': {'class': 'auth-input', 'placeholder': 'alexander@pierce.com'}}) }}
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="mb-4">
                            <label class="input-label">Satellite Contact</label>
                            {{ form_widget(registrationForm.mobile, {'attr': {'class': 'auth-input', 'placeholder': '+1 555 0000'}}) }}
                        </div>
                    </div>
                </div>

                {# Demographic Details #}
                <div class="row">
                    <div class="col-md-6">
                        <div class="mb-4">
                            <label class="input-label">Gender</label>
                            {{ form_widget(registrationForm.gender, {'attr': {'class': 'auth-input'}}) }}
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="mb-4">
                            <label class="input-label">Date of Birth</label>
                            {{ form_widget(registrationForm.dot, {'attr': {'class': 'auth-input'}}) }}
                        </div>
                    </div>
                </div>

                {# Gentry Address #}
                <div class="row">
                    <div class="col-md-12">
                        <div class="mb-4">
                            <label class="input-label">Residential Address</label>
                            {{ form_widget(registrationForm.address, {'attr': {'class': 'auth-input', 'placeholder': 'Estate Avenue 42'}}) }}
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="mb-4">
                            <label class="input-label">City</label>
                            {{ form_widget(registrationForm.city, {'attr': {'class': 'auth-input', 'placeholder': 'Metropolis'}}) }}
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="mb-4">
                            <label class="input-label">Pincode</label>
                            {{ form_widget(registrationForm.pincode, {'attr': {'class': 'auth-input', 'placeholder': '000-000'}}) }}
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6">
                        <div class="mb-4">
                            <label class="input-label">Secure Pass-Key</label>
                            {{ form_widget(registrationForm.plainPassword.first, {'attr': {'class': 'auth-input', 'placeholder': '••••••••'}}) }}
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="mb-4">
                            <label class="input-label">Confirm Pass-Key</label>
                            {{ form_widget(registrationForm.plainPassword.second, {'attr': {'class': 'auth-input', 'placeholder': '••••••••'}}) }}
                        </div>
                    </div>
                </div>

                <div class="mb-5 d-flex align-items-center gap-3">
                    {{ form_widget(registrationForm.agreeTerms, {'attr': {'class': 'form-check-input bg-transparent', 'style': 'border-color: #cbd5e1;'}}) }}
                    <label class="text-xxs text-dim fw-bold cursor-pointer">I AGREE TO THE <a href="#" class="text-gold text-decoration-none">HERITAGE BYLAWS</a></label>
                </div>

                {{ form_rest(registrationForm) }}

                <button type="submit" class="btn-aurora-gradient w-100 py-3 mb-0 justify-content-center" style="font-size: 0.8rem; border-radius: 50px;">
                    INITIALIZE LEGACY <i class="fas fa-rocket ms-2"></i>
                </button>
            {{ form_end(registrationForm) }}
        </div>
    </div>
</div>
{% endblock %}