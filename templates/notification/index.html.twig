{% extends 'dashboard_base.html.twig' %}

{% block title %}Signal Archive — ServiceHub{% endblock %}
{% block page_title %}Transmission Log{% endblock %}

{% block body %}
<div class="reveal-3d">
    {# ── 1. ALERT CENTER HEADER ── #}
    <div class="d-flex flex-wrap justify-content-between align-items-end gap-4 mb-5">
        <div>
            <div class="text-xxs text-teal fw-900 letter-spacing-3 mb-2 text-uppercase">Operational Signals</div>
            <h1 class="luxury-serif text-white mb-2" style="font-size: 2.8rem;">Signal Archive<span class="text-teal">.</span></h1>
            <div class="d-flex align-items-center gap-3">
                <span class="text-dim text-xxs fw-800">UNRESOLVED NODES:</span>
                <span class="badge-status {{ unreadCount > 0 ? 'status-active' : 'status-pending' }} px-3">
                    {{ unreadCount }} ACTIVE
                </span>
            </div>
        </div>
        <div class="d-flex gap-3">
            <a href="{{ path('app_profile_edit') }}#notification-preferences" class="btn-outline-luxury py-2 px-4">
                <i class="fas fa-sliders me-2"></i> PREFERENCES
            </a>
            {% if unreadCount > 0 %}
                <form action="{{ path('app_notification_mark_all_read') }}" method="post" class="m-0">
                    <input type="hidden" name="_token" value="{{ csrf_token('mark_all_notifications') }}">
                    <button type="submit" class="btn-luxury py-2 px-4">
                        <i class="fas fa-shield-check me-2"></i> ARCHIVE ALL
                    </button>
                </form>
            {% endif %}
        </div>
    </div>

    {# ── 2. TRANSMISSION FEED ── #}
    <div class="d-grid gap-3">
        {% for notification in notifications %}
            <a href="{{ path('app_notification_visit', {'id': notification.id}) }}" class="text-decoration-none">
                <div class="notification-node {{ notification.isRead ? 'node-read' : 'node-unread' }} reveal-3d">
                    <div class="d-flex flex-wrap justify-content-between align-items-start gap-4 mb-3">
                        <div class="d-flex gap-3 align-items-center">
                            <div class="type-indicator">
                                <i class="fas {{ notification.type|lower == 'booking' ? 'fa-calendar-check' : 'fa-comment-dots' }}"></i>
                            </div>
                            <div>
                                <div class="fw-800 text-white letter-spacing-1 small">{{ notification.title|upper }}</div>
                                <div class="text-xxs text-teal fw-900 letter-spacing-2 mt-1">
                                    {{ notification.type|upper }}{% if not notification.isRead %} · PRIORITY UPLINK{% endif %}
                                </div>
                            </div>
                        </div>
                        <div class="text-dim font-monospace" style="font-size: 0.7rem;">
                            {{ notification.createdAt|date('d . m . Y @ H:i') }}
                        </div>
                    </div>
                    <p class="text-dim mb-0" style="line-height: 1.7; font-size: 0.9rem; max-width: 800px;">
                        {{ notification.message }}
                    </p>
                    
                    {% if not notification.isRead %}
                        <div class="unread-beam"></div>
                    {% endif %}
                </div>
            </a>
        {% else %}
            <div class="glass-card p-5 text-center border-dashed">
                <div class="opacity-20 mb-4">
                    <i class="fas fa-satellite-dish" style="font-size: 3.5rem;"></i>
                </div>
                <h3 class="luxury-serif text-white h4 mb-2">No active transmissions</h3>
                <p class="text-dim text-xs letter-spacing-1">Archives are currently quiet. New alerts will be logged as they arrive.</p>
                <a href="{{ path('app_service_list') }}" class="btn-luxury mt-4 py-2 px-5" style="font-size: 0.6rem;">BROWSE SERVICE ARCHIVE</a>
            </div>
        {% endfor %}
    </div>
</div>

<style>
    /* ── NOTIFICATION NODE ARCHITECTURE ── */
    .notification-node {
        position: relative;
        padding: 24px 32px;
        border-radius: 20px;
        transition: all 0.4s var(--ease-spatial);
        border: 1px solid rgba(255, 255, 255, 0.05);
        overflow: hidden;
    }

    .node-read {
        background: rgba(255, 255, 255, 0.01);
        opacity: 0.7;
    }

    .node-unread {
        background: linear-gradient(135deg, rgba(0, 255, 213, 0.05), rgba(255, 255, 255, 0.03));
        border-color: rgba(0, 255, 213, 0.15);
        box-shadow: 0 10px 30px rgba(0,0,0,0.2);
    }

    .notification-node:hover {
        transform: translateX(8px);
        background: rgba(255, 255, 255, 0.05);
        border-color: rgba(255, 255, 255, 0.2);
    }

    .node-unread:hover {
        border-color: var(--accent-teal);
        box-shadow: 0 0 30px rgba(0, 255, 213, 0.1);
    }

    .type-indicator {
        width: 38px; height: 38px;
        border-radius: 10px;
        background: rgba(255, 255, 255, 0.03);
        display: flex; align-items: center; justify-content: center;
        color: var(--accent-teal);
        font-size: 0.9rem;
        border: 1px solid rgba(255, 255, 255, 0.05);
    }

    .node-unread .type-indicator {
        background: rgba(0, 255, 213, 0.1);
        border-color: var(--accent-teal);
        box-shadow: 0 0 15px rgba(0, 255, 213, 0.2);
    }

    .unread-beam {
        position: absolute;
        left: 0; top: 0; bottom: 0;
        width: 3px;
        background: var(--accent-teal);
        box-shadow: 0 0 20px var(--accent-teal);
    }

    .font-monospace { font-family: 'Fira Code', 'Courier New', monospace; }
</style>
{% endblock %}