{% extends 'dashboard_base.html.twig' %}

{% block title %}Notifications — ServiceHub{% endblock %}
{% block page_title %}Notifications{% endblock %}

{% block body %}
<div class="animate-fade-in">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-5">
        <div>
            <div class="text-uppercase text-muted fw-bold mb-2" style="font-size: 0.72rem; letter-spacing: 0.16em;">Alert Center</div>
            <h1 class="luxury-serif mb-2">Stay in sync with every booking and chat</h1>
            <p class="text-muted mb-0">Unread alerts: <span class="fw-bold text-dark">{{ unreadCount }}</span></p>
        </div>
        <div class="d-flex gap-2">
            <a href="{{ path('app_profile_edit') }}#notification-preferences" class="btn-outline-luxury px-4 py-2">Preferences</a>
            {% if unreadCount > 0 %}
                <form action="{{ path('app_notification_mark_all_read') }}" method="post">
                    <input type="hidden" name="_token" value="{{ csrf_token('mark_all_notifications') }}">
                    <button type="submit" class="btn-luxury px-4 py-2">Mark all read</button>
                </form>
            {% endif %}
        </div>
    </div>

    <div class="d-grid gap-3">
        {% for notification in notifications %}
            <a href="{{ path('app_notification_visit', {'id': notification.id}) }}"
               class="text-decoration-none">
                <div class="glass-card p-4 border-0 {{ notification.isRead ? '' : 'shadow-sm' }}"
                     style="{{ notification.isRead ? 'background: rgba(255,255,255,0.86);' : 'background: linear-gradient(135deg, rgba(59,130,246,0.08), rgba(255,255,255,0.98)); border: 1px solid rgba(59,130,246,0.16);' }}">
                    <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-2">
                        <div>
                            <div class="fw-bold text-dark mb-1">{{ notification.title }}</div>
                            <div class="text-uppercase text-muted fw-bold" style="font-size: 0.68rem; letter-spacing: 0.14em;">
                                {{ notification.type|upper }}{% if not notification.isRead %} · NEW{% endif %}
                            </div>
                        </div>
                        <div class="text-muted" style="font-size: 0.78rem;">{{ notification.createdAt|date('d M Y, H:i') }}</div>
                    </div>
                    <p class="text-muted mb-0" style="line-height: 1.6;">{{ notification.message }}</p>
                </div>
            </a>
        {% else %}
            <div class="glass-card p-5 text-center border-0">
                <div class="mb-3 text-muted" style="font-size: 2rem;"><i class="fa-regular fa-bell-slash"></i></div>
                <h3 class="fw-bold text-dark mb-2">No alerts yet</h3>
                <p class="text-muted mb-0">When bookings change or someone messages you, this feed will show it here.</p>
            </div>
        {% endfor %}
    </div>
</div>
{% endblock %}
