{# templates/components/card.html.twig #}
{# 
  Props:
  title (string|null)
  content (block)
  style (string) => 'glass' | 'aurora'
#}
{% set c_style = style|default('glass') %}
{% set base_class = c_style == 'glass' ? 'bg-white rounded-xl shadow-editorial border border-outline-variant/15 overflow-hidden' : 'aurora-card' %}

<div class="{{ base_class }} {{ class|default('') }}">
    {% if title is defined and title %}
        <div class="px-6 py-4 bg-surface-low border-b border-outline-variant/10">
            <h3 class="font-serif text-xl m-0 p-0 text-on-surface">{{ title }}</h3>
        </div>
    {% endif %}
    
    <div class="px-6 py-5">
        {% block content %}{% endblock %}
    </div>
</div>
