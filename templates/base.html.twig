<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <meta name="theme-color" content="#0a0e16">
        <title>{% block title %}ServiceHub — Digital Luxury Heritage{% endblock %}</title>
        <meta name="description" content="ServiceHub: Premium Concierge & Elite Service Marketplace. Bridging the gap between complex engineering and effortless luxury.">
        <meta property="og:title" content="ServiceHub — Digital Luxury Heritage">
        <meta property="og:description" content="Experience the next evolution of prestige maintenance and bespoke service delivery.">
        <meta property="og:type" content="website">
        <meta property="og:url" content="{{ app.request.uri }}">
        <meta name="robots" content="index, follow">
        
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Noto+Serif:ital,wght@0,400;0,700;1,400&family=Inter:wght@400;500;600;700&family=Public+Sans:wght@300;400;600;700&display=swap" rel="stylesheet">
        <!-- Client-side tailwind compiler removed for production rendering speed -->
        <script>
            tailwind.config = {
                theme: {
                    extend: {
                        colors: {
                            primary: '#006b5a',
                            'primary-container': '#33ccaf',
                            'on-primary': '#ffffff',
                            'on-surface': '#1b1c1d',
                            'on-surface-variant': '#3c4a45',
                            'outline-variant': '#bbcac4',
                            'surface-low': '#f5f3f4',
                            background: '#faf9fa',
                        },
                        fontFamily: {
                            serif: ['Noto Serif', 'serif'],
                            sans: ['Inter', 'sans-serif'],
                            label: ['Public Sans', 'sans-serif'],
                        },
                        borderRadius: {
                            'xl': '8px',
                        }
                    }
                }
            }
        </script>

        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
        
        <link rel="stylesheet" href="{{ asset('styles/app.css') }}?v={{ random() }}">
        
        {% block stylesheets %}{% endblock %}

        <style>
            .luxury-navbar {
                background: rgba(250, 249, 250, 0.8) !important;
                backdrop-filter: blur(20px);
                -webkit-backdrop-filter: blur(20px);
                border-bottom: 1px solid var(--color-outline-variant);
                padding: 1.5rem 0;
                position: sticky;
                top: 0;
                z-index: 1000;
                transition: all 0.4s var(--ease-luxury);
            }
            .luxury-navbar.scrolled {
                padding: 1rem 0;
                background: rgba(255, 255, 255, 0.98) !important;
                box-shadow: var(--shadow-editorial);
            }
            .nav-brand-luxury {
                font-family: 'Noto Serif', serif;
                font-size: 1.75rem;
                font-weight: 700;
                color: var(--color-on-surface) !important;
                text-decoration: none;
                letter-spacing: -0.02em;
            }
            .brand-accent { color: var(--color-primary); font-style: italic; }
            
            .nav-link-alexandria {
                font-family: 'Noto Serif', serif;
                color: var(--color-on-surface-variant);
                font-weight: 400;
                font-size: 0.95rem;
                padding: 4px 0;
                transition: all 0.3s var(--ease-luxury);
                text-decoration: none;
                border-bottom: 2px solid transparent;
            }
            .nav-link-alexandria:hover, .nav-link-alexandria.active {
                color: #ffffff !important;
                border-bottom-color: #ffffff;
                border-bottom-width: 3px;
                font-weight: 700;
            }

            .user-orb {
                width: 40px; height: 40px;
                border-radius: 50%;
                background: linear-gradient(135deg, var(--color-primary), var(--color-emerald-deep));
                display: flex; align-items: center; justify-content: center;
                font-weight: 700; color: #ffffff;
                box-shadow: var(--shadow-primary-glow);
                border: 2px solid #ffffff;
                transition: all 0.3s var(--ease-luxury);
            }
            button:hover .user-orb {
                transform: scale(1.1) rotate(5deg);
                box-shadow: 0 0 20px rgba(0, 107, 90, 0.4);
            }
            .profile-trigger {
                transition: all 0.3s var(--ease-luxury);
                border-radius: 12px;
                padding: 4px 12px !important;
            }
            .profile-trigger:hover {
                background: rgba(0, 107, 90, 0.05);
            }
        </style>
    </head>
    <body class="customer-accent">

    {% if app.request.get('_route') not in ['app_login', 'app_register', 'app_verify_otp'] %}
    <nav class="luxury-navbar" id="mainNavbar">
        <div class="container d-flex align-items-center justify-content-between">
            
            <a class="nav-brand-luxury" href="{{ path('app_home') }}">
                Service<span class="brand-accent">Hub</span>
            </a>

            <ul class="nav d-none d-lg-flex align-items-center gap-5">
                {% if is_granted('ROLE_PROVIDER') %}
                    {# PROVIDER DASHBOARD NAVIGATION #}
                    <li><a href="{{ path('app_provider_home') }}" class="nav-link-alexandria {{ app.request.get('_route') == 'app_provider_home' ? 'active' : '' }}">Home</a></li>
                    <li><a href="{{ path('app_provider_dashboard') }}" class="nav-link-alexandria {{ app.request.get('_route') starts with 'app_provider_dashboard' or app.request.get('_route') == 'app_provider_onboarding' ? 'active' : '' }}">Dashboard</a></li>
                    <li><a href="{{ path('app_provider_my_services') }}" class="nav-link-alexandria {{ app.request.get('_route') starts with 'app_provider_my_services' or app.request.get('_route') starts with 'app_service_show' ? 'active' : '' }}">My Services</a></li>
                    <li><a href="{{ path('app_service_new') }}" class="nav-link-alexandria {{ app.request.get('_route') == 'app_service_new' ? 'active' : '' }}">Add Service</a></li>
                {% else %}
                    {# CUSTOMER/GUEST MARKETPLACE NAVIGATION #}
                    <li><a href="{{ path('app_home') }}" class="nav-link-alexandria {{ app.request.get('_route') == 'app_home' ? 'active' : '' }}">Home</a></li>
                    <li><a href="{{ path('app_service_list') }}" class="nav-link-alexandria {{ app.request.get('_route') == 'app_service_list' ? 'active' : '' }}">Services</a></li>
                    
                    {% if app.user %}
                        <li><a href="{{ path('app_booking_my_bookings') }}" class="nav-link-alexandria {{ app.request.get('_route') == 'app_booking_my_bookings' ? 'active' : '' }}">My Bookings</a></li>
                        <li><a href="{{ path('app_customer_dashboard') }}" class="nav-link-alexandria {{ app.request.get('_route') == 'app_customer_dashboard' ? 'active' : '' }}">My Profile</a></li>
                    {% else %}
                        <li><a href="{{ path('app_login') }}" class="nav-link-alexandria">Login</a></li>
                    {% endif %}
                {% endif %}
                
                {% if is_granted('ROLE_ADMIN') %}
                    <li><a href="{{ path('app_admin_dashboard') }}" class="nav-link-alexandria {{ 'admin' in app.request.getPathInfo() ? 'active' : '' }}">Admin</a></li>
                {% endif %}
            </ul>

            <div class="d-flex align-items-center gap-4">
                {% if app.user %}
                    {% include 'partials/_notification_bell.html.twig' %}

                    <div class="dropdown">
                        <button class="bg-transparent border-0 p-0 d-flex align-items-center gap-3" data-bs-toggle="dropdown">
                            <div class="user-orb">{{ app.user.fullName|slice(0,1)|upper }}</div>
                            <div class="text-start d-none d-md-block">
                                <div class="text-xxs fw-800" style="letter-spacing:0.15em; color: #64748b;">{{ app.user.tier|upper }}</div>
                                <div class="fw-bold" style="font-size:0.8rem; color: #0f172a;">{{ app.user.fullName|split(' ')[0] }}</div>
                            </div>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end p-2 mt-3 shadow" style="min-width:220px; background: rgba(255,255,255,0.98); border: 1px solid rgba(15, 23, 42, 0.1); border-radius: 12px;">
                            <li><a class="dropdown-item p-3 rounded-3 border-0" style="color: #334155; font-weight: 600;" href="{{ path('app_profile') }}"><i class="fa-regular fa-user me-3" style="color: #0ea5e9;"></i> Heritage Profile</a></li>
                            <li><hr class="dropdown-divider" style="border-color: rgba(15, 23, 42, 0.1);"></li>
                            <li><a class="dropdown-item p-3 rounded-3 border-0" style="color: #ef4444; font-weight: 600;" href="{{ path('app_logout') }}"><i class="fa-solid fa-arrow-right-from-bracket me-3" style="color: #ef4444;"></i> Relinquish Session</a></li>
                        </ul>
                    </div>
                {% else %}
                    <a href="{{ path('app_login') }}" class="btn-luxury">Access Portal</a>
                {% endif %}
            </div>
        </div>
    </nav>
    {% endif %}

    <div class="container">
        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="glass-card p-3 mb-4 d-flex align-items-center gap-3 border-0 animate-fade-in" style="background: rgba(16, 185, 129, 0.05);">
                    <i class="fas {{ label == 'success' ? 'fa-circle-check text-teal' : (label == 'error' ? 'fa-circle-exclamation text-red' : 'fa-info-circle text-silver') }} fs-5"></i>
                    <div class="text-silver fw-medium" style="font-size: 0.9rem;">{{ message }}</div>
                </div>
            {% endfor %}
        {% endfor %}
    </div>

    <main>
        {% block body %}{% endblock %}
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        window.addEventListener('scroll', () => {
            const nav = document.getElementById('mainNavbar');
            if(nav) {
                if(window.scrollY > 30) nav.classList.add('scrolled');
                else nav.classList.remove('scrolled');
            }
        });

        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if(entry.isIntersecting) {
                    entry.target.classList.add('animate-fade-in');
                    observer.unobserve(entry.target);
                }
            });
        }, { threshold: 0.05 });

        document.querySelectorAll('.glass-card, .timeline-node').forEach(el => observer.observe(el));
    </script>
    
    {% block javascripts %}
        {% block importmap %}{{ importmap('app') }}{% endblock %}
    {% endblock %}
    </body>
</html>

