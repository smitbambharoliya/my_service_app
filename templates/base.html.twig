<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <meta name="theme-color" content="#0a0e16">
        <title>{% block title %}ServiceHub — Digital Luxury Heritage{% endblock %}</title>
        <meta name="description" content="Premium Concierge & Service Marketplace. Redefining Digital Luxury.">
        
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Playfair+Display:ital,wght@0,400;0,700;1,400;1,700&display=swap" rel="stylesheet">

        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
        
        <link rel="stylesheet" href="{{ asset('styles/app.css') }}">
        
        {% block stylesheets %}{% endblock %}

        <style>
            .luxury-navbar {
                background: rgba(10, 14, 22, 0.4);
                backdrop-filter: blur(20px);
                -webkit-backdrop-filter: blur(20px);
                border-bottom: 1px solid var(--glass-border);
                padding: 1.25rem 0;
                position: sticky;
                top: 0;
                z-index: 1000;
                transition: all 0.4s var(--ease-luxury);
            }
            .luxury-navbar.scrolled {
                padding: 0.85rem 0;
                background: rgba(10, 14, 22, 0.95);
                border-bottom-color: rgba(16, 185, 129, 0.3);
            }
            .nav-brand-luxury {
                font-family: 'Playfair Display', serif;
                font-size: 1.6rem;
                font-weight: 700;
                color: var(--text-pure) !important;
                display: flex; align-items: center; gap: 10px;
                text-decoration: none;
            }
            .gold-dot { color: var(--accent-gold); }
            
            .nav-link-luxury {
                color: var(--text-silver);
                font-weight: 600;
                font-size: 0.75rem;
                text-transform: uppercase;
                letter-spacing: 0.12em;
                padding: 8px 16px;
                transition: all 0.3s var(--ease-luxury);
                text-decoration: none;
                opacity: 0.8;
            }
            .nav-link-luxury:hover, .nav-link-luxury.active {
                color: var(--accent-teal);
                opacity: 1;
                transform: translateY(-1px);
            }

            .nav-notification {
                position: relative;
                color: var(--text-muted);
                font-size: 1.1rem;
                cursor: pointer;
                transition: color 0.3s;
            }
            .nav-notification:hover { color: var(--accent-teal); }
            .notif-dot {
                position: absolute;
                top: -2px; right: -2px;
                width: 8px; height: 8px;
                background: var(--accent-red);
                border-radius: 50%;
                border: 2px solid var(--bg-deep);
            }

            .user-orb {
                width: 38px; height: 38px;
                border-radius: 12px;
                background: linear-gradient(135deg, var(--accent-teal), var(--accent-violet));
                display: flex; align-items: center; justify-content: center;
                font-weight: 800; color: #0a0e16;
                box-shadow: 0 4px 15px var(--accent-teal-glow);
                border: 1px solid rgba(255,255,255,0.1);
            }
        </style>
    </head>
    <body class="customer-accent">

    {% if app.request.get('_route') not in ['app_login', 'app_register', 'app_verify_otp'] %}
    <nav class="luxury-navbar" id="mainNavbar">
        <div class="container d-flex align-items-center justify-content-between">
            
            <a class="nav-brand-luxury" href="{{ path('app_home') }}">
                Service<span class="gold-dot">Hub</span>
            </a>

            <ul class="nav d-none d-lg-flex align-items-center gap-2">
                <li><a href="{{ path('app_home') }}" class="nav-link-luxury {{ app.request.get('_route') == 'app_home' ? 'active' : '' }}">Registry</a></li>
                <li><a href="{{ path('app_service_list') }}" class="nav-link-luxury {{ app.request.get('_route') == 'app_service_list' ? 'active' : '' }}">Curation</a></li>
                {% if app.user %}
                    {% if is_granted('ROLE_PROVIDER') %}
                        <li><a href="{{ path('app_provider_dashboard') }}" class="nav-link-luxury {{ app.request.get('_route') == 'app_provider_dashboard' ? 'active' : '' }}">Atelier</a></li>
                    {% else %}
                        <li><a href="{{ path('app_customer_dashboard') }}" class="nav-link-luxury {{ app.request.get('_route') == 'app_customer_dashboard' ? 'active' : '' }}">Manifest</a></li>
                    {% endif %}
                {% endif %}
            </ul>

            <div class="d-flex align-items-center gap-4">
                {% if app.user %}
                    <div class="nav-notification d-none d-md-block">
                        <i class="fa-regular fa-bell"></i>
                        <span class="notif-dot"></span>
                    </div>

                    <div class="dropdown">
                        <button class="bg-transparent border-0 p-0 d-flex align-items-center gap-3" data-bs-toggle="dropdown">
                            <div class="user-orb">{{ app.user.fullName|slice(0,1)|upper }}</div>
                            <div class="text-start d-none d-md-block">
                                <div class="text-xxs text-muted fw-800" style="letter-spacing:0.15em;">{{ app.user.tier|upper }}</div>
                                <div class="text-pure fw-bold" style="font-size:0.8rem;">{{ app.user.fullName|split(' ')[0] }}</div>
                            </div>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end glass-card p-2 mt-3" style="min-width:220px; background: rgba(10,14,22,0.98); border-color: var(--glass-border);">
                            <li><a class="dropdown-item p-3 rounded-3 text-silver border-0" href="{{ path('app_profile') }}"><i class="fa-regular fa-user me-3 text-teal"></i> Heritage Profile</a></li>
                            <li><hr class="dropdown-divider opacity-10"></li>
                            <li><a class="dropdown-item p-3 rounded-3 text-silver border-0" href="{{ path('app_logout') }}"><i class="fa-solid fa-arrow-right-from-bracket me-3 text-gold"></i> Relinquish Session</a></li>
                        </ul>
                    </div>
                {% else %}
                    <a href="{{ path('app_login') }}" class="btn-luxury">Access Portal</a>
                {% endif %}
            </div>
        </div>
    </nav>
    {% endif %}

    <div class="container">
        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="glass-card p-3 mb-4 d-flex align-items-center gap-3 border-0 animate-fade-in" style="background: rgba(16, 185, 129, 0.05);">
                    <i class="fas {{ label == 'success' ? 'fa-circle-check text-teal' : (label == 'error' ? 'fa-circle-exclamation text-red' : 'fa-info-circle text-silver') }} fs-5"></i>
                    <div class="text-silver fw-medium" style="font-size: 0.9rem;">{{ message }}</div>
                </div>
            {% endfor %}
        {% endfor %}
    </div>

    <main>
        {% block body %}{% endblock %}
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        window.addEventListener('scroll', () => {
            const nav = document.getElementById('mainNavbar');
            if(nav) {
                if(window.scrollY > 30) nav.classList.add('scrolled');
                else nav.classList.remove('scrolled');
            }
        });

        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if(entry.isIntersecting) {
                    entry.target.classList.add('animate-fade-in');
                    observer.unobserve(entry.target);
                }
            });
        }, { threshold: 0.05 });

        document.querySelectorAll('.glass-card, .timeline-node').forEach(el => observer.observe(el));
    </script>
    
    {% block javascripts %}
        {% block importmap %}{{ importmap('app') }}{% endblock %}
    {% endblock %}
    </body>
</html>

