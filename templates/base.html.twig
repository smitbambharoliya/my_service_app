<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <meta name="theme-color" content="#0a0e16">
        <title>{% block title %}ServiceHub — Spatial Portal{% endblock %}</title>
        <meta name="description" content="Intelligent service marketplace for 2026.">
        
        {# ── FONTS ── #}
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;600;800&family=Inter:wght@400;600;700&display=swap" rel="stylesheet">

        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
        
        <link rel="stylesheet" href="{{ asset('styles/color-system.css') }}">
        <link rel="stylesheet" href="{{ asset('styles/app.css') }}">
        
        {% block stylesheets %}{% endblock %}

        <style>
            :root {
                --accent-teal: #00ffd5;
                --bg-obsidian: #080a0f;
                --glass-frost: rgba(255, 255, 255, 0.04);
                --ease-spatial: cubic-bezier(0.23, 1, 0.32, 1);
            }

            body {
                background-color: var(--bg-obsidian);
                color: #f7fbff;
                font-family: 'Plus Jakarta Sans', sans-serif;
                overflow-x: hidden;
                padding-top: 100px;
            }

            /* ── SPATIAL NAVIGATION ── */
            .luxury-navbar {
                width: min(1180px, calc(100% - 32px));
                left: 50%;
                top: 20px;
                transform: translateX(-50%);
                padding: 0.6rem 1.5rem !important;
                background: rgba(8, 10, 15, 0.75) !important;
                backdrop-filter: blur(30px);
                -webkit-backdrop-filter: blur(30px);
                border: 1px solid rgba(255, 255, 255, 0.12);
                border-radius: 24px;
                position: fixed;
                z-index: 2000;
                transition: all 0.5s var(--ease-spatial);
                box-shadow: 0 30px 60px rgba(0,0,0,0.4);
            }

            .luxury-navbar.scrolled {
                top: 10px;
                border-color: rgba(0, 255, 213, 0.3);
                box-shadow: 0 20px 50px rgba(0,0,0,0.5), 0 0 20px rgba(0,255,213,0.1);
            }

            .nav-brand-luxury {
                font-weight: 800;
                font-size: 1.4rem;
                color: #fff !important;
                text-decoration: none;
            }
            .brand-accent { color: var(--accent-teal); text-shadow: 0 0 15px rgba(0,255,213,0.5); }

            .nav-link-alexandria {
                font-family: 'Inter', sans-serif;
                color: rgba(255,255,255,0.7) !important;
                font-weight: 600;
                font-size: 0.85rem;
                padding: 0.5rem 1rem !important;
                border-radius: 99px;
                transition: all 0.3s var(--ease-spatial);
                text-decoration: none;
            }

            .nav-link-alexandria:hover, .nav-link-alexandria.active {
                color: var(--accent-teal) !important;
                background: rgba(0, 255, 213, 0.08);
            }

            /* ── USER ORB ── */
            .user-orb {
                width: 38px; height: 38px;
                border-radius: 12px;
                background: linear-gradient(135deg, var(--accent-teal), #8b5cf6);
                display: flex; align-items: center; justify-content: center;
                font-weight: 800; color: #000;
                box-shadow: 0 0 20px rgba(0, 255, 213, 0.2);
                border: 1px solid rgba(255,255,255,0.3);
            }

            /* ── SPATIAL UTILITIES ── */
            .glass-card {
                background: var(--glass-frost);
                backdrop-filter: blur(20px);
                border: 1px solid rgba(255,255,255,0.08);
                border-radius: 24px;
                transition: var(--ease-spatial);
            }

            .reveal-3d {
                opacity: 0;
                transform: translateY(30px) scale(0.95);
                transition: all 0.8s var(--ease-spatial);
            }

            .reveal-3d.is-visible {
                opacity: 1;
                transform: translateY(0) scale(1);
            }
        </style>
    </head>
    <body class="customer-accent">

    {% if app.request.get('_route') not in ['app_login', 'app_register', 'app_verify_otp'] %}
    <nav class="luxury-navbar d-flex align-items-center justify-content-between" id="mainNavbar">
        <a class="nav-brand-luxury" href="{{ path('app_home') }}">
            Service<span class="brand-accent">Hub</span>
        </a>

        <ul class="nav d-none d-lg-flex align-items-center gap-2">
            {% if is_granted('ROLE_PROVIDER') %}
                <li><a href="{{ path('app_provider_home') }}" class="nav-link-alexandria {{ app.request.get('_route') == 'app_provider_home' ? 'active' : '' }}">Portal</a></li>
                <li><a href="{{ path('app_provider_dashboard') }}" class="nav-link-alexandria {{ app.request.get('_route') starts with 'app_provider_dashboard' ? 'active' : '' }}">Command</a></li>
                <li><a href="{{ path('app_provider_my_services') }}" class="nav-link-alexandria {{ app.request.get('_route') starts with 'app_provider_my_services' ? 'active' : '' }}">Inventory</a></li>
            {% else %}
                <li><a href="{{ path('app_home') }}" class="nav-link-alexandria {{ app.request.get('_route') == 'app_home' ? 'active' : '' }}">Explore</a></li>
                <li><a href="{{ path('app_service_list') }}" class="nav-link-alexandria {{ app.request.get('_route') == 'app_service_list' ? 'active' : '' }}">Archive</a></li>
                {% if app.user %}
                    <li><a href="{{ path('app_booking_my_bookings') }}" class="nav-link-alexandria {{ app.request.get('_route') == 'app_booking_my_bookings' ? 'active' : '' }}">Manifest</a></li>
                {% endif %}
            {% endif %}
        </ul>

        <div class="d-flex align-items-center gap-3">
            {% if app.user %}
                {% include 'partials/_notification_bell.html.twig' %}
                <div class="dropdown">
                    <button class="bg-transparent border-0 p-0 d-flex align-items-center gap-2" data-bs-toggle="dropdown">
                        <div class="user-orb">{{ app.user.fullName|slice(0,1)|upper }}</div>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end p-2 mt-3" style="background: rgba(8,10,15,0.9); border: 1px solid rgba(255,255,255,0.1); border-radius: 16px; backdrop-filter: blur(20px);">
                        <li><a class="dropdown-item rounded-3 py-2 text-white" href="{{ path('app_profile') }}"><i class="fa-regular fa-user me-2 text-teal"></i> Profile</a></li>
                        <li><hr class="dropdown-divider" style="border-color: rgba(255,255,255,0.1);"></li>
                        <li><a class="dropdown-item rounded-3 py-2 text-danger" href="{{ path('app_logout') }}"><i class="fa-solid fa-power-off me-2"></i> Sign Out</a></li>
                    </ul>
                </div>
            {% else %}
                <a href="{{ path('app_login') }}" class="nav-link-alexandria active">Initialize Access</a>
            {% endif %}
        </div>
    </nav>
    {% endif %}

    <main class="container">
        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="glass-card p-3 mb-4 d-flex align-items-center gap-3 border-0 reveal-3d is-visible" style="background: rgba(0, 255, 213, 0.05); border-left: 3px solid var(--accent-teal) !important;">
                    <i class="fas fa-bolt text-teal"></i>
                    <div style="font-weight: 600; color: var(--accent-teal);">{{ message }}</div>
                </div>
            {% endfor %}
        {% endfor %}

        {% block body %}{% endblock %}
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/vanilla-tilt/1.8.1/vanilla-tilt.min.js"></script>
    <script>
        // Navbar Scroll Logic
        window.addEventListener('scroll', () => {
            const nav = document.getElementById('mainNavbar');
            if(nav && window.scrollY > 40) nav.classList.add('scrolled');
            else if(nav) nav.classList.remove('scrolled');
        });

        // Spatial Reveal Logic
        const revealObserver = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if(entry.isIntersecting) {
                    entry.target.classList.add('is-visible');
                }
            });
        }, { threshold: 0.1 });

        document.querySelectorAll('.reveal-3d, .glass-card, .card').forEach(el => revealObserver.observe(el));

        // 3D Tilt Initialization
        document.addEventListener('DOMContentLoaded', () => {
            if(typeof VanillaTilt !== 'undefined') {
                VanillaTilt.init(document.querySelectorAll(".glass-card, .btn-luxury, .user-orb"), {
                    max: 5, speed: 400, glare: true, "max-glare": 0.2, perspective: 1000
                });
            }
        });
    </script>
    </body>
</html>