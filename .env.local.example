# .env.local.example
# Copy this file to .env.local and fill in your values
# DO NOT commit .env.local to git (it's in .gitignore)

###> Email Configuration ###
# Gmail: Generate App Password at https://myaccount.google.com/apppasswords
# Then use: gmail://your-email@gmail.com:app-password@default
MAILER_DSN=gmail://your-email@gmail.com:your-app-password@default
MAILER_FROM=noreply@servicehub.local

###> Stripe Configuration ###
# Get from: https://dashboard.stripe.com/apikeys
# Use sk_test_... for development
# Use sk_live_... for production
STRIPE_SECRET_KEY=sk_test_YOUR_SECRET_KEY_HERE
STRIPE_PUBLISHABLE_KEY=pk_test_YOUR_PUBLISHABLE_KEY_HERE

###> Database (if different from .env) ###
# Uncomment if you need to override the default
# DATABASE_URL="mysql://username:password@localhost:3307/database_name?serverVersion=8.0.32&charset=utf8mb4"

###> Application ###
# Change this to a random string for production
# APP_SECRET should be at least 32 characters
APP_SECRET=your-random-secret-key-min-32-characters

###> Google Maps (Optional) ###
# If you need geolocation features
# GOOGLE_MAPS_API_KEY=your_api_key_here
